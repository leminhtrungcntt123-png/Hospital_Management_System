                                        </div>
                                    }
                                    else if (docPendingMorning != null)
                                    {
                                        <div style="background:#fef3c7; border-left:3px solid #d97706; border-radius:6px; padding:6px 8px; margin-bottom:4px;" title="Lý do: @docPendingMorning.Reason - Vào tab Duyệt nghỉ để xử lý">
                                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                                <strong style="display:block; font-size:11px; color:#92400e;">Ca sáng</strong>
                                                <span style="font-size:9px; background:#fde68a; color:#78350f; padding:1px 5px; border-radius:4px; font-weight:700;">Chờ duyệt</span>
                                            </div>
                                            <small style="color:#b45309; font-size:10px; font-weight:600; display:block; margin-top:2px;">
                                                @(docPendingMorning.Type == ScheduleExceptionType.ShiftSwap ? "Xin đổi ca" : "Xin nghỉ phép")
                                            </small>
                                        </div>
                                    }
                                    else if (docReplaceMorning != null)
                                    {
                                        <div style="background:#f0fdf4; border-left:3px solid #16a34a; border-radius:6px; padding:6px 8px;" title="Trực thay BS. @docReplaceMorning.DoctorName">
                                            <strong style="display:block; font-size:11px; color:#15803d;">Ca sáng (07:30–11:30)</strong>
                                            <small style="color:#16a34a; font-size:10px; font-weight:600;">Trực thay BS. @docReplaceMorning.DoctorName.Split(' ').Last()</small>
                                        </div>
                                    }
                                    else if (schedMorning != null)
                                    {
                                        var mQuay = Math.Max(0, schedMorning.MaxPatients - schedMorning.OnlineSlots);
                                        if (curDate < Model.Today)
                                        {
                                            <div style="background:#e0f2fe; border-left:3px solid #0284c7; border-radius:6px; padding:6px 8px; cursor:default; opacity:0.85;"
                                                 title="Ca khám trong quá khứ - Không thể chỉnh sửa">
                                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                                    <strong style="font-size:11px; color:#0369a1;">Ca sáng</strong>
                                                    <span style="font-size:10px; color:#0284c7; font-weight:600;">@(schedMorning.StartTime.ToString("HH:mm"))–@(schedMorning.EndTime.ToString("HH:mm"))</span>
                                                </div>
                                                <div style="font-size:10px; color:#0369a1; margin-top:3px; display:flex; align-items:center; gap:4px; flex-wrap:wrap;">
                                                    <span style="background:#bae6fd; padding:1px 4px; border-radius:4px; font-weight:700;">@schedMorning.RoomNumber</span>
                                                    <span>🎯 <strong>@schedMorning.MaxPatients</strong> (<span style="color:#0284c7;">On: @schedMorning.OnlineSlots</span> · <span style="color:#0369a1;">Quầy: @mQuay</span>)</span>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div onclick="openScheduleModalWithData(@doc.Id, @schedMorning.RoomId, @((int)dOfWeek), 0, '@schedMorning.StartTime.ToString("HH:mm")', '@schedMorning.EndTime.ToString("HH:mm")', @schedMorning.MaxPatients, @schedMorning.OnlineSlots, @schedMorning.Id, '@curDate.ToString("yyyy-MM-dd")')"
                                                 style="background:#e0f2fe; border-left:3px solid #0284c7; border-radius:6px; padding:6px 8px; cursor:pointer; transition:transform 0.1s; position:relative;"
                                                 onmouseover="this.style.boxShadow='0 2px 6px rgba(2,132,199,0.25)'" onmouseout="this.style.boxShadow='none'"
                                                 title="Nhấp để xem/sửa cấu hình Quota ca sáng">
                                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                                    <strong style="font-size:11px; color:#0369a1;">Ca sáng</strong>
                                                    <div style="display:flex; align-items:center; gap:6px;">
                                                        <span style="font-size:10px; color:#0284c7; font-weight:600;">@(schedMorning.StartTime.ToString("HH:mm"))–@(schedMorning.EndTime.ToString("HH:mm"))</span>
                                                        <button type="button"
                                                                onclick="event.stopPropagation(); openDeleteScheduleById(@schedMorning.Id, '@CleanDocName(doc.FullName)', 'Ca sáng (@schedMorning.StartTime.ToString("HH:mm")–@schedMorning.EndTime.ToString("HH:mm")) - @curDate.ToString("dd/MM/yyyy")')"
                                                                style="background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.3); color:#dc2626; width:18px; height:18px; border-radius:4px; display:inline-flex; align-items:center; justify-content:center; font-size:10px; font-weight:700; cursor:pointer; padding:0; line-height:1; transition:all 0.15s ease;"
                                                                onmouseover="this.style.background='#ef4444'; this.style.color='#fff';"
                                                                onmouseout="this.style.background='rgba(239,68,68,0.12)'; this.style.color='#dc2626';"
                                                                title="Xóa ca sáng này">
                                                            ✕
                                                        </button>
                                                    </div>
                                                </div>
                                                <div style="font-size:10px; color:#0369a1; margin-top:3px; display:flex; align-items:center; gap:4px; flex-wrap:wrap;">
                                                    <span style="background:#bae6fd; padding:1px 4px; border-radius:4px; font-weight:700;">@schedMorning.RoomNumber</span>
                                                    <span>🎯 <strong>@schedMorning.MaxPatients</strong> (<span style="color:#0284c7;">On: @schedMorning.OnlineSlots</span> · <span style="color:#0369a1;">Quầy: @mQuay</span>)</span>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        if (curDate < Model.Today)
                                        {
                                            <div style="background:#f1f5f9; border:1px solid #e2e8f0; border-radius:6px; padding:5px 8px; font-size:10px; color:#94a3b8; text-align:center; cursor:not-allowed;"
                                                 title="Đã qua ngày - Không thể thiết lập lịch khám trong quá khứ">
                                                <span style="opacity:0.6;">Đã qua</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div onclick="openScheduleModalWithData(@doc.Id, 1, @((int)dOfWeek), 0, '07:30', '11:30', 40, 25, 0, '@curDate.ToString("yyyy-MM-dd")')"
                                                 style="background:#f8fafc; border:1px dashed #cbd5e1; border-radius:6px; padding:5px 8px; cursor:pointer; font-size:10px; color:#94a3b8; text-align:center;"
                                                 title="Nhấp để thêm ca sáng cho bác sĩ">
                                                + Ca sáng (07:30)
                                            </div>
                                        }
                                    }
                                </div>

                                <!-- 2. CA CHIỀU -->
                                <div class="shift-block shift-afternoon">
                                    @if (docLeaveAfternoon != null)
                                    {
                                        <div style="background:#fff5e5; border-left:3px solid #f59e0b; border-radius:6px; padding:6px 8px;" title="Lý do: @docLeaveAfternoon.Reason">
                                            <strong style="display:block; font-size:11px; color:#78350f;">Ca chiều (13:00–16:30)</strong>
                                            <small style="color:#b45309; font-size:10px; font-weight:600;">
                                                @(docLeaveAfternoon.Type == ScheduleExceptionType.ShiftSwap ? "Đã đổi ca" : "Đã duyệt nghỉ")
                                            </small>
                                        </div>
                                    }
                                    else if (docPendingAfternoon != null)
                                    {
                                        <div style="background:#fef3c7; border-left:3px solid #d97706; border-radius:6px; padding:6px 8px; margin-bottom:4px;" title="Lý do: @docPendingAfternoon.Reason - Vào tab Duyệt nghỉ để xử lý">
                                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                                <strong style="display:block; font-size:11px; color:#92400e;">Ca chiều</strong>
                                                <span style="font-size:9px; background:#fde68a; color:#78350f; padding:1px 5px; border-radius:4px; font-weight:700;">Chờ duyệt</span>
                                            </div>
                                            <small style="color:#b45309; font-size:10px; font-weight:600; display:block; margin-top:2px;">
                                                @(docPendingAfternoon.Type == ScheduleExceptionType.ShiftSwap ? "Xin đổi ca" : "Xin nghỉ phép")
                                            </small>
                                        </div>
                                    }
                                    else if (docReplaceAfternoon != null)
                                    {
                                        <div style="background:#f0fdf4; border-left:3px solid #16a34a; border-radius:6px; padding:6px 8px;" title="Trực thay BS. @docReplaceAfternoon.DoctorName">
                                            <strong style="display:block; font-size:11px; color:#15803d;">Ca chiều (13:00–16:30)</strong>
                                            <small style="color:#16a34a; font-size:10px; font-weight:600;">Trực thay BS. @docReplaceAfternoon.DoctorName.Split(' ').Last()</small>
                                        </div>
                                    }
                                    else if (schedAfternoon != null)
                                    {
                                        var aQuay = Math.Max(0, schedAfternoon.MaxPatients - schedAfternoon.OnlineSlots);
                                        if (curDate < Model.Today)
                                        {
                                            <div style="background:#ede9fe; border-left:3px solid #7c3aed; border-radius:6px; padding:6px 8px; cursor:default; opacity:0.85;"
                                                 title="Ca khám trong quá khứ - Không thể chỉnh sửa">
                                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                                    <strong style="font-size:11px; color:#5b21b6;">Ca chiều</strong>
                                                    <span style="font-size:10px; color:#7c3aed; font-weight:600;">@(schedAfternoon.StartTime.ToString("HH:mm"))–@(schedAfternoon.EndTime.ToString("HH:mm"))</span>
                                                </div>
                                                <div style="font-size:10px; color:#5b21b6; margin-top:3px; display:flex; align-items:center; gap:4px; flex-wrap:wrap;">
                                                    <span style="background:#ddd6fe; padding:1px 4px; border-radius:4px; font-weight:700;">@schedAfternoon.RoomNumber</span>
                                                    <span>🎯 <strong>@schedAfternoon.MaxPatients</strong> (<span style="color:#7c3aed;">On: @schedAfternoon.OnlineSlots</span> · <span style="color:#5b21b6;">Quầy: @aQuay</span>)</span>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div onclick="openScheduleModalWithData(@doc.Id, @schedAfternoon.RoomId, @((int)dOfWeek), 1, '@schedAfternoon.StartTime.ToString("HH:mm")', '@schedAfternoon.EndTime.ToString("HH:mm")', @schedAfternoon.MaxPatients, @schedAfternoon.OnlineSlots, @schedAfternoon.Id, '@curDate.ToString("yyyy-MM-dd")')"
                                                 style="background:#ede9fe; border-left:3px solid #7c3aed; border-radius:6px; padding:6px 8px; cursor:pointer; transition:transform 0.1s; position:relative;"
                                                 onmouseover="this.style.boxShadow='0 2px 6px rgba(124,58,237,0.25)'" onmouseout="this.style.boxShadow='none'"
                                                 title="Nhấp để xem/sửa cấu hình Quota ca chiều">
                                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                                    <strong style="font-size:11px; color:#5b21b6;">Ca chiều</strong>
                                                    <div style="display:flex; align-items:center; gap:6px;">
                                                        <span style="font-size:10px; color:#7c3aed; font-weight:600;">@(schedAfternoon.StartTime.ToString("HH:mm"))–@(schedAfternoon.EndTime.ToString("HH:mm"))</span>
                                                        <button type="button"
                                                                onclick="event.stopPropagation(); openDeleteScheduleById(@schedAfternoon.Id, '@CleanDocName(doc.FullName)', 'Ca chiều (@schedAfternoon.StartTime.ToString("HH:mm")–@schedAfternoon.EndTime.ToString("HH:mm")) - @curDate.ToString("dd/MM/yyyy")')"
                                                                style="background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.3); color:#dc2626; width:18px; height:18px; border-radius:4px; display:inline-flex; align-items:center; justify-content:center; font-size:10px; font-weight:700; cursor:pointer; padding:0; line-height:1; transition:all 0.15s ease;"
                                                                onmouseover="this.style.background='#ef4444'; this.style.color='#fff';"
                                                                onmouseout="this.style.background='rgba(239,68,68,0.12)'; this.style.color='#dc2626';"
                                                                title="Xóa ca chiều này">
                                                            ✕
                                                        </button>
                                                    </div>
                                                </div>
                                                <div style="font-size:10px; color:#5b21b6; margin-top:3px; display:flex; align-items:center; gap:4px; flex-wrap:wrap;">
                                                    <span style="background:#ddd6fe; padding:1px 4px; border-radius:4px; font-weight:700;">@schedAfternoon.RoomNumber</span>
                                                    <span>🎯 <strong>@schedAfternoon.MaxPatients</strong> (<span style="color:#7c3aed;">On: @schedAfternoon.OnlineSlots</span> · <span style="color:#5b21b6;">Quầy: @aQuay</span>)</span>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        if (curDate < Model.Today)
                                        {
                                            <div style="background:#f1f5f9; border:1px solid #e2e8f0; border-radius:6px; padding:5px 8px; font-size:10px; color:#94a3b8; text-align:center; cursor:not-allowed;"
                                                 title="Đã qua ngày - Không thể thiết lập lịch khám trong quá khứ">
                                                <span style="opacity:0.6;">Đã qua</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div onclick="openScheduleModalWithData(@doc.Id, 1, @((int)dOfWeek), 1, '13:00', '16:30', 40, 25, 0, '@curDate.ToString("yyyy-MM-dd")')"
                                                 style="background:#f8fafc; border:1px dashed #cbd5e1; border-radius:6px; padding:5px 8px; cursor:pointer; font-size:10px; color:#94a3b8; text-align:center;"
                                                 title="Nhấp để thêm ca chiều cho bác sĩ">
                                                + Ca chiều (13:00)
                                            </div>
                                        }
                                    }
                                </div>

                                <!-- 3. CA TRỰC ĐÊM (DUTY SHIFT) - Render tất cả các ca trực đêm trong ngày -->
                                <div class="shift-block shift-night">
                                    @foreach (var docDutyNight in docDutyNights)
                                    {
                                        <div style="background:#0f172a; color:#f8fafc; border-left:3px solid #38bdf8; border-radius:6px; padding:6px 8px; margin-bottom:4px; position:relative;"
                                             title="Ca trực đêm · Phân công bởi: @(docDutyNight.AssignedByName ?? "Trưởng khoa")">
                                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                                <strong style="color:#38bdf8; font-size:11px; display:flex; align-items:center; gap:4px;">
                                                    <span>🌙</span> Trực đêm
                                                </strong>
                                                <div style="display:flex; align-items:center; gap:6px;">
                                                    <span style="font-size:9px; background:#334155; color:#94a3b8; padding:1px 5px; border-radius:4px;">@(docDutyNight.StartTime.ToString("HH:mm"))–@(docDutyNight.EndTime.ToString("HH:mm"))</span>
                                                    <button type="button"
                                                            onclick="event.stopPropagation(); openDeleteDutyModal(@docDutyNight.Id, '@CleanDocName(docDutyNight.StaffName)', '@docDutyNight.StartTime.ToString("dd/MM/yyyy HH:mm")')"
                                                            style="background:rgba(239,68,68,0.2); border:1px solid rgba(239,68,68,0.4); color:#fca5a5; width:18px; height:18px; border-radius:4px; display:inline-flex; align-items:center; justify-content:center; font-size:10px; font-weight:700; cursor:pointer; padding:0; line-height:1; transition:all 0.15s ease;"
                                                            onmouseover="this.style.background='#ef4444'; this.style.color='#fff';"
                                                            onmouseout="this.style.background='rgba(239,68,68,0.2)'; this.style.color='#fca5a5';"
                                                            title="Xóa ca trực đêm này">
                                                        ✕
                                                    </button>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(docDutyNight.Note))
                                            {
                                                <div style="font-size:10px; color:#cbd5e1; margin-top:2px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@docDutyNight.Note</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @{
                    var otherDutyStaff = Model.DutyShifts
                        .Where(ds => !doctorsList.Any(d => d.AccountId == ds.AccountId || (!string.IsNullOrEmpty(ds.StaffName) && d.FullName.Contains(ds.StaffName))))
                        .GroupBy(ds => ds.AccountId)
                        .ToList();
                }
                @foreach (var staffGrp in otherDutyStaff)
                {
                    var staffSample = staffGrp.First();
                    var sInit = staffSample.StaffName.Split(' ').Last()[..Math.Min(2, staffSample.StaffName.Split(' ').Last().Length)].ToUpper();
                    <div class="doctor-schedule-row" data-doctor-name="@staffSample.StaffName.ToLowerInvariant()" style="display:contents;">
                        <div style="padding:16px 14px; border-bottom:1px solid #e2e8f0; border-right:1px solid #e2e8f0; display:flex; align-items:center; gap:10px; background:#fafafa;">
                            <span class="avatar" style="background:#ccfbf1; color:#0f766e; font-weight:700; width:32px; height:32px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:11px;">@sInit</span>
                            <div>
                                <strong style="font-size:12px; color:#0f172a;">@staffSample.StaffName</strong>
                                <div class="text-muted" style="font-size:11px;">@(staffSample.RoleName ?? "Điều dưỡng") · Trực khoa</div>
                            </div>
                        </div>

                        @for (int col = 0; col < 5; col++)
                        {
                            var curDate = weekDates[col];
                            var isToday = (curDate == Model.Today);
                            var staffNights = staffGrp.Where(ds => DateOnly.FromDateTime(ds.StartTime) == curDate).ToList();

                            <div style="padding:10px; border-bottom:1px solid #e2e8f0; @(isToday ? "border-left:2px solid #079bc9; border-right:2px solid #079bc9; background:#f0fdfa;" : "border-right:1px solid #e2e8f0;") display:flex; flex-direction:column; justify-content:center;">
                                <div class="shift-block shift-night">
                                    @if (staffNights.Count > 0)
                                    {
                                        @foreach (var staffNight in staffNights)
                                        {
                                            <div style="background:#0f172a; color:#f8fafc; border-left:3px solid #38bdf8; border-radius:6px; padding:6px 8px; margin-bottom:4px; position:relative;"
                                                 title="Ca trực đêm · Phân công: @(staffNight.AssignedByName ?? "Trưởng khoa")">
                                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                                    <strong style="color:#38bdf8; font-size:11px; display:flex; align-items:center; gap:4px;">
                                                        <span>🌙</span> Trực đêm
                                                    </strong>
                                                    <div style="display:flex; align-items:center; gap:6px;">
                                                        <span style="font-size:9px; background:#334155; color:#94a3b8; padding:1px 5px; border-radius:4px;">@(staffNight.StartTime.ToString("HH:mm"))–@(staffNight.EndTime.ToString("HH:mm"))</span>
                                                        <button type="button"
                                                                onclick="event.stopPropagation(); openDeleteDutyModal(@staffNight.Id, '@CleanDocName(staffNight.StaffName)', '@staffNight.StartTime.ToString("dd/MM/yyyy HH:mm")')"
                                                                style="background:rgba(239,68,68,0.2); border:1px solid rgba(239,68,68,0.4); color:#fca5a5; width:18px; height:18px; border-radius:4px; display:inline-flex; align-items:center; justify-content:center; font-size:10px; font-weight:700; cursor:pointer; padding:0; line-height:1; transition:all 0.15s ease;"
                                                                onmouseover="this.style.background='#ef4444'; this.style.color='#fff';"
                                                                onmouseout="this.style.background='rgba(239,68,68,0.2)'; this.style.color='#fca5a5';"
                                                                title="Xóa ca trực đêm này">
                                                            ✕
                                                        </button>
                                                    </div>
                                                </div>
                                                @if (!string.IsNullOrEmpty(staffNight.Note))
                                                {
                                                    <div style="font-size:10px; color:#cbd5e1; margin-top:2px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@staffNight.Note</div>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div style="font-size:11px; color:#94a3b8; text-align:center;">—</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- BẢNG DANH SÁCH CA TRỰC ĐÊM TRONG KHOA (MỚI) -->
    <section class="card" style="background:#fff; border:1px solid #e2ebf3; border-radius:10px; margin-top:20px; overflow:hidden;">
        <div style="padding:14px 18px; border-bottom:1px solid #eef3f7; display:flex; justify-content:space-between; align-items:center;">
            <div>
                <h3 style="font-size:13px; font-weight:700; margin:0; color:#0f172a; display:flex; align-items:center; gap:6px;">
                    <span>🌙</span> Danh sách ca trực đêm nhân sự khoa
                </h3>
                <small style="color:#64748b; font-size:11px;">Tổng hợp phân công trực ngoài giờ / cấp cứu / theo dõi bệnh phòng</small>
            </div>
            <button type="button" class="btn outline sm" onclick="openDutyModal()">
                <span>+ Phân công trực</span>
            </button>
        </div>
        <div class="table-responsive">
            <table class="table" style="width:100%; border-collapse:collapse; font-size:12px;">
                <thead>
                    <tr style="background:#f8fafc; border-bottom:1px solid #e2e8f0; text-align:left; color:#475569;">
                        <th style="padding:10px 16px;">Nhân sự trực</th>
                        <th style="padding:10px 16px;">Vai trò</th>
                        <th style="padding:10px 16px;">Bắt đầu</th>
                        <th style="padding:10px 16px;">Kết thúc</th>
                        <th style="padding:10px 16px;">Người phân công</th>
                        <th style="padding:10px 16px;">Ghi chú trực</th>
                        <th style="padding:10px 16px; text-align:center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DutyShifts.Count == 0)
                    {
                        <tr>
                            <td colspan="7" style="padding:24px; text-align:center; color:#94a3b8;">Chưa có ca trực đêm nào được phân công.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ds in Model.DutyShifts.OrderByDescending(d => d.StartTime))
                        {
                            <tr style="border-bottom:1px solid #f1f5f9;">
                                <td style="padding:10px 16px; font-weight:600; color:#0f172a;">@CleanDocName(ds.StaffName)</td>
                                <td style="padding:10px 16px;">
                                    <span style="background:#f1f5f9; color:#475569; padding:2px 8px; border-radius:4px; font-size:11px;">
                                        @(ds.RoleName ?? "Bác sĩ")
                                    </span>
                                </td>
                                <td style="padding:10px 16px; color:#0284c7; font-weight:600;">@ds.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                                <td style="padding:10px 16px; color:#64748b;">@ds.EndTime.ToString("dd/MM/yyyy HH:mm")</td>
                                <td style="padding:10px 16px; color:#334155;">@(ds.AssignedByName ?? "Trưởng khoa")</td>
                                <td style="padding:10px 16px; color:#475569;">@(ds.Note ?? "Trực định kỳ")</td>
                                <td style="padding:10px 16px; text-align:center;">
                                    <button type="button" class="btn outline sm" style="color:#ef4444; border-color:#fca5a5; font-size:11px; padding:3px 8px; display:inline-flex; align-items:center; gap:4px;"
                                            onclick="openDeleteDutyModal(@ds.Id, '@CleanDocName(ds.StaffName)', '@ds.StartTime.ToString("dd/MM/yyyy HH:mm")')"
                                            title="Xóa ca trực này">
                                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:11px;height:11px;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                        <span>Xóa</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- Modal Phân ca trực đêm -->
    <div id="dutyModal" class="app-modal-backdrop">
        <div class="app-modal-card">
            <div class="app-modal-header">
                <div>
                    <h5 style="margin:0; font-size:15px; font-weight:700;">Phân công ca trực đêm</h5>
                    <small style="color:#94a3b8; font-size:12px;">Ca trực đêm không tạo lịch đặt khám trên cổng người bệnh</small>
                </div>
                <button type="button" class="app-modal-close" onclick="closeDutyModal()">✕</button>
            </div>
            <form asp-area="Staff" asp-controller="Schedule" asp-action="AssignDuty" method="post">
                @Html.AntiForgeryToken()
                <div class="app-modal-body">
                    <div style="margin-bottom:12px;">
                        <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Nhân sự trực *</label>
                        <select name="accountId" class="form-control" style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;" required>
                            @if (Model.AvailableStaff.Count == 0)
                            {
                                <option value="1">BS. Nguyễn Hoàng Nam (Bác sĩ)</option>
                                <option value="2">BS. Trần Minh Thư (Bác sĩ)</option>
                                <option value="3">Điều dưỡng Hoàng Lan (Y tá)</option>
                            }
                            else
                            {
                                @foreach (var s in Model.AvailableStaff)
                                {
                                    <option value="@s.Id">@CleanDocName(s.FullName) (@s.RoleName)</option>
                                }
                            }
                        </select>
                    </div>

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:12px;">
                        <div>
                            <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Thời gian bắt đầu *</label>
                            <input type="datetime-local" name="startTime" class="form-control" style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" value="@(Model.Today.ToString("yyyy-MM-dd"))T18:00" required />
                        </div>
                        <div>
                            <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Thời gian kết thúc *</label>
                            <input type="datetime-local" name="endTime" class="form-control" style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" value="@(Model.Today.AddDays(1).ToString("yyyy-MM-dd"))T07:00" required />
                        </div>
                    </div>

                    <div style="margin-bottom:6px;">
                        <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Ghi chú trực</label>
                        <input type="text" name="note" class="form-control" style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;" placeholder="Ví dụ: Trực cấp cứu nội khoa sảnh B..." />
                    </div>
                </div>
                <div class="app-modal-footer">
                    <button type="button" class="btn ghost" onclick="closeDutyModal()">Hủy</button>
                    <button type="submit" class="btn primary">Lưu phân công</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Thiết lập lịch khám & Quota -->
    <div id="scheduleModal" class="app-modal-backdrop">
        <div class="app-modal-card">
            <div class="app-modal-header">
                <div>
                    <h5 style="margin:0; font-size:15px; font-weight:700;">Thiết lập lịch khám & Quota</h5>
                    <small style="color:#94a3b8; font-size:12px;">Cấu hình mẫu lịch tuần và định mức tiếp nhận</small>
                </div>
                <button type="button" class="app-modal-close" onclick="closeScheduleModal()">✕</button>
            </div>
            <form asp-area="Staff" asp-controller="Schedule" asp-action="UpsertSchedule" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="scheduleId" id="scheduleModalScheduleId" value="" />
                <input type="hidden" name="slotDurationMinutes" id="scheduleModalSlotDuration" value="15" />
                <div class="app-modal-body">
                    <div style="margin-bottom:12px;">
                        <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Ngày bắt đầu áp dụng *</label>
                        <input type="date" name="effectiveFrom" id="scheduleModalEffectiveFrom" class="form-control" style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;" min="@(Model.Today.ToString("yyyy-MM-dd"))" value="@(Model.Today.ToString("yyyy-MM-dd"))" required />
                        <small style="color:#64748b; font-size:11px;">Chỉ được thiết lập cho ngày hôm nay hoặc tương lai.</small>
                    </div>

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:12px;">
                        <div>
                            <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Bác sĩ *</label>
                            <select name="doctorId" id="scheduleModalDoctorSelect" class="form-control" style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;" required>
                                @if (Model.AvailableDoctors.Count == 0)
                                {
                                    <option value="1">BS. Nguyễn Hoàng Nam</option>
                                    <option value="2">BS. Trần Minh Thư</option>
                                }
                                else
                                {
                                    @foreach (var d in Model.AvailableDoctors)
                                    {
                                        <option value="@d.Id">@CleanDocName(d.FullName)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div>
                            <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Phòng khám *</label>
                            <select name="roomId" id="scheduleModalRoomSelect" class="form-control" style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;" required>
                                @if (Model.AvailableRooms.Count == 0)
                                {
                                    <option value="1">P.201 - Khám Nội 1</option>
                                    <option value="2">P.203 - Khám Tim mạch</option>
                                }
                                else
                                {
                                    @foreach (var r in Model.AvailableRooms)
                                    {
                                        <option value="@r.Id">@r.RoomName (@r.RoomNumber)</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:12px;">
                        <div>
                            <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Thứ trong tuần</label>
                            <select name="dayOfWeek" id="scheduleModalDaySelect" style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;">
                                <option value="1">Thứ Hai</option>
                                <option value="2">Thứ Ba</option>
                                <option value="3">Thứ Tư</option>
                                <option value="4">Thứ Năm</option>
                                <option value="5">Thứ Sáu</option>
                                <option value="6">Thứ Bảy</option>
                            </select>
                        </div>
                        <div>
                            <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Ca khám</label>
                            <select name="shift" id="scheduleModalShiftSelect" style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;">
                                <option value="0">Ca Sáng (07:30 – 11:30)</option>
                                <option value="1">Ca Chiều (13:00 – 16:30)</option>
                            </select>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:12px;">
                        <div>
                            <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Giờ bắt đầu</label>
                            <input type="time" name="startTime" id="scheduleModalStartTime" class="form-control" style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;" value="07:30" required />
                        </div>
                        <div>
                            <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Giờ kết thúc</label>
                            <input type="time" name="endTime" id="scheduleModalEndTime" class="form-control" style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;" value="11:30" required />
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:6px;">
                        <div>
                            <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Tổng chỉ tiêu / ca</label>
                            <input type="number" name="maxPatients" id="scheduleModalMaxPatients" class="form-control" style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;" value="40" min="1" max="100" required />
                        </div>
                        <div>
                            <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Hạn mức trực tuyến</label>
                            <input type="number" name="onlineSlots" id="scheduleModalOnlineSlots" class="form-control" style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;" value="25" min="0" max="100" required />
                        </div>
                    </div>

                    <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:8px 10px; font-size:11px; color:#475569; margin-top:8px;">
                        💡 <strong>Cơ chế Quota:</strong> Khám trực tuyến tối đa = <code>Hạn mức trực tuyến</code>. Số lượt khám tại quầy (tiếp nhận trực tiếp) tự động = <code>Tổng chỉ tiêu - Hạn mức trực tuyến</code>. Khi sửa cấu hình, hệ thống sẽ tự động cập nhật đè bản ghi cũ của bác sĩ trong ca đó.
                    </div>
                </div>
                <div class="app-modal-footer" style="display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <button type="button" id="btnDeleteSchedule" class="btn outline" style="color:#ef4444; border-color:#fca5a5; display:none; align-items:center; gap:5px;" onclick="openDeleteScheduleModal()">
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            <span>Xóa lịch này</span>
                        </button>
                    </div>
                    <div style="display:flex; gap:8px;">
                        <button type="button" class="btn ghost" onclick="closeScheduleModal()">Hủy</button>
                        <button type="submit" class="btn primary">Lưu cấu hình</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Dialog Xác nhận Xóa (thay thế confirm mặc định của trình duyệt) -->
    <div id="confirmDeleteModal" class="app-modal-backdrop" style="z-index:10050;" onclick="if(event.target === this) closeConfirmDeleteModal()">
        <div class="app-modal-card" style="max-width:440px;">
            <div class="app-modal-header" style="background:#b91c1c;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <span style="font-size:16px;">⚠️</span>
                    <h5 id="confirmDeleteTitle" style="margin:0; font-size:15px; font-weight:700;">Xác nhận xóa</h5>
                </div>
                <button type="button" class="app-modal-close" onclick="closeConfirmDeleteModal()">✕</button>
            </div>
            <div class="app-modal-body" style="padding:20px;">
                <div id="confirmDeleteMessage" style="font-size:13px; color:#1e293b; line-height:1.5; margin-bottom:12px;"></div>
                <div id="confirmDeleteDetails" style="background:#fef2f2; border:1px solid #fee2e2; border-radius:6px; padding:10px 12px; font-size:12px; color:#991b1b; display:none;"></div>
            </div>
            <div class="app-modal-footer" style="padding:12px 20px; background:#f8fafc; border-top:1px solid #e2e8f0; display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" class="btn ghost" onclick="closeConfirmDeleteModal()">Hủy bỏ</button>
                <button type="button" id="confirmDeleteActionBtn" class="btn primary" style="background:#dc2626; border-color:#dc2626;" onclick="executeDeleteAction()">Xác nhận xóa</button>
            </div>
        </div>
    </div>

    <!-- Form ẩn để xóa lịch khám -->
    <form id="deleteScheduleForm" asp-area="Staff" asp-controller="Schedule" asp-action="DeleteSchedule" method="post" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="scheduleId" id="deleteScheduleIdInput" value="" />
    </form>

    <!-- Form ẩn để xóa ca trực đêm -->
    <form id="deleteDutyForm" asp-area="Staff" asp-controller="Schedule" asp-action="DeleteDutyShift" method="post" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="deleteDutyIdInput" value="" />
    </form>
}

<script>
    // --- Xử lý Lọc Danh Sách Ngoại Lệ (Image 1) ---
    function filterExceptions(status, btn) {
        document.querySelectorAll('.medicare-tab-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const rows = document.querySelectorAll('.exception-row');
        rows.forEach(r => {
            const rowStatus = r.getAttribute('data-status');
            if (status === 'ALL' || rowStatus === status) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    function openApproveModal(id, doctorName, date, replacementName, affectedCount) {
        document.getElementById('approveExceptionId').value = id;
        document.getElementById('approveModalSub').textContent = doctorName + ' · ' + date;
        document.getElementById('approveReplacementName').textContent = replacementName;
        document.getElementById('approveAffectedCount').textContent = affectedCount || 2;
        document.getElementById('approveModal').classList.add('show');
    }
    function closeApproveModal() {
        document.getElementById('approveModal').classList.remove('show');
    }

    function openRejectModal(id) {
        document.getElementById('rejectExceptionId').value = id;
        document.getElementById('rejectModal').classList.add('show');
    }
    function closeRejectModal() {
        document.getElementById('rejectModal').classList.remove('show');
    }

    // --- Xử lý Tìm kiếm Bệnh án trong khoa (Image 2) ---
    function filterRecords(query) {
        const q = (query || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.record-row');
        let count = 0;
        rows.forEach(r => {
            const text = (r.getAttribute('data-search') || '').toLowerCase();
            if (!q || text.includes(q)) {
                r.style.display = '';
                count++;
            } else {
                r.style.display = 'none';
            }
        });
        const countDisplay = document.getElementById('recordCountDisplay');
        if (countDisplay) countDisplay.textContent = count + ' phiếu khám';
    }

    function openRecordDetailModal(name, code, age, doctor, date, conclusion, diagnosis, exam) {
        document.getElementById('recDetailTitle').textContent = 'Hồ sơ: ' + name;
        document.getElementById('recDetailSub').textContent = code + ' · ' + age + ' · ' + doctor + ' · ' + date;
        document.getElementById('recDetailDiagnosis').textContent = diagnosis || 'Chưa cập nhật mã ICD';
        document.getElementById('recDetailExam').textContent = exam || 'Khám lâm sàng tim mạch ổn định.';
        document.getElementById('recDetailConclusion').textContent = conclusion || 'Đã hoàn tất khám theo yêu cầu.';
        document.getElementById('recordDetailModal').classList.add('show');
    }
    function closeRecordDetailModal() {
        document.getElementById('recordDetailModal').classList.remove('show');
    }

    // --- Xử lý Tab Hàng Chờ Tổng Quan Khoa (Image 3) ---
    function filterOverviewQueue(type, btn) {
        document.querySelectorAll('.medicare-tab-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const rows = document.querySelectorAll('.queue-row');
        rows.forEach(r => {
            const rowType = r.getAttribute('data-type');
            if (type === 'ALL' || rowType === type) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    function openQueueDetailModal(name, code, age, gender, time, status, room, doctor, notes) {
        document.getElementById('qModalTitle').textContent = 'Lượt khám: ' + name;
        document.getElementById('qModalSub').textContent = code + ' · Giờ hẹn: ' + time;
        document.getElementById('qModalPatientName').textContent = name;
        document.getElementById('qModalPatientMeta').textContent = code + ' · ' + age + ' · ' + gender;
        document.getElementById('qModalAvatar').textContent = name.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase();
        document.getElementById('qModalTime').textContent = time;
        document.getElementById('qModalStatus').textContent = status;
        document.getElementById('qModalRoom').textContent = room;
        document.getElementById('qModalDoctor').textContent = doctor;
        document.getElementById('qModalNotes').textContent = notes;
        document.getElementById('queueDetailModal').classList.add('show');
    }
    function closeQueueDetailModal() {
        document.getElementById('queueDetailModal').classList.remove('show');
    }

    // --- Xử lý Tìm kiếm Người Khám (Image 5) ---
    function filterPatients(query) {
        const q = (query || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.patient-row');
        let count = 0;
        rows.forEach(r => {
            const text = (r.getAttribute('data-search') || '').toLowerCase();
            if (!q || text.includes(q)) {
                r.style.display = '';
                count++;
            } else {
                r.style.display = 'none';
            }
        });
        const countDisplay = document.getElementById('patientCountDisplay');
        if (countDisplay) countDisplay.textContent = count + ' hồ sơ';
    }

    function openPatientModal(name, code, gender, dob, phone, address) {
        document.getElementById('pInfoName').textContent = name;
        document.getElementById('pInfoCode').textContent = code;
        document.getElementById('pInfoGender').textContent = gender;
        document.getElementById('pInfoDob').textContent = dob;
        document.getElementById('pInfoPhone').textContent = phone;
        document.getElementById('pInfoAddress').textContent = address;
        document.getElementById('patientInfoModal').classList.add('show');
    }
    function closePatientModal() {
        document.getElementById('patientInfoModal').classList.remove('show');
    }

    // --- Xử lý Lịch khám tuần & Modal Phân ca (Image 4) ---
    function changeWeek(delta) {
        const url = new URL(window.location.href);
        let offset = parseInt(url.searchParams.get('weekOffset') || '0', 10);
        offset += delta;
        url.searchParams.set('tab', 'schedule');
        url.searchParams.set('weekOffset', offset);
        window.location.href = url.toString();
    }
    function resetWeek() {
        const url = new URL(window.location.href);
        url.searchParams.set('tab', 'schedule');
        url.searchParams.delete('weekOffset');
        window.location.href = url.toString();
    }

    // Lọc ca khám bằng Checkbox: Sáng, Chiều, Tối/Trực đêm, Tất cả
    function filterShifts() {
        const chkMorning = document.querySelector('.shift-filter-chk[data-shift-type="morning"]')?.checked;
        const chkAfternoon = document.querySelector('.shift-filter-chk[data-shift-type="afternoon"]')?.checked;
        const chkNight = document.querySelector('.shift-filter-chk[data-shift-type="night"]')?.checked;

        document.querySelectorAll('.shift-morning').forEach(el => el.style.display = chkMorning ? 'block' : 'none');
        document.querySelectorAll('.shift-afternoon').forEach(el => el.style.display = chkAfternoon ? 'block' : 'none');
        document.querySelectorAll('.shift-night').forEach(el => el.style.display = chkNight ? 'block' : 'none');

        const allChecked = chkMorning && chkAfternoon && chkNight;
        const chkAll = document.getElementById('chkAllShifts');
        if (chkAll) {
            chkAll.checked = allChecked;
            chkAll.indeterminate = !allChecked && (chkMorning || chkAfternoon || chkNight);
        }
    }

    function toggleAllShifts(master) {
        const isChecked = master.checked;
        document.querySelectorAll('.shift-filter-chk').forEach(c => c.checked = isChecked);
        filterShifts();
    }

    // Lọc theo Bác sĩ: ô tìm kiếm text hoặc select dropdown
    function applyDoctorFilter() {
        const searchVal = (document.getElementById('searchDoctorInput')?.value || '').toLowerCase().trim();
        const selectVal = (document.getElementById('selectDoctorFilter')?.value || '').toLowerCase().trim();

        document.querySelectorAll('.doctor-schedule-row').forEach(row => {
            const docName = (row.getAttribute('data-doctor-name') || '').toLowerCase();
            let match = true;
            if (selectVal && !docName.includes(selectVal)) {
                match = false;
            }
            if (searchVal && !docName.includes(searchVal)) {
                match = false;
            }
            row.style.display = match ? 'contents' : 'none';
        });
    }

    function filterDoctors(q) {
        applyDoctorFilter();
    }

    function filterDoctorsBySelect(v) {
        applyDoctorFilter();
    }

    function openDutyModal() {
        document.getElementById('dutyModal').classList.add('show');
    }
    function closeDutyModal() {
        document.getElementById('dutyModal').classList.remove('show');
    }

    function openScheduleModal() {
        const idInput = document.getElementById('scheduleModalScheduleId');
        if (idInput) idInput.value = '';
        const delBtn = document.getElementById('btnDeleteSchedule');
        if (delBtn) delBtn.style.display = 'none';

        document.getElementById('scheduleModal').classList.add('show');
    }
    function closeScheduleModal() {
        document.getElementById('scheduleModal').classList.remove('show');
    }

    function openScheduleModalWithData(doctorId, roomId, dayOfWeek, shift, startTime, endTime, maxPatients, onlineSlots, scheduleId, effectiveDate) {
        const idInput = document.getElementById('scheduleModalScheduleId');
        if (idInput) idInput.value = scheduleId > 0 ? scheduleId : '';

        const delBtn = document.getElementById('btnDeleteSchedule');
        if (delBtn) {
            delBtn.style.display = (scheduleId && scheduleId > 0) ? 'inline-flex' : 'none';
        }

        const efInput = document.getElementById('scheduleModalEffectiveFrom');
        if (efInput) efInput.value = effectiveDate || '@(Model.Today.ToString("yyyy-MM-dd"))';

        const docSelect = document.getElementById('scheduleModalDoctorSelect');
        if (docSelect && doctorId) docSelect.value = doctorId;

        const roomSelect = document.getElementById('scheduleModalRoomSelect');
        if (roomSelect && roomId) roomSelect.value = roomId;

        const daySelect = document.getElementById('scheduleModalDaySelect');
        if (daySelect) daySelect.value = dayOfWeek;

        const shiftSelect = document.getElementById('scheduleModalShiftSelect');
        if (shiftSelect) shiftSelect.value = shift;

        const stInput = document.getElementById('scheduleModalStartTime');
        if (stInput) stInput.value = startTime || (shift === 1 ? '13:00' : '07:30');

        const etInput = document.getElementById('scheduleModalEndTime');
        if (etInput) etInput.value = endTime || (shift === 1 ? '16:30' : '11:30');

        const mpInput = document.getElementById('scheduleModalMaxPatients');
        if (mpInput) mpInput.value = maxPatients || 40;

        const osInput = document.getElementById('scheduleModalOnlineSlots');
        if (osInput) osInput.value = onlineSlots || 25;

        document.getElementById('scheduleModal').classList.add('show');
    }

    // --- Xác nhận và Xóa ca trực / lịch khám bằng Modal Dialog (thay thế browser confirm) ---
    let pendingDeleteAction = null;

    function openDeleteDutyModal(id, staffName, time) {
        if (!id || parseInt(id, 10) <= 0) return;
        document.getElementById('confirmDeleteTitle').textContent = 'Xác nhận xóa ca trực đêm';
        document.getElementById('confirmDeleteMessage').textContent = 'Bạn có chắc chắn muốn xóa ca trực đêm này không?';
        const detailsEl = document.getElementById('confirmDeleteDetails');
        if (detailsEl) {
            detailsEl.style.display = 'block';
            detailsEl.innerHTML = '<strong>Nhân sự trực:</strong> ' + (staffName || 'Nhân sự khoa') + '<br/><strong>Thời gian bắt đầu:</strong> ' + (time || '');
        }

        pendingDeleteAction = function() {
            document.getElementById('deleteDutyIdInput').value = id;
            document.getElementById('deleteDutyForm').submit();
        };

        document.getElementById('confirmDeleteModal').classList.add('show');
    }

    function openDeleteScheduleById(id, doctorName, shiftInfo) {
        if (!id || parseInt(id, 10) <= 0) return;

        document.getElementById('confirmDeleteTitle').textContent = 'Xác nhận xóa lịch khám';
        document.getElementById('confirmDeleteMessage').textContent = 'Bạn có chắc chắn muốn xóa ca khám này của bác sĩ không? Thao tác này sẽ hủy cấu hình ca khám của bác sĩ.';
        const detailsEl = document.getElementById('confirmDeleteDetails');
        if (detailsEl) {
            detailsEl.style.display = 'block';
            detailsEl.innerHTML = '<strong>Bác sĩ:</strong> ' + (doctorName || 'Bác sĩ') + '<br/><strong>Ca khám:</strong> ' + (shiftInfo || '');
        }

        pendingDeleteAction = function() {
            document.getElementById('deleteScheduleIdInput').value = id;
            document.getElementById('deleteScheduleForm').submit();
        };

        document.getElementById('confirmDeleteModal').classList.add('show');
    }

    function openDeleteScheduleModal() {
        const id = document.getElementById('scheduleModalScheduleId')?.value;
        if (!id || parseInt(id, 10) <= 0) return;

        const docSelect = document.getElementById('scheduleModalDoctorSelect');
        const docName = docSelect && docSelect.selectedIndex >= 0 ? docSelect.options[docSelect.selectedIndex].text : 'Bác sĩ';
        const daySelect = document.getElementById('scheduleModalDaySelect');
        const dayName = daySelect && daySelect.selectedIndex >= 0 ? daySelect.options[daySelect.selectedIndex].text : '';
        const shiftSelect = document.getElementById('scheduleModalShiftSelect');
        const shiftName = shiftSelect && shiftSelect.selectedIndex >= 0 ? shiftSelect.options[shiftSelect.selectedIndex].text : '';

        openDeleteScheduleById(id, docName, dayName + ' · ' + shiftName);
    }

    function closeConfirmDeleteModal() {
        document.getElementById('confirmDeleteModal').classList.remove('show');
        pendingDeleteAction = null;
    }

    function executeDeleteAction() {
        if (typeof pendingDeleteAction === 'function') {
            const btn = document.getElementById('confirmDeleteActionBtn');
            if (btn) {
                btn.disabled = true;
                btn.textContent = 'Đang xóa...';
            }
            pendingDeleteAction();
        }
    }

    // Tương thích ngược nếu còn lời gọi cũ
    function confirmDeleteCurrentSchedule() {
        openDeleteScheduleModal();
    }
    function confirmDeleteDuty(id, staffName, time) {
        openDeleteDutyModal(id, staffName, time);
    }
</script>
