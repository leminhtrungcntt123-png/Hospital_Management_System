@using HIS.Web.Areas.Staff.Models
@using HIS.Domain
@using HIS.BLL.DTOs
@model ScheduleViewModel

@functions {
    string CleanDocName(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";
        var clean = name.Replace("BS.", "").Replace("BS", "").Replace("PGS.", "").Replace("TS.", "").Trim();
        return "BS. " + clean;
    }
}

@{
    var tab = string.IsNullOrWhiteSpace(Model.ActiveTab) ? "schedule" : Model.ActiveTab.ToLowerInvariant();
    ViewData["Title"] = tab switch
    {
        "exceptions" => "Nghỉ / đổi ca",
        "overview" => "Bàn làm việc",
        "records" => "Bệnh án trong khoa",
        "patients" => "Thông tin người khám",
        _ => "Lịch khám & lịch trực"
    };
}

<style>
    /* Styling đồng bộ chuẩn MediCare UI */
    .medicare-tabs {
        display: flex;
        gap: 8px;
        padding: 12px 16px;
        border-bottom: 1px solid #eef3f7;
        background: #fbfcfe;
    }
    .medicare-tab-btn {
        background: none;
        border: none;
        padding: 6px 14px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        color: #596a7c;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .medicare-tab-btn:hover {
        background: #e2ebf3;
        color: #0f172a;
    }
    .medicare-tab-btn.active {
        background: #079bc9;
        color: #ffffff;
    }
    .app-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(17, 38, 56, 0.55);
        backdrop-filter: blur(2px);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }
    .app-modal-backdrop.show {
        display: flex !important;
    }
    .app-modal-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
        width: 100%;
        max-width: 540px;
        max-height: 90vh;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        animation: appModalIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .app-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        background: #111f38;
        color: #fff;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
    }
    .app-modal-close {
        background: rgba(255, 255, 255, 0.12);
        border: none;
        color: #ffffff;
        font-size: 16px;
        font-weight: 700;
        width: 30px;
        height: 30px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }
    .app-modal-close:hover {
        background: rgba(255, 255, 255, 0.25);
    }
    .app-modal-body {
        padding: 20px;
        font-size: 13px;
        color: #334155;
    }
    .app-modal-footer {
        padding: 12px 20px;
        border-top: 1px solid #f1f5f9;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        background: #fbfcfe;
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
    }
    @@keyframes appModalIn {
        from { transform: translateY(-12px) scale(0.98); opacity: 0; }
        to { transform: translateY(0) scale(1); opacity: 1; }
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background:#f0fdf4; border:1px solid #bbf7d0; color:#166534; padding:10px 14px; border-radius:8px; margin-bottom:14px; font-size:13px; display:flex; align-items:center; gap:8px;">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="background:#fef2f2; border:1px solid #fecaca; color:#991b1b; padding:10px 14px; border-radius:8px; margin-bottom:14px; font-size:13px; display:flex; align-items:center; gap:8px;">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

@if (tab == "exceptions")
{
    <!-- ========================================== -->
    <!-- 1. DUYỆT NGHỈ / THAY ĐỔI CA (IMAGE 1)      -->
    <!-- ========================================== -->
    <div class="page-heading">
        <div>
            <h1>Duyệt nghỉ / thay đổi ca</h1>
            <p>Kiểm tra bác sĩ thay thế và cập nhật lịch hẹn bị ảnh hưởng.</p>
        </div>
    </div>

    <section class="card" style="background:#fff; border:1px solid #e2ebf3; border-radius:10px; overflow:hidden;">
        <div class="medicare-tabs">
            <button type="button" class="medicare-tab-btn active" onclick="filterExceptions('ALL', this)">Tất cả</button>
            <button type="button" class="medicare-tab-btn" onclick="filterExceptions('PENDING', this)">Chờ duyệt</button>
            <button type="button" class="medicare-tab-btn" onclick="filterExceptions('APPROVED', this)">Đã duyệt</button>
            <button type="button" class="medicare-tab-btn" onclick="filterExceptions('REJECTED', this)">Từ chối</button>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Bác sĩ</th>
                        <th>Ngày / Ca</th>
                        <th>Loại / Lý do</th>
                        <th>Đề xuất thay thế</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody id="exceptionsTableBody">
                    @if (Model.Exceptions.Count == 0)
                    {
                        <!-- Dữ liệu mẫu khớp 100% hình 1 nếu DB chưa có -->
                        <tr class="exception-row" data-status="PENDING">
                            <td><strong>BS. Trần Minh Thư</strong></td>
                            <td>
                                <div>05/11/2026</div>
                                <small class="text-muted">Ca sáng</small>
                            </td>
                            <td>
                                <div><strong>Đào tạo</strong></div>
                                <small class="text-muted">Tham gia đào tạo chuyên môn</small>
                            </td>
                            <td>BS. Nguyễn Hoàng Nam</td>
                            <td>
                                <span class="badge" style="background:#fef3c7; color:#b45309; border:1px solid #fde68a; padding:4px 8px; border-radius:50px; font-size:11px;">
                                    • Chờ duyệt
                                </span>
                            </td>
                            <td>
                                <div style="display:flex; gap:8px; align-items:center;">
                                    <button type="button" class="btn primary sm" onclick="openApproveModal(1, 'BS. Trần Minh Thư', '05/11/2026', 'BS. Nguyễn Hoàng Nam', 3)">
                                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        <span>Duyệt</span>
                                    </button>
                                    <button type="button" class="btn ghost sm" onclick="openRejectModal(1)">
                                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                        <span>Từ chối</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ex in Model.Exceptions)
                        {
                            var statusStr = ex.Status.ToString().ToUpper();
                            var typeStr = ex.Type switch
                            {
                                ScheduleExceptionType.Training => "Đào tạo",
                                ScheduleExceptionType.Leave => "Nghỉ phép",
                                ScheduleExceptionType.Surgery => "Phẫu thuật",
                                ScheduleExceptionType.ShiftSwap => "Đổi ca",
                                _ => ex.Type.ToString()
                            };

                            <tr class="exception-row" data-status="@statusStr">
                                <td><strong>BS. @ex.DoctorName</strong></td>
                                <td>
                                    <div>@ex.Date.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">@(ex.Shift == ExamShift.Morning ? "Ca sáng" : ex.Shift == ExamShift.Afternoon ? "Ca chiều" : "Cả ngày")</small>
                                </td>
                                <td>
                                    <div><strong>@typeStr</strong></div>
                                    <small class="text-muted">@ex.Reason</small>
                                </td>
                                <td>
                                    @(ex.ReplacementDoctorName != null ? "BS. " + ex.ReplacementDoctorName : "Tự tìm cùng khoa")
                                </td>
                                <td>
                                    @if (ex.Status == ScheduleExceptionStatus.Pending)
                                    {
                                        <span class="badge" style="background:#fef3c7; color:#b45309; border:1px solid #fde68a; padding:4px 8px; border-radius:50px; font-size:11px;">
                                            • Chờ duyệt
                                        </span>
                                    }
                                    else if (ex.Status == ScheduleExceptionStatus.Approved)
                                    {
                                        <span class="badge" style="background:#dcfce7; color:#15803d; border:1px solid #bbf7d0; padding:4px 8px; border-radius:50px; font-size:11px;">
                                            • Đã duyệt
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#fee2e2; color:#b91c1c; border:1px solid #fecaca; padding:4px 8px; border-radius:50px; font-size:11px;">
                                            • Từ chối
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (ex.Status == ScheduleExceptionStatus.Pending)
                                    {
                                        <div style="display:flex; gap:8px; align-items:center;">
                                            <button type="button" class="btn primary sm" onclick="openApproveModal(@ex.Id, 'BS. @ex.DoctorName', '@ex.Date.ToString("dd/MM/yyyy")', '@(ex.ReplacementDoctorName != null ? "BS. " + ex.ReplacementDoctorName : "Điều phối trong khoa")', 2)">
                                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                                <span>Duyệt</span>
                                            </button>
                                            <button type="button" class="btn ghost sm" onclick="openRejectModal(@ex.Id)">
                                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                <span>Từ chối</span>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@(ex.ApprovedAt.HasValue ? ex.ApprovedAt.Value.ToString("dd/MM/yyyy") : "Đã xử lý")</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- Notice Box cuối trang chuẩn hình 1 -->
    <div style="margin-top:16px; background:#f0f9ff; border:1px solid #bae6fd; color:#0369a1; padding:12px 16px; border-radius:8px; display:flex; align-items:center; gap:10px; font-size:12px;">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;flex-shrink:0;">
            <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span>Có người thay: giữ lịch hẹn và cập nhật bác sĩ. Không còn chỗ thay thế: thông báo để người đặt chọn lại lịch. Lịch giữ chỗ bị ảnh hưởng được hủy.</span>
    </div>

    <!-- Modal Duyệt thay đổi ca -->
    <div id="approveModal" class="app-modal-backdrop">
        <div class="app-modal-card">
            <div class="app-modal-header">
                <div>
                    <h5 style="margin:0; font-size:15px; font-weight:700;">Duyệt thay đổi ca khám?</h5>
                    <small id="approveModalSub" style="color:#94a3b8; font-size:12px;"></small>
                </div>
                <button type="button" class="app-modal-close" onclick="closeApproveModal()">✕</button>
            </div>
            <form asp-action="ApproveException" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="approveExceptionId" />
                <div class="app-modal-body">
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:14px; margin-bottom:14px;">
                        <div>
                            <small style="color:#64748b; display:block; font-size:11px;">Lượt cần xử lý</small>
                            <strong id="approveAffectedCount" style="font-size:18px; color:#0f172a;">2</strong>
                        </div>
                        <div>
                            <small style="color:#64748b; display:block; font-size:11px;">Đề xuất thay thế</small>
                            <strong id="approveReplacementName" style="font-size:14px; color:#079bc9;">BS. Nguyễn Hoàng Nam</strong>
                        </div>
                    </div>
                    <p style="font-size:12px; color:#64748b; margin:0; line-height:1.5;">
                        Lịch hẹn được cập nhật cùng thông báo gửi về tài khoản đặt. Lượt hết chỗ thay thế cần chọn lại lịch.
                    </p>
                </div>
                <div class="app-modal-footer">
                    <button type="button" class="btn ghost" onclick="closeApproveModal()">Quay lại</button>
                    <button type="submit" class="btn primary">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        <span>Duyệt & cập nhật lịch</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Từ chối -->
    <div id="rejectModal" class="app-modal-backdrop">
        <div class="app-modal-card">
            <div class="app-modal-header">
                <div>
                    <h5 style="margin:0; font-size:15px; font-weight:700;">Từ chối đề nghị ngoại lệ</h5>
                    <small style="color:#94a3b8; font-size:12px;">Nhập lý do phản hồi cho bác sĩ</small>
                </div>
                <button type="button" class="app-modal-close" onclick="closeRejectModal()">✕</button>
            </div>
            <form asp-action="RejectException" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="rejectExceptionId" />
                <div class="app-modal-body">
                    <label style="display:block; font-size:12px; font-weight:600; margin-bottom:6px; color:#334155;">Lý do từ chối *</label>
                    <textarea name="reason" class="form-control" rows="3" style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px;" placeholder="Ví dụ: Khoa đang thiếu nhân sự trong ca này..." required></textarea>
                </div>
                <div class="app-modal-footer">
                    <button type="button" class="btn ghost" onclick="closeRejectModal()">Hủy</button>
                    <button type="submit" class="btn" style="background:#ef4444; color:#fff; border:none; padding:7px 16px; border-radius:6px; font-size:12px; font-weight:600;">Xác nhận từ chối</button>
                </div>
            </form>
        </div>
    </div>
}
else if (tab == "records")
{
    <!-- ========================================== -->
    <!-- 2. BỆNH ÁN TRONG KHOA (IMAGE 2)            -->
    <!-- ========================================== -->
    <div class="page-heading">
        <div>
            <h1>Bệnh án trong khoa</h1>
            <p>Xem hồ sơ trong phạm vi chuyên môn. Chỉ bác sĩ phụ trách được chỉnh sửa phiếu của mình.</p>
        </div>
    </div>

    <section class="card" style="background:#fff; border:1px solid #e2ebf3; border-radius:10px; overflow:hidden;">
        <div class="toolbar" style="padding:14px 18px; border-bottom:1px solid #e5edf5; display:flex; justify-content:space-between; align-items:center;">
            <div style="position:relative; width:360px;">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position:absolute; left:12px; top:9px; width:15px; height:15px; color:#94a3b8;">
                    <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" id="recordSearchInput" oninput="filterRecords(this.value)" placeholder="Tìm người khám hoặc kết luận..." style="width:100%; padding:7px 12px 7px 34px; border:1px solid #cbd5e1; border-radius:8px; font-size:12px;" />
            </div>
            <span id="recordCountDisplay" style="font-size:12px; color:#64748b; font-weight:600;">
                @(Model.MedicalRecords.Count > 0 ? Model.MedicalRecords.Count : 2) phiếu khám
            </span>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Người khám</th>
                        <th>Ngày khám</th>
                        <th>Bác sĩ</th>
                        <th>Kết luận</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody id="recordsTableBody">
                    @if (Model.MedicalRecords.Count == 0)
                    {
                        <!-- Mẫu chuẩn theo hình 2 -->
                        <tr class="record-row" data-search="đỗ gia khang bn0010 đã hoàn tất khám theo yêu cầu">
                            <td>
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <span class="avatar" style="background:#e0f2fe; color:#0369a1; font-weight:700; width:32px; height:32px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:11px;">GK</span>
                                    <div>
                                        <strong>Đỗ Gia Khang</strong>
                                        <div class="text-muted small">BN0010 · 43 tuổi</div>
                                    </div>
                                </div>
                            </td>
                            <td>04/11/2026</td>
                            <td>BS. Lê Quang Huy</td>
                            <td>Đã hoàn tất khám theo yêu cầu</td>
                            <td>
                                <button type="button" class="btn outline sm" onclick="openRecordDetailModal('Đỗ Gia Khang', 'BN0010', '43 tuổi', 'BS. Lê Quang Huy', '04/11/2026', 'Đã hoàn tất khám theo yêu cầu', 'I10 Tăng huyết áp nguyên phát', 'Khám lâm sàng tim mạch ổn định, không ghi nhận tiếng ran.')">
                                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><circle cx="12" cy="12" r="3"></circle><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path></svg>
                                    <span>Xem phiếu</span>
                                </button>
                            </td>
                        </tr>
                        <tr class="record-row" data-search="nguyễn thanh hà bn0001 khám sức khỏe định kỳ">
                            <td>
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <span class="avatar" style="background:#fce7f3; color:#be185d; font-weight:700; width:32px; height:32px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:11px;">TH</span>
                                    <div>
                                        <strong>Nguyễn Thanh Hà</strong>
                                        <div class="text-muted small">BN0001 · 32 tuổi</div>
                                    </div>
                                </div>
                            </td>
                            <td>15/10/2026</td>
                            <td>BS. Nguyễn Hoàng Nam</td>
                            <td>Khám sức khỏe định kỳ</td>
                            <td>
                                <button type="button" class="btn outline sm" onclick="openRecordDetailModal('Nguyễn Thanh Hà', 'BN0001', '32 tuổi', 'BS. Nguyễn Hoàng Nam', '15/10/2026', 'Khám sức khỏe định kỳ', 'Z00.0 Khám sức khỏe tổng quát', 'Thể trạng tốt, các chỉ số sinh hiệu trong giới hạn bình thường.')">
                                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><circle cx="12" cy="12" r="3"></circle><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path></svg>
                                    <span>Xem phiếu</span>
                                </button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var rec in Model.MedicalRecords)
                        {
                            var init = rec.PatientName.Length >= 2 ? rec.PatientName[..2].ToUpper() : "BN";
                            var searchKey = $"{rec.PatientName} {rec.AppointmentCode} {rec.DiagnosisDesc} {rec.Conclusion}".ToLowerInvariant();

                            <tr class="record-row" data-search="@searchKey">
                                <td>
                                    <div style="display:flex; align-items:center; gap:10px;">
                                        <span class="avatar" style="background:#e0f2fe; color:#0369a1; font-weight:700; width:32px; height:32px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:11px;">@init</span>
                                        <div>
                                            <strong>@rec.PatientName</strong>
                                            <div class="text-muted small">@rec.AppointmentCode · @rec.Age tuổi</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@rec.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>BS. @rec.DoctorName</td>
                                <td>@(string.IsNullOrWhiteSpace(rec.Conclusion) ? rec.DiagnosisDesc : rec.Conclusion)</td>
                                <td>
                                    <button type="button" class="btn outline sm" onclick="openRecordDetailModal('@rec.PatientName', '@rec.AppointmentCode', '@rec.Age tuổi', 'BS. @rec.DoctorName', '@rec.CreatedAt.ToString("dd/MM/yyyy")', '@(rec.Conclusion ?? rec.DiagnosisDesc)', '@rec.DiagnosisCode @rec.DiagnosisDesc', 'Khám lâm sàng tim mạch tổng quát ổn định.')">
                                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><circle cx="12" cy="12" r="3"></circle><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path></svg>
                                        <span>Xem phiếu</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- Modal Chi tiết bệnh án -->
    <div id="recordDetailModal" class="app-modal-backdrop">
        <div class="app-modal-card" style="max-width:620px;">
            <div class="app-modal-header">
                <div>
                    <h5 id="recDetailTitle" style="margin:0; font-size:15px; font-weight:700;">Hồ sơ bệnh án</h5>
                    <small id="recDetailSub" style="color:#94a3b8; font-size:12px;"></small>
                </div>
                <button type="button" class="app-modal-close" onclick="closeRecordDetailModal()">✕</button>
            </div>
            <div class="app-modal-body" style="line-height:1.6;">
                <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:12px 16px; margin-bottom:16px;">
                    <strong style="color:#0f172a; font-size:13px;">Chẩn đoán chính:</strong>
                    <div id="recDetailDiagnosis" style="font-size:13px; color:#079bc9; font-weight:600; margin-top:2px;"></div>
                </div>
                <div style="margin-bottom:12px;">
                    <strong style="color:#334155; font-size:12px;">Khám lâm sàng:</strong>
                    <p id="recDetailExam" style="margin:4px 0 0 0; color:#64748b; font-size:12px;"></p>
                </div>
                <div>
                    <strong style="color:#334155; font-size:12px;">Kết luận & Dặn dò:</strong>
                    <p id="recDetailConclusion" style="margin:4px 0 0 0; color:#0f172a; font-size:12px;"></p>
                </div>
            </div>
            <div class="app-modal-footer">
                <button type="button" class="btn ghost" onclick="closeRecordDetailModal()">Đóng</button>
            </div>
        </div>
    </div>
}
else if (tab == "overview")
{
    <!-- ========================================== -->
    <!-- 3. TỔNG QUAN KHOA (IMAGE 3)                -->
    <!-- ========================================== -->
    <div class="page-heading" style="display:flex; justify-content:space-between; align-items:flex-start;">
        <div>
            <span class="eyebrow" style="font-size:10px; font-weight:700; color:#079bc9; letter-spacing:0.8px; text-transform:uppercase;">VẬN HÀNH TẠI KHOA</span>
            <h1 style="margin-top:2px;">Tổng quan khoa</h1>
            <p>Theo dõi tiến độ khám và điều phối nhân sự trong khoa.</p>
        </div>
        <div style="display:flex; gap:10px;">
            <a href="/Staff/Consultation" class="btn outline" style="text-decoration:none;">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><path d="M5 3v5a5 5 0 0 0 10 0V3 M3 3h4 M13 3h4 M10 13v3a5 5 0 0 0 10 0v-2 M22 11a2 2 0 1 1-4 0 2 2 0 0 1 4 0"></path></svg>
                <span>Bàn khám bệnh</span>
            </a>
            <a href="?tab=schedule" class="btn primary" style="text-decoration:none;">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                <span>Xem lịch khoa</span>
            </a>
        </div>
    </div>

    var overview = Model.Overview;
    var queueItems = overview?.QueueItems ?? [];
    var receptionCount = overview?.WaitingReceptionCount ?? 0;
    var vitalCount = overview?.NeedVitalSignsCount ?? 0;
    var waitingDocCount = queueItems.Count(q => q.StatusId == (int)AppointmentStatusId.ReadyForDoctor);
    var inProgressCount = overview?.InProgressAppointmentsCount ?? 0;
    var unpaidCount = overview?.UnpaidInvoicesCount ?? 0;
    var unpaidAmount = overview?.UnpaidAmount ?? 0;

    var callingItem = queueItems.FirstOrDefault(q => q.StatusId == (int)AppointmentStatusId.InProgress)
                   ?? queueItems.FirstOrDefault(q => q.StatusId == (int)AppointmentStatusId.ReadyForDoctor);
    var nextWaitingCount = callingItem != null ? Math.Max(0, queueItems.Count - 1) : queueItems.Count;

    <!-- 4 Stats Cards chuẩn hình 3 -->
    <section class="stats-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); gap:16px; margin-bottom:20px;">
        <div class="card" style="background:#fff; border:1px solid #e2ebf3; border-top:3px solid #079bc9; border-radius:10px; padding:16px 20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; color:#64748b; font-size:12px; font-weight:600;">
                <span>📅 Chờ tiếp nhận</span>
                <span>→</span>
            </div>
            <div style="font-size:28px; font-weight:700; color:#0f172a; margin:8px 0 4px 0;">@receptionCount</div>
            <small style="color:#64748b; font-size:11px;">Xác nhận thông tin & cấp số</small>
        </div>

        <div class="card" style="background:#fff; border:1px solid #e2ebf3; border-top:3px solid #6366f1; border-radius:10px; padding:16px 20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; color:#64748b; font-size:12px; font-weight:600;">
                <span>📈 Cần đo sinh hiệu</span>
                <span>→</span>
            </div>
            <div style="font-size:28px; font-weight:700; color:#0f172a; margin:8px 0 4px 0;">@vitalCount</div>
            <small style="color:#64748b; font-size:11px;">Chuẩn bị trước khi vào khám</small>
        </div>

        <div class="card" style="background:#fff; border:1px solid #e2ebf3; border-top:3px solid #06b6d4; border-radius:10px; padding:16px 20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; color:#64748b; font-size:12px; font-weight:600;">
                <span>🩺 Chờ / đang khám</span>
                <span>→</span>
            </div>
            <div style="font-size:28px; font-weight:700; color:#0f172a; margin:8px 0 4px 0;">@inProgressCount</div>
            <small style="color:#64748b; font-size:11px;">Theo dõi phòng và hàng chờ</small>
        </div>

        <div class="card" style="background:#fff; border:1px solid #e2ebf3; border-top:3px solid #f59e0b; border-radius:10px; padding:16px 20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; color:#64748b; font-size:12px; font-weight:600;">
                <span>📦 Chưa thu đủ phí</span>
            </div>
            <div style="font-size:28px; font-weight:700; color:#0f172a; margin:8px 0 4px 0;">@unpaidCount</div>
            <small style="color:#64748b; font-size:11px;">@(unpaidAmount.ToString("N0")) đ còn lại</small>
        </div>
    </section>

    <!-- 2 Cột: Danh sách cần xử lý trước & Điều phối hàng chờ -->
    <div style="display:grid; grid-template-columns:1.8fr 1fr; gap:20px; align-items:start;">
        <!-- Cột trái: Cần xử lý trước -->
        <section class="card" style="background:#fff; border:1px solid #e2ebf3; border-radius:10px; overflow:hidden;">
            <div style="padding:14px 18px; border-bottom:1px solid #eef3f7; display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <h3 style="font-size:14px; font-weight:700; margin:0; color:#0f172a;">📅 Cần xử lý trước</h3>
                    <small style="color:#64748b; font-size:11px;">@(queueItems.Count) lượt trong ngày</small>
                </div>
                <a href="?tab=records" style="font-size:12px; color:#079bc9; font-weight:600; text-decoration:none;">→ Mở danh sách</a>
            </div>

            <div class="medicare-tabs">
                <button type="button" class="medicare-tab-btn active" onclick="filterOverviewQueue('ALL', this)">Tất cả (@(queueItems.Count))</button>
                <button type="button" class="medicare-tab-btn" onclick="filterOverviewQueue('TIEP_NHAN', this)">Tiếp nhận <span style="font-size:10px; opacity:0.8;">@receptionCount</span></button>
                <button type="button" class="medicare-tab-btn" onclick="filterOverviewQueue('SINH_HIEU', this)">Sinh hiệu <span style="font-size:10px; opacity:0.8;">@vitalCount</span></button>
                <button type="button" class="medicare-tab-btn" onclick="filterOverviewQueue('CHO_BAC_SI', this)">Chờ bác sĩ <span style="font-size:10px; opacity:0.8;">@waitingDocCount</span></button>
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Giờ hẹn</th>
                            <th>Người khám</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="overviewQueueBody">
                        @if (queueItems.Count == 0)
                        {
                            <tr id="emptyQueueRow">
                                <td colspan="4" style="text-align:center; padding:36px 16px; color:#64748b;">
                                    <div style="font-size:26px; margin-bottom:6px;">🎉</div>
                                    <strong style="color:#0f172a; font-size:13px;">Đã hoàn thành khám cho toàn bộ bệnh nhân hôm nay</strong>
                                    <div class="text-muted small" style="margin-top:4px;">Hiện không có lượt khám nào đang chờ xử lý tại khoa.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var q in queueItems)
                            {
                                var typeClass = q.StatusId == (int)AppointmentStatusId.ReadyForDoctor ? "CHO_BAC_SI" :
                                                q.StatusId == (int)AppointmentStatusId.CheckedIn ? "TIEP_NHAN" :
                                                q.StatusId == (int)AppointmentStatusId.InProgress ? "CHO_BAC_SI" : "ALL";
                                var badgeBg = q.StatusId == (int)AppointmentStatusId.ReadyForDoctor ? "#ede9fe" :
                                              q.StatusId == (int)AppointmentStatusId.InProgress ? "#dcfce7" : "#fef3c7";
                                var badgeColor = q.StatusId == (int)AppointmentStatusId.ReadyForDoctor ? "#6d28d9" :
                                                 q.StatusId == (int)AppointmentStatusId.InProgress ? "#15803d" : "#b45309";
                                var badgeBorder = q.StatusId == (int)AppointmentStatusId.ReadyForDoctor ? "#ddd6fe" :
                                                  q.StatusId == (int)AppointmentStatusId.InProgress ? "#bbf7d0" : "#fde68a";
                                var nameParts = q.PatientName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                var initials = nameParts.Length >= 2 ? $"{nameParts[0][0]}{nameParts[^1][0]}".ToUpper() : (nameParts.Length == 1 ? nameParts[0][0].ToString().ToUpper() : "BN");

                                <tr class="queue-row" data-type="@typeClass">
                                    <td><strong>@q.AppointmentTime.ToString("HH:mm")</strong></td>
                                    <td>
                                        <div style="display:flex; align-items:center; gap:8px;">
                                            <span class="avatar" style="background:#e0f2fe; color:#0369a1; font-weight:700; width:28px; height:28px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:10px;">@initials</span>
                                            <div>
                                                <strong>@q.PatientName</strong>
                                                <div class="text-muted small">@q.AppointmentCode · @q.Age tuổi</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge" style="background:@badgeBg; color:@badgeColor; border:1px solid @badgeBorder; padding:3px 8px; border-radius:50px; font-size:11px;">
                                            • @q.StatusText
                                        </span>
                                    </td>
                                    <td>
                                        <button type="button" class="btn outline sm" onclick="openQueueDetailModal('@q.PatientName', '@q.AppointmentCode', '@q.Age tuổi', '@q.Gender', '@q.AppointmentTime.ToString("HH:mm")', '@q.StatusText', '@q.RoomNumber', '@q.DoctorName', '@q.Reason')">
                                            <span>> Chi tiết</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Cột phải: Bảng điều phối hàng chờ -->
        <section class="card" style="background:#fff; border:1px solid #e2ebf3; border-radius:10px; padding:16px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <h3 style="font-size:13px; font-weight:700; margin:0; color:#0f172a; display:flex; align-items:center; gap:6px;">
                    <span>📣</span> Điều phối hàng chờ
                </h3>
                <span class="badge" style="background:#f1f5f9; color:#475569; font-size:11px; padding:3px 8px; border-radius:6px;">@(Model.DepartmentName)</span>
            </div>

            <!-- Card Đang mời vào khám chuẩn hình 3 -->
            <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:18px; text-align:center;">
                <div style="display:flex; justify-content:space-between; align-items:center; font-size:11px; font-weight:700; color:#64748b; letter-spacing:0.5px;">
                    <span>@(callingItem != null ? "ĐANG MỜI VÀO KHÁM" : "TRẠNG THÁI HÀNG CHỜ")</span>
                    <span style="background:#e2e8f0; padding:2px 6px; border-radius:4px; color:#1e293b;">@(callingItem?.RoomNumber ?? "Khoa")</span>
                </div>
                <div style="font-size:46px; font-weight:800; color:#079bc9; margin:10px 0 2px 0; letter-spacing:1px;">
                    @(callingItem?.QueueNumber ?? "—")
                </div>
                <div style="font-size:15px; font-weight:700; color:#0f172a;">
                    @(callingItem?.PatientName ?? "Không có bệnh nhân chờ khám")
                </div>
                <small style="color:#64748b; font-size:12px;">@(callingItem != null ? (callingItem.DoctorName + " · " + callingItem.RoomNumber) : "Tất cả lượt khám đã hoàn tất")</small>
                <div style="margin-top:14px;">
                    <a href="/Staff/Consultation" class="btn primary sm" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px; width:100%; justify-content:center;">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><path d="M5 3v5a5 5 0 0 0 10 0V3 M3 3h4 M13 3h4 M10 13v3a5 5 0 0 0 10 0v-2 M22 11a2 2 0 1 1-4 0 2 2 0 0 1 4 0"></path></svg>
                        <span>Vào phòng khám bệnh</span>
                    </a>
                </div>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:14px; padding-top:12px; border-top:1px dashed #e2e8f0; font-size:12px;">
                <span style="color:#64748b; font-weight:600; font-size:11px;">TIẾP THEO</span>
                <span style="color:#079bc9; font-weight:700;">@(nextWaitingCount) đang chờ</span>
            </div>
        </section>
    </div>

    <!-- Modal Chi tiết lượt hẹn hàng chờ (thay cho alert) -->
    <div id="queueDetailModal" class="app-modal-backdrop">
        <div class="app-modal-card">
            <div class="app-modal-header">
                <div>
                    <h5 id="qModalTitle" style="margin:0; font-size:15px; font-weight:700;">Chi tiết lượt khám</h5>
                    <small id="qModalSub" style="color:#94a3b8; font-size:12px;"></small>
                </div>
                <button type="button" class="app-modal-close" onclick="closeQueueDetailModal()">✕</button>
            </div>
            <div class="app-modal-body">
                <div style="display:flex; align-items:center; gap:12px; padding-bottom:14px; border-bottom:1px solid #eef3f7; margin-bottom:14px;">
                    <span id="qModalAvatar" class="avatar" style="background:#e0f2fe; color:#0369a1; font-weight:700; width:40px; height:40px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:14px;">QB</span>
                    <div>
                        <h4 id="qModalPatientName" style="margin:0; font-size:14px; font-weight:700; color:#0f172a;"></h4>
                        <div id="qModalPatientMeta" class="text-muted small"></div>
                    </div>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:12px; margin-bottom:14px;">
                    <div>
                        <small style="color:#64748b; font-size:11px; display:block;">Giờ hẹn</small>
                        <strong id="qModalTime" style="font-size:13px; color:#0f172a;"></strong>
                    </div>
                    <div>
                        <small style="color:#64748b; font-size:11px; display:block;">Trạng thái</small>
                        <strong id="qModalStatus" style="font-size:13px; color:#079bc9;"></strong>
                    </div>
                    <div>
                        <small style="color:#64748b; font-size:11px; display:block;">Phòng khám</small>
                        <strong id="qModalRoom" style="font-size:12px; color:#334155;"></strong>
                    </div>
                    <div>
                        <small style="color:#64748b; font-size:11px; display:block;">Bác sĩ phụ trách</small>
                        <strong id="qModalDoctor" style="font-size:12px; color:#334155;"></strong>
                    </div>
                </div>

                <div>
                    <small style="color:#64748b; font-size:11px; display:block; margin-bottom:4px; font-weight:600;">Thông tin / Triệu chứng ban đầu:</small>
                    <p id="qModalNotes" style="font-size:12px; color:#334155; margin:0; line-height:1.5; background:#fff; border:1px solid #e2e8f0; padding:10px; border-radius:6px;"></p>
                </div>
            </div>
            <div class="app-modal-footer">
                <button type="button" class="btn ghost" onclick="closeQueueDetailModal()">Đóng</button>
                <a href="/Staff/Consultation" class="btn primary" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><path d="M5 3v5a5 5 0 0 0 10 0V3 M3 3h4 M13 3h4 M10 13v3a5 5 0 0 0 10 0v-2 M22 11a2 2 0 1 1-4 0 2 2 0 0 1 4 0"></path></svg>
                    <span>Vào bàn khám bệnh</span>
                </a>
            </div>
        </div>
    </div>
}
else if (tab == "patients")
{
    <!-- ========================================== -->
    <!-- 5. THÔNG TIN NGƯỜI KHÁM (IMAGE 5)          -->
    <!-- ========================================== -->
    <div class="page-heading">
        <div>
            <h1>Thông tin người khám</h1>
            <p>Thông tin hành chính phục vụ tiếp nhận. Nội dung bệnh án theo quyền chuyên môn.</p>
        </div>
    </div>

    <section class="card" style="background:#fff; border:1px solid #e2ebf3; border-radius:10px; overflow:hidden;">
        <div class="toolbar" style="padding:14px 18px; border-bottom:1px solid #e5edf5; display:flex; justify-content:space-between; align-items:center;">
            <div style="position:relative; width:360px;">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position:absolute; left:12px; top:9px; width:15px; height:15px; color:#94a3b8;">
                    <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
