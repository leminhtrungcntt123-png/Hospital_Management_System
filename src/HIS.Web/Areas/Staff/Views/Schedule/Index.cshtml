    }

    function openCreatePeriodModal() {
        const modal = document.getElementById('createPeriodModal');
        if (modal) modal.classList.add('show');
    }

    function closeCreatePeriodModal() {
        const modal = document.getElementById('createPeriodModal');
        if (modal) modal.classList.remove('show');
    }

    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    // ========================================================
    // QUẢN LÝ LỊCH KHÁM & KHUNG GIỜ (SLOT) JAVASCRIPT
    // ========================================================

    function doGenerateSlots() {
        const startInput = document.getElementById('genStartDate');
        const endInput = document.getElementById('genEndDate');
        const deptSelect = document.getElementById('genDepartmentId');
        const btn = document.getElementById('btnGenerateSlots');
        const label = document.getElementById('genResultLabel');

        const startDate = startInput ? startInput.value : '';
        const endDate = endInput ? endInput.value : '';
        const deptVal = deptSelect ? deptSelect.value : '';
        const departmentId = deptVal ? parseInt(deptVal, 10) : null;

        if (!startDate || !endDate) {
            alert('Vui lòng chọn đầy đủ khoảng thời gian (Từ ngày - Đến ngày).');
            return;
        }

        if (endDate < startDate) {
            alert('Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu.');
            return;
        }

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span>⏳ Đang sinh slot...</span>';
        }
        if (label) {
            label.style.display = 'none';
        }

        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';

        const formData = new URLSearchParams();
        formData.append('startDate', startDate);
        formData.append('endDate', endDate);
        if (departmentId) {
            formData.append('departmentId', departmentId);
        }
        formData.append('__RequestVerificationToken', token);

        fetch('/Staff/Schedule/GenerateSlots', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: formData.toString()
        })
        .then(res => res.json())
        .then(data => {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '⚡ Sinh Slot Tự Động';
            }
            if (data.success) {
                if (label) {
                    label.style.display = 'block';
                    label.style.color = '#16a34a';
                    label.textContent = `✓ Đã sinh thành công ${data.totalSlotsGenerated} slot (${data.totalSchedulesProcessed} ca làm việc).`;
                }
                setTimeout(() => {
                    doSearchSlots();
                }, 600);
            } else {
                if (label) {
                    label.style.display = 'block';
                    label.style.color = '#dc2626';
                    label.textContent = `❌ ${data.message || 'Lỗi khi sinh khung giờ khám.'}`;
                }
            }
        })
        .catch(err => {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '⚡ Sinh Slot Tự Động';
            }
            if (label) {
                label.style.display = 'block';
                label.style.color = '#dc2626';
                label.textContent = '❌ Lỗi kết nối máy chủ.';
            }
        });
    }

    function doSearchSlots() {
        const startInput = document.getElementById('filterStartDate');
        const endInput = document.getElementById('filterEndDate');
        const chkMorning = document.getElementById('chkFilterMorning');
        const chkAfternoon = document.getElementById('chkFilterAfternoon');
        const deptSelect = document.getElementById('filterDepartmentId');
        const roomSelect = document.getElementById('filterRoomId');
        const docSelect = document.getElementById('filterDoctorId');
        const btn = document.getElementById('btnSearchSlots');

        const startDate = startInput ? startInput.value : '';
        const endDate = endInput ? endInput.value : '';

        if (!startDate || !endDate) {
            alert('Vui lòng chọn khoảng ngày cần tra cứu.');
            return;
        }

        const params = new URLSearchParams();
        params.append('filterStartDate', startDate);
        params.append('filterEndDate', endDate);

        if (chkMorning && chkMorning.checked) {
            params.append('shifts', 'MORNING');
        }
        if (chkAfternoon && chkAfternoon.checked) {
            params.append('shifts', 'AFTERNOON');
        }

        if (deptSelect && deptSelect.value) {
            params.append('departmentId', deptSelect.value);
        }
        if (roomSelect && roomSelect.value) {
            params.append('roomId', roomSelect.value);
        }
        if (docSelect && docSelect.value) {
            params.append('doctorId', docSelect.value);
        }

        if (btn) {
            btn.disabled = true;
            btn.textContent = 'Đang tra cứu...';
        }

        fetch('/Staff/Schedule/SearchSlotsJson?' + params.toString())
        .then(res => res.json())
        .then(slots => {
            if (btn) {
                btn.disabled = false;
                btn.textContent = 'Tra cứu';
            }
            renderSlotsTable(slots);
        })
        .catch(err => {
            if (btn) {
                btn.disabled = false;
                btn.textContent = 'Tra cứu';
            }
            alert('Lỗi khi tra cứu danh sách slot khám.');
        });
    }

    function resetSlotFilter() {
        const fStart = document.getElementById('filterStartDate');
        const fEnd = document.getElementById('filterEndDate');
        const chkMorning = document.getElementById('chkFilterMorning');
        const chkAfternoon = document.getElementById('chkFilterAfternoon');
        const deptSelect = document.getElementById('filterDepartmentId');
        const roomSelect = document.getElementById('filterRoomId');
        const docSelect = document.getElementById('filterDoctorId');

        const today = '@(Model.Today.ToString("yyyy-MM-dd"))';
        const nextWeek = '@(Model.Today.AddDays(7).ToString("yyyy-MM-dd"))';

        if (fStart) fStart.value = today;
        if (fEnd) fEnd.value = nextWeek;
        if (chkMorning) chkMorning.checked = true;
        if (chkAfternoon) chkAfternoon.checked = true;
        if (deptSelect) deptSelect.value = '';
        if (roomSelect) roomSelect.value = '';
        if (docSelect) docSelect.value = '';

        onFilterDepartmentChanged();
        doSearchSlots();
    }

    function onFilterDepartmentChanged() {
        const deptSelect = document.getElementById('filterDepartmentId');
        const roomSelect = document.getElementById('filterRoomId');
        const docSelect = document.getElementById('filterDoctorId');

        const deptId = deptSelect ? deptSelect.value : '';

        // Tải phòng khám theo chuyên khoa
        if (roomSelect) {
            fetch('/Staff/Schedule/GetRoomsByDepartment?departmentId=' + (deptId || 0))
            .then(res => res.json())
            .then(rooms => {
                let options = '<option value="">-- Tất cả phòng --</option>';
                if (Array.isArray(rooms)) {
                    rooms.forEach(r => {
                        options += `<option value="${r.id}">${escapeHtml(r.roomNumber)} - ${escapeHtml(r.roomName)}</option>`;
                    });
                }
                roomSelect.innerHTML = options;
            })
            .catch(err => {
                console.error('Error fetching rooms:', err);
            });
        }

        // Tải danh sách bác sĩ theo chuyên khoa
        if (docSelect) {
            fetch('/Staff/Schedule/GetDoctorsByDepartment?departmentId=' + (deptId || 0))
            .then(res => res.json())
            .then(doctors => {
                let options = '<option value="">-- Tất cả bác sĩ --</option>';
                if (Array.isArray(doctors)) {
                    doctors.forEach(d => {
                        options += `<option value="${d.id}">${escapeHtml(d.fullName)}</option>`;
                    });
                }
                docSelect.innerHTML = options;
            })
            .catch(err => {
                console.error('Error fetching doctors:', err);
            });
        }
    }

    function renderSlotsTable(slots) {
        const tbody = document.getElementById('slotsTableBody');
        const emptyState = document.getElementById('slotsEmptyState');
        const footerTotal = document.getElementById('footerTotalSlots');
        const footerBooked = document.getElementById('footerTotalBooked');
        const footerAvailable = document.getElementById('footerTotalAvailable');

        if (!tbody) return;

        if (!Array.isArray(slots) || slots.length === 0) {
            tbody.innerHTML = '';
            if (emptyState) emptyState.style.display = 'block';
            if (footerTotal) footerTotal.textContent = '0';
            if (footerBooked) footerBooked.textContent = '0';
            if (footerAvailable) footerAvailable.textContent = '0';
            return;
        }

        if (emptyState) emptyState.style.display = 'none';

        let totalSlots = slots.length;
        let totalBooked = 0;
        let totalAvail = 0;

        let rowsHtml = '';
        slots.forEach(s => {
            totalBooked += (s.bookedCount || 0);
            totalAvail += (s.remainingCount || 0);

            const isAvailable = s.isAvailable && s.remainingCount > 0;
            const statusBadge = isAvailable
                ? '<span style="background:#ecfdf5; color:#059669; padding:4px 8px; border-radius:4px; font-weight:700; font-size:11px;">Còn trống</span>'
                : '<span style="background:#fef2f2; color:#dc2626; padding:4px 8px; border-radius:4px; font-weight:700; font-size:11px;">Đã kín</span>';

            const formattedDate = s.date ? s.date.split('-').reverse().join('/') : '';
            const startTimeStr = s.startTime ? s.startTime.substring(0, 5) : '';
            const endTimeStr = s.endTime ? s.endTime.substring(0, 5) : '';

            rowsHtml += `
                <tr style="border-bottom:1px solid #f1f5f9; transition:background 0.15s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
                    <td style="padding:10px 14px; font-weight:600; color:#64748b;">#${s.id}</td>
                    <td style="padding:10px 14px; font-weight:700; color:#1e293b;">${escapeHtml(s.doctorName || 'Chưa phân công')}</td>
                    <td style="padding:10px 14px; color:#475569;">${escapeHtml(s.departmentName || 'Chưa xác định')}</td>
                    <td style="padding:10px 14px; font-weight:600; color:#0284c7;">${escapeHtml(s.roomNumber || '')} - ${escapeHtml(s.roomName || '')}</td>
                    <td style="padding:10px 14px; color:#334155;">${formattedDate}</td>
                    <td style="padding:10px 14px; font-weight:700; color:#0f172a;">${startTimeStr} - ${endTimeStr}</td>
                    <td style="padding:10px 14px; text-align:center; font-weight:600;">${s.maxPatients}</td>
                    <td style="padding:10px 14px; text-align:center; font-weight:700; color:${s.bookedCount > 0 ? '#0284c7' : '#64748b'};">${s.bookedCount}</td>
                    <td style="padding:10px 14px; text-align:center; font-weight:700; color:${isAvailable ? '#059669' : '#dc2626'};">${s.remainingCount}</td>
                    <td style="padding:10px 14px; text-align:center;">${statusBadge}</td>
                </tr>
            `;
        });

        tbody.innerHTML = rowsHtml;
        if (footerTotal) footerTotal.textContent = totalSlots.toLocaleString();
        if (footerBooked) footerBooked.textContent = totalBooked.toLocaleString();
        if (footerAvailable) footerAvailable.textContent = totalAvail.toLocaleString();
    }

    // ========================================================
    // BẢNG CHỈ SỐ QUYẾT ĐỊNH & ĐIỀU PHỐI CA (DECISION MATRIX)
    // ========================================================

    let cachedAvailableRooms = [];

    function openDecisionMatrixQuick() {
        const defaultDate = '@(Model.ActivePeriod != null ? Model.ActivePeriod.StartDate.ToString("yyyy-MM-dd") : Model.WeekStart.ToString("yyyy-MM-dd"))';
        loadDecisionMatrix(defaultDate, 'Morning');
    }

    function onDmDateShiftChanged() {
        const d = document.getElementById('dmDateSelect')?.value;
        const s = document.getElementById('dmShiftSelect')?.value;
        if (d && s) {
            loadDecisionMatrix(d, s);
        }
    }

    function closeDecisionMatrixModal() {
        document.getElementById('decisionMatrixModal')?.classList.remove('show');
    }

    function loadDecisionMatrix(workDate, shift) {
        const dateInput = document.getElementById('dmDateSelect');
        const shiftInput = document.getElementById('dmShiftSelect');
        const modal = document.getElementById('decisionMatrixModal');
        const loading = document.getElementById('dmLoading');
        const tableContainer = document.getElementById('dmTableContainer');
        const emptyState = document.getElementById('dmEmpty');
        const summary = document.getElementById('dmShiftSummary');
        const tbody = document.getElementById('dmTableBody');

        if (!modal) return;
        modal.classList.add('show');

        // Normalize shift name
        let shiftStr = 'Morning';
        if (shift === 1 || shift === '1' || shift === 'Afternoon') {
            shiftStr = 'Afternoon';
        }

        if (dateInput) dateInput.value = workDate;
        if (shiftInput) shiftInput.value = shiftStr;

        if (loading) loading.style.display = 'block';
        if (tableContainer) tableContainer.style.display = 'none';
        if (emptyState) emptyState.style.display = 'none';

        fetch(`/Staff/Schedule/GetDecisionMatrix?workDate=${encodeURIComponent(workDate)}&shift=${encodeURIComponent(shiftStr)}`)
            .then(res => {
                if (!res.ok) throw new Error('Không thể tải ma trận quyết định.');
                return res.json();
            })
            .then(data => {
                if (loading) loading.style.display = 'none';
                cachedAvailableRooms = data.availableRooms || [];

                if (summary) {
                    const hotBadge = data.isHotShift ? '<span style="color:#dc2626; font-weight:700;">🔥 Ca Hot (Cạnh tranh cao)</span> · ' : '';
                    summary.innerHTML = `${hotBadge}Số buồng khám khả dụng của khoa: <strong>${data.totalActiveRooms}</strong>`;
                }

                if (!data.candidates || data.candidates.length === 0) {
                    if (emptyState) emptyState.style.display = 'block';
                    return;
                }

                if (tableContainer) tableContainer.style.display = 'block';
                if (!tbody) return;

                let html = '';
                data.candidates.forEach((c, idx) => {
                    const isBidding = (c.status === 0 || c.status === 'Bidding');
                    const isApproved = (c.status === 1 || c.status === 'Approved');
                    const isRejected = (c.status === 2 || c.status === 'Rejected');
                    const isReallocated = (c.status === 3 || c.status === 'Reallocated');

                    // 1. Fatigue status
                    const fatigueHtml = c.hasNightDutyConflict
                        ? '<span style="background:#fee2e2; color:#dc2626; padding:2px 6px; border-radius:4px; font-weight:700; font-size:11px;">⚠️ Xung đột trực đêm</span>'
                        : '<span style="background:#dcfce7; color:#15803d; padding:2px 6px; border-radius:4px; font-weight:600; font-size:11px;">✓ Đảm bảo</span>';

                    // 2. Rotation badge
                    let rotBadgeClass = 'background:#f1f5f9; color:#475569;';
                    if (c.rotationPriorityScore === 2) rotBadgeClass = 'background:#fef3c7; color:#92400e; font-weight:700; border:1px solid #fde68a;';
                    else if (c.rotationPriorityScore === 1) rotBadgeClass = 'background:#e0f2fe; color:#0369a1; font-weight:700; border:1px solid #bae6fd;';
                    const rotHtml = `<span style="${rotBadgeClass} padding:2px 6px; border-radius:4px; font-size:11px;">${c.rotationBadgeText || 'Ca thường'}</span>`;

                    // 3. Quota
                    const quotaHtml = `<span style="font-weight:600;">${c.approvedShiftsThisPeriod} / ${c.maxShiftsPerWeek} ca</span>`;

                    // 4. Care continuity
                    const careHtml = c.continuityOfCareFollowUpCount > 0
                        ? `<span style="background:#f0fdf4; color:#16a34a; font-weight:700; padding:2px 6px; border-radius:4px;">🎯 ${c.continuityOfCareFollowUpCount} BN hẹn</span>`
                        : '<span style="color:#94a3b8;">0</span>';

                    // Status
                    let statusHtml = '';
                    if (isBidding) statusHtml = '<span style="background:#fef9c3; color:#854d0e; padding:2px 6px; border-radius:4px; font-weight:700;">Chờ duyệt</span>';
                    else if (isApproved) statusHtml = `<span style="background:#dcfce7; color:#166534; padding:2px 6px; border-radius:4px; font-weight:700;">Đã duyệt (${c.roomNumber || 'Phòng khám'})</span>`;
                    else if (isRejected) statusHtml = '<span style="background:#fee2e2; color:#991b1b; padding:2px 6px; border-radius:4px; font-weight:700;">Bị trượt ca Hot</span>';
                    else if (isReallocated) statusHtml = '<span style="background:#ffedd5; color:#9a3412; padding:2px 6px; border-radius:4px; font-weight:700;">Đã điều chuyển</span>';
                    else statusHtml = `<span style="color:#64748b;">${c.status}</span>`;

                    // Action buttons
                    let actionHtml = '';
                    if (isBidding) {
                        if (!cachedAvailableRooms || cachedAvailableRooms.length === 0) {
                            actionHtml = '<span style="background:#fee2e2; color:#dc2626; font-size:11px; font-weight:700; padding:4px 8px; border-radius:4px; border:1px solid #fecaca; display:inline-block;">🔒 Đã hết buồng</span>';
                        } else {
                            let roomOptions = '<option value="">-- Chọn phòng --</option>';
                            cachedAvailableRooms.forEach(r => {
                                roomOptions += `<option value="${r.id}">${r.roomNumber} - ${r.roomName}</option>`;
                            });
                            actionHtml = `
                                <div style="display:flex; align-items:center; justify-content:flex-end; gap:6px;">
                                    <select id="dmRoomSelect_${c.scheduleId}" style="padding:5px 8px; font-size:11.5px; border:1px solid #cbd5e1; border-radius:5px; max-width:160px;">
                                        ${roomOptions}
                                    </select>
                                    <button type="button" class="btn primary sm" onclick="submitApproveShift(${c.scheduleId})" style="padding:4px 10px; font-size:11.5px; background:#079bc9; font-weight:600;">
                                        Duyệt
                                    </button>
                                </div>
                            `;
                        }
                    } else if (isRejected) {
                        actionHtml = `
                            <button type="button" class="btn outline sm" onclick="openReallocateModal(${c.scheduleId}, '${escapeHtml(c.doctorName)}')" style="padding:4px 10px; font-size:11.5px; border-color:#d97706; color:#d97706; font-weight:600;">
                                🔀 Điều chuyển bù
                            </button>
                        `;
                    } else if (isApproved) {
                        actionHtml = `<span style="font-size:11.5px; color:#15803d; font-weight:700; background:#f0fdf4; border:1px solid #bbf7d0; padding:3px 8px; border-radius:4px; display:inline-block;">✓ Buồng ${c.roomNumber || ''}</span>`;
                    } else if (isReallocated) {
                        actionHtml = `<span style="font-size:11.5px; color:#9a3412; font-weight:700; background:#fff7ed; border:1px solid #fed7aa; padding:3px 8px; border-radius:4px; display:inline-block;">✓ Đã xếp bù ca</span>`;
                    }

                    html += `
                        <tr style="border-bottom:1px solid #e2e8f0; ${idx % 2 === 1 ? 'background:#f8fafc;' : ''}">
                            <td style="padding:10px 12px; font-weight:700; color:#64748b;">${idx + 1}</td>
                            <td style="padding:10px 12px;">
                                <strong style="color:#0f172a; font-size:13px;">${escapeHtml(c.doctorName)}</strong>
                                <div style="font-size:11.5px; color:#64748b; margin-top:2px;">${c.academicTitle ? escapeHtml(c.academicTitle) + ' · ' : ''}${escapeHtml(c.specialty || '')} · <span style="font-weight:600; color:#334155;">${c.employmentType === 1 ? 'Part-time' : 'Full-time'}</span></div>
                                ${c.doctorNote ? `<div style="font-size:10.5px; color:#b45309; font-style:italic; margin-top:2px;">"${escapeHtml(c.doctorNote)}"</div>` : ''}
                            </td>
                            <td style="padding:10px 12px; text-align:center;">${fatigueHtml}</td>
                            <td style="padding:10px 12px; text-align:center;">${rotHtml}</td>
                            <td style="padding:10px 12px; text-align:center;">${quotaHtml}</td>
                            <td style="padding:10px 12px; text-align:center;">${careHtml}</td>
                            <td style="padding:10px 12px;">${statusHtml}</td>
                            <td style="padding:10px 12px; text-align:right;">${actionHtml}</td>
                        </tr>
                    `;
                });

                tbody.innerHTML = html;
            })
            .catch(err => {
                if (loading) loading.style.display = 'none';
                alert(err.message || 'Lỗi khi tải bảng quyết định.');
            });
    }

    function submitApproveShift(scheduleId) {
        const roomSelect = document.getElementById(`dmRoomSelect_${scheduleId}`);
        const roomId = roomSelect ? roomSelect.value : null;
        if (!roomId) {
            alert('Vui lòng chọn Buồng khám để duyệt ca cho bác sĩ.');
            return;
        }

        const sidInput = document.getElementById('approveShiftScheduleId');
        const ridInput = document.getElementById('approveShiftRoomId');
        const form = document.getElementById('approveShiftForm');

        if (sidInput && ridInput && form) {
            sidInput.value = scheduleId;
            ridInput.value = roomId;
            form.submit();
        }
    }

    function openReallocateModal(oldScheduleId, doctorName) {
        document.getElementById('reallocOldScheduleId').value = oldScheduleId;
        document.getElementById('reallocDoctorName').textContent = doctorName;
        
        // Populate available rooms dropdown
        const roomSelect = document.getElementById('reallocTargetRoomId');
        if (roomSelect) {
            let options = '';
            cachedAvailableRooms.forEach(r => {
                options += `<option value="${r.id}">${r.roomNumber} - ${r.roomName}</option>`;
            });
            roomSelect.innerHTML = options;
        }

        // Set default target date to current select date
        const curDate = document.getElementById('dmDateSelect')?.value;
        const targetDateInput = document.getElementById('reallocTargetDate');
        if (targetDateInput && curDate) {
            targetDateInput.value = curDate;
        }

        document.getElementById('reallocateModal')?.classList.add('show');
    }

    function closeReallocateModal() {
        document.getElementById('reallocateModal')?.classList.remove('show');
    }

    // INLINE DECISION MATRIX (TAB BIDDING)
    function onDmInlineChange() {
        const d = document.getElementById('dmInlineDateSelect')?.value;
        const s = document.getElementById('dmInlineShiftSelect')?.value;
        if (d && s) {
            loadDecisionMatrixInline(d, s);
        }
    }

    function loadDecisionMatrixInline(workDate, shift) {
        const loading = document.getElementById('dmInlineLoading');
        const tableContainer = document.getElementById('dmInlineTableContainer');
        const emptyState = document.getElementById('dmInlineEmpty');
        const summary = document.getElementById('dmInlineSummary');
        const tbody = document.getElementById('dmInlineTableBody');

        if (!tbody) return;

        let shiftStr = 'Morning';
        if (shift === 1 || shift === '1' || shift === 'Afternoon') {
            shiftStr = 'Afternoon';
        }

        if (loading) loading.style.display = 'block';
        if (tableContainer) tableContainer.style.display = 'none';
        if (emptyState) emptyState.style.display = 'none';

        fetch(`/Staff/Schedule/GetDecisionMatrix?workDate=${encodeURIComponent(workDate)}&shift=${encodeURIComponent(shiftStr)}`)
            .then(res => {
                if (!res.ok) throw new Error('Không thể tải ma trận quyết định.');
                return res.json();
            })
            .then(data => {
                if (loading) loading.style.display = 'none';
                cachedAvailableRooms = data.availableRooms || [];

                if (summary) {
                    const hotBadge = data.isHotShift ? '<span style="color:#dc2626; font-weight:700;">🔥 Ca Hot (Cạnh tranh cao)</span> · ' : '';
                    summary.innerHTML = `${hotBadge}Số buồng khám khả dụng của khoa: <strong>${data.totalActiveRooms}</strong>`;
                }

                if (!data.candidates || data.candidates.length === 0) {
                    if (emptyState) emptyState.style.display = 'block';
                    return;
                }

                if (tableContainer) tableContainer.style.display = 'block';

                let html = '';
                data.candidates.forEach((c, idx) => {
                    const isBidding = (c.status === 0 || c.status === 'Bidding');
                    const isApproved = (c.status === 1 || c.status === 'Approved');
                    const isRejected = (c.status === 2 || c.status === 'Rejected');
                    const isReallocated = (c.status === 3 || c.status === 'Reallocated');

                    const fatigueHtml = c.hasNightDutyConflict
                        ? '<span style="background:#fee2e2; color:#dc2626; padding:2px 6px; border-radius:4px; font-weight:700; font-size:11px;">⚠️ Xung đột trực đêm</span>'
                        : '<span style="background:#dcfce7; color:#15803d; padding:2px 6px; border-radius:4px; font-weight:600; font-size:11px;">✓ Đảm bảo</span>';

                    let rotBadgeClass = 'background:#f1f5f9; color:#475569;';
                    if (c.rotationPriorityScore === 2) rotBadgeClass = 'background:#fef3c7; color:#92400e; font-weight:700; border:1px solid #fde68a;';
                    else if (c.rotationPriorityScore === 1) rotBadgeClass = 'background:#e0f2fe; color:#0369a1; font-weight:700; border:1px solid #bae6fd;';
                    const rotHtml = `<span style="${rotBadgeClass} padding:2px 6px; border-radius:4px; font-size:11px;">${c.rotationBadgeText || 'Ca thường'}</span>`;

                    const quotaHtml = `<span style="font-weight:600;">${c.approvedShiftsThisPeriod} / ${c.maxShiftsPerWeek} ca</span>`;

                    const careHtml = c.continuityOfCareFollowUpCount > 0
                        ? `<span style="background:#f0fdf4; color:#16a34a; font-weight:700; padding:2px 6px; border-radius:4px;">🎯 ${c.continuityOfCareFollowUpCount} BN hẹn</span>`
                        : '<span style="color:#94a3b8;">0</span>';

                    let statusHtml = '';
                    if (isBidding) statusHtml = '<span style="background:#fef9c3; color:#854d0e; padding:2px 6px; border-radius:4px; font-weight:700;">Chờ duyệt</span>';
                    else if (isApproved) statusHtml = `<span style="background:#dcfce7; color:#166534; padding:2px 6px; border-radius:4px; font-weight:700;">Đã duyệt (${c.roomNumber || 'Phòng khám'})</span>`;
                    else if (isRejected) statusHtml = '<span style="background:#fee2e2; color:#991b1b; padding:2px 6px; border-radius:4px; font-weight:700;">Bị trượt ca Hot</span>';
                    else if (isReallocated) statusHtml = '<span style="background:#ffedd5; color:#9a3412; padding:2px 6px; border-radius:4px; font-weight:700;">Đã điều chuyển</span>';
                    else statusHtml = `<span style="color:#64748b;">${c.status}</span>`;

                    let actionHtml = '';
                    if (isBidding) {
                        if (!cachedAvailableRooms || cachedAvailableRooms.length === 0) {
                            actionHtml = '<span style="background:#fee2e2; color:#dc2626; font-size:11px; font-weight:700; padding:4px 8px; border-radius:4px; border:1px solid #fecaca; display:inline-block;">🔒 Đã hết buồng</span>';
                        } else {
                            let roomOptions = '<option value="">-- Chọn phòng --</option>';
                            cachedAvailableRooms.forEach(r => {
                                roomOptions += `<option value="${r.id}">${r.roomNumber} - ${r.roomName}</option>`;
                            });
                            actionHtml = `
                                <div style="display:flex; align-items:center; justify-content:flex-end; gap:6px;">
                                    <select id="dmRoomSelect_${c.scheduleId}" style="padding:5px 8px; font-size:11.5px; border:1px solid #cbd5e1; border-radius:5px; max-width:160px;">
                                        ${roomOptions}
                                    </select>
                                    <button type="button" class="btn primary sm" onclick="submitApproveShift(${c.scheduleId})" style="padding:4px 10px; font-size:11.5px; background:#079bc9; font-weight:600;">
                                        Duyệt
                                    </button>
                                </div>
                            `;
                        }
                    } else if (isRejected) {
                        actionHtml = `
                            <button type="button" class="btn outline sm" onclick="openReallocateModal(${c.scheduleId}, '${escapeHtml(c.doctorName)}')" style="padding:4px 10px; font-size:11.5px; border-color:#d97706; color:#d97706; font-weight:600;">
                                🔀 Điều chuyển bù
                            </button>
                        `;
                    } else if (isApproved) {
                        actionHtml = `<span style="font-size:11.5px; color:#15803d; font-weight:700; background:#f0fdf4; border:1px solid #bbf7d0; padding:3px 8px; border-radius:4px; display:inline-block;">✓ Buồng ${c.roomNumber || ''}</span>`;
                    } else if (isReallocated) {
                        actionHtml = `<span style="font-size:11.5px; color:#9a3412; font-weight:700; background:#fff7ed; border:1px solid #fed7aa; padding:3px 8px; border-radius:4px; display:inline-block;">✓ Đã xếp bù ca</span>`;
                    }

                    html += `
                        <tr style="border-bottom:1px solid #e2e8f0; ${idx % 2 === 1 ? 'background:#f8fafc;' : ''}">
                            <td style="padding:10px 12px; font-weight:700; color:#64748b;">${idx + 1}</td>
                            <td style="padding:10px 12px;">
                                <strong style="color:#0f172a; font-size:13px;">${escapeHtml(c.doctorName)}</strong>
                                <div style="font-size:11.5px; color:#64748b; margin-top:2px;">${c.academicTitle ? escapeHtml(c.academicTitle) + ' · ' : ''}${escapeHtml(c.specialty || '')} · <span style="font-weight:600; color:#334155;">${c.employmentType === 1 ? 'Part-time' : 'Full-time'}</span></div>
                                ${c.doctorNote ? `<div style="font-size:10.5px; color:#b45309; font-style:italic; margin-top:2px;">"${escapeHtml(c.doctorNote)}"</div>` : ''}
                            </td>
                            <td style="padding:10px 12px; text-align:center;">${fatigueHtml}</td>
                            <td style="padding:10px 12px; text-align:center;">${rotHtml}</td>
                            <td style="padding:10px 12px; text-align:center;">${quotaHtml}</td>
                            <td style="padding:10px 12px; text-align:center;">${careHtml}</td>
                            <td style="padding:10px 12px;">${statusHtml}</td>
                            <td style="padding:10px 12px; text-align:right;">${actionHtml}</td>
                        </tr>
                    `;
                });

                tbody.innerHTML = html;
            })
            .catch(err => {
                if (loading) loading.style.display = 'none';
                alert(err.message || 'Lỗi khi tải bảng quyết định.');
            });
    }

    document.addEventListener('DOMContentLoaded', function () {
        if ('@tab' === 'bidding') {
            onDmInlineChange();
        }
    });
</script>
