else
{
    <!-- ========================================== -->
    <!-- 4. LỊCH KHÁM & ĐIỀU PHỐI KHOA (IMAGE 4)   -->
    <!-- ========================================== -->
    <div class="page-heading" style="display:flex; justify-content:space-between; align-items:flex-start;">
        <div>
            <h1>Lịch khám & điều phối khoa</h1>
            <p>Lịch khám sáng / chiều và lịch trực nhân sự được quản lý riêng.</p>
        </div>
        <div style="display:flex; gap:10px;">
            <button type="button" class="btn outline" onclick="openDutyModal()">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>+ Phân ca trực</span>
            </button>
            <button type="button" class="btn primary" onclick="openScheduleModal()">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                <span>Thiết lập lịch khám & Quota</span>
            </button>
        </div>
    </div>

    <!-- Thanh chuyển tuần chuẩn hình 4 (Đồng bộ theo tuần thực tế và URL) -->
    <div style="display:flex; justify-content:space-between; align-items:center; background:#fff; border:1px solid #e2ebf3; border-radius:10px; padding:10px 16px; margin-bottom:14px;">
        <div style="display:flex; align-items:center; gap:12px;">
            <button type="button" class="icon-btn" onclick="changeWeek(-1)" title="Tuần trước" style="background:#f1f5f9; border:none; width:28px; height:28px; border-radius:6px; cursor:pointer; display:flex; align-items:center; justify-content:center;">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <strong id="weekDateLabel" style="font-size:13px; color:#0f172a;">@Model.WeekStart.ToString("dd/MM/yyyy") – @Model.WeekStart.AddDays(4).ToString("dd/MM/yyyy")</strong>
            <button type="button" class="icon-btn" onclick="changeWeek(1)" title="Tuần kế tiếp" style="background:#f1f5f9; border:none; width:28px; height:28px; border-radius:6px; cursor:pointer; display:flex; align-items:center; justify-content:center;">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
        </div>
        <div>
            <button type="button" class="btn ghost sm" onclick="resetWeek()">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                <span>Tuần này</span>
            </button>
        </div>
    </div>

    <!-- THANH BỘ LỌC CA TRỰC & TÌM KIẾM BÁC SĨ (MỚI) -->
    <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12px; background:#fff; border:1px solid #e2ebf3; border-radius:10px; padding:10px 16px; margin-bottom:16px;">
        <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
            <span style="font-size:12px; font-weight:700; color:#334155; display:inline-flex; align-items:center; gap:4px;">
                <span>🎯</span> Hiển thị ca:
            </span>
            <label style="display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600; color:#0f172a; cursor:pointer;">
                <input type="checkbox" id="chkAllShifts" checked onchange="toggleAllShifts(this)" style="cursor:pointer; accent-color:#079bc9; width:15px; height:15px;" />
                <span>Tất cả</span>
            </label>
            <label style="display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600; color:#0369a1; cursor:pointer; background:#e0f2fe; padding:4px 10px; border-radius:6px;">
                <input type="checkbox" class="shift-filter-chk" data-shift-type="morning" checked onchange="filterShifts()" style="cursor:pointer; accent-color:#0284c7; width:14px; height:14px;" />
                <span>🌅 Sáng (07:30–11:30)</span>
            </label>
            <label style="display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600; color:#5b21b6; cursor:pointer; background:#ede9fe; padding:4px 10px; border-radius:6px;">
                <input type="checkbox" class="shift-filter-chk" data-shift-type="afternoon" checked onchange="filterShifts()" style="cursor:pointer; accent-color:#7c3aed; width:14px; height:14px;" />
                <span>🌇 Chiều (13:00–16:30)</span>
            </label>
            <label style="display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600; color:#0f172a; cursor:pointer; background:#f1f5f9; padding:4px 10px; border-radius:6px; border:1px solid #cbd5e1;">
                <input type="checkbox" class="shift-filter-chk" data-shift-type="night" checked onchange="filterShifts()" style="cursor:pointer; accent-color:#0f172a; width:14px; height:14px;" />
                <span>🌙 Tối (Trực đêm 18:00–07:00)</span>
            </label>
        </div>

        <div style="display:flex; align-items:center; gap:8px; flex:1; max-width:440px; justify-content:flex-end;">
            <div style="position:relative; width:100%; max-width:220px;">
                <input type="text" id="searchDoctorInput" placeholder="Tìm tên bác sĩ..." oninput="filterDoctors(this.value)"
                       style="width:100%; padding:6px 10px 6px 28px; font-size:12px; border:1px solid #cbd5e1; border-radius:6px;" />
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position:absolute; left:8px; top:7px; width:13px; height:13px; color:#94a3b8;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </div>
            <select id="selectDoctorFilter" onchange="filterDoctorsBySelect(this.value)"
                    style="padding:6px 10px; font-size:12px; border:1px solid #cbd5e1; border-radius:6px; background:#fff; max-width:180px;">
                <option value="">-- Tất cả bác sĩ --</option>
                @foreach (var doc in (Model.AvailableDoctors.Count > 0 ? Model.AvailableDoctors : new List<DoctorListItemDto> { new(1, "Nguyễn Hoàng Nam", "Nội tổng quát", Model.DepartmentName, "P.201"), new(2, "Trần Minh Thư", "Tim mạch", Model.DepartmentName, "P.203") }))
                {
                    <option value="@doc.FullName.ToLowerInvariant()">@CleanDocName(doc.FullName)</option>
                }
            </select>
        </div>
    </div>

    <!-- Bảng Grid Lịch khám tuần chuẩn hình 4 -->
    <section class="card" style="background:#fff; border:1px solid #e2ebf3; border-radius:10px; overflow:hidden;">
        <div style="padding:14px 18px; border-bottom:1px solid #eef3f7; display:flex; justify-content:space-between; align-items:center;">
            <div>
                <h3 style="font-size:13px; font-weight:700; margin:0; color:#0f172a; display:flex; align-items:center; gap:6px;">
                    <span>📅</span> Lịch khám trong tuần
                </h3>
                <small style="color:#64748b; font-size:11px;">Nhấp vào ca khám để xem hoặc chỉnh sửa Quota tiếp nhận (Tổng chỉ tiêu / Đặt online / Khám tại quầy)</small>
            </div>
            <span style="font-size:11px; background:#f1f5f9; color:#475569; padding:4px 8px; border-radius:6px;">
                Sáng: 07:30–11:30 · Chiều: 13:00–16:30 · Tối: 18:00–07:00
            </span>
        </div>

        <div style="overflow-x:auto;">
            <div id="scheduleGrid" style="display:grid; grid-template-columns:220px repeat(5, minmax(140px, 1fr)); min-width:920px;">
                <!-- Header Cột Bác sĩ / Phòng -->
                <div style="padding:12px 14px; background:#f8fafc; font-size:12px; font-weight:700; color:#475569; border-bottom:1px solid #e2e8f0; border-right:1px solid #e2e8f0;">
                    Bác sĩ / Nhân sự
                </div>
                <!-- 5 Cột Header ngày trong tuần: render động theo Model.WeekDates -->
                @for (int c = 0; c < (Model.WeekDates.Count > 0 ? Model.WeekDates.Count : 5); c++)
                {
                    var d = Model.WeekDates.Count > c ? Model.WeekDates[c] : new DateOnly(2026, 11, 2).AddDays(c);
                    var isToday = (d == Model.Today);
                    var dayName = c switch { 0 => "Thứ Hai", 1 => "Thứ Ba", 2 => "Thứ Tư", 3 => "Thứ Năm", _ => "Thứ Sáu" };

                    if (isToday)
                    {
                        <div style="padding:10px; background:#f0fdfa; text-align:center; border:2px solid #079bc9; border-bottom:none;">
                            <div style="font-size:11px; color:#0d9488; font-weight:700;">@dayName</div>
                            <strong style="font-size:14px; color:#0f766e;">@d.ToString("dd/MM")</strong>
                            <div style="font-size:10px; color:#079bc9; font-weight:700;">Hôm nay</div>
                        </div>
                    }
                    else
                    {
                        <div style="padding:10px; background:#f8fafc; text-align:center; border-bottom:1px solid #e2e8f0; border-right:1px solid #e2e8f0;">
                            <div style="font-size:11px; color:#64748b;">@dayName</div>
                            <strong style="font-size:13px; color:#0f172a;">@d.ToString("dd/MM")</strong>
                        </div>
                    }
                }

                @{
                    var weekDates = Model.WeekDates.Count == 5
                        ? Model.WeekDates
                        : new List<DateOnly>
                        {
                            new(2026, 11, 2),
                            new(2026, 11, 3),
                            new(2026, 11, 4),
                            new(2026, 11, 5),
                            new(2026, 11, 6)
                        };

                    var doctorsList = Model.AvailableDoctors.Count > 0
                        ? Model.AvailableDoctors
                        : new List<DoctorListItemDto>
                        {
                            new(1, "Nguyễn Hoàng Nam", "Nội tổng quát", Model.DepartmentName, "P.201"),
                            new(2, "Trần Minh Thư", "Tim mạch", Model.DepartmentName, "P.203")
                        };
                }

                @foreach (var doc in doctorsList)
                {
                    var docInit = doc.FullName.Split(' ').Last()[..Math.Min(2, doc.FullName.Split(' ').Last().Length)].ToUpper();
                    var docColor = doc.Id % 2 == 1 ? "background:#e0f2fe; color:#0369a1;" : "background:#fce7f3; color:#be185d;";

                    <div class="doctor-schedule-row" data-doctor-name="@doc.FullName.ToLowerInvariant()" style="display:contents;">
                        <!-- Cột thông tin Bác sĩ / Phòng -->
                        <div style="padding:16px 14px; border-bottom:1px solid #e2e8f0; border-right:1px solid #e2e8f0; display:flex; align-items:center; gap:10px;">
                            <span class="avatar" style="@docColor font-weight:700; width:32px; height:32px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:11px;">@docInit</span>
                            <div>
                                <strong style="font-size:12px; color:#0f172a;">@CleanDocName(doc.FullName)</strong>
                                <div class="text-muted" style="font-size:11px;">@doc.Specialty · @(doc.LicenseNumber.StartsWith("P.") ? doc.LicenseNumber : "P.20" + doc.Id)</div>
                            </div>
                        </div>

                        @for (int col = 0; col < 5; col++)
                        {
                            var curDate = weekDates[col];
                            var isToday = (curDate == Model.Today);
                            var dOfWeek = curDate.DayOfWeek;

                            // Tìm ngoại lệ bác sĩ này xin nghỉ / đổi ca đã duyệt:
                            var docLeaveMorning = Model.Exceptions.FirstOrDefault(e =>
                                e.Status == ScheduleExceptionStatus.Approved &&
                                e.Date == curDate &&
                                (e.Shift == ExamShift.Morning || e.Shift == null) &&
                                (e.DoctorId == doc.Id || e.DoctorName.Contains(doc.FullName) || doc.FullName.Contains(e.DoctorName)));

                            var docLeaveAfternoon = Model.Exceptions.FirstOrDefault(e =>
                                e.Status == ScheduleExceptionStatus.Approved &&
                                e.Date == curDate &&
                                (e.Shift == ExamShift.Afternoon || e.Shift == null) &&
                                (e.DoctorId == doc.Id || e.DoctorName.Contains(doc.FullName) || doc.FullName.Contains(e.DoctorName)));

                            // Tìm ngoại lệ bác sĩ này xin nghỉ / đổi ca ĐANG CHỜ DUYỆT (Pending):
                            var docPendingMorning = Model.Exceptions.FirstOrDefault(e =>
                                e.Status == ScheduleExceptionStatus.Pending &&
                                e.Date == curDate &&
                                (e.Shift == ExamShift.Morning || e.Shift == null) &&
                                (e.DoctorId == doc.Id || e.DoctorName.Contains(doc.FullName) || doc.FullName.Contains(e.DoctorName)));

                            var docPendingAfternoon = Model.Exceptions.FirstOrDefault(e =>
                                e.Status == ScheduleExceptionStatus.Pending &&
                                e.Date == curDate &&
                                (e.Shift == ExamShift.Afternoon || e.Shift == null) &&
                                (e.DoctorId == doc.Id || e.DoctorName.Contains(doc.FullName) || doc.FullName.Contains(e.DoctorName)));

                            // Tìm ngoại lệ bác sĩ này nhận TRỰC THAY đã duyệt:
                            var docReplaceMorning = Model.Exceptions.FirstOrDefault(e =>
                                e.Status == ScheduleExceptionStatus.Approved &&
                                e.Date == curDate &&
                                (e.Shift == ExamShift.Morning || e.Shift == null) &&
                                ((e.ReplacementDoctorId.HasValue && e.ReplacementDoctorId.Value == doc.Id) ||
                                 (!string.IsNullOrEmpty(e.ReplacementDoctorName) && (e.ReplacementDoctorName.Contains(doc.FullName) || doc.FullName.Contains(e.ReplacementDoctorName)))));

                            var docReplaceAfternoon = Model.Exceptions.FirstOrDefault(e =>
                                e.Status == ScheduleExceptionStatus.Approved &&
                                e.Date == curDate &&
                                (e.Shift == ExamShift.Afternoon || e.Shift == null) &&
                                ((e.ReplacementDoctorId.HasValue && e.ReplacementDoctorId.Value == doc.Id) ||
                                 (!string.IsNullOrEmpty(e.ReplacementDoctorName) && (e.ReplacementDoctorName.Contains(doc.FullName) || doc.FullName.Contains(e.ReplacementDoctorName)))));

                            // Tìm Lịch khám định mức Quota đã cấu hình:
                            var schedMorning = Model.Schedules.FirstOrDefault(s => s.DoctorId == doc.Id && s.DayOfWeek == dOfWeek && s.Shift == ExamShift.Morning && s.IsActive);
                            var schedAfternoon = Model.Schedules.FirstOrDefault(s => s.DoctorId == doc.Id && s.DayOfWeek == dOfWeek && s.Shift == ExamShift.Afternoon && s.IsActive);

                            // Tìm TẤT CẢ các ca trực đêm nhân sự đã phân công (hỗ trợ nhiều ca trong cùng 1 ngày):
                            var docDutyNights = Model.DutyShifts.Where(ds =>
                                (ds.AccountId == doc.AccountId || (!string.IsNullOrEmpty(ds.StaffName) && (ds.StaffName.Contains(doc.FullName) || doc.FullName.Contains(ds.StaffName)))) &&
                                DateOnly.FromDateTime(ds.StartTime) == curDate).ToList();

                            <div style="padding:10px; border-bottom:1px solid #e2e8f0; @(isToday ? "border-left:2px solid #079bc9; border-right:2px solid #079bc9; background:#f0fdfa;" : "border-right:1px solid #e2e8f0;") display:flex; flex-direction:column; gap:6px;">
                                <!-- 1. CA SÁNG -->
                                <div class="shift-block shift-morning">
                                    @if (docLeaveMorning != null)
                                    {
                                        <div style="background:#fff5e5; border-left:3px solid #f59e0b; border-radius:6px; padding:6px 8px;" title="Lý do: @docLeaveMorning.Reason">
