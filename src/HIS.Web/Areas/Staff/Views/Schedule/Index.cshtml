                            && !doctorsList.Any(d => d.AccountId == ds.AccountId || (!string.IsNullOrEmpty(ds.StaffName) && d.FullName.Contains(ds.StaffName))))
                        .GroupBy(ds => ds.AccountId)
                        .ToList();
                }
