            </div>
            <span id="patientCountDisplay" style="font-size:12px; color:#64748b; font-weight:600;">6 hồ sơ</span>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Người khám</th>
                        <th>Giới tính</th>
                        <th>Điện thoại</th>
                        <th>Ngày sinh</th>
                        <th>Hồ sơ</th>
                    </tr>
                </thead>
                <tbody id="patientsTableBody">
                    <tr class="patient-row" data-search="nguyễn thanh hà bn0001 0901234567">
                        <td>
                            <div style="display:flex; align-items:center; gap:10px;">
                                <span class="avatar" style="background:#fce7f3; color:#be185d; font-weight:700; width:32px; height:32px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:11px;">TH</span>
                                <div>
                                    <strong>Nguyễn Thanh Hà</strong>
                                    <div class="text-muted small">BN0001 · 32 tuổi</div>
                                </div>
                            </div>
                        </td>
                        <td>Nữ</td>
                        <td>0901234567</td>
                        <td>15/06/1994</td>
                        <td>
                            <button type="button" class="btn outline sm" onclick="openPatientModal('Nguyễn Thanh Hà', 'BN0001', 'Nữ', '15/06/1994 (32 tuổi)', '0901234567', 'Quận 1, TP. Hồ Chí Minh')">
                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><circle cx="12" cy="12" r="3"></circle><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path></svg>
                                <span>Thông tin</span>
                            </button>
                        </td>
                    </tr>
                    <tr class="patient-row" data-search="nguyễn văn minh bn0003 0902223344">
                        <td>
                            <div style="display:flex; align-items:center; gap:10px;">
                                <span class="avatar" style="background:#e0f2fe; color:#0369a1; font-weight:700; width:32px; height:32px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:11px;">VM</span>
                                <div>
                                    <strong>Nguyễn Văn Minh</strong>
                                    <div class="text-muted small">BN0003 · 64 tuổi</div>
                                </div>
                            </div>
                        </td>
                        <td>Nam</td>
