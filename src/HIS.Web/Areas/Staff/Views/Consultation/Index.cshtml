@using HIS.Web.Areas.Staff.Models
@using HIS.Domain
@model ConsultationViewModel
@inject TimeProvider Clock

@{
    var tab = Model.ActiveTab;
    ViewData["StaffDepartment"] = Model.DepartmentName;
    ViewData["Title"] = tab switch
    {
        "labs" => "Chỉ định & kết quả",
        "records" => "Bệnh án trong khoa",
        "schedule" => "Lịch làm việc của tôi",
        "exceptions" => "Đề nghị nghỉ / đổi ca",
        _ => "Khám & kê đơn"
    };

    var currentPatient = Model.ActivePatient ?? (Model.QueuePatients.Count > 0 ? Model.QueuePatients[0] : null);

    string WithBs(string? name) => string.IsNullOrWhiteSpace(name)
        ? ""
        : (name.TrimStart().StartsWith("BS.", StringComparison.OrdinalIgnoreCase) ? name.Trim() : "BS. " + name.Trim());

    var now = Clock.GetLocalNow().DateTime.Date;
    int diff = (7 + (now.DayOfWeek - DayOfWeek.Monday)) % 7;
    var mondayThisWeek = now.AddDays(-diff);
    var monday = mondayThisWeek.AddDays(Model.WeekOffset * 7);
    var sunday = monday.AddDays(6);
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff-consultation.css" asp-append-version="true" />
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="flash-banner ok">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="flash-banner err">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

@if (tab == "labs")
{
    <div class="page-heading">
        <div>
            <h1>Chỉ định & kết quả</h1>
        </div>
    </div>

    <section class="card">
        <div class="consult-toolbar">
            <span class="filter-label">Lọc trạng thái:</span>
            <label class="filter-check">
                <input type="checkbox" id="chk-lab-all" checked onchange="toggleLabFilter('all')" />
                Tất cả
            </label>
            <label class="filter-check">
                <input type="checkbox" id="chk-lab-pending" onchange="toggleLabFilter('pending')" />
                Chờ kết quả
            </label>
            <label class="filter-check">
                <input type="checkbox" id="chk-lab-completed" onchange="toggleLabFilter('completed')" />
                Đã có kết quả
            </label>
            <input type="text" id="search-lab-input" class="search-input push-right" onkeyup="filterLabTable()" placeholder="Tìm theo người khám…" />
        </div>

        <div class="table-wrap">
            <table class="consult-table">
                <thead>
                    <tr>
                        <th>Người khám</th>
                        <th>Dịch vụ</th>
                        <th>Ngày chỉ định</th>
                        <th>Trạng thái</th>
                        <th class="right">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="lab-table-body">
                    @if (Model.LabOrders.Count > 0)
                    {
                        @foreach (var lab in Model.LabOrders)
                        {
                            var initials = string.Join("", lab.PatientName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper();
                            if (initials.Length > 2) initials = initials.Substring(initials.Length - 2);
                            var isCompleted = lab.Status.Contains("Đã có kết quả") || lab.Status == "COMPLETED";

                            <tr class="lab-row" data-status="@(isCompleted ? "COMPLETED" : "PENDING")" data-name="@lab.PatientName.ToLower()">
                                <td>
                                    <div class="cell-main">
                                        <div class="avatar-sm">@initials</div>
                                        <div>
                                            <strong>@lab.PatientName</strong>
                                            <small>@lab.PatientCode · @lab.Age tuổi</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span>@lab.ServiceName</span>
                                    <small class="cell-sub">@lab.Note</small>
                                </td>
                                <td>@lab.OrderTime.ToString("dd/MM/yyyy · HH:mm")</td>
                                <td>
                                    <span class="status-badge @(isCompleted ? "ok" : "warn")">@lab.Status</span>
                                </td>
                                <td class="right">
                                    <button type="button" class="btn outline sm"
                                            data-patient="@lab.PatientName"
                                            data-code="@lab.PatientCode"
                                            data-age="@lab.Age"
                                            data-service="@lab.ServiceName"
                                            data-time="@lab.OrderTime.ToString("dd/MM/yyyy HH:mm")"
                                            data-status="@lab.Status"
                                            data-result="@(string.IsNullOrWhiteSpace(lab.ResultData) ? "Chưa có kết quả xét nghiệm từ phòng lab." : lab.ResultData)"
                                            onclick="openLabResultModalFromBtn(this)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:12px;height:12px;">
                                            <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12"></path><circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                        Xem kết quả
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="table-empty">
                                @await Html.PartialAsync("_AdminIcon", "clipboard")
                                <div>Chưa có chỉ định xét nghiệm nào.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <div class="app-dialog-backdrop" id="labResultDialog" onclick="handleDialogBackdropClick(event, 'labResultDialog')">
        <div class="app-dialog-card">
            <div class="app-dialog-header">
                <div>
                    <h3>Kết quả xét nghiệm</h3>
                    <small id="dialog-lab-patient">Người khám: —</small>
                </div>
                <button type="button" class="app-dialog-close" onclick="closeAppDialog('labResultDialog')" title="Đóng (Esc)">✕</button>
            </div>
            <div class="app-dialog-body">
                <div class="detail-box">
                    <div><strong>Dịch vụ:</strong> <span id="dialog-lab-service">—</span></div>
                    <div><strong>Thời gian chỉ định:</strong> <span id="dialog-lab-time">—</span></div>
                    <div><strong>Trạng thái:</strong> <span id="dialog-lab-status">—</span></div>
                </div>
                <div class="record-section">
                    <strong>Chi tiết kết quả:</strong>
                    <div id="dialog-lab-result-text" class="result-box">—</div>
                </div>
            </div>
            <div class="app-dialog-footer">
                <button type="button" class="btn outline sm" onclick="closeAppDialog('labResultDialog')">Đóng</button>
            </div>
        </div>
    </div>
}
else if (tab == "records")
{
    <div class="page-heading">
        <div>
            <h1>Bệnh án trong khoa</h1>
        </div>
    </div>

    <section class="card">
        <div class="consult-toolbar">
            <input type="text" id="search-record-input" class="search-input" onkeyup="filterRecordTable()" placeholder="Tìm người khám hoặc kết luận…" />
            <span id="record-count-badge" class="count-badge push-right">@Model.MedicalRecords.Count phiếu khám</span>
        </div>
        <div class="table-wrap">
            <table class="consult-table">
                <thead>
                    <tr>
                        <th>Người khám</th>
                        <th>Ngày khám</th>
                        <th>Bác sĩ</th>
                        <th>Kết luận</th>
                        <th class="right">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="record-table-body">
                    @if (Model.MedicalRecords.Count > 0)
                    {
                        @foreach (var rec in Model.MedicalRecords)
                        {
                            var initials = string.Join("", rec.PatientName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper();
                            if (initials.Length > 2) initials = initials.Substring(initials.Length - 2);

                            <tr class="record-row" data-text="@(rec.PatientName.ToLower() + " " + rec.Diagnosis.ToLower() + " " + rec.Conclusion.ToLower())">
                                <td>
                                    <div class="cell-main">
                                        <div class="avatar-sm">@initials</div>
                                        <div>
                                            <strong>@rec.PatientName</strong>
                                            <small>@rec.PatientCode · @rec.Age tuổi</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@rec.DateTime.ToString("dd/MM/yyyy · HH:mm")</td>
                                <td>@rec.DoctorName</td>
                                <td>@rec.Diagnosis</td>
                                <td class="right">
                                    <button type="button" class="btn outline sm"
                                            data-id="@rec.RecordId"
                                            data-patient="@rec.PatientName"
                                            data-code="@rec.PatientCode"
                                            data-age="@rec.Age"
                                            data-gender="@rec.Gender"
                                            data-date="@rec.DateTime.ToString("dd/MM/yyyy HH:mm")"
                                            data-doctor="@rec.DoctorName"
                                            data-dept="@rec.DepartmentName"
                                            data-symptoms="@rec.Symptoms"
                                            data-exam="@rec.ClinicalExam"
                                            data-icd="@rec.DiagnosisCode"
                                            data-diagnosis="@rec.Diagnosis"
                                            data-conclusion="@rec.Conclusion"
                                            onclick="openRecordModalFromBtn(this)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:12px;height:12px;">
                                            <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12"></path><circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                        Xem phiếu
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="table-empty">
                                @await Html.PartialAsync("_AdminIcon", "clipboard")
                                <div>Chưa có hồ sơ bệnh án nào.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <div class="app-dialog-backdrop" id="recordDetailDialog" onclick="handleDialogBackdropClick(event, 'recordDetailDialog')">
        <div class="app-dialog-card lg">
            <div class="app-dialog-header">
                <div>
                    <h3>Phiếu khám bệnh</h3>
                    <small id="dialog-record-header-sub">Mã hồ sơ: —</small>
                </div>
                <button type="button" class="app-dialog-close" onclick="closeAppDialog('recordDetailDialog')" title="Đóng (Esc)">✕</button>
            </div>
            <div class="app-dialog-body">
                <div class="detail-box detail-grid">
                    <div><strong>Họ và tên:</strong> <span id="dialog-record-patient">—</span></div>
                    <div><strong>Ngày giờ khám:</strong> <span id="dialog-record-date">—</span></div>
                    <div><strong>Tuổi / Giới tính:</strong> <span id="dialog-record-age-gender">—</span></div>
                    <div><strong>Bác sĩ phụ trách:</strong> <span id="dialog-record-doctor">—</span></div>
                    <div><strong>Khoa chuyên môn:</strong> <span id="dialog-record-dept">—</span></div>
                    <div><strong>Mã lượt hẹn:</strong> <span id="dialog-record-code">—</span></div>
                </div>

                <div class="record-section">
                    <strong>1. Triệu chứng / lý do khám</strong>
                    <div id="dialog-record-symptoms" class="result-box">—</div>
                </div>
                <div class="record-section">
                    <strong>2. Khám lâm sàng</strong>
                    <div id="dialog-record-exam" class="result-box">—</div>
                </div>
                <div class="record-icd-row record-section">
                    <div>
                        <strong>Mã ICD-10</strong>
                        <div id="dialog-record-icd" class="result-box" style="min-height:0;">—</div>
                    </div>
                    <div>
                        <strong>Chẩn đoán chính</strong>
                        <div id="dialog-record-diagnosis" class="result-box" style="min-height:0;">—</div>
                    </div>
                </div>
                <div class="record-section">
                    <strong>3. Kết luận & lời dặn</strong>
                    <div id="dialog-record-conclusion" class="result-box">—</div>
                </div>
            </div>
            <div class="app-dialog-footer">
                <button type="button" class="btn outline sm" onclick="closeAppDialog('recordDetailDialog')">Đóng</button>
            </div>
        </div>
    </div>
}
else if (tab == "schedule")
{
    var docDisplayName = string.IsNullOrWhiteSpace(Model.CurrentDoctorName) ? "Bác sĩ" : Model.CurrentDoctorName;
    var docDisplayInit = docDisplayName.Split(' ').Last()[..Math.Min(2, docDisplayName.Split(' ').Last().Length)].ToUpper();
    var docDisplayRoom = string.IsNullOrWhiteSpace(Model.CurrentDoctorRoom) ? "Chưa phân phòng" : Model.CurrentDoctorRoom;
    var deptDisplayName = string.IsNullOrWhiteSpace(Model.DepartmentName) ? "Chưa gán khoa" : Model.DepartmentName;
    var currentClaimId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    int.TryParse(currentClaimId, out var currentAccId);

    <div class="page-heading">
        <div>
            <h1>Lịch làm việc của tôi</h1>
        </div>
        <div class="heading-actions">
            <span class="room-pill-fixed">
                @await Html.PartialAsync("_AdminIcon", "door") Phòng @docDisplayRoom
            </span>
            <a href="?tab=exceptions" class="btn outline">
                @await Html.PartialAsync("_AdminIcon", "clock") Đề nghị nghỉ / đổi ca
            </a>
        </div>
    </div>

    <div class="week-nav">
        <div class="week-controls">
            <button type="button" class="icon-btn-sm" onclick="changeWeek(-1)" title="Tuần trước" aria-label="Tuần trước">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <span class="week-range">
                @await Html.PartialAsync("_AdminIcon", "calendar")
                @monday.ToString("dd/MM/yyyy") – @sunday.ToString("dd/MM/yyyy")
            </span>
            <button type="button" class="icon-btn-sm" onclick="changeWeek(1)" title="Tuần kế tiếp" aria-label="Tuần kế tiếp">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
            @if (Model.WeekOffset != 0)
            {
                <button type="button" class="back-week" onclick="resetWeek()">Về tuần này</button>
            }
        </div>
    </div>

    <div class="sched-subtabs" role="tablist" aria-label="Khu vực lịch làm việc">
        <button type="button" role="tab" class="is-active" aria-selected="true" data-consult-pane="week" onclick="switchConsultPane('week')">Lịch làm việc</button>
        <button type="button" role="tab" aria-selected="false" data-consult-pane="bidding" onclick="switchConsultPane('bidding')">Đăng ký ca khám</button>
    </div>

    <section class="card consult-pane" id="consult-pane-week">
        <div class="wk-table-shell">
            <table class="wk-table">
                <thead>
                    <tr>
                        <th class="wk-shift-col">Ca</th>
                        @{
                            var currentDocId = Model.SelectedDoctorId ?? Model.CurrentDoctorId;
                            var dayTitles = new[] { "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy", "Chủ Nhật" };
                            for (int i = 0; i < 7; i++)
                            {
                                var headDate = monday.AddDays(i);
                                var headToday = headDate.Date == now.Date;
                                var headWeekend = headDate.DayOfWeek == DayOfWeek.Saturday || headDate.DayOfWeek == DayOfWeek.Sunday;
                                <th class="wk-day @(headToday ? "is-today" : "") @(headWeekend ? "is-weekend" : "")">
                                    <span class="wk-day-name">@dayTitles[i]</span>
                                    <span class="wk-day-date">@headDate.ToString("dd/MM")</span>
                                    @if (headToday)
                                    {
                                        <span class="wk-today-badge">Hôm nay</span>
                                    }
                                </th>
                            }
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr class="wk-row-top">
                        <td class="wk-shift-label is-morning">Sáng</td>
                        @{
                            for (int i = 0; i < 7; i++)
                            {
                                var dayDate = monday.AddDays(i);
                                var curDate = DateOnly.FromDateTime(dayDate);
                                var isToday = dayDate.Date == now.Date;
                                var isWeekend = dayDate.DayOfWeek == DayOfWeek.Saturday || dayDate.DayOfWeek == DayOfWeek.Sunday;

                                var schedMorning = Model.DoctorSchedules.FirstOrDefault(s =>
                                    s.WorkDate == curDate &&
                                    s.Shift == ExamShift.Morning &&
                                    (!s.DoctorId.HasValue || s.DoctorId.Value == currentDocId || s.DoctorName == docDisplayName));

                                var approvedLeaveMorning = Model.Exceptions.FirstOrDefault(e =>
                                    e.Date == curDate &&
                                    (e.Shift == ExamShift.Morning || e.Shift == null) &&
                                    (e.DoctorId == currentDocId || (e.DoctorId == null && !Model.IsDepartmentHead)) &&
                                    e.Status.Contains("duyệt") && !e.Status.Contains("Từ") && !e.Status.Contains("Chờ"));

                                var pendingLeaveMorning = Model.Exceptions.FirstOrDefault(e =>
                                    e.Date == curDate &&
                                    (e.Shift == ExamShift.Morning || e.Shift == null) &&
                                    (e.DoctorId == currentDocId || (e.DoctorId == null && !Model.IsDepartmentHead)) &&
                                    e.Status.Contains("Chờ"));

                                var coveringSwapMorning = Model.Exceptions.FirstOrDefault(e =>
                                    e.Date == curDate &&
                                    (e.Shift == ExamShift.Morning || e.Shift == null) &&
                                    e.ReplacementDoctorId.HasValue && e.ReplacementDoctorId.Value == currentDocId &&
                                    e.DoctorId != currentDocId &&
                                    e.Status.Contains("duyệt") && !e.Status.Contains("Từ") && !e.Status.Contains("Chờ"));

                                var dayDutyShifts = Model.DutyShifts.Where(d => DateOnly.FromDateTime(d.StartTime) == curDate).ToList();
                                var myDutyNight = dayDutyShifts.FirstOrDefault(d =>
                                    d.AccountId == currentAccId ||
                                    (!string.IsNullOrEmpty(d.StaffName) && (d.StaffName.Contains(docDisplayName) || docDisplayName.Contains(d.StaffName))));

                                <td class="wk-cell @(isToday ? "is-today" : "") @(isWeekend ? "is-weekend" : "")">
                                    <div class="wk-stack">
                                        @if (coveringSwapMorning != null)
                                        {
                                            <div class="wk-pill is-cover" title="Trực thay ca đổi: @coveringSwapMorning.Reason">
                                                <span class="wk-pill-room">Trực thay</span>
                                                <span class="wk-pill-time">07:30–11:30</span>
                                            </div>
                                        }
                                        else if (approvedLeaveMorning != null)
                                        {
                                            <div class="wk-pill is-leave" title="Lý do: @approvedLeaveMorning.Reason">
                                                <span class="wk-pill-room">@(approvedLeaveMorning.Type.Contains("Swap") || approvedLeaveMorning.Type.Contains("Đổi") ? "Đã đổi ca" : "Nghỉ phép")</span>
                                                <span class="wk-pill-time">Đã duyệt</span>
                                            </div>
                                        }
                                        else if (pendingLeaveMorning != null)
                                        {
                                            <div class="wk-pill is-pending" title="Lý do: @pendingLeaveMorning.Reason — Chờ Trưởng khoa duyệt">
                                                <span class="wk-pill-room">@(pendingLeaveMorning.Type.Contains("Swap") || pendingLeaveMorning.Type.Contains("Đổi") ? "Xin đổi ca" : "Xin nghỉ phép")</span>
                                                <span class="wk-pill-flag">· Chờ duyệt</span>
                                            </div>
                                        }
                                        else if (schedMorning != null)
                                        {
                                            <div class="wk-pill is-morning" title="Ca sáng @schedMorning.StartTime.ToString("HH:mm")–@schedMorning.EndTime.ToString("HH:mm") · Phòng @schedMorning.RoomNumber">
                                                <span class="wk-pill-room">P.@schedMorning.RoomNumber</span>
                                                <span class="wk-pill-time">@schedMorning.StartTime.ToString("HH:mm")–@schedMorning.EndTime.ToString("HH:mm")</span>
                                            </div>
                                            @if (myDutyNight != null)
                                            {
                                                <span class="wk-duty" title="Trực đêm · @myDutyNight.Note">Trực đêm</span>
                                            }
                                        }
                                        else if (myDutyNight != null)
                                        {
                                            <span class="wk-duty" title="Trực đêm · @myDutyNight.Note">Trực đêm</span>
                                        }
                                        else
                                        {
                                            <span class="wk-none @(isWeekend ? "is-weekend" : "is-past")">@(isWeekend ? "Nghỉ cuối tuần" : "—")</span>
                                        }
                                    </div>
                                </td>
                            }
                        }
                    </tr>
                    <tr class="wk-row-bottom">
                        <td class="wk-shift-label is-afternoon">Chiều</td>
                        @{
                            for (int i = 0; i < 7; i++)
                            {
                                var dayDate = monday.AddDays(i);
                                var curDate = DateOnly.FromDateTime(dayDate);
                                var isToday = dayDate.Date == now.Date;
                                var isWeekend = dayDate.DayOfWeek == DayOfWeek.Saturday || dayDate.DayOfWeek == DayOfWeek.Sunday;

                                var schedAfternoon = Model.DoctorSchedules.FirstOrDefault(s =>
                                    s.WorkDate == curDate &&
                                    s.Shift == ExamShift.Afternoon &&
                                    (!s.DoctorId.HasValue || s.DoctorId.Value == currentDocId || s.DoctorName == docDisplayName));

                                var approvedLeaveAfternoon = Model.Exceptions.FirstOrDefault(e =>
                                    e.Date == curDate &&
                                    (e.Shift == ExamShift.Afternoon || e.Shift == null) &&
                                    (e.DoctorId == currentDocId || (e.DoctorId == null && !Model.IsDepartmentHead)) &&
                                    e.Status.Contains("duyệt") && !e.Status.Contains("Từ") && !e.Status.Contains("Chờ"));

                                var pendingLeaveAfternoon = Model.Exceptions.FirstOrDefault(e =>
                                    e.Date == curDate &&
                                    (e.Shift == ExamShift.Afternoon || e.Shift == null) &&
                                    (e.DoctorId == currentDocId || (e.DoctorId == null && !Model.IsDepartmentHead)) &&
                                    e.Status.Contains("Chờ"));

                                var coveringSwapAfternoon = Model.Exceptions.FirstOrDefault(e =>
                                    e.Date == curDate &&
                                    (e.Shift == ExamShift.Afternoon || e.Shift == null) &&
                                    e.ReplacementDoctorId.HasValue && e.ReplacementDoctorId.Value == currentDocId &&
                                    e.DoctorId != currentDocId &&
                                    e.Status.Contains("duyệt") && !e.Status.Contains("Từ") && !e.Status.Contains("Chờ"));

                                <td class="wk-cell @(isToday ? "is-today" : "") @(isWeekend ? "is-weekend" : "")">
                                    <div class="wk-stack">
                                        @if (coveringSwapAfternoon != null)
                                        {
                                            <div class="wk-pill is-cover" title="Trực thay ca đổi: @coveringSwapAfternoon.Reason">
                                                <span class="wk-pill-room">Trực thay</span>
                                                <span class="wk-pill-time">13:00–16:30</span>
                                            </div>
                                        }
                                        else if (approvedLeaveAfternoon != null)
                                        {
                                            <div class="wk-pill is-leave" title="Lý do: @approvedLeaveAfternoon.Reason">
                                                <span class="wk-pill-room">@(approvedLeaveAfternoon.Type.Contains("Swap") || approvedLeaveAfternoon.Type.Contains("Đổi") ? "Đã đổi ca" : "Nghỉ phép")</span>
                                                <span class="wk-pill-time">Đã duyệt</span>
                                            </div>
                                        }
                                        else if (pendingLeaveAfternoon != null)
                                        {
                                            <div class="wk-pill is-pending" title="Lý do: @pendingLeaveAfternoon.Reason — Chờ Trưởng khoa duyệt">
                                                <span class="wk-pill-room">@(pendingLeaveAfternoon.Type.Contains("Swap") || pendingLeaveAfternoon.Type.Contains("Đổi") ? "Xin đổi ca" : "Xin nghỉ phép")</span>
                                                <span class="wk-pill-flag">· Chờ duyệt</span>
                                            </div>
                                        }
                                        else if (schedAfternoon != null)
                                        {
                                            <div class="wk-pill is-afternoon" title="Ca chiều @schedAfternoon.StartTime.ToString("HH:mm")–@schedAfternoon.EndTime.ToString("HH:mm") · Phòng @schedAfternoon.RoomNumber">
                                                <span class="wk-pill-room">P.@schedAfternoon.RoomNumber</span>
                                                <span class="wk-pill-time">@schedAfternoon.StartTime.ToString("HH:mm")–@schedAfternoon.EndTime.ToString("HH:mm")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="wk-none @(isWeekend ? "is-weekend" : "is-past")">@(isWeekend ? "Nghỉ cuối tuần" : "—")</span>
                                        }
                                    </div>
                                </td>
                            }
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="card consult-pane" id="consult-pane-bidding" hidden>
        <div class="bidding-section">

            <div class="bidding-header">
                <h2>Đăng ký ca khám</h2>
                @if (Model.ActivePeriod != null)
                {
                    var (pillClass, pillText) = Model.ActivePeriod.Status switch
                    {
                        SchedulingPeriodStatus.Open when Model.ActivePeriod.IsOpenForBidding => ("open", "Đang mở đăng ký"),
                        SchedulingPeriodStatus.Open => ("closed", "Đã đóng đăng ký"),
                        SchedulingPeriodStatus.Reviewing => ("review", "Đang xét duyệt"),
                        SchedulingPeriodStatus.Published => ("published", "Đã xuất bản lịch"),
                        _ => ("closed", "Đã đóng")
                    };
                    <div class="period-info">
                        <span class="period-pill @pillClass">@pillText</span>
                        <div class="period-meta">Kỳ @Model.ActivePeriod.Name · @Model.ActivePeriod.StartDate.ToString("dd/MM") – @Model.ActivePeriod.EndDate.ToString("dd/MM/yyyy")</div>
                    </div>
                }
                else
                {
                    <span class="period-pill closed">Chưa có kỳ đăng ký</span>
                }
            </div>

            @if (Model.DemandGrid != null && Model.ActivePeriod != null)
            {
                var myBids = Model.DemandGrid.Cells
                    .SelectMany(c => c.Bidders)
                    .Where(b => b.DoctorId == Model.CurrentDoctorId)
                    .ToList();

                var totalBids = myBids.Count;
                var approvedBids = myBids.Count(b => b.Status == DoctorScheduleStatus.Approved);
                var pendingBids = myBids.Count(b => b.Status == DoctorScheduleStatus.Bidding);
                var rejectedBids = myBids.Count(b => b.Status == DoctorScheduleStatus.Rejected);
                var reallocatedBids = myBids.Count(b => b.Status == DoctorScheduleStatus.Reallocated);

                var minQuota = Model.MinShiftsPerWeek > 0 ? Model.MinShiftsPerWeek : 2;
                var maxQuota = Model.MaxShiftsPerWeek > 0 ? Model.MaxShiftsPerWeek : 10;
                var pctProgress = Math.Min(100, (int)Math.Round((double)totalBids / minQuota * 100));
                var isMinQuotaMet = totalBids >= minQuota;
                var shiftsNeeded = Math.Max(0, minQuota - totalBids);

                <div class="quota-card">
                    <div class="quota-row">
                        <div class="quota-main">
                            Định mức tuần
                            <span class="quota-count">@totalBids / @minQuota – @maxQuota ca</span>
                            @if (totalBids >= maxQuota)
                            {
                                <span class="quota-pill ok">Đã chọn đủ tối đa</span>
                            }
                            else if (isMinQuotaMet)
                            {
                                <span class="quota-pill ok">Đã đạt chỉ tiêu</span>
                            }
                            else
                            {
                                <span class="quota-pill warn">Còn thiếu @shiftsNeeded ca</span>
                            }
                        </div>
                        <div class="quota-stats">
                            <span><span class="dot" style="background:#22c55e;"></span>Đã duyệt: <strong>@approvedBids</strong></span>
                            <span><span class="dot" style="background:#15803d;"></span>Chờ duyệt: <strong>@pendingBids</strong></span>
                            <span><span class="dot" style="background:@(rejectedBids > 0 ? "#ef4444" : "#94a3b8");"></span>Không duyệt: <strong>@rejectedBids</strong></span>
                            @if (reallocatedBids > 0)
                            {
                                <span><span class="dot" style="background:#eab308;"></span>Điều chuyển: <strong>@reallocatedBids</strong></span>
                            }
                        </div>
                    </div>
                    <div class="quota-bar">
                        <span style="width:@pctProgress%; background:@(isMinQuotaMet ? "#10b981" : "#f59e0b");"></span>
                    </div>
                </div>

                @if (rejectedBids > 0)
                {
                    <div class="reject-alert">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 9v4"></path><path d="M12 17h.01"></path><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>
                        <div>
                            <strong>Có @rejectedBids ca đăng ký không thành công do hết buồng khám.</strong>
                            @if (Model.ActivePeriod.IsOpenForBidding)
                            {
                                <span>Chọn ca còn chỗ (màu xanh) bên dưới để đăng ký thay thế.</span>
                            }
                            else
                            {
                                <span>Kỳ đăng ký đã đóng. Liên hệ Trưởng khoa để được hỗ trợ.</span>
                            }
                        </div>
                    </div>
                }

                <div class="demand-card">
                    <div class="demand-grid">
                        @{
                            var dates = Model.DemandGrid.Cells.Select(c => c.WorkDate).Distinct().OrderBy(d => d).ToList();
                        }
                        @foreach (var d in dates)
                        {
                            var morningCell = Model.DemandGrid.Cells.FirstOrDefault(c => c.WorkDate == d && c.Shift == ExamShift.Morning);
                            var afternoonCell = Model.DemandGrid.Cells.FirstOrDefault(c => c.WorkDate == d && c.Shift == ExamShift.Afternoon);
                            var isSunday = d.DayOfWeek == DayOfWeek.Sunday;
                            var isSaturday = d.DayOfWeek == DayOfWeek.Saturday;

                            <div class="demand-day">
                                <div class="demand-day-head">
                                    <div class="demand-dow @(isSunday ? "sunday" : isSaturday ? "saturday" : "")">
                                        @(d.DayOfWeek switch { DayOfWeek.Monday => "Thứ Hai", DayOfWeek.Tuesday => "Thứ Ba", DayOfWeek.Wednesday => "Thứ Tư", DayOfWeek.Thursday => "Thứ Năm", DayOfWeek.Friday => "Thứ Sáu", DayOfWeek.Saturday => "Thứ Bảy", _ => "Chủ Nhật" })
                                    </div>
                                    <div class="demand-date">@d.ToString("dd/MM")</div>
                                </div>

                                @if (morningCell != null)
                                {
                                    var myBid = morningCell.Bidders.FirstOrDefault(b => b.DoctorId == Model.CurrentDoctorId);
                                    var (cellBg, cellBorder, cellText) = morningCell.Level switch
                                    {
                                        DemandLevel.HighCompetition => ("#fef2f2", "#fca5a5", "#b91c1c"),
                                        DemandLevel.Available => ("#f0fdf4", "#86efac", "#15803d"),
                                        _ => ("#f8fafc", "#e2e8f0", "#64748b")
                                    };

                                    <div class="demand-cell" style="background:@cellBg; border-color:@cellBorder;">
                                        <div class="demand-cell-head">
                                            <span class="demand-shift">Ca sáng</span>
                                            <span class="demand-rooms" style="color:@cellText;">@morningCell.CurrentBidders / @morningCell.TotalRooms phòng</span>
                                        </div>

                                        @if (morningCell.IsHotShift)
                                        {
                                            <span class="hot-badge">Hot</span>
                                        }

                                        @if (myBid != null)
                                        {
                                            <div class="bid-state">
                                                @if (myBid.Status == DoctorScheduleStatus.Bidding)
                                                {
                                                    <div class="bid-cancel-row">
                                                        <span class="bid-ok">Đã đăng ký</span>
                                                        @if (Model.ActivePeriod.IsOpenForBidding)
                                                        {
                                                            <form asp-action="CancelShiftBid" method="post" style="margin:0;">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="scheduleId" value="@myBid.ScheduleId" />
                                                                <button type="submit" class="link-cancel">Hủy</button>
                                                            </form>
                                                        }
                                                    </div>
                                                }
                                                else if (myBid.Status == DoctorScheduleStatus.Approved)
                                                {
                                                    <span class="bid-ok">Đã duyệt · P.@myBid.RoomNumber</span>
                                                }
                                                else if (myBid.Status == DoctorScheduleStatus.Rejected)
                                                {
                                                    <div class="bid-rejected">
                                                        Không duyệt (hết buồng)
                                                        @if (Model.ActivePeriod.IsOpenForBidding)
                                                        {
                                                            <span class="hint">Chọn ca khác</span>
                                                        }
                                                    </div>
                                                }
                                                else if (myBid.Status == DoctorScheduleStatus.Reallocated)
                                                {
                                                    <span class="bid-reallocated">Đã điều chuyển</span>
                                                }
                                            </div>
                                        }
                                        else if (Model.ActivePeriod.IsOpenForBidding)
                                        {
                                            @if (morningCell.ApprovedCount >= morningCell.TotalRooms)
                                            {
                                                <div class="bid-full">Kín buồng (@morningCell.ApprovedCount/@morningCell.TotalRooms)</div>
                                            }
                                            else
                                            {
                                                <button type="button" class="register-btn" onclick="openShiftBidModal('@Model.ActivePeriod.Id', '@d.ToString("yyyy-MM-dd")', '@((int)ExamShift.Morning)', 'Ca sáng (07:30–11:30) ngày @d.ToString("dd/MM/yyyy")')">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14 M5 12h14"></path></svg>
                                                    Đăng ký
                                                </button>
                                            }
                                        }
                                    </div>
                                }

                                @if (afternoonCell != null)
                                {
                                    var myBid = afternoonCell.Bidders.FirstOrDefault(b => b.DoctorId == Model.CurrentDoctorId);
                                    var (cellBg, cellBorder, cellText) = afternoonCell.Level switch
                                    {
                                        DemandLevel.HighCompetition => ("#fef2f2", "#fca5a5", "#b91c1c"),
                                        DemandLevel.Available => ("#f0fdf4", "#86efac", "#15803d"),
                                        _ => ("#f8fafc", "#e2e8f0", "#64748b")
                                    };

                                    <div class="demand-cell" style="background:@cellBg; border-color:@cellBorder;">
                                        <div class="demand-cell-head">
                                            <span class="demand-shift">Ca chiều</span>
                                            <span class="demand-rooms" style="color:@cellText;">@afternoonCell.CurrentBidders / @afternoonCell.TotalRooms phòng</span>
                                        </div>

                                        @if (afternoonCell.IsHotShift)
                                        {
                                            <span class="hot-badge">Hot</span>
                                        }

                                        @if (myBid != null)
                                        {
                                            <div class="bid-state">
                                                @if (myBid.Status == DoctorScheduleStatus.Bidding)
                                                {
                                                    <div class="bid-cancel-row">
                                                        <span class="bid-ok">Đã đăng ký</span>
                                                        @if (Model.ActivePeriod.IsOpenForBidding)
                                                        {
                                                            <form asp-action="CancelShiftBid" method="post" style="margin:0;">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="scheduleId" value="@myBid.ScheduleId" />
                                                                <button type="submit" class="link-cancel">Hủy</button>
                                                            </form>
                                                        }
                                                    </div>
                                                }
                                                else if (myBid.Status == DoctorScheduleStatus.Approved)
                                                {
                                                    <span class="bid-ok">Đã duyệt · P.@myBid.RoomNumber</span>
                                                }
                                                else if (myBid.Status == DoctorScheduleStatus.Rejected)
                                                {
                                                    <div class="bid-rejected">
                                                        Không duyệt (hết buồng)
                                                        @if (Model.ActivePeriod.IsOpenForBidding)
                                                        {
                                                            <span class="hint">Chọn ca khác</span>
                                                        }
                                                    </div>
                                                }
                                                else if (myBid.Status == DoctorScheduleStatus.Reallocated)
                                                {
                                                    <span class="bid-reallocated">Đã điều chuyển</span>
                                                }
                                            </div>
                                        }
                                        else if (Model.ActivePeriod.IsOpenForBidding)
                                        {
                                            @if (afternoonCell.ApprovedCount >= afternoonCell.TotalRooms)
                                            {
                                                <div class="bid-full">Kín buồng (@afternoonCell.ApprovedCount/@afternoonCell.TotalRooms)</div>
                                            }
                                            else
                                            {
                                                <button type="button" class="register-btn" onclick="openShiftBidModal('@Model.ActivePeriod.Id', '@d.ToString("yyyy-MM-dd")', '@((int)ExamShift.Afternoon)', 'Ca chiều (13:00–16:30) ngày @d.ToString("dd/MM/yyyy")')">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14 M5 12h14"></path></svg>
                                                    Đăng ký
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="empty-period">
                    @await Html.PartialAsync("_AdminIcon", "calendar")
                    <strong>Chưa có kỳ đăng ký đang mở</strong>
                    <p>Chờ Trưởng khoa mở đợt đăng ký cho tuần tiếp theo.</p>
                </div>
            }
        </div>
    </section>

    <div class="app-dialog-backdrop" id="shiftBidDialog" onclick="handleDialogBackdropClick(event, 'shiftBidDialog')">
        <div class="app-dialog-card" style="max-width:440px;">
            <form asp-action="RegisterShiftBid" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="periodId" id="bidModalPeriodId" />
                <input type="hidden" name="workDate" id="bidModalWorkDate" />
                <input type="hidden" name="shift" id="bidModalShift" />

                <div class="app-dialog-header">
                    <h3>Đăng ký ca khám</h3>
                    <button type="button" class="app-dialog-close" onclick="closeAppDialog('shiftBidDialog')">✕</button>
                </div>
                <div class="app-dialog-body">
                    <div class="dialog-summary">Ca khám: <strong id="bidModalLabel">...</strong></div>
                    <div class="field-group">
                        <label for="bid-note">Ghi chú (tùy chọn)</label>
                        <textarea name="doctorNote" id="bid-note" rows="3" placeholder="Ví dụ: có hẹn bệnh nhân cũ..."></textarea>
                    </div>
                    <div class="dialog-hint">Nếu trực đêm hôm trước kéo sang sáng nay, hệ thống sẽ tự chặn đăng ký ca sáng.</div>
                </div>
                <div class="app-dialog-footer">
                    <button type="button" class="btn outline sm" onclick="closeAppDialog('shiftBidDialog')">Hủy</button>
                    <button type="submit" class="btn primary sm">Xác nhận đăng ký</button>
                </div>
            </form>
        </div>
    </div>
}
else if (tab == "exceptions")
{
    <div class="page-heading">
        <div>
            <h1>Đề nghị nghỉ / đổi ca</h1>
        </div>
        <div class="heading-actions">
            <button type="button" class="btn primary" onclick="openAppDialog('createExceptionDialog'); toggleReplacementDoctorField();">
                @await Html.PartialAsync("_AdminIcon", "plus") Tạo đề nghị
            </button>
        </div>
    </div>

    <section class="card">
        <div class="consult-toolbar">
            <span class="filter-label">Lọc trạng thái:</span>
            <label class="filter-check">
                <input type="checkbox" id="chk-exc-all" checked onchange="toggleExcFilter('all')" />
                Tất cả
            </label>
            <label class="filter-check">
                <input type="checkbox" id="chk-exc-pending" onchange="toggleExcFilter('pending')" />
                Chờ duyệt
            </label>
            <label class="filter-check">
                <input type="checkbox" id="chk-exc-approved" onchange="toggleExcFilter('approved')" />
                Đã duyệt
            </label>
            <label class="filter-check">
                <input type="checkbox" id="chk-exc-rejected" onchange="toggleExcFilter('rejected')" />
                Từ chối
            </label>
        </div>

        <div class="table-wrap">
            <table class="consult-table">
                <thead>
                    <tr>
                        <th>Ngày xin nghỉ</th>
                        <th>Ca trực</th>
                        <th>Loại đề nghị</th>
                        <th>Bác sĩ thay thế</th>
                        <th>Lý do</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody id="exc-table-body">
                    @if (Model.Exceptions.Count > 0)
                    {
                        @foreach (var ex in Model.Exceptions)
                        {
                            var statusNormalized = ex.Status.Contains("Chờ") ? "PENDING" : (ex.Status.Contains("duyệt") && !ex.Status.Contains("Từ")) ? "APPROVED" : "REJECTED";
                            var badgeClass = statusNormalized switch
                            {
                                "APPROVED" => "ok",
                                "REJECTED" => "bad",
                                _ => "warn"
                            };

                            <tr class="exc-row" data-status="@statusNormalized">
                                <td><strong>@ex.Date.ToString("dd/MM/yyyy")</strong></td>
                                <td>@(ex.Shift == ExamShift.Morning ? "Ca sáng" : ex.Shift == ExamShift.Afternoon ? "Ca chiều" : "Cả ngày")</td>
                                <td>
                                    @(ex.Type switch
                                    {
                                        "ShiftSwap" => "Đổi ca trực",
                                        "Leave" => "Nghỉ phép",
                                        "Training" => "Đào tạo",
                                        "Surgery" => "Phẫu thuật",
                                        _ => ex.Type
                                    })
                                </td>
                                <td>@(ex.ReplacementDoctorName ?? "—")</td>
                                <td>@ex.Reason</td>
                                <td>
                                    <span class="status-badge @badgeClass">@ex.Status</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="exc-empty-row">
                            <td colspan="6" class="table-empty">
                                @await Html.PartialAsync("_AdminIcon", "calendar")
                                <div>Chưa có đề nghị nào.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <div class="app-dialog-backdrop" id="createExceptionDialog" onclick="handleDialogBackdropClick(event, 'createExceptionDialog')">
        <div class="app-dialog-card">
            <form asp-area="Staff" asp-controller="Consultation" asp-action="CreateException" method="post" style="margin:0;">
                <div class="app-dialog-header">
                    <h3>Tạo đề nghị nghỉ / đổi ca</h3>
                    <button type="button" class="app-dialog-close" onclick="closeAppDialog('createExceptionDialog')" title="Đóng (Esc)">✕</button>
                </div>
                <div class="app-dialog-body">
                    <div class="field-group">
                        <label for="exc-date">Ngày xin nghỉ / đổi ca <span class="req">*</span></label>
                        <input type="date" name="date" id="exc-date" min="@now.ToString("yyyy-MM-dd")" required value="@now.AddDays(1).ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="field-group">
                        <label for="exc-shift">Ca trực ảnh hưởng</label>
                        <select name="shift" id="exc-shift">
                            <option value="@ExamShift.Morning">Ca sáng (07:30–11:30)</option>
                            <option value="@ExamShift.Afternoon">Ca chiều (13:00–16:30)</option>
                            <option value="">Cả ngày</option>
                        </select>
                    </div>
                    <div class="field-group">
                        <label for="sel-exception-type">Loại đề nghị</label>
                        <select name="type" id="sel-exception-type" onchange="toggleReplacementDoctorField()">
                            <option value="@ScheduleExceptionType.Leave">Nghỉ phép</option>
                            <option value="@ScheduleExceptionType.ShiftSwap">Đổi ca trực</option>
                            <option value="@ScheduleExceptionType.Training">Đào tạo / Công tác</option>
                            <option value="@ScheduleExceptionType.Surgery">Kíp phẫu thuật</option>
                        </select>
                    </div>
                    <div class="field-group" id="replacement-doctor-group" style="display:none;">
                        <label for="sel-replacement-doctor">Bác sĩ đổi ca cùng <span class="req">*</span></label>
                        <select name="replacementDoctorId" id="sel-replacement-doctor">
                            <option value="">-- Chọn bác sĩ nhận đổi ca --</option>
                            @foreach (var doc in Model.AvailableDoctors.Where(d => !string.Equals(d.FullName, Model.CurrentDoctorName, StringComparison.OrdinalIgnoreCase)))
                            {
                                <option value="@doc.Id">@doc.FullName (@doc.Specialty)</option>
                            }
                        </select>
                    </div>
                    <div class="field-group">
                        <label for="exc-reason">Lý do <span class="req">*</span></label>
                        <textarea name="reason" id="exc-reason" rows="3" placeholder="Ghi rõ lý do đổi ca hoặc việc bận..." required></textarea>
                    </div>
                </div>
                <div class="app-dialog-footer">
                    <button type="button" class="btn outline sm" onclick="closeAppDialog('createExceptionDialog')">Hủy bỏ</button>
                    <button type="submit" class="btn primary sm">Gửi đề nghị</button>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="page-heading">
        <div>
            <h1>Khám bệnh & kê đơn</h1>
        </div>
        <div class="heading-actions">
            @if (Model.IsDepartmentHead)
            {
                <a href="@Url.Action("Index", "Schedule", new { area = "Staff" })" class="btn outline">
                    @await Html.PartialAsync("_AdminIcon", "grid") Điều phối khoa
                </a>
            }
            else
            {
                <a href="?tab=schedule" class="btn outline">
                    @await Html.PartialAsync("_AdminIcon", "calendar") Lịch cá nhân
                </a>
            }
        </div>
    </div>

    <div class="clinical-layout">
        <aside class="card consultation-list">
            <div class="card-header">
                <h2>Danh sách chờ</h2>
                <span style="font-size:11px; color:#64748b;">@Model.QueuePatients.Count lượt khám</span>
            </div>

            @if (Model.IsDepartmentHead)
            {
                <div class="doctor-filter">
                    <label for="queue-doctor-filter">Lọc theo bác sĩ:</label>
                    <select id="queue-doctor-filter" onchange="window.location.href = '?tab=consultation&doctorId=' + this.value;">
                        <option value="">-- Tất cả bác sĩ trong khoa --</option>
                        @foreach (var doc in Model.AvailableDoctors)
                        {
                            <option value="@doc.Id" selected="@(Model.SelectedDoctorId == doc.Id)">@WithBs(doc.FullName) (@(doc.RoomNumber ?? doc.Specialty))</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="queue-meta">
                    <span>Phòng: <strong>@Model.CurrentDoctorRoom</strong></span>
                    <span>Bác sĩ: <strong>@WithBs(Model.CurrentDoctorName)</strong></span>
                </div>
            }

            <div>
                @if (Model.QueuePatients.Count > 0)
                {
                    var isFirst = true;
                    foreach (var p in Model.QueuePatients)
                    {
                        var initials = string.Join("", p.PatientName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper();
                        if (initials.Length > 2) initials = initials.Substring(initials.Length - 2);

                        <button type="button"
                                class="consultation-person @(isFirst ? "active" : "")"
                                data-id="@p.AppointmentId"
                                data-name="@p.PatientName"
                                data-code="@p.AppointmentCode"
                                data-age="@p.Age"
                                data-gender="@p.Gender"
                                data-queue="@p.QueueNumber"
                                data-reason="@p.Reason"
                                data-allergy="@(p.Allergy ?? "")"
                                data-pulse="@(p.Pulse?.ToString() ?? "")"
                                data-bp="@(p.BloodPressure ?? "")"
                                data-temp="@(p.Temperature?.ToString() ?? "")"
                                data-spo2="@(p.Spo2?.ToString() ?? "")"
                                data-weight="@(p.Weight?.ToString() ?? "")"
                                data-status="@p.StatusId"
                                onclick="selectConsultPatient(this)">
                            <div class="avatar">@initials</div>
                            <span>
                                <strong>@p.PatientName</strong>
                                <small>@p.QueueNumber · @(p.CheckedInAt?.ToString("HH:mm") ?? "Chờ vào")@(!string.IsNullOrEmpty(p.RoomNumber) ? $" · {p.RoomNumber}" : "")</small>
                                @if (Model.IsDepartmentHead && !string.IsNullOrEmpty(p.DoctorName))
                                {
                                    <small style="color:#15803d; font-size:10px; display:block;">@WithBs(p.DoctorName)</small>
                                }
                                @if (p.StatusId == 3)
                                {
                                    <span class="queue-status-badge warn">Chờ đo sinh hiệu</span>
                                }
                                else if (p.StatusId == 5)
                                {
                                    <span class="queue-status-badge ok">Đang khám</span>
                                }
                                else
                                {
                                    <span class="queue-status-badge ok">Sẵn sàng khám</span>
                                }
                            </span>
                        </button>
                        isFirst = false;
                    }
                }
                else
                {
                    <div class="queue-empty">
                        @await Html.PartialAsync("_AdminIcon", "stethoscope")
                        <div>Không có bệnh nhân chờ trong ca này.</div>
                    </div>
                }
            </div>
        </aside>

        <section class="card consultation-workspace">
            @if (currentPatient != null)
            {
                <div class="card-header">
                    <div class="patient-head">
                        @await Html.PartialAsync("_AdminIcon", "stethoscope")
                        <div>
                            <h2 id="patient-name-display">@currentPatient.PatientName</h2>
                            <span id="patient-info-display" class="patient-meta">@currentPatient.AppointmentCode · @currentPatient.Gender · @currentPatient.Age tuổi · @currentPatient.QueueNumber</span>
                        </div>
                    </div>
                </div>

                <div class="clinical-inner">
                    <div class="notice amber" id="patient-notice-display">
                        <strong>Dị ứng / Lưu ý:</strong> <span id="patient-allergy-display">@(string.IsNullOrWhiteSpace(currentPatient.Allergy) ? "Không ghi nhận" : currentPatient.Allergy)</span><br />
                        <span id="patient-reason-display">Lý do khám: @currentPatient.Reason</span>
                    </div>

                    <div class="vitals-strip">
                        <div><small>Mạch</small><strong id="vital-pulse">@(currentPatient.Pulse.HasValue ? $"{currentPatient.Pulse} " : "— ")<span>l/p</span></strong></div>
                        <div><small>Huyết áp</small><strong id="vital-bp">@(currentPatient.BloodPressure != null ? $"{currentPatient.BloodPressure} " : "— ")<span>mmHg</span></strong></div>
                        <div><small>Nhiệt độ</small><strong id="vital-temp">@(currentPatient.Temperature.HasValue ? $"{currentPatient.Temperature} " : "— ")<span>°C</span></strong></div>
                        <div><small>SpO₂</small><strong id="vital-spo2">@(currentPatient.Spo2.HasValue ? $"{currentPatient.Spo2} " : "— ")<span>%</span></strong></div>
                        <div><small>Cân nặng</small><strong id="vital-weight">@(currentPatient.Weight.HasValue ? $"{currentPatient.Weight} " : "— ")<span>kg</span></strong></div>
                    </div>

                    @{
                        var hasVitals = currentPatient.Pulse.HasValue || currentPatient.BloodPressure != null || currentPatient.Temperature.HasValue || currentPatient.Weight.HasValue;
                        var isUnmeasured = currentPatient.StatusId == 3 || !hasVitals;
                        var isInProgress = currentPatient.StatusId == 5;
                    }
                    <div class="begin-exam" id="begin-exam-box" style="display:@(isInProgress ? "none" : "flex");">
                        <div>
                            <h3>@(isUnmeasured ? "Chưa đo sinh hiệu" : "Bệnh nhân đã sẵn sàng")</h3>
                            <p>@(isUnmeasured ? "Cần điều dưỡng đo sinh hiệu trước khi khám." : "Bắt đầu khám để nhập phiếu và tạo chỉ định.")</p>
                        </div>
                        <button type="button" class="btn primary" onclick="startExamNow()" @(isUnmeasured ? "disabled" : "")>
                            @await Html.PartialAsync("_AdminIcon", "stethoscope") Bắt đầu khám
                        </button>
                    </div>

                    <form id="consult-form" asp-action="CreateRecord" method="post" onsubmit="reindexClinicalServices(); reindexMedications();">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="AppointmentId" id="active-appointment-id" value="@currentPatient.AppointmentId" />

                        <fieldset id="exam-fieldset" @(isInProgress ? "" : "disabled")>
                            <div class="form-section-title">
                                <span>01</span>
                                <h3>Thăm khám & chẩn đoán</h3>
                            </div>
                            <div class="form-grid">
                                <div class="field full">
                                    <label for="allergies-input">Tiền sử dị ứng / lưu ý y khoa</label>
                                    <input id="allergies-input" name="Allergies" maxlength="500" value="@currentPatient.Allergy" placeholder="Dị ứng thuốc, thức ăn... (nếu có)" />
                                </div>
                                <div class="field full">
                                    <label for="symptoms">Triệu chứng / lý do khám *</label>
                                    <textarea id="symptoms" name="Symptoms" rows="2" placeholder="Nhập triệu chứng..." required>@currentPatient.Reason</textarea>
                                </div>
                                <div class="field full">
                                    <label for="examination">Khám lâm sàng</label>
                                    <textarea id="examination" name="ClinicalExamination" rows="2" placeholder="Tim mạch, hô hấp, tiêu hóa..."></textarea>
                                </div>
                                <div class="field">
                                    <label for="icd">Mã chẩn đoán (ICD-10)</label>
                                    <input id="icd" name="PrimaryDiagnosisCode" maxlength="20" placeholder="Ví dụ: J00" required />
                                </div>
                                <div class="field">
                                    <label for="diagnosis">Chẩn đoán chính *</label>
                                    <input id="diagnosis" name="PrimaryDiagnosisDesc" maxlength="255" placeholder="Nhập chẩn đoán chính" required />
                                </div>
                                <div class="field full">
                                    <label for="secondary">Chẩn đoán kèm theo</label>
                                    <input id="secondary" name="SecondaryDiagnosis" placeholder="Chẩn đoán phụ (nếu có)" />
                                </div>
                            </div>

                            <div class="form-section-title">
                                <span>02</span>
                                <h3>Chỉ định cận lâm sàng</h3>
                                <button type="button" class="btn text-link" onclick="addClinicalServiceRow()">+ Thêm chỉ định</button>
                            </div>
                            <div id="servicesList" style="display:none; margin-bottom:12px;"></div>
                            <p id="noServicesNotice" class="empty-note">Chưa có chỉ định cận lâm sàng.</p>

                            <div class="form-section-title">
                                <span>03</span>
                                <h3>Đơn thuốc</h3>
                                <button type="button" class="btn text-link" onclick="addMedicationRow()">+ Thêm thuốc</button>
                            </div>
                            <div id="medicationsList" style="display:none; margin-bottom:12px;"></div>
                            <p id="noMedicationsNotice" class="empty-note">Chưa kê đơn thuốc.</p>

                            <div class="form-section-title">
                                <span>04</span>
                                <h3>Kết luận & lời dặn</h3>
                            </div>
                            <div class="field full">
                                <label for="conclusion">Kết luận / hướng dẫn theo dõi</label>
                                <textarea id="conclusion" name="Conclusion" rows="2" placeholder="Hướng dẫn dùng thuốc, chế độ sinh hoạt, hẹn tái khám..."></textarea>
                            </div>
                        </fieldset>

                        <div class="clinical-actions">
                            <span>Hoàn tất sẽ tạo hóa đơn thu phí.</span>
                            <button type="submit" class="btn primary" id="btn-submit-exam" @(isInProgress ? "" : "disabled")>Hoàn tất khám</button>
                        </div>
                    </form>
                </div>
            }
            else
            {
                <div class="workspace-empty">
                    @await Html.PartialAsync("_AdminIcon", "stethoscope")
                    <h3>Không có bệnh nhân đang chờ</h3>
                    <p>Lượt khám sẽ xuất hiện sau khi nhân viên hoàn tất sinh hiệu.</p>
                </div>
            }
        </section>
    </div>
}

@section Scripts {
    <script>
        // --- QUẢN LÝ DIALOG NỔI ĐỘC LẬP (KHÔNG BỊ CHE TRẮNG MÀN HÌNH) ---
        function openAppDialog(id) {
            const dialog = document.getElementById(id);
            if (dialog) {
                dialog.classList.add('show');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeAppDialog(id) {
            const dialog = document.getElementById(id);
            if (dialog) {
                dialog.classList.remove('show');
                document.body.style.overflow = '';
            }
        }

        function handleDialogBackdropClick(event, id) {
            if (event.target === event.currentTarget) {
                closeAppDialog(id);
            }
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.app-dialog-backdrop.show').forEach(d => {
                    d.classList.remove('show');
                });
                document.body.style.overflow = '';
            }
        });

        // --- 1. XỬ LÝ KHÁM & KÊ ĐƠN ---
        // Các ô nhập của phiếu khám (ngoài ô triệu chứng được điền sẵn từ lý do khám)
        const CONSULT_FORM_FIELDS = ['examination', 'icd', 'diagnosis', 'secondary', 'conclusion'];

        function consultFormHasUserInput() {
            const symptoms = document.getElementById('symptoms');
            const autoReason = symptoms ? (symptoms.dataset.auto ?? symptoms.defaultValue) : '';
            const symptomsEdited = symptoms && symptoms.value !== autoReason;
            const othersFilled = CONSULT_FORM_FIELDS.some(fid => {
                const el = document.getElementById(fid);
                return el && el.value.trim() !== '';
            });
            const hasDynamicRows = document.querySelectorAll('#servicesList .clinical-service-item, #medicationsList .prescription-med-item').length > 0;
            return symptomsEdited || othersFilled || hasDynamicRows;
        }

        function selectConsultPatient(btn) {
            const activeIdInput = document.getElementById('active-appointment-id');
            const switching = !!activeIdInput && activeIdInput.value !== btn.getAttribute('data-id');

            // Đổi sang bệnh nhân khác: nếu bác sĩ đã nhập dở thì hỏi trước, tránh mất dữ liệu hoặc ghi nhầm sang người khác
            if (switching && consultFormHasUserInput()
                && !confirm('Phiếu khám đang nhập dở của bệnh nhân hiện tại sẽ bị xóa khi chuyển sang bệnh nhân khác. Tiếp tục?')) {
                return;
            }

            document.querySelectorAll('.consultation-person').forEach(el => el.classList.remove('active'));
            btn.classList.add('active');

            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');
            const code = btn.getAttribute('data-code');
            const age = btn.getAttribute('data-age');
            const gender = btn.getAttribute('data-gender');
            const queue = btn.getAttribute('data-queue');
            const reason = btn.getAttribute('data-reason');
            const allergy = btn.getAttribute('data-allergy');
            const pulse = btn.getAttribute('data-pulse');
            const bp = btn.getAttribute('data-bp');
            const temp = btn.getAttribute('data-temp');
            const spo2 = btn.getAttribute('data-spo2');
            const weight = btn.getAttribute('data-weight');

            const nameDisplay = document.getElementById('patient-name-display');
            const infoDisplay = document.getElementById('patient-info-display');
            const allergyDisplay = document.getElementById('patient-allergy-display');
            const reasonDisplay = document.getElementById('patient-reason-display');
            const inputId = document.getElementById('active-appointment-id');
            const symptomsField = document.getElementById('symptoms');
            const allergyInput = document.getElementById('allergies-input');

            if (nameDisplay) nameDisplay.textContent = name;
            if (infoDisplay) infoDisplay.textContent = code + ' · ' + gender + ' · ' + age + ' tuổi · ' + queue;
            if (allergyDisplay) allergyDisplay.textContent = allergy ? allergy : 'Không ghi nhận';
            if (allergyInput) allergyInput.value = allergy || '';
            if (reasonDisplay) reasonDisplay.textContent = 'Lý do khám: ' + reason;
            if (inputId) inputId.value = id;
            if (switching) {
                // Xóa phiếu của bệnh nhân trước để không lưu nhầm sang người đang chọn
                CONSULT_FORM_FIELDS.forEach(fid => {
                    const el = document.getElementById(fid);
                    if (el) el.value = '';
                });
                if (symptomsField) {
                    symptomsField.value = reason || '';
                    symptomsField.dataset.auto = reason || '';
                }
                const servicesList = document.getElementById('servicesList');
                const medicationsList = document.getElementById('medicationsList');
                if (servicesList) servicesList.innerHTML = '';
                if (medicationsList) medicationsList.innerHTML = '';
                reindexClinicalServices();
                reindexMedications();
            }

            const pulseEl = document.getElementById('vital-pulse');
            const bpEl = document.getElementById('vital-bp');
            const tempEl = document.getElementById('vital-temp');
            const spo2El = document.getElementById('vital-spo2');
            const weightEl = document.getElementById('vital-weight');

            if (pulseEl) pulseEl.innerHTML = (pulse ? pulse + ' ' : '— ') + '<span>l/p</span>';
            if (bpEl) bpEl.innerHTML = (bp ? bp + ' ' : '— ') + '<span>mmHg</span>';
            if (tempEl) tempEl.innerHTML = (temp ? temp + ' ' : '— ') + '<span>°C</span>';
            if (spo2El) spo2El.innerHTML = (spo2 ? spo2 + ' ' : '— ') + '<span>%</span>';
            if (weightEl) weightEl.innerHTML = (weight ? weight + ' ' : '— ') + '<span>kg</span>';

            const status = parseInt(btn.getAttribute('data-status') || '4');
            const fieldset = document.getElementById('exam-fieldset');
            const submitBtn = document.getElementById('btn-submit-exam');
            const banner = document.getElementById('begin-exam-box');
            const bannerTitle = banner ? banner.querySelector('h3') : null;
            const bannerDesc = banner ? banner.querySelector('p') : null;
            const btnStart = banner ? banner.querySelector('button') : null;

            const hasVitals = !!(pulse || bp || temp || weight);

            if (status === 5) {
                // Đang khám: mở sẵn form
                if (fieldset) fieldset.removeAttribute('disabled');
                if (submitBtn) {
                    submitBtn.removeAttribute('disabled');
                    submitBtn.style.cursor = 'pointer';
                }
                if (banner) banner.style.display = 'none';
            } else if (status === 3 || !hasVitals) {
                // Chưa đo sinh hiệu: Khóa form và hiển thị cảnh báo
                if (fieldset) fieldset.setAttribute('disabled', 'disabled');
                if (submitBtn) {
                    submitBtn.setAttribute('disabled', 'disabled');
                    submitBtn.style.cursor = 'not-allowed';
                }
                if (banner) {
                    banner.style.display = 'flex';
                    if (bannerTitle) {
                        bannerTitle.textContent = 'Chưa đo sinh hiệu';
                        bannerTitle.style.color = '#d97706';
                    }
                    if (bannerDesc) {
                        bannerDesc.textContent = 'Bệnh nhân cần được điều dưỡng đo sinh hiệu trước khi bắt đầu khám.';
                    }
                    if (btnStart) {
                        btnStart.setAttribute('disabled', 'disabled');
                        btnStart.style.opacity = '0.5';
                        btnStart.style.cursor = 'not-allowed';
                    }
                }
            } else {
                // Sẵn sàng khám (Status == 4 và có vitals)
                if (fieldset) fieldset.setAttribute('disabled', 'disabled');
                if (submitBtn) {
                    submitBtn.setAttribute('disabled', 'disabled');
                    submitBtn.style.cursor = 'not-allowed';
                }
                if (banner) {
                    banner.style.display = 'flex';
                    if (bannerTitle) {
                        bannerTitle.textContent = 'Bệnh nhân đã sẵn sàng';
                        bannerTitle.style.color = '#0f172a';
                    }
                    if (bannerDesc) {
                        bannerDesc.textContent = 'Bắt đầu khám để nhập phiếu và tạo chỉ định.';
                    }
                    if (btnStart) {
                        btnStart.removeAttribute('disabled');
                        btnStart.style.opacity = '1';
                        btnStart.style.cursor = 'pointer';
                    }
                }
            }
        }

        async function startExamNow() {
            const inputId = document.getElementById('active-appointment-id');
            const appointmentId = inputId ? parseInt(inputId.value) : 0;
            if (!appointmentId) return;

            const banner = document.getElementById('begin-exam-box');
            const btnStart = banner ? banner.querySelector('button') : null;
            if (btnStart) btnStart.disabled = true;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const res = await fetch('/Staff/Consultation/StartExam', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ appointmentId })
                });

                const data = await res.json();
                if (!res.ok || !data.success) {
                    alert(data.message || 'Không thể bắt đầu ca khám.');
                    if (btnStart) btnStart.disabled = false;
                    return;
                }

                const fieldset = document.getElementById('exam-fieldset');
                const submitBtn = document.getElementById('btn-submit-exam');

                if (fieldset) fieldset.removeAttribute('disabled');
                if (submitBtn) {
                    submitBtn.removeAttribute('disabled');
                    submitBtn.style.cursor = 'pointer';
                }
                if (banner) banner.style.display = 'none';

                // Cập nhật badge người bệnh đang chọn
                const activeBtn = document.querySelector('.consultation-person.active');
                if (activeBtn) {
                    activeBtn.setAttribute('data-status', '5');
                    const badge = activeBtn.querySelector('.queue-status-badge');
                    if (badge) {
                        badge.textContent = 'Đang khám';
                        badge.style.background = '#dcfce7';
                        badge.style.color = '#166534';
                    }
                }
            } catch (err) {
                alert('Lỗi kết nối máy chủ: ' + err.message);
                if (btnStart) btnStart.disabled = false;
            }
        }

        // --- 2. XỬ LÝ LỌC CHECKBOX VÀ XEM KẾT QUẢ XÉT NGHIỆM (LABS) ---
        function toggleLabFilter(clicked) {
            const chkAll = document.getElementById('chk-lab-all');
            const chkPending = document.getElementById('chk-lab-pending');
            const chkCompleted = document.getElementById('chk-lab-completed');

            if (clicked === 'all') {
                if (chkAll.checked) {
                    chkPending.checked = false;
                    chkCompleted.checked = false;
                } else {
                    chkAll.checked = true;
                }
            } else {
                chkAll.checked = false;
                // Nếu cả 2 cùng được tích -> chuyển về Tất cả
                if (chkPending.checked && chkCompleted.checked) {
                    chkAll.checked = true;
                    chkPending.checked = false;
                    chkCompleted.checked = false;
                } else if (!chkPending.checked && !chkCompleted.checked) {
                    // Nếu không chọn cái nào -> chuyển về Tất cả
                    chkAll.checked = true;
                }
            }

            filterLabTable();
        }

        function filterLabTable() {
            const chkAll = document.getElementById('chk-lab-all')?.checked;
            const chkPending = document.getElementById('chk-lab-pending')?.checked;
            const chkCompleted = document.getElementById('chk-lab-completed')?.checked;
            const searchKeyword = (document.getElementById('search-lab-input')?.value || '').toLowerCase().trim();

            const rows = document.querySelectorAll('.lab-row');
            rows.forEach(row => {
                const status = row.getAttribute('data-status');
                const name = row.getAttribute('data-name') || '';

                let statusMatch = false;
                if (chkAll) {
                    statusMatch = true;
                } else if (chkPending && status === 'PENDING') {
                    statusMatch = true;
                } else if (chkCompleted && status === 'COMPLETED') {
                    statusMatch = true;
                }

                const searchMatch = !searchKeyword || name.includes(searchKeyword);

                if (statusMatch && searchMatch) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function openLabResultModalFromBtn(btn) {
            const d = btn.dataset;
            document.getElementById('dialog-lab-patient').textContent = `Người khám: ${d.patient} (${d.code} · ${d.age} tuổi)`;
            document.getElementById('dialog-lab-service').textContent = d.service;
            document.getElementById('dialog-lab-time').textContent = d.time;
            document.getElementById('dialog-lab-status').textContent = d.status;
            document.getElementById('dialog-lab-result-text').textContent = d.result;

            openAppDialog('labResultDialog');
        }

        // --- 3. XỬ LÝ TÌM KIẾM & XEM PHIẾU BỆNH ÁN (RECORDS) ---
        function filterRecordTable() {
            const keyword = (document.getElementById('search-record-input')?.value || '').toLowerCase().trim();
            const rows = document.querySelectorAll('.record-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.getAttribute('data-text') || '';
                if (!keyword || text.includes(keyword)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const countBadge = document.getElementById('record-count-badge');
            if (countBadge) {
                countBadge.textContent = visibleCount + ' phiếu khám';
            }
        }

        function openRecordModalFromBtn(btn) {
            const d = btn.dataset;
            document.getElementById('dialog-record-header-sub').textContent = `Mã hồ sơ: #BA-${d.id} | Lượt hẹn: ${d.code}`;
            document.getElementById('dialog-record-patient').textContent = d.patient;
            document.getElementById('dialog-record-date').textContent = d.date;
            document.getElementById('dialog-record-age-gender').textContent = `${d.age} tuổi · ${d.gender}`;
            document.getElementById('dialog-record-doctor').textContent = d.doctor;
            document.getElementById('dialog-record-dept').textContent = d.dept;
            document.getElementById('dialog-record-code').textContent = d.code;

            document.getElementById('dialog-record-symptoms').textContent = d.symptoms;
            document.getElementById('dialog-record-exam').textContent = d.exam;
            document.getElementById('dialog-record-icd').textContent = d.icd;
            document.getElementById('dialog-record-diagnosis').textContent = d.diagnosis;
            document.getElementById('dialog-record-conclusion').textContent = d.conclusion;

            openAppDialog('recordDetailDialog');
        }

        // --- 4. XỬ LÝ LỌC CHECKBOX CHO NGHỈ / ĐỔI CA (EXCEPTIONS) ---
        function toggleExcFilter(clicked) {
            const chkAll = document.getElementById('chk-exc-all');
            const chkPending = document.getElementById('chk-exc-pending');
            const chkApproved = document.getElementById('chk-exc-approved');
            const chkRejected = document.getElementById('chk-exc-rejected');

            if (clicked === 'all') {
                if (chkAll.checked) {
                    chkPending.checked = false;
                    chkApproved.checked = false;
                    chkRejected.checked = false;
                } else {
                    chkAll.checked = true;
                }
            } else {
                chkAll.checked = false;
                const totalActive = (chkPending.checked ? 1 : 0) + (chkApproved.checked ? 1 : 0) + (chkRejected.checked ? 1 : 0);
                if (totalActive === 3 || totalActive === 0) {
                    chkAll.checked = true;
                    chkPending.checked = false;
                    chkApproved.checked = false;
                    chkRejected.checked = false;
                }
            }

            filterExcTable();
        }

        function filterExcTable() {
            const chkAll = document.getElementById('chk-exc-all')?.checked;
            const chkPending = document.getElementById('chk-exc-pending')?.checked;
            const chkApproved = document.getElementById('chk-exc-approved')?.checked;
            const chkRejected = document.getElementById('chk-exc-rejected')?.checked;

            const rows = document.querySelectorAll('.exc-row');
            rows.forEach(row => {
                const status = row.getAttribute('data-status');
                let match = false;
                if (chkAll) {
                    match = true;
                } else if (chkPending && status === 'PENDING') {
                    match = true;
                } else if (chkApproved && status === 'APPROVED') {
                    match = true;
                } else if (chkRejected && status === 'REJECTED') {
                    match = true;
                }

                row.style.display = match ? '' : 'none';
            });
        }

        // --- 5. ĐỔI CA / THAY THẾ BÁC SĨ ---
        function toggleReplacementDoctorField() {
            const typeSel = document.getElementById('sel-exception-type');
            const group = document.getElementById('replacement-doctor-group');
            const repSel = document.getElementById('sel-replacement-doctor');
            if (!typeSel || !group) return;
            if (typeSel.value === '@ScheduleExceptionType.ShiftSwap') {
                group.style.display = 'block';
                if (repSel) repSel.required = true;
            } else {
                group.style.display = 'none';
                if (repSel) {
                    repSel.required = false;
                    repSel.value = '';
                }
            }
        }

        // --- 6. ĐIỀU HƯỚNG TUẦN TRỰC BÁC SĨ ---
        function changeWeek(delta) {
            const url = new URL(window.location.href);
            let offset = parseInt(url.searchParams.get('weekOffset') || '0', 10);
            offset += delta;
            url.searchParams.set('tab', 'schedule');
            url.searchParams.set('weekOffset', offset);
            window.location.href = url.toString();
        }
        function resetWeek() {
            const url = new URL(window.location.href);
            url.searchParams.set('tab', 'schedule');
            url.searchParams.delete('weekOffset');
            window.location.href = url.toString();
        }

        // --- 7. TAB CON LỊCH LÀM VIỆC / ĐĂNG KÝ CA KHÁM ---
        function switchConsultPane(name) {
            document.querySelectorAll('.sched-subtabs [data-consult-pane]').forEach(btn => {
                const active = btn.dataset.consultPane === name;
                btn.classList.toggle('is-active', active);
                btn.setAttribute('aria-selected', active ? 'true' : 'false');
            });
            const week = document.getElementById('consult-pane-week');
            const bidding = document.getElementById('consult-pane-bidding');
            if (week) week.hidden = name !== 'week';
            if (bidding) bidding.hidden = name !== 'bidding';
            try { sessionStorage.setItem('consult-pane', name); } catch (e) { }
        }

        (function () {
            if (!document.getElementById('consult-pane-week')) return;
            let saved = null;
            try { saved = sessionStorage.getItem('consult-pane'); } catch (e) { }
            switchConsultPane(saved === 'bidding' ? 'bidding' : 'week');
        })();

        // --- 8. MODAL ĐĂNG KÝ CA KHÁM (SHIFT BIDDING) ---
        function openShiftBidModal(periodId, workDate, shift, label) {
            const pidInput = document.getElementById('bidModalPeriodId');
            const wdInput = document.getElementById('bidModalWorkDate');
            const shiftInput = document.getElementById('bidModalShift');
            const lbl = document.getElementById('bidModalLabel');
            if (pidInput) pidInput.value = periodId;
            if (wdInput) wdInput.value = workDate;
            if (shiftInput) shiftInput.value = shift;
            if (lbl) lbl.innerText = label;
            openAppDialog('shiftBidDialog');
        }

        // --- 9. CHỈ ĐỊNH CẬN LÂM SÀNG & ĐƠN THUỐC ĐỘNG TỪ DATABASE ---
        const dbServices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableServices));
        const dbMedications = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableMedications));

        function buildDynamicSelect(className, placeholder, items, formatLabel) {
            const select = document.createElement('select');
            select.className = className;
            select.required = true;
            const defaultOpt = document.createElement('option');
            defaultOpt.value = '';
            defaultOpt.textContent = placeholder;
            select.appendChild(defaultOpt);
            if (Array.isArray(items)) {
                items.forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item.Id;
                    opt.textContent = formatLabel(item);
                    select.appendChild(opt);
                });
            }
            return select;
        }

        function createRemoveRowButton(onRemove) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn ghost sm dynamic-row-remove';
            btn.textContent = '✕';
            btn.title = 'Xóa dòng';
            btn.addEventListener('click', () => {
                btn.parentElement.remove();
                onRemove();
            });
            return btn;
        }

        function addClinicalServiceRow() {
            const list = document.getElementById('servicesList');
            const notice = document.getElementById('noServicesNotice');
            if (!list) return;
            list.style.display = 'block';
            if (notice) notice.style.display = 'none';

            const row = document.createElement('div');
            row.className = 'clinical-service-item dynamic-row';

            const select = buildDynamicSelect(
                'form-control clinical-service-select dynamic-row-field',
                '-- Chọn dịch vụ cận lâm sàng --',
                dbServices,
                s => `${s.Name} (${Number(s.Price).toLocaleString('vi-VN')} đ)`
            );

            const note = document.createElement('input');
            note.type = 'text';
            note.className = 'clinical-service-note dynamic-row-field';
            note.placeholder = 'Ghi chú lâm sàng...';

            row.append(select, note, createRemoveRowButton(reindexClinicalServices));
            list.appendChild(row);
            reindexClinicalServices();
        }

        function reindexClinicalServices() {
            const list = document.getElementById('servicesList');
            const notice = document.getElementById('noServicesNotice');
            if (!list) return;
            const rows = list.querySelectorAll('.clinical-service-item');
            if (rows.length === 0) {
                list.style.display = 'none';
                if (notice) notice.style.display = 'block';
                return;
            }
            rows.forEach((row, idx) => {
                const select = row.querySelector('.clinical-service-select');
                const note = row.querySelector('.clinical-service-note');
                if (select) select.name = `LabOrders[${idx}].ServiceId`;
                if (note) note.name = `LabOrders[${idx}].Note`;
            });
        }

        function addMedicationRow() {
            const list = document.getElementById('medicationsList');
            const notice = document.getElementById('noMedicationsNotice');
            if (!list) return;
            list.style.display = 'block';
            if (notice) notice.style.display = 'none';

            const row = document.createElement('div');
            row.className = 'prescription-med-item dynamic-row';

            const select = buildDynamicSelect(
                'form-control med-item-select dynamic-row-field wide',
                '-- Chọn thuốc trong danh mục dược --',
                dbMedications,
                m => `${m.Name} (${m.Unit}) - ${Number(m.Price).toLocaleString('vi-VN')} đ`
            );

            const qty = document.createElement('input');
            qty.type = 'number';
            qty.min = '1';
            qty.value = '10';
            qty.required = true;
            qty.className = 'form-control med-item-qty dynamic-row-qty';
            qty.placeholder = 'Số lượng';

            const dosage = document.createElement('input');
            dosage.type = 'text';
            dosage.className = 'med-item-dosage dynamic-row-field wide';
            dosage.placeholder = 'Liều dùng (vd: 2 viên/ngày chia 2 lần sau ăn)...';

            row.append(select, qty, dosage, createRemoveRowButton(reindexMedications));
            list.appendChild(row);
            reindexMedications();
        }

        function reindexMedications() {
            const list = document.getElementById('medicationsList');
            const notice = document.getElementById('noMedicationsNotice');
            if (!list) return;
            const rows = list.querySelectorAll('.prescription-med-item');
            if (rows.length === 0) {
                list.style.display = 'none';
                if (notice) notice.style.display = 'block';
                return;
            }
            rows.forEach((row, idx) => {
                const select = row.querySelector('.med-item-select');
                const qty = row.querySelector('.med-item-qty');
                const dosage = row.querySelector('.med-item-dosage');
                if (select) select.name = `PrescriptionItems[${idx}].MedicationId`;
                if (qty) qty.name = `PrescriptionItems[${idx}].Quantity`;
                if (dosage) dosage.name = `PrescriptionItems[${idx}].Dosage`;
            });
        }
    </script>
}
