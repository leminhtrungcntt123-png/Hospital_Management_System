@model IReadOnlyList<HIS.BLL.DTOs.DepositDto>
@inject Microsoft.Extensions.Options.IOptions<HIS.BLL.Options.BillingOptions> BillingOptionsAccessor
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Quản lý tạm ứng viện phí";
    var shift = ViewBag.CurrentShift as HIS.BLL.DTOs.CashierShiftDto;
    var status = ViewBag.Status as HIS.Domain.DepositStatus?;
    var method = ViewBag.Method as HIS.Domain.PaymentMethod?;
    string search = (ViewBag.Search as string) ?? "";
    int? patientId = ViewBag.PatientId as int?;
    var totals = ViewBag.Totals as HIS.BLL.DTOs.DepositSummaryTotalsDto;
    var totalCount = totals?.TotalCount ?? Model.Count;
    var totalAmount = totals?.TotalAmount ?? Model.Sum(m => m.Amount);
    var totalUsed = totals?.TotalUsed ?? Model.Sum(m => m.UsedAmount);
    var totalBalance = totals?.TotalBalance ?? Model.Sum(m => m.Balance);
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff-cashier.css" asp-append-version="true" />
}

<div id="anti-forgery-token-holder" style="display: none;">
    @Html.AntiForgeryToken()
</div>

<div class="cashier-page">
    <div class="page-heading">
        <div>
            <span class="eyebrow">TÀI CHÍNH KẾ TOÁN</span>
            <h1>Quản lý tạm ứng</h1>
        </div>

        <div class="heading-actions">
            @if (shift != null)
            {
                <div class="shift-pill open">
                    <span class="shift-dot"></span>
                    <span>Ca từ @shift.OpenedAt.ToString("HH:mm")</span>
                </div>
            }
            else
            {
                <div class="shift-pill closed">
                    <span class="shift-dot"></span>
                    <span>Chưa mở ca</span>
                </div>
            }

            <button type="button" class="btn primary" onclick="handleCreateDepositClick()">
                + Thu tạm ứng
            </button>
            <a class="btn outline" asp-action="Deposits">
                @await Html.PartialAsync("_AdminIcon", "refresh") Làm mới
            </a>
        </div>
    </div>

    @if (shift == null)
    {
        <div class="flash-banner warn">
            <div class="flash-left">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                <span><strong>Chưa mở ca thu ngân:</strong> Bạn cần mở ca làm việc tại Quầy thu ngân trước khi thực hiện thu tạm ứng cho bệnh nhân.</span>
            </div>
            <a class="btn primary sm" asp-action="Index">Đến Quầy thu ngân mở ca</a>
        </div>
    }

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="flash-banner ok">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>@success</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="flash-banner err">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@error</span>
        </div>
    }

    <div class="kpi-grid">
        <article class="card stat-card">
            <span class="stat-icon">@await Html.PartialAsync("_AdminIcon", "clipboard")</span>
            <div class="stat-body">
                <span class="stat-label">Tổng số phiếu</span>
                <strong>@totalCount</strong>
            </div>
        </article>
        <article class="card stat-card">
            <span class="stat-icon">@await Html.PartialAsync("_AdminIcon", "wallet")</span>
            <div class="stat-body">
                <span class="stat-label">Tổng đã thu</span>
                <strong>@totalAmount.ToString("N0") đ</strong>
            </div>
        </article>
        <article class="card stat-card">
            <span class="stat-icon">@await Html.PartialAsync("_AdminIcon", "wallet")</span>
            <div class="stat-body">
                <span class="stat-label">Đã khấu trừ</span>
                <strong>@totalUsed.ToString("N0") đ</strong>
            </div>
        </article>
        <article class="card stat-card">
            <span class="stat-icon">@await Html.PartialAsync("_AdminIcon", "wallet")</span>
            <div class="stat-body">
                <span class="stat-label">Đang tồn quỹ</span>
                <strong class="num-pos">@totalBalance.ToString("N0") đ</strong>
            </div>
        </article>
    </div>

    <section class="card">
        <div class="card-body">
            <form asp-action="Deposits" method="get" class="filter-bar">
                <div class="filter-field grow">
                    <label for="dep-filter-search">Tìm kiếm</label>
                    <input id="dep-filter-search" type="text" name="search" value="@search"
                           placeholder="Mã BN, CCCD, họ tên, SĐT, mã phiếu..." />
                </div>
                <div class="filter-field">
                    <label for="dep-filter-method">Hình thức</label>
                    <select id="dep-filter-method" name="method">
                        <option value="">Tất cả</option>
                        <option value="1" selected="@(method == HIS.Domain.PaymentMethod.BankTransfer)">Chuyển khoản</option>
                        <option value="0" selected="@(method == HIS.Domain.PaymentMethod.Cash)">Tiền mặt</option>
                    </select>
                </div>
                <div class="filter-field">
                    <label for="dep-filter-status">Trạng thái</label>
                    <select id="dep-filter-status" name="status">
                        <option value="">Tất cả</option>
                        <option value="0" selected="@(status == HIS.Domain.DepositStatus.Active)">Đang tồn quỹ</option>
                        <option value="1" selected="@(status == HIS.Domain.DepositStatus.Depleted)">Đã cấn trừ</option>
                        <option value="2" selected="@(status == HIS.Domain.DepositStatus.Refunded)">Đã hoàn trả</option>
                    </select>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn primary">Lọc</button>
                    @if (!string.IsNullOrWhiteSpace(search) || method.HasValue || status.HasValue)
                    {
                        <a asp-action="Deposits" class="btn outline">Xóa lọc</a>
                    }
                </div>
            </form>
        </div>
    </section>

    <section class="card">
        <div class="card-header">
            <h2>Danh sách phiếu tạm ứng (@Model.Count)</h2>
        </div>
        <div class="table-wrap">
            <table class="cashier-table">
                <thead>
                    <tr>
                        <th>Mã phiếu</th>
                        <th>Bệnh nhân</th>
                        <th>Mục đích</th>
                        <th>Người duyệt</th>
                        <th class="center">Hình thức</th>
                        <th class="right">Tạm ứng</th>
                        <th class="right">Còn lại</th>
                        <th class="center">Trạng thái</th>
                        <th class="center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="center" style="padding: 36px 16px; color: #64748b;">
                                Không tìm thấy phiếu tạm ứng phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="mono">
                                    <strong>@item.DepositCode</strong><br />
                                    <small>@item.CreatedAt.ToString("dd/MM HH:mm")</small>
                                </td>
                                <td>
                                    <strong>@item.PatientName</strong><br />
                                    <small>@item.PatientCode · @item.PhoneNumber</small>
                                </td>
                                <td>
                                    @(item.Purpose ?? "Tạm ứng viện phí")
                                    @if (!string.IsNullOrWhiteSpace(item.ReferenceCode))
                                    {
                                        <br /><small class="mono">Ref: @item.ReferenceCode</small>
                                    }
                                </td>
                                <td>
                                    <strong class="num-pos">@(string.IsNullOrWhiteSpace(item.ApprovedBy) ? "BS. Phạm Thu Hằng" : item.ApprovedBy)</strong><br />
                                    <small>Thu ngân: @(item.CashierName ?? "Thu ngân")</small>
                                </td>
                                <td class="center">
                                    @if (item.PaymentMethod == HIS.Domain.PaymentMethod.Cash)
                                    {
                                        <span class="status-badge muted">Tiền mặt</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge ok">Chuyển khoản</span>
                                    }
                                </td>
                                <td class="right mono">
                                    <strong>@item.Amount.ToString("N0") đ</strong>
                                    @if (item.UsedAmount > 0)
                                    {
                                        <br /><small>Trừ: @item.UsedAmount.ToString("N0") đ</small>
                                    }
                                </td>
                                <td class="right mono num-pos"><strong>@item.Balance.ToString("N0") đ</strong></td>
                                <td class="center">
                                    @if (item.Status == HIS.Domain.DepositStatus.Active)
                                    {
                                        <span class="status-badge ok">Đang tồn quỹ</span>
                                    }
                                    else if (item.Status == HIS.Domain.DepositStatus.Depleted)
                                    {
                                        <span class="status-badge muted">Đã cấn trừ hết</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge danger">Đã hoàn tiền mặt</span>
                                        @if (item.RefundedAmount > 0)
                                        {
                                            <br /><small class="num-neg">Hoàn: @item.RefundedAmount.ToString("N0") đ</small>
                                        }
                                    }
                                </td>
                                <td class="center">
                                    <div style="display: inline-flex; gap: 6px; align-items: center; justify-content: center; flex-wrap: wrap;">
                                        <button type="button" class="btn outline sm"
                                                data-code="@item.DepositCode"
                                                data-patient-name="@item.PatientName"
                                                data-patient-code="@item.PatientCode"
                                                data-national-id="@(item.NationalId ?? "")"
                                                data-phone="@(item.PhoneNumber ?? "")"
                                                data-app-code="@(item.AppointmentCode ?? "")"
                                                data-amount="@item.Amount"
                                                data-method="@((int)item.PaymentMethod)"
                                                data-ref="@(item.ReferenceCode ?? "")"
                                                data-purpose="@(item.Purpose ?? "Tạm ứng viện phí")"
                                                data-approved-by="@(item.ApprovedBy ?? "BS. Phạm Thu Hằng")"
                                                data-cashier="@item.CashierName"
                                                data-created="@item.CreatedAt.ToString("O")"
                                                onclick="reprintDepositFromBtn(this)">
                                            In phiếu
                                        </button>
                                        @if (item.Status == HIS.Domain.DepositStatus.Active && item.Balance > 0)
                                        {
                                            if (shift != null)
                                            {
                                                <button type="button" class="btn outline sm"
                                                        style="color: #b91c1c; border-color: #fca5a5;"
                                                        onclick="handleRefundDeposit(@item.Id, '@item.DepositCode', '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.PatientName)', @item.Balance)">
                                                    Hoàn tiền
                                                </button>
                                            }
                                            else
                                            {
                                                <small>Chưa mở ca</small>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<dialog id="modal-create-deposit" class="staff-dialog lg">
    <div class="staff-dialog-header">
        <h3>Lập phiếu thu tạm ứng viện phí</h3>
        <button type="button" class="staff-dialog-close" onclick="document.getElementById('modal-create-deposit').close()" aria-label="Đóng">&times;</button>
    </div>

    <div class="staff-dialog-body">
        <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 14px; margin-bottom: 14px;">
            <label for="dep-search-input" style="display: block; margin-bottom: 6px;">
                1. Tra cứu &amp; đối chiếu hồ sơ bệnh nhân *
            </label>

            <div id="dep-search-box-container">
                <div style="display: flex; gap: 8px;">
                    <input type="text" id="dep-search-input"
                           placeholder="Gõ Mã BN (00000001), CCCD, SĐT hoặc Họ tên..."
                           style="flex: 1; height: 36px; padding: 0 12px;"
                           onkeydown="if(event.key==='Enter'){event.preventDefault();searchPatientForDeposit();}" />
                    <button type="button" class="btn primary" onclick="searchPatientForDeposit()">
                        @await Html.PartialAsync("_AdminIcon", "search") Tìm hồ sơ
                    </button>
                </div>
                <div id="dep-search-status" style="font-size: 12px; color: #64748b; margin-top: 6px; display: none;"></div>
                <div id="dep-search-results-list" style="margin-top: 10px; max-height: 220px; overflow-y: auto; display: none; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff;"></div>
            </div>

            <div id="dep-selected-patient-card" style="display: none; background: #f0fdf4; border: 1px solid #86efac; border-radius: 8px; padding: 12px 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span class="status-badge ok">Hồ sơ bệnh nhân đã xác thực</span>
                    <button type="button" class="btn outline sm" onclick="resetSelectedPatientForDeposit()">
                        @await Html.PartialAsync("_AdminIcon", "refresh") Đổi bệnh nhân
                    </button>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px; font-size: 12.5px;">
                    <div>Họ và tên: <strong id="dep-card-name"></strong></div>
                    <div>Mã BN: <strong id="dep-card-code" class="mono"></strong></div>
                    <div>CCCD: <strong id="dep-card-cccd" class="num-pos"></strong></div>
                    <div>Ngày sinh: <span id="dep-card-dob"></span> (<span id="dep-card-age"></span> tuổi) - <span id="dep-card-gender"></span></div>
                    <div style="grid-column: span 2;">SĐT: <strong id="dep-card-phone"></strong> · Địa chỉ: <span id="dep-card-address"></span></div>
                    <div id="dep-card-app-box" style="grid-column: span 2; display: none; background: #ffffff; padding: 6px 10px; border-radius: 6px; font-size: 12px; border: 1px solid #bbf7d0;">
                        Lượt khám liên kết: <strong id="dep-card-app-code"></strong> - <span id="dep-card-app-dept"></span>
                    </div>
                </div>
            </div>
            <input type="hidden" id="dep-patient-id" value="" />
            <input type="hidden" id="dep-appointment-id" value="" />
        </div>

        <!-- Bước 2: Thông tin tạm ứng -->
        <div style="margin-bottom: 12px;">
            <label for="dep-amount" style="display: block; margin-bottom: 4px;">2. Số tiền tạm ứng (VNĐ) *</label>
            <input type="number" id="dep-amount" min="10000" step="50000" placeholder="VD: 2000000" style="width: 100%; height: 38px; padding: 0 12px; font-weight: 700; color: #107c41;" oninput="refreshDepositQrIfTransfer()" required />
            <div style="display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap;">
                <button type="button" class="btn outline sm" onclick="setDepositAmount(500000)">+500.000 đ</button>
                <button type="button" class="btn outline sm" onclick="setDepositAmount(1000000)">+1.000.000 đ</button>
                <button type="button" class="btn outline sm" onclick="setDepositAmount(2000000)">+2.000.000 đ</button>
                <button type="button" class="btn outline sm" onclick="setDepositAmount(5000000)">+5.000.000 đ</button>
                <button type="button" class="btn outline sm" onclick="setDepositAmount(10000000)">+10.000.000 đ</button>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
            <div>
                <label for="dep-approved-by" style="display: block; margin-bottom: 4px;">Người duyệt / Bác sĩ chỉ định *</label>
                <input type="text" id="dep-approved-by" list="dep-approved-by-suggestions" value="" placeholder="Nhập tên BS chỉ định / Người duyệt..." style="width: 100%; height: 36px; padding: 0 12px;" required />
                <datalist id="dep-approved-by-suggestions">
                    <option value="BS. Phạm Thu Hằng (Khoa Nội tổng quát)" />
                    <option value="BS. Nguyễn Hoàng Nam (Khoa Ngoại tổng quát)" />
                    <option value="BS. Trần Minh Đức (Khoa Cấp cứu)" />
                    <option value="Trưởng ca thu ngân" />
                </datalist>
            </div>
            <div>
                <label for="dep-method" style="display: block; margin-bottom: 4px;">Hình thức thu tiền *</label>
                <select id="dep-method" style="width: 100%; height: 36px; padding: 0 10px;" onchange="toggleDepRefCode()">
                    <option value="0">Tiền mặt</option>
                    <option value="1">Chuyển khoản ngân hàng (VietQR)</option>
                </select>
            </div>
        </div>

        <div style="margin-bottom: 12px;">
            <label for="dep-purpose" style="display: block; margin-bottom: 4px;">Mục đích tạm ứng</label>
            <input type="text" id="dep-purpose" list="dep-purpose-suggestions" placeholder="VD: Tạm ứng viện phí..." style="width: 100%; height: 36px; padding: 0 12px;" />
            <datalist id="dep-purpose-suggestions">
                <option value="Tạm ứng nhập viện điều trị" />
                <option value="Tạm ứng phẫu thuật - thủ thuật" />
                <option value="Tạm ứng xét nghiệm / CLS kỹ thuật cao" />
                <option value="Tạm ứng viện phí tổng quát" />
            </datalist>
        </div>

        <div id="dep-vietqr-panel" class="vietqr-panel" style="display: none;">
            <div style="font-size: 12px; font-weight: 700; color: #107c41; text-transform: uppercase; margin-bottom: 10px;">
                Quét mã VietQR chuyển khoản (Napas 247)
            </div>

            <div id="dep-qr-prompt" class="flash-banner warn" style="display: none; margin-bottom: 0;">
                <span>Vui lòng chọn hồ sơ bệnh nhân và nhập số tiền tạm ứng lớn hơn 0 đ để tạo mã VietQR động.</span>
            </div>

            <div id="dep-qr-content" style="display: none;">
                <div style="display: flex; gap: 16px; align-items: center; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px;">
                    <div style="text-align: center; flex-shrink: 0;">
                        <img id="dep-qr-img" src="" alt="Mã VietQR Tạm ứng" style="width: 150px; height: 150px; border: 1px solid #e2e8f0; border-radius: 6px;" />
                        <div style="font-size: 11px; color: #64748b; margin-top: 3px;">Quét bằng app ngân hàng</div>
                    </div>
                    <div style="flex: 1; font-size: 12.5px; color: #334155; line-height: 1.6;">
                        <div style="font-weight: 700; color: #0f172a; font-size: 13.5px;" id="dep-qr-bank">Ngân hàng: VietinBank (970415)</div>
                        <div>
                            Số tài khoản: <strong id="dep-qr-acc" class="mono">119002953584</strong>
                            <button type="button" class="btn outline sm" style="margin-left: 6px;" onclick="copyText(document.getElementById('dep-qr-acc').innerText)">Sao chép</button>
                        </div>
                        <div>Chủ TK: <strong id="dep-qr-holder">BENH VIEN MEDICARE</strong></div>
                        <div>
                            Số tiền: <strong id="dep-qr-amount-text" class="num-pos">0 đ</strong>
                            <button type="button" class="btn outline sm" style="margin-left: 6px;" onclick="copyText(document.getElementById('dep-amount').value)">Sao chép</button>
                        </div>
                        <div>
                            Nội dung: <strong id="dep-qr-msg" class="mono num-neg">TU...</strong>
                            <button type="button" class="btn outline sm" style="margin-left: 6px;" onclick="copyText(document.getElementById('dep-qr-msg').innerText)">Sao chép</button>
                        </div>
                    </div>
                </div>

                <div style="margin-top: 10px;">
                    <label for="dep-ref" style="display: block; margin-bottom: 4px;">Mã chuẩn chi / Giao dịch ngân hàng (Bắt buộc khi CK) *</label>
                    <input type="text" id="dep-ref" placeholder="Nhập mã chuẩn chi từ thông báo biến động số dư / app ngân hàng..." style="width: 100%; height: 36px; padding: 0 12px;" />
                </div>
            </div>
        </div>

        <div>
            <label for="dep-note" style="display: block; margin-bottom: 4px;">Ghi chú</label>
            <input type="text" id="dep-note" placeholder="Ghi chú thêm (người nộp hộ, cam kết,...)" style="width: 100%; height: 36px; padding: 0 12px;" />
        </div>
    </div>

    <div class="staff-dialog-footer">
        <button type="button" class="btn outline" onclick="document.getElementById('modal-create-deposit').close()">Hủy bỏ</button>
        <button type="button" class="btn primary" id="btn-submit-deposit" onclick="submitCreateDeposit()">
            Xác nhận thu tạm ứng
        </button>
    </div>
</dialog>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var isShiftOpen = @(shift != null ? "true" : "false");
        var depositQrSeq = 0;

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        async function handleCreateDepositClick() {
            if (!isShiftOpen) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Chưa mở ca thu ngân',
                    text: 'Vui lòng mở ca thu ngân tại quầy trước khi thu tạm ứng.',
                    confirmButtonText: 'Đến quầy mở ca',
                    confirmButtonColor: '#15803d'
                });
                window.location.href = '@Url.Action("Index", "Cashier", new { area = "Staff" })';
                return;
            }
            resetSelectedPatientForDeposit();
            document.getElementById('dep-search-input').value = '';
            document.getElementById('dep-amount').value = '';
            document.getElementById('dep-method').value = '0';
            document.getElementById('dep-approved-by').value = '';
            toggleDepRefCode();
            document.getElementById('dep-purpose').value = 'Tạm ứng viện phí điều trị';
            document.getElementById('dep-ref').value = '';
            document.getElementById('dep-note').value = '';

            document.getElementById('modal-create-deposit').showModal();
            setTimeout(() => document.getElementById('dep-search-input')?.focus(), 150);
        }

        async function searchPatientForDeposit() {
            var input = document.getElementById('dep-search-input');
            var status = document.getElementById('dep-search-status');
            var resultsBox = document.getElementById('dep-search-results-list');
            var term = input.value.trim();

            if (!term) {
                status.style.display = 'block';
                status.innerHTML = '<span style="color: #b91c1c;">Vui lòng nhập Mã BN, CCCD, SĐT hoặc Họ tên để tìm kiếm.</span>';
                resultsBox.style.display = 'none';
                input.focus();
                return;
            }

            status.style.display = 'block';
            status.innerHTML = '<span style="color: #15803d;">⏳ Đang tìm kiếm hồ sơ người bệnh...</span>';
            resultsBox.style.display = 'none';

            try {
                var url = '@Url.Action("SearchPatients", "Cashier", new { area = "Staff" })?term=' + encodeURIComponent(term);
                var res = await fetch(url);
                if (!res.ok) throw new Error('Không thể tải dữ liệu tìm kiếm.');
                var list = await res.json();

                if (!list || list.length === 0) {
                    status.innerHTML = '<span style="color: #b91c1c;">Không tìm thấy hồ sơ người bệnh nào khớp với từ khóa "<strong>' + escapeHtml(term) + '</strong>".</span>';
                    resultsBox.style.display = 'none';
                    return;
                }

                status.innerHTML = '<span style="color: #15803d;">Tìm thấy <strong>' + list.length + '</strong> hồ sơ phù hợp. Bấm "Chọn" để đối chiếu:</span>';
                resultsBox.innerHTML = '';

                list.forEach(p => {
                    var item = document.createElement('div');
                    item.style.cssText = 'padding: 10px 12px; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; cursor: pointer; transition: background 0.15s;';
