            </label>
            <input type="text" id="dep-approved-by" class="form-control" list="dep-approved-by-suggestions" value="" placeholder="Nhập tên BS chỉ định / Người duyệt..." style="width: 100%; padding: 8px 12px; font-size: 13px; font-weight: 600; color: #0369a1;" required />
            <datalist id="dep-approved-by-suggestions">
                <option value="BS. Phạm Thu Hằng (Khoa Nội tổng quát)" />
                <option value="BS. Nguyễn Hoàng Nam (Khoa Ngoại tổng quát)" />
                <option value="BS. Trần Minh Đức (Khoa Cấp cứu)" />
