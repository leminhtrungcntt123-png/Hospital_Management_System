        async function submitCreateDeposit() {
            var patientId = parseInt(document.getElementById('dep-patient-id').value);
            var amount = parseFloat(document.getElementById('dep-amount').value);
            var method = parseInt(document.getElementById('dep-method').value);
            var approvedBy = document.getElementById('dep-approved-by')?.value?.trim() || '';
            var purpose = document.getElementById('dep-purpose').value.trim();
            var ref = document.getElementById('dep-ref')?.value?.trim() || '';
            var note = document.getElementById('dep-note').value.trim();
            var appointmentId = parseInt(document.getElementById('dep-appointment-id').value) || null;

            if (!patientId || isNaN(patientId) || patientId <= 0) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Chưa chọn bệnh nhân',
                    text: 'Vui lòng tra cứu và bấm chọn hồ sơ bệnh nhân để đối chiếu trước khi thu tiền.',
                    confirmButtonColor: '#15803d'
                });
                resetSelectedPatientForDeposit();
                return;
            }
            if (!amount || amount <= 0) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Số tiền không hợp lệ',
                    text: 'Số tiền tạm ứng phải lớn hơn 0 đ.',
                    confirmButtonColor: '#15803d'
                });
                document.getElementById('dep-amount')?.focus();
                return;
            }
            if (!approvedBy) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Thiếu thông tin người duyệt',
                    text: 'Vui lòng nhập tên Bác sĩ chỉ định / Người duyệt tạm ứng.',
                    confirmButtonColor: '#15803d'
                });
                document.getElementById('dep-approved-by')?.focus();
                return;
            }
            if (method === 1 && !ref) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Thiếu mã giao dịch ngân hàng',
                    text: 'Người bệnh quét mã VietQR thành công: vui lòng nhập mã chuẩn chi / giao dịch ngân hàng để đối soát.',
                    confirmButtonColor: '#15803d'
                });
                document.getElementById('dep-ref')?.focus();
                return;
            }

            var patientName = document.getElementById('dep-card-name')?.innerText || 'Bệnh nhân';
            var methodStr = method === 0 ? 'Tiền mặt' : 'Chuyển khoản (VietQR)';

            var confirmRes = await Swal.fire({
                icon: 'question',
                title: 'Xác nhận thu tạm ứng viện phí?',
                html: `<div style="text-align:left; font-size:14px; line-height:1.6;">
                    <div>• Người bệnh: <b>${patientName}</b></div>
                    <div>• Số tiền thu: <b style="color:#15803d;">${amount.toLocaleString('vi-VN')} đ</b></div>
                    <div>• Người duyệt / BS chỉ định: <b>${approvedBy}</b></div>
                    <div>• Hình thức: <b>${methodStr}</b></div>
                    <div>• Mục đích: <b>${purpose || 'Tạm ứng viện phí'}</b></div>
                </div>`,
                showCancelButton: true,
                confirmButtonText: '✓ Ghi sổ & In biên lai',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#15803d',
                cancelButtonColor: '#64748b'
            });

            if (!confirmRes.isConfirmed) {
                return;
            }

            var btnSubmit = document.getElementById('btn-submit-deposit');
            if (btnSubmit) {
                btnSubmit.disabled = true;
                btnSubmit.innerText = '⏳ Đang ghi sổ...';
            }

            try {
                var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                var res = await fetch('@Url.Action("CreateDeposit", "Cashier", new { area = "Staff" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({
                        patientId: patientId,
                        appointmentId: appointmentId,
                        amount: amount,
                        method: method,
                        purpose: purpose || 'Tạm ứng viện phí',
                        approvedBy: approvedBy,
                        referenceCode: ref || null,
                        note: note || null,
                        cashierAccountId: 0
                    })
                });

                var data = await res.json();
                if (res.ok && data.success) {
                    var depositObj = data.deposit || {
                        depositCode: (data.message && data.message.match(/TU-\d+/)) ? data.message.match(/TU-\d+/)[0] : 'TU-MỚI',
                        patientName: patientName,
                        patientCode: document.getElementById('dep-card-code')?.innerText || '',
                        nationalId: document.getElementById('dep-card-cccd')?.innerText || '',
                        phoneNumber: document.getElementById('dep-card-phone')?.innerText || '',
                        appointmentCode: document.getElementById('dep-card-app-code')?.innerText || '',
                        amount: amount,
                        paymentMethod: method,
                        referenceCode: ref || null,
                        purpose: purpose || 'Tạm ứng viện phí',
                        approvedBy: approvedBy,
                        cashierName: '@(shift?.CashierName ?? "Thu ngân")',
                        createdAt: new Date().toISOString()
                    };

                    document.getElementById('modal-create-deposit').close();
                    await Swal.fire({
                        icon: 'success',
                        title: 'Thu tạm ứng thành công!',
                        text: data.message || 'Đã ghi sổ phiếu thu tạm ứng.',
                        showCancelButton: true,
                        confirmButtonText: '🖨️ In biên lai tạm ứng',
                        cancelButtonText: 'Đóng',
                        confirmButtonColor: '#15803d',
                        cancelButtonColor: '#64748b'
                    }).then(function(result) {
                        if (result.isConfirmed) {
                            printDepositReceipt(depositObj);
                        }
                    });
                    window.location.reload();
                } else {
                    await Swal.fire({
                        icon: 'error',
                        title: 'Không thể tạo phiếu tạm ứng',
                        text: data.message || 'Không thể tạo phiếu tạm ứng.',
                        confirmButtonColor: '#dc2626'
                    });
                    if (btnSubmit) {
                        btnSubmit.disabled = false;
                        btnSubmit.innerText = '✓ Xác nhận thu tạm ứng';
                    }
                }
            } catch (err) {
                await Swal.fire({
                    icon: 'error',
                    title: 'Lỗi kết nối',
                    text: err.message,
                    confirmButtonColor: '#dc2626'
                });
                if (btnSubmit) {
                    btnSubmit.disabled = false;
                    btnSubmit.innerText = '✓ Xác nhận thu tạm ứng';
                }
            }
        }

        async function handleRefundDeposit(depositId, code, patientName, maxBalance) {
            var safeCode = escapeHtml(code);
            var safePatient = escapeHtml(patientName);
            var { value: formValues } = await Swal.fire({
                title: 'Hoàn trả tạm ứng ' + safeCode,
                html:
                    '<div style="text-align:left; font-size:13px; display:flex; flex-direction:column; gap:10px;">' +
                    '<div>Bệnh nhân: <strong>' + safePatient + '</strong> (Tối đa: <strong>' + maxBalance.toLocaleString('vi-VN') + ' đ</strong>)</div>' +
                    '<div><label style="display:block; margin-bottom:4px; font-weight:600;">Số tiền hoàn (VNĐ)</label>' +
                    '<input id="swal-ref-amount" type="number" class="swal2-input" style="margin:0; width:100%; height:36px; font-size:13px;" min="1000" max="' + maxBalance + '" step="1000" value="' + maxBalance + '"></div>' +
                    '<div><label style="display:block; margin-bottom:4px; font-weight:600;">Hình thức hoàn</label>' +
                    '<select id="swal-ref-method" class="swal2-select" style="margin:0; width:100%; height:36px; font-size:13px;">' +
                    '<option value="0">Tiền mặt</option><option value="1">Chuyển khoản</option></select></div>' +
                    '<div id="swal-ref-bank-wrap" style="display:none;"><label style="display:block; margin-bottom:4px; font-weight:600;">Mã giao dịch ngân hàng</label>' +
                    '<input id="swal-ref-bank-code" type="text" class="swal2-input" style="margin:0; width:100%; height:36px; font-size:13px;" placeholder="VD: FT26318..."></div>' +
                    '<div><label style="display:block; margin-bottom:4px; font-weight:600;">Lý do hoàn</label>' +
                    '<input id="swal-ref-reason" type="text" class="swal2-input" style="margin:0; width:100%; height:36px; font-size:13px;" value="Hoàn trả tạm ứng theo yêu cầu người bệnh"></div>' +
                    '</div>',
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Xác nhận hoàn tiền',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#107c41',
                didOpen: () => {
                    var methodEl = document.getElementById('swal-ref-method');
                    var bankWrap = document.getElementById('swal-ref-bank-wrap');
                    if (methodEl && bankWrap) {
                        methodEl.addEventListener('change', function () {
                            bankWrap.style.display = this.value === '1' ? 'block' : 'none';
                        });
                    }
                },
                preConfirm: () => {
                    var amt = Number(document.getElementById('swal-ref-amount').value);
                    var reason = (document.getElementById('swal-ref-reason').value || '').trim();
                    var method = Number(document.getElementById('swal-ref-method').value);
                    var bankCode = (document.getElementById('swal-ref-bank-code')?.value || '').trim();
                    if (!amt || amt <= 0 || amt > maxBalance) {
                        Swal.showValidationMessage('Số tiền hoàn phải từ 1.000 đ đến ' + maxBalance.toLocaleString('vi-VN') + ' đ');
                        return false;
                    }
                    if (method === 1 && !bankCode) {
                        Swal.showValidationMessage('Vui lòng nhập mã giao dịch ngân hàng khi hoàn chuyển khoản');
                        return false;
                    }
                    if (!reason) {
                        Swal.showValidationMessage('Vui lòng nhập lý do hoàn trả');
                        return false;
                    }
                    return { amount: amt, method: method, referenceCode: method === 1 ? bankCode : null, reason: reason };
                }
            });
            if (!formValues) return;

            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            var res = await fetch('@Url.Action("RefundDeposit", "Cashier", new { area = "Staff" })', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token || '' },
                body: JSON.stringify({
                    depositId: depositId,
                    amount: formValues.amount,
                    reason: formValues.reason,
                    method: formValues.method,
                    referenceCode: formValues.referenceCode,
                    cashierAccountId: 0
                })
            });
            var data = await res.json();
            if (res.ok && data.success) {
                await Swal.fire({ icon: 'success', title: 'Đã hoàn tạm ứng', text: data.message, confirmButtonColor: '#107c41' });
                window.location.reload();
            } else {
                await Swal.fire({ icon: 'error', title: 'Không thể hoàn tiền', text: data.message || 'Có lỗi xảy ra.', confirmButtonColor: '#dc2626' });
            }
        }
    </script>
}
