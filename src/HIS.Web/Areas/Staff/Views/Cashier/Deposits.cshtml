        async function submitCreateDeposit() {
            var patientId = parseInt(document.getElementById('dep-patient-id').value);
            var amount = parseFloat(document.getElementById('dep-amount').value);
            var method = parseInt(document.getElementById('dep-method').value);
            var approvedBy = document.getElementById('dep-approved-by')?.value?.trim() || '';
            var purpose = document.getElementById('dep-purpose').value.trim();
            var ref = document.getElementById('dep-ref')?.value?.trim() || '';
            var note = document.getElementById('dep-note').value.trim();
            var appointmentId = parseInt(document.getElementById('dep-appointment-id').value) || null;

            if (!patientId || isNaN(patientId) || patientId <= 0) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Chưa chọn bệnh nhân',
                    text: 'Vui lòng tra cứu và bấm chọn hồ sơ bệnh nhân để đối chiếu trước khi thu tiền.',
                    confirmButtonColor: '#0284c7'
                });
                resetSelectedPatientForDeposit();
                return;
            }
            if (!amount || amount <= 0) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Số tiền không hợp lệ',
                    text: 'Số tiền tạm ứng phải lớn hơn 0 đ.',
                    confirmButtonColor: '#0284c7'
                });
                document.getElementById('dep-amount')?.focus();
                return;
            }
            if (!approvedBy) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Thiếu thông tin người duyệt',
                    text: 'Vui lòng nhập tên Bác sĩ chỉ định / Người duyệt tạm ứng.',
                    confirmButtonColor: '#0284c7'
                });
                document.getElementById('dep-approved-by')?.focus();
                return;
            }
            if (method === 1 && !ref) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Thiếu mã giao dịch ngân hàng',
                    text: 'Người bệnh quét mã VietQR thành công: vui lòng nhập mã chuẩn chi / giao dịch ngân hàng để đối soát.',
                    confirmButtonColor: '#0284c7'
                });
                document.getElementById('dep-ref')?.focus();
                return;
            }

            var patientName = document.getElementById('dep-card-name')?.innerText || 'Bệnh nhân';
            var methodStr = method === 0 ? 'Tiền mặt' : 'Chuyển khoản (VietQR)';

            var confirmRes = await Swal.fire({
                icon: 'question',
                title: 'Xác nhận thu tạm ứng viện phí?',
                html: `<div style="text-align:left; font-size:14px; line-height:1.6;">
                    <div>• Người bệnh: <b>${patientName}</b></div>
                    <div>• Số tiền thu: <b style="color:#0284c7;">${amount.toLocaleString('vi-VN')} đ</b></div>
                    <div>• Người duyệt / BS chỉ định: <b>${approvedBy}</b></div>
                    <div>• Hình thức: <b>${methodStr}</b></div>
                    <div>• Mục đích: <b>${purpose || 'Tạm ứng viện phí'}</b></div>
                </div>`,
                showCancelButton: true,
                confirmButtonText: '✓ Ghi sổ & In biên lai',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#0284c7',
                cancelButtonColor: '#64748b'
            });

            if (!confirmRes.isConfirmed) {
                return;
            }

            var btnSubmit = document.getElementById('btn-submit-deposit');
            if (btnSubmit) {
                btnSubmit.disabled = true;
                btnSubmit.innerText = '⏳ Đang ghi sổ...';
            }

            try {
                var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                var res = await fetch('@Url.Action("CreateDeposit", "Cashier", new { area = "Staff" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({
                        patientId: patientId,
                        appointmentId: appointmentId,
                        amount: amount,
                        method: method,
                        purpose: purpose || 'Tạm ứng viện phí',
                        approvedBy: approvedBy,
                        referenceCode: ref || null,
                        note: note || null,
                        cashierAccountId: 0
                    })
                });

                var data = await res.json();
                if (res.ok && data.success) {
                    var depositObj = data.deposit || {
                        depositCode: (data.message && data.message.match(/TU-\d+/)) ? data.message.match(/TU-\d+/)[0] : 'TU-MỚI',
                        patientName: patientName,
                        patientCode: document.getElementById('dep-card-code')?.innerText || '',
                        nationalId: document.getElementById('dep-card-cccd')?.innerText || '',
                        phoneNumber: document.getElementById('dep-card-phone')?.innerText || '',
                        appointmentCode: document.getElementById('dep-card-app-code')?.innerText || '',
                        amount: amount,
                        paymentMethod: method,
                        referenceCode: ref || null,
                        purpose: purpose || 'Tạm ứng viện phí',
                        approvedBy: approvedBy,
                        cashierName: '@(shift?.CashierName ?? "Thu ngân")',
                        createdAt: new Date().toISOString()
                    };

                    document.getElementById('modal-create-deposit').close();
                    await Swal.fire({
                        icon: 'success',
                        title: 'Thu tạm ứng thành công!',
                        text: data.message || 'Đã ghi sổ phiếu thu tạm ứng.',
                        showCancelButton: true,
                        confirmButtonText: '🖨️ In biên lai tạm ứng',
                        cancelButtonText: 'Đóng',
                        confirmButtonColor: '#0284c7',
                        cancelButtonColor: '#64748b'
                    }).then(function(result) {
                        if (result.isConfirmed) {
                            printDepositReceipt(depositObj);
                        }
                    });
                    window.location.reload();
                } else {
                    await Swal.fire({
                        icon: 'error',
                        title: 'Không thể tạo phiếu tạm ứng',
                        text: data.message || 'Không thể tạo phiếu tạm ứng.',
                        confirmButtonColor: '#dc2626'
                    });
                    if (btnSubmit) {
                        btnSubmit.disabled = false;
                        btnSubmit.innerText = '✓ Xác nhận thu tạm ứng';
                    }
                }
            } catch (err) {
                await Swal.fire({
                    icon: 'error',
                    title: 'Lỗi kết nối',
                    text: err.message,
                    confirmButtonColor: '#dc2626'
                });
                if (btnSubmit) {
                    btnSubmit.disabled = false;
                    btnSubmit.innerText = '✓ Xác nhận thu tạm ứng';
                }
            }
        }
    </script>
}
