            <button type="button" class="btn outline" style="padding: 2px 8px; font-size: 11.5px; border-radius: 4px;" onclick="setDepositAmount(1000000)">+1.000.000 đ</button>
            <button type="button" class="btn outline" style="padding: 2px 8px; font-size: 11.5px; border-radius: 4px;" onclick="setDepositAmount(2000000)">+2.000.000 đ</button>
            <button type="button" class="btn outline" style="padding: 2px 8px; font-size: 11.5px; border-radius: 4px;" onclick="setDepositAmount(5000000)">+5.000.000 đ</button>
