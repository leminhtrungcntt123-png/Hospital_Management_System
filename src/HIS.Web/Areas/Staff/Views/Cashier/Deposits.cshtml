                    var cccdHtml = p.nationalId ? ' · <span style="color: #15803d; font-weight: 600;">CCCD: ' + p.nationalId + '</span>' : '';
                    var appHtml = p.activeAppointmentCode 
                        ? '<div style="font-size: 11.5px; color: #0d6535; margin-top: 3px;">🏥 Lượt khám gần nhất: <strong>' + p.activeAppointmentCode + '</strong> (' + (p.activeDepartmentName || 'Đang khám') + ')</div>' 
