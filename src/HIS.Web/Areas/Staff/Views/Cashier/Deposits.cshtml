        <input type="text" id="dep-purpose" class="form-control" list="dep-purpose-suggestions" placeholder="VD: Tạm ứng viện phí..." style="width: 100%; padding: 8px 12px; font-size: 13px;" />
        <datalist id="dep-purpose-suggestions">
