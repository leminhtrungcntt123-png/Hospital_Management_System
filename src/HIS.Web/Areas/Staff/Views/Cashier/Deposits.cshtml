        <div class="info-val"><strong>${dep.patientName}</strong></div>
    </div>
    <div class="info-row">
        <div class="info-label">Mã người bệnh:</div>
        <div class="info-val"><strong>${dep.patientCode}</strong>${dep.nationalId ? ' · CCCD: <strong>' + dep.nationalId + '</strong>' : ''} · SĐT: ${dep.phoneNumber || '—'}</div>
    </div>
    <div class="info-row">
        <div class="info-label">Lượt khám / Đợt điều trị:</div>
        <div class="info-val">${dep.appointmentCode ? ('Mã lượt: <strong>' + dep.appointmentCode + '</strong>') : 'Tạm ứng đợt khám/nhập viện mới'}</div>
