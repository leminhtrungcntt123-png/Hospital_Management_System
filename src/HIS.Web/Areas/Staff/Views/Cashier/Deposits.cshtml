@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var isShiftOpen = @(shift != null ? "true" : "false");
        var depositQrSeq = 0;

        async function handleCreateDepositClick() {
            if (!isShiftOpen) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Chưa mở ca thu ngân',
                    text: 'Vui lòng mở ca thu ngân tại quầy trước khi thu tạm ứng.',
                    confirmButtonText: 'Đến quầy mở ca',
                    confirmButtonColor: '#0284c7'
                });
                window.location.href = '@Url.Action("Index", "Cashier", new { area = "Staff" })';
                return;
            }
            resetSelectedPatientForDeposit();
            document.getElementById('dep-search-input').value = '';
            document.getElementById('dep-amount').value = '';
            document.getElementById('dep-method').value = '0';
            document.getElementById('dep-approved-by').value = '';
            toggleDepRefCode();
            document.getElementById('dep-purpose').value = 'Tạm ứng viện phí điều trị';
            document.getElementById('dep-ref').value = '';
            document.getElementById('dep-note').value = '';

            document.getElementById('modal-create-deposit').showModal();
            setTimeout(() => document.getElementById('dep-search-input')?.focus(), 150);
        }

        async function searchPatientForDeposit() {
            var input = document.getElementById('dep-search-input');
            var status = document.getElementById('dep-search-status');
            var resultsBox = document.getElementById('dep-search-results-list');
            var term = input.value.trim();

            if (!term) {
                status.style.display = 'block';
                status.innerHTML = '<span style="color: #b91c1c;">Vui lòng nhập Mã BN, CCCD, SĐT hoặc Họ tên để tìm kiếm.</span>';
                resultsBox.style.display = 'none';
                input.focus();
                return;
            }

            status.style.display = 'block';
            status.innerHTML = '<span style="color: #0284c7;">⏳ Đang tìm kiếm hồ sơ người bệnh...</span>';
            resultsBox.style.display = 'none';

            try {
                var url = '@Url.Action("SearchPatients", "Cashier", new { area = "Staff" })?term=' + encodeURIComponent(term);
                var res = await fetch(url);
                if (!res.ok) throw new Error('Không thể tải dữ liệu tìm kiếm.');
                var list = await res.json();

                if (!list || list.length === 0) {
                    status.innerHTML = '<span style="color: #b91c1c;">Không tìm thấy hồ sơ người bệnh nào khớp với từ khóa "<strong>' + term + '</strong>".</span>';
                    resultsBox.style.display = 'none';
                    return;
                }

                status.innerHTML = '<span style="color: #15803d;">Tìm thấy <strong>' + list.length + '</strong> hồ sơ phù hợp. Bấm "Chọn" để đối chiếu:</span>';
                resultsBox.innerHTML = '';

                list.forEach(p => {
                    var item = document.createElement('div');
                    item.style.cssText = 'padding: 10px 12px; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; cursor: pointer; transition: background 0.15s;';
                    item.onmouseover = function() { this.style.backgroundColor = '#f8fafc'; };
                    item.onmouseout = function() { this.style.backgroundColor = 'transparent'; };

                    var cccdHtml = p.nationalId ? ' · <span style="color: #0284c7; font-weight: 600;">CCCD: ' + p.nationalId + '</span>' : '';
                    var appHtml = p.activeAppointmentCode 
                        ? '<div style="font-size: 11.5px; color: #0369a1; margin-top: 3px;">🏥 Lượt khám gần nhất: <strong>' + p.activeAppointmentCode + '</strong> (' + (p.activeDepartmentName || 'Đang khám') + ')</div>' 
                        : '';

                    item.innerHTML = `
                        <div style="flex: 1; padding-right: 12px;">
                            <div style="font-weight: 700; color: #0f172a; font-size: 13.5px;">
                                ${p.fullName} <span style="color: #1e3a8a; font-family: monospace; font-size: 12.5px; font-weight: 700;">(Mã: ${p.patientCode})</span>
                            </div>
                            <div style="font-size: 12px; color: #475569; margin-top: 2px;">
                                ${p.gender} · ${p.age} tuổi (${p.dateOfBirth}) · SĐT: <strong>${p.phoneNumber}</strong>${cccdHtml}
                            </div>
                            ${appHtml}
                        </div>
                        <button type="button" class="btn primary" style="padding: 5px 12px; font-size: 12px; font-weight: 700; white-space: nowrap;">✓ Chọn</button>
                    `;

                    item.onclick = function() { selectPatientForDeposit(p); };
                    resultsBox.appendChild(item);
                });

                resultsBox.style.display = 'block';

                if (list.length === 1) {
                    selectPatientForDeposit(list[0]);
                }
            } catch (err) {
                status.innerHTML = '<span style="color: #b91c1c;">Lỗi: ' + err.message + '</span>';
            }
        }

        function selectPatientForDeposit(p) {
            document.getElementById('dep-patient-id').value = p.id;
            document.getElementById('dep-appointment-id').value = p.activeAppointmentId || '';

            document.getElementById('dep-card-name').innerText = p.fullName;
            document.getElementById('dep-card-code').innerText = p.patientCode;
            document.getElementById('dep-card-cccd').innerText = p.nationalId || 'Chưa cập nhật';
            document.getElementById('dep-card-dob').innerText = p.dateOfBirth;
            document.getElementById('dep-card-age').innerText = p.age;
            document.getElementById('dep-card-gender').innerText = p.gender;
            document.getElementById('dep-card-phone').innerText = p.phoneNumber;
            document.getElementById('dep-card-address').innerText = p.address || 'Chưa cập nhật';

            var appBox = document.getElementById('dep-card-app-box');
            if (p.activeAppointmentCode) {
                document.getElementById('dep-card-app-code').innerText = p.activeAppointmentCode;
                document.getElementById('dep-card-app-dept').innerText = p.activeDepartmentName || 'Khám bệnh';
                appBox.style.display = 'block';
            } else {
                appBox.style.display = 'none';
            }

            document.getElementById('dep-search-box-container').style.display = 'none';
            document.getElementById('dep-selected-patient-card').style.display = 'block';

            refreshDepositQrIfTransfer();
            setTimeout(() => document.getElementById('dep-amount')?.focus(), 100);
        }

        function resetSelectedPatientForDeposit() {
            depositQrSeq++;
            var qrImg = document.getElementById('dep-qr-img');
            if (qrImg) qrImg.removeAttribute('src');
            document.getElementById('dep-patient-id').value = '';
            document.getElementById('dep-appointment-id').value = '';
            document.getElementById('dep-selected-patient-card').style.display = 'none';
            document.getElementById('dep-search-box-container').style.display = 'block';
            document.getElementById('dep-search-results-list').style.display = 'none';
            document.getElementById('dep-search-results-list').innerHTML = '';
            document.getElementById('dep-search-status').style.display = 'none';
            setTimeout(() => document.getElementById('dep-search-input')?.focus(), 100);
        }

        function setDepositAmount(val) {
            document.getElementById('dep-amount').value = val;
            refreshDepositQrIfTransfer();
        }

        function toggleDepRefCode() {
            refreshDepositQrIfTransfer();
        }

        async function refreshDepositQrIfTransfer() {
            const reqSeq = ++depositQrSeq;
            var method = document.getElementById('dep-method').value;
            var panel = document.getElementById('dep-vietqr-panel');
            var prompt = document.getElementById('dep-qr-prompt');
            var content = document.getElementById('dep-qr-content');
            var qrImg = document.getElementById('dep-qr-img');
            
            if (method !== '1') {
                if (panel) panel.style.display = 'none';
                if (qrImg) qrImg.removeAttribute('src');
                return;
            }
            if (panel) panel.style.display = 'block';

            var patientId = parseInt(document.getElementById('dep-patient-id').value);
            var amount = parseFloat(document.getElementById('dep-amount').value);

            if (!patientId || isNaN(patientId) || patientId <= 0 || !amount || isNaN(amount) || amount <= 0) {
                if (prompt) prompt.style.display = 'block';
                if (content) content.style.display = 'none';
                if (qrImg) qrImg.removeAttribute('src');
                return;
            }

            if (prompt) prompt.style.display = 'none';
            if (content) content.style.display = 'block';
            if (qrImg) qrImg.removeAttribute('src');
            document.getElementById('dep-qr-amount-text').innerText = Number(amount).toLocaleString('vi-VN') + ' đ';

            try {
                var url = '@Url.Action("GenerateDepositQr", "Cashier", new { area = "Staff" })?patientId=' + patientId + '&amount=' + amount;
                var res = await fetch(url);
                var data = await res.json();
                if (reqSeq !== depositQrSeq) return;
                if (res.ok && data.qrDataUri) {
                    if (qrImg) qrImg.src = data.qrDataUri;
                    document.getElementById('dep-qr-bank').innerText = 'Ngân hàng: ' + data.bankName + ' (' + data.bankCode + ')';
                    document.getElementById('dep-qr-acc').innerText = data.accountNumber;
                    document.getElementById('dep-qr-holder').innerText = data.accountHolder;
                    document.getElementById('dep-qr-msg').innerText = data.message;
                } else if (qrImg) {
                    qrImg.removeAttribute('src');
                }
            } catch (err) {
                if (reqSeq === depositQrSeq && qrImg) {
                    qrImg.removeAttribute('src');
                }
                console.error('Không thể tạo mã VietQR:', err);
            }
        }

        function copyText(text) {
            if (!text) return;
            navigator.clipboard.writeText(text).then(() => {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'Đã sao chép: ' + text,
                    showConfirmButton: false,
                    timer: 1800,
                    timerProgressBar: true
                });
            }).catch(() => {
                prompt('Sao chép nội dung:', text);
            });
        }

        function numberToVietnameseWords(n) {
            if (!n || isNaN(n) || n === 0) return 'Không đồng';
            if (n < 0) return 'Âm ' + numberToVietnameseWords(-n);

            var units = ['', 'nghìn', 'triệu', 'tỷ', 'nghìn tỷ', 'triệu tỷ'];
            var numbers = ['không', 'một', 'hai', 'ba', 'bốn', 'năm', 'sáu', 'bảy', 'tám', 'chín'];

            function readThreeDigits(num, hasHigherGroup) {
                var h = Math.floor(num / 100);
                var t = Math.floor((num % 100) / 10);
                var u = num % 10;
                var res = '';

                if (h > 0 || hasHigherGroup) {
                    res += numbers[h] + ' trăm ';
                }

                if (t === 0 && u === 0) {
                    return res.trim();
                }

                if (t === 0 && u > 0) {
                    res += (hasHigherGroup || h > 0 ? 'lẻ ' : '') + numbers[u];
                    return res.trim();
                }

                if (t === 1) {
                    res += 'mười ';
                } else if (t > 1) {
                    res += numbers[t] + ' mươi ';
                }

                if (u === 1) {
                    res += t > 1 ? 'mốt' : 'một';
                } else if (u === 5) {
                    res += t > 0 ? 'lăm' : 'năm';
                } else if (u > 0) {
                    res += numbers[u];
                }

                return res.trim();
            }

            var groups = [];
            var temp = Math.floor(n);
            while (temp > 0) {
                groups.push(temp % 1000);
                temp = Math.floor(temp / 1000);
            }

            var parts = [];
            for (var i = groups.length - 1; i >= 0; i--) {
                var g = groups[i];
                if (g > 0) {
                    var s = readThreeDigits(g, i < groups.length - 1);
                    parts.push(s + ' ' + units[i]);
                }
            }

            var result = parts.join(' ').replace(/\s+/g, ' ').trim();
            if (!result) return 'Không đồng';
            return result.charAt(0).toUpperCase() + result.slice(1) + ' đồng chẵn.';
        }

        function printDepositReceipt(dep) {
            if (!dep) return;
            var printWin = window.open('', '_blank', 'width=850,height=750');
            if (!printWin) {
                alert('Trình duyệt đã chặn cửa sổ bật lên (popup). Vui lòng cho phép popup để in biên lai tạm ứng.');
                return;
            }

            var now = dep.createdAt ? new Date(dep.createdAt) : new Date();
            var words = numberToVietnameseWords(Math.round(dep.amount));
            var methodStr = dep.paymentMethod === 0 ? 'Tiền mặt' : ('Chuyển khoản' + (dep.referenceCode ? ' (Mã chuẩn chi: ' + dep.referenceCode + ')' : ''));
            var approvedByStr = dep.approvedBy || 'BS. Phạm Thu Hằng';

            var content = `<!DOCTYPE html>
<html>
