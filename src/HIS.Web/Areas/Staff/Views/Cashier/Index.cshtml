        async function submitUpsertBhyt(appId, patientId, isActive) {
            var cardNum = (document.getElementById('bhyt-card-number')?.value || '').trim().toUpperCase();
            var planId = parseInt(document.getElementById('bhyt-plan-id')?.value || '0');
            var validFrom = document.getElementById('bhyt-valid-from')?.value || '';
            var validTo = document.getElementById('bhyt-valid-to')?.value || '';
            var isRegisteredHere = !!(document.getElementById('bhyt-registered-here')?.checked);
            var facility = (document.getElementById('bhyt-facility')?.value || '').trim();

            if (isActive) {
                if (!cardNum || cardNum.length < 10) {
                    await Swal.fire({ icon: 'warning', title: 'Mã thẻ chưa hợp lệ', text: 'Vui lòng nhập mã số thẻ BHYT (10–20 ký tự).', confirmButtonColor: '#0284c7' });
                    return;
                }
                if (!planId || !validFrom || !validTo) {
                    await Swal.fire({ icon: 'warning', title: 'Thiếu thông tin thẻ', text: 'Vui lòng chọn mức hưởng và thời hạn hiệu lực của thẻ BHYT.', confirmButtonColor: '#0284c7' });
                    return;
                }
            }

            var btn = document.getElementById('btn-save-bhyt');
            if (btn) btn.disabled = true;

            try {
                var res = await fetch('@Url.Action("UpsertInsuranceCard", "Cashier", new { area = "Staff" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({
                        patientId: patientId,
                        cardNumber: isActive ? cardNum : 'DEACTIVATED',
                        insurancePlanId: planId || 1,
                        registeredFacility: facility || null,
                        isRegisteredHere: isRegisteredHere,
                        validFrom: validFrom || '2026-01-01',
                        validTo: validTo || '2026-12-31',
                        isActive: isActive,
                        cashierAccountId: 0
                    })
                });
                var data = await res.json();
                if (res.ok && data.success) {
                    document.getElementById('modal-upsert-bhyt')?.close();
                    await selectAppointment(appId, document.getElementById('app-card-' + appId));
                    await Swal.fire({ icon: 'success', title: 'Đã cập nhật BHYT', text: data.message, timer: 2200, showConfirmButton: false });
                } else {
                    await Swal.fire({ icon: 'error', title: 'Không thể lưu thẻ BHYT', text: data.message || 'Vui lòng kiểm tra lại thông tin thẻ.', confirmButtonColor: '#dc2626' });
                }
            } catch (err) {
                await Swal.fire({ icon: 'error', title: 'Lỗi kết nối', text: err.message, confirmButtonColor: '#dc2626' });
            } finally {
                if (btn) btn.disabled = false;
            }
        }

