                <th style="width: 85px;">BHYT trả</th>
                <th style="width: 95px;">BN cùng trả</th>
            </tr>
        </thead>
        <tbody>
            ${itemsHtml}
        </tbody>
        <tfoot>
            <tr style="font-weight: bold; background: #f9f9f9;">
                <td colspan="4" style="text-align: right; border: 1px solid #333; padding: 5px 6px;">TỔNG CỘNG:</td>
                <td style="text-align: right; border: 1px solid #333; padding: 5px 6px;">${totalAmount.toLocaleString('vi-VN')}</td>
                <td style="text-align: right; border: 1px solid #333; padding: 5px 6px;">${insuranceCovered.toLocaleString('vi-VN')}</td>
                <td style="text-align: right; border: 1px solid #333; padding: 5px 6px;">${patientAmount.toLocaleString('vi-VN')}</td>
            </tr>
        </tfoot>
    </table>

    <div class="summary-box">
        <div style="font-weight: bold; margin-bottom: 6px; font-size: 13.5px; border-bottom: 1px dashed #999; padding-bottom: 4px;">II. TỔNG HỢP CÂN ĐỐI TÀI CHÍNH QUYẾT TOÁN:</div>
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 4px 10px;">
            <div>1. Tổng chi phí khám & điều trị:</div>
            <div style="text-align: right; font-weight: bold;">${totalAmount.toLocaleString('vi-VN')} đ</div>
            <div>2. Quỹ BHYT chi trả:</div>
            <div style="text-align: right; font-weight: bold; color: #15803d;">- ${insuranceCovered.toLocaleString('vi-VN')} đ</div>
            <div>3. Người bệnh cùng chi trả (Viện phí thực tế):</div>
            <div style="text-align: right; font-weight: bold;">${patientAmount.toLocaleString('vi-VN')} đ</div>
            <div>4. Tiền tạm ứng đã nộp:</div>
            <div style="text-align: right; font-weight: bold;">${depositBal.toLocaleString('vi-VN')} đ</div>
            <div style="font-size: 13.5px; font-weight: bold; border-top: 1px solid #333; padding-top: 4px;">5. KẾT QUẢ QUYẾT TOÁN CÂN ĐỐI:</div>
            <div style="font-size: 13.5px; font-weight: bold; text-align: right; border-top: 1px solid #333; padding-top: 4px;">
                ${netDiff > 0 ? ('BN nộp thêm: ' + Number(netDiff).toLocaleString('vi-VN') + ' đ') : (netDiff < 0 ? ('Hoàn tiền mặt cho BN: ' + Number(Math.abs(netDiff)).toLocaleString('vi-VN') + ' đ') : 'Cấn trừ đủ 100%')}
            </div>
        </div>
        <div style="margin-top: 6px; font-style: italic;">
            (Bằng chữ: <strong>${balanceWord}</strong>)
        </div>
    </div>

    <div class="signatures">
        <div>
            <div class="sig-title">NGƯỜI BỆNH / ĐẠI DIỆN<br /><span style="font-weight: normal; font-size: 11px;">(Ký, ghi rõ họ tên)</span></div>
