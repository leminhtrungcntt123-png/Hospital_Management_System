            body { padding: 0; }
            .no-print { display: none; }
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="header-left">
            <strong>SỞ Y TẾ TP. HỒ CHÍ MINH</strong><br />
            <strong>BỆNH VIỆN ĐA KHOA MEDICARE</strong><br />
            <span>Phòng Tài chính - Kế toán</span>
