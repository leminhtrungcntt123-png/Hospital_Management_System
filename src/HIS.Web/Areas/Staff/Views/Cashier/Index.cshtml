            var method = document.getElementById('refund-inv-method')?.value;
            var box = document.getElementById('refund-inv-ref-box');
            if (box) box.style.display = method === '1' ? 'block' : 'none';
        }

        async function submitRefundInvoice(appId, invoiceId, maxRefundable) {
            if (!isShiftOpen) {
                await Swal.fire({ icon: 'warning', title: 'Chưa mở ca thu ngân', text: 'Vui lòng mở ca trước khi thực hiện hoàn viện phí.', confirmButtonColor: '#0284c7' });
                return;
            }

            var amount = parseFloat(document.getElementById('refund-inv-amount')?.value || '0');
            var method = parseInt(document.getElementById('refund-inv-method')?.value || '0');
            var refCode = (document.getElementById('refund-inv-ref')?.value || '').trim();
            var approvedBy = (document.getElementById('refund-inv-approver')?.value || '').trim();
            var reason = (document.getElementById('refund-inv-reason')?.value || '').trim();

            if (!amount || amount <= 0 || amount > maxRefundable) {
                await Swal.fire({ icon: 'warning', title: 'Số tiền không hợp lệ', text: 'Số tiền hoàn phải từ 1.000 đ đến tối đa ' + maxRefundable.toLocaleString('vi-VN') + ' đ.', confirmButtonColor: '#0284c7' });
                return;
            }
            if (!reason) {
                await Swal.fire({ icon: 'warning', title: 'Thiếu lý do hoàn tiền', text: 'Bắt buộc nhập lý do hoàn trả / điều chỉnh hóa đơn.', confirmButtonColor: '#0284c7' });
                return;
            }
            if (method === 1 && !refCode) {
                await Swal.fire({ icon: 'warning', title: 'Thiếu mã giao dịch ngân hàng', text: 'Vui lòng nhập mã giao dịch chuyển khoản hoàn tiền.', confirmButtonColor: '#0284c7' });
                return;
            }

            var btn = document.getElementById('btn-submit-refund-inv');
            if (btn) btn.disabled = true;

            try {
                var res = await fetch('@Url.Action("RefundInvoice", "Cashier", new { area = "Staff" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({
                        invoiceId: invoiceId,
                        amount: amount,
                        reason: reason,
                        method: method,
                        referenceCode: method === 1 ? refCode : null,
                        cashierAccountId: 0,
                        approvedBy: approvedBy || null
                    })
                });
                var data = await res.json();
                if (res.ok && data.success) {
                    document.getElementById('modal-refund-invoice')?.close();
                    await selectAppointment(appId, document.getElementById('app-card-' + appId));
                    await Swal.fire({ icon: 'success', title: 'Hoàn viện phí thành công', text: data.message, confirmButtonColor: '#15803d' });
                } else {
                    await Swal.fire({ icon: 'error', title: 'Không thể hoàn viện phí', text: data.message || 'Thao tác thất bại.', confirmButtonColor: '#dc2626' });
                }
            } catch (err) {
                await Swal.fire({ icon: 'error', title: 'Lỗi kết nối', text: err.message, confirmButtonColor: '#dc2626' });
            } finally {
                if (btn) btn.disabled = false;
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            initInvoiceDetailScripts();
        });
    </script>
}
