@model IReadOnlyList<HIS.BLL.DTOs.PendingInvoiceItemDto>
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Thu viện phí & BHYT";
    var selected = ViewBag.SelectedInvoice as HIS.BLL.DTOs.InvoiceDetailDto;
    int selectedId = (int)(ViewBag.SelectedId ?? 0);
    string search = (string)(ViewBag.Search ?? "");
    string statusFilter = (string)(ViewBag.StatusFilter ?? "unpaid");
    var shift = ViewBag.CurrentShift as HIS.BLL.DTOs.CashierShiftDto;
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff-cashier.css" asp-append-version="true" />
}

<div id="anti-forgery-token-holder" style="display: none;">
    @Html.AntiForgeryToken()
</div>

<div class="cashier-page">
    <div class="page-heading">
        <div>
            <span class="eyebrow">TÀI CHÍNH KẾ TOÁN</span>
            <h1>Thu viện phí &amp; BHYT</h1>
        </div>

        <div class="heading-actions">
            @if (shift != null)
            {
                <div class="shift-pill open">
                    <span class="shift-dot"></span>
                    <span>Ca từ @shift.OpenedAt.ToString("HH:mm") · <strong>@shift.OpeningCash.ToString("N0") đ</strong></span>
                    <button type="button" class="btn outline sm" onclick="document.getElementById('modal-close-shift').showModal()">
                        Kết ca
                    </button>
                </div>
            }
            else
            {
                <div class="shift-pill closed">
                    <span class="shift-dot"></span>
                    <span>Chưa mở ca</span>
                    <button type="button" class="btn primary sm" onclick="document.getElementById('modal-open-shift').showModal()">
                        Mở ca
                    </button>
                </div>
            }

            <a class="btn outline" asp-action="Index">
                @await Html.PartialAsync("_AdminIcon", "refresh") Làm mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="flash-banner ok">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>@success</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="flash-banner err">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@error</span>
        </div>
    }

    <section class="card">
        <div class="card-body">
            <form asp-action="Index" method="get" class="search-row">
                <div class="search-input-wrap">
                    <input id="cashier-search" name="search" value="@search" maxlength="60"
                           placeholder="Nhập Mã BN, Mã lượt khám, số CCCD, SĐT hoặc Họ tên..." />
                </div>
                <select name="statusFilter" aria-label="Trạng thái hóa đơn" style="height: 38px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13.5px; font-weight: 600; color: #0f172a; background: #fff;">
                    <option value="unpaid" selected="@(statusFilter == "unpaid")">Chưa thanh toán</option>
                    <option value="paid" selected="@(statusFilter == "paid")">Đã quyết toán</option>
                    <option value="all" selected="@(statusFilter == "all")">Tất cả hồ sơ</option>
                </select>
                <button class="btn primary" type="submit">
                    @await Html.PartialAsync("_AdminIcon", "search") Tra cứu
                </button>
                @if (!string.IsNullOrWhiteSpace(search) || selectedId > 0 || statusFilter != "unpaid")
                {
                    <a asp-action="Index" class="btn outline">Xóa lọc</a>
                }
            </form>

            @if (!string.IsNullOrWhiteSpace(search) && Model.Count == 0 && selected == null)
            {
                <div class="flash-banner err" style="margin-top: 12px;">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <span>Không tìm thấy hồ sơ chưa thanh toán cho "<strong>@search</strong>".</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(search) && Model.Count > 1)
            {
                <div class="quick-chips-bar">
                    <span class="quick-chips-label">Kết quả khớp "@search" (@Model.Count hồ sơ):</span>
                    @foreach (var item in Model)
                    {
                        bool isCur = item.AppointmentId == selectedId;
                        decimal diff = item.PatientPayAmount - item.DepositBalance;
                        string statusTag;
                        string badgeClass;

                        if (item.InvoiceStatus == HIS.Domain.InvoiceStatus.Paid)
                        {
                            statusTag = $"Đã tất toán ({item.PatientPayAmount:N0} đ)";
                            badgeClass = "ok";
                        }
                        else if (item.DepositBalance > 0 && diff < 0)
                        {
                            statusTag = $"Hoàn tạm ứng: {Math.Abs(diff):N0} đ";
                            badgeClass = "ok";
                        }
                        else if (item.DepositBalance > 0 && diff > 0)
                        {
                            statusTag = $"Thu thêm: {diff:N0} đ";
                            badgeClass = "danger";
                        }
                        else
                        {
                            statusTag = $"Cần thu: {item.PatientPayAmount:N0} đ";
                            badgeClass = "muted";
                        }

                        <button type="button"
                                onclick="selectAppointment(@item.AppointmentId, this)"
                                class="patient-quick-chip @(isCur ? "active" : "")"
                                id="app-card-@item.AppointmentId"
                                data-id="@item.AppointmentId">
                            <strong>@item.PatientName</strong>
                            <span class="chip-code">(@item.PatientCode)</span>
                            <span id="app-chip-status-@item.AppointmentId" class="status-badge @badgeClass">
                                @statusTag
                            </span>
                        </button>
                    }
                </div>
            }
        </div>
    </section>

    <section class="card">
        <div id="right-detail-container" class="card-body" style="min-height: 440px; transition: opacity 0.15s ease;">
            @if (selected != null)
            {
                @await Html.PartialAsync("_InvoiceDetail", selected)
            }
            else if (string.IsNullOrWhiteSpace(search))
            {
                <div class="empty-state">
                    <div class="empty-state-icon">@await Html.PartialAsync("_AdminIcon", "wallet")</div>
                    <h3>Tra cứu viện phí</h3>
                    <p>Nhập Mã bệnh nhân hoặc số CCCD ở trên để thu tiền, trừ BHYT và tất toán tạm ứng.</p>
                </div>
            }
            else
            {
                <div class="empty-state err">
                    <div class="empty-state-icon">@await Html.PartialAsync("_AdminIcon", "search")</div>
                    <h3>Không tìm thấy hồ sơ</h3>
                    <p>Không có hồ sơ viện phí chưa thanh toán nào khớp với <strong>"@search"</strong>.</p>
                </div>
            }
        </div>
    </section>
</div>

<dialog id="modal-open-shift" class="staff-dialog">
    <form asp-action="OpenShift" method="post">
        <div class="staff-dialog-header">
            <h3>Mở ca thu ngân mới</h3>
            <button type="button" class="staff-dialog-close" onclick="document.getElementById('modal-open-shift').close()" aria-label="Đóng">&times;</button>
        </div>
        <div class="staff-dialog-body">
            <div>
                <label for="open-shift-cash" style="display: block; margin-bottom: 6px;">Tiền mặt đầu ca (VNĐ)</label>
                <input id="open-shift-cash" type="number" name="openingCash" value="10000000" min="0" step="100000" style="width: 100%; height: 38px; padding: 0 12px; font-weight: 700;" required />
            </div>
        </div>
        <div class="staff-dialog-footer">
            <button type="button" class="btn outline" onclick="document.getElementById('modal-open-shift').close()">Hủy</button>
            <button type="submit" class="btn primary">Xác nhận mở ca</button>
        </div>
    </form>
</dialog>

@if (shift != null)
{
    <dialog id="modal-close-shift" class="staff-dialog">
        <form asp-action="CloseShift" method="post">
            <input type="hidden" name="shiftId" value="@shift.Id" />
            <div class="staff-dialog-header">
                <h3>Kết thúc ca làm việc</h3>
                <button type="button" class="staff-dialog-close" onclick="document.getElementById('modal-close-shift').close()" aria-label="Đóng">&times;</button>
            </div>
            <div class="staff-dialog-body">
                <div style="background: #f8fafc; border: 1px solid #e3e9e6; padding: 10px 14px; border-radius: 8px; margin-bottom: 14px;">
                    <div>Tiền đầu ca: <strong>@shift.OpeningCash.ToString("N0") đ</strong></div>
                    <div>Mở lúc: @shift.OpenedAt.ToString("HH:mm, dd/MM/yyyy")</div>
                </div>
                <div style="margin-bottom: 14px;">
                    <label for="close-shift-cash" style="display: block; margin-bottom: 6px;">Tiền mặt thực đếm tại quầy (VNĐ)</label>
                    <input id="close-shift-cash" type="number" name="countedCash" min="0" step="1000" style="width: 100%; height: 38px; padding: 0 12px; font-weight: 700; color: #15803d;" required />
                </div>
                <div>
                    <label for="close-shift-note" style="display: block; margin-bottom: 6px;">Ghi chú bàn giao ca</label>
                    <textarea id="close-shift-note" name="note" rows="2" placeholder="Ghi chú thêm nếu có tiền rách, tạm ứng chưa hoàn..." style="width: 100%; padding: 8px 12px;"></textarea>
                </div>
            </div>
            <div class="staff-dialog-footer">
                <button type="button" class="btn outline" onclick="document.getElementById('modal-close-shift').close()">Hủy</button>
                <button type="submit" class="btn danger">Xác nhận kết ca</button>
            </div>
        </form>
    </dialog>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var isShiftOpen = @(shift != null ? "true" : "false");
        var currentSettleMethod = 'Cash';
        var detailLoadSeq = 0;
        var settleQrSeq = 0;
        var settleIdempotencyKeys = {};

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function getOrCreateIdempotencyKey(appId) {
            if (!settleIdempotencyKeys[appId]) {
                var rnd = (window.crypto && typeof window.crypto.randomUUID === 'function')
                    ? window.crypto.randomUUID()
                    : ('settle-' + appId + '-' + Date.now() + '-' + Math.random().toString(16).slice(2, 10));
                settleIdempotencyKeys[appId] = rnd;
            }
            return settleIdempotencyKeys[appId];
        }

        function toggleReceiptEmailInput() {
            var chk = document.getElementById('settle-send-email');
            var inp = document.getElementById('settle-receipt-email');
            if (!chk || !inp) return;
            inp.disabled = !chk.checked;
            inp.style.opacity = chk.checked ? '1' : '0.6';
            if (chk.checked && !inp.value) {
                inp.focus();
            }
        }

        function getAntiForgeryToken() {
            return document.querySelector('#anti-forgery-token-holder input[name="__RequestVerificationToken"]')?.value || '';
        }

        @if (TempData["SuccessMessage"] is string swalSuccess)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công',
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(swalSuccess)),
                    confirmButtonColor: '#15803d',
                    timer: 3000,
                    timerProgressBar: true
                });
            });
            </text>
        }
        @if (TempData["ErrorMessage"] is string swalError)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                Swal.fire({
                    icon: 'error',
                    title: 'Thông báo lỗi',
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(swalError)),
                    confirmButtonColor: '#dc2626'
                });
            });
            </text>
        }

        // 1. CHỌN HỒ SƠ BỆNH NHÂN QUA AJAX (KHÔNG RELOAD TRANG)
        function selectAppointment(appId, chipElem) {
            if (!appId) return Promise.resolve();
            const reqSeq = ++detailLoadSeq;

            document.querySelectorAll('.patient-quick-chip').forEach(function(el) {
                el.style.borderColor = '#cbd5e1';
                el.style.background = '#ffffff';
            });
            if (chipElem) {
                chipElem.style.borderColor = '#15803d';
                chipElem.style.background = '#dcfce7';
            }

            try {
                var url = new URL(window.location.href);
                url.searchParams.set('selectedId', appId);
                window.history.replaceState({ selectedId: appId }, '', url.toString());
            } catch (e) { }

            var container = document.getElementById('right-detail-container');
            if (container) {
                container.style.opacity = '0.5';
                container.style.pointerEvents = 'none';
            }

            var fetchUrl = '@Url.Action("GetDetailPartial", "Cashier", new { area = "Staff" })?appointmentId=' + appId;
            return fetch(fetchUrl)
                .then(function(res) {
                    if (!res.ok) throw new Error('Không thể tải chi tiết hồ sơ viện phí.');
                    return res.text();
                })
                .then(function(html) {
                    if (reqSeq !== detailLoadSeq) return;
                    if (container) {
                        container.innerHTML = html;
                        container.style.opacity = '1';
                        container.style.pointerEvents = 'auto';
                        initInvoiceDetailScripts();
                    }
                })
                .catch(function(err) {
                    if (reqSeq !== detailLoadSeq) return;
                    if (container) {
                        container.innerHTML = '<div style="color: #dc2626; padding: 40px 20px; text-align: center; font-size: 14px;">Lỗi tải dữ liệu: ' + err.message + '</div>';
                        container.style.opacity = '1';
                        container.style.pointerEvents = 'auto';
                    }
                });
        }

        function initInvoiceDetailScripts() {
            currentSettleMethod = 'Cash';
            toggleReceiptEmailInput();
            var netDiffElem = document.getElementById('val-net-diff');
            if (netDiffElem) {
                var netDiff = parseFloat(netDiffElem.getAttribute('data-net')) || 0;
                if (netDiff > 0) {
                    setCashGiven(netDiff, netDiff);
                }
            }
        }

        // 2. MÁY TÍNH TIỀN MẶT THU NGÂN (CASH CALCULATOR)
        function calculateCashChange(requiredAmount) {
            var input = document.getElementById('calc-cash-given');
            var changeBox = document.getElementById('calc-change-box');
            var changeLabel = document.getElementById('calc-change-label');
            var changeAmount = document.getElementById('calc-change-amount');
            var changeWords = document.getElementById('calc-change-words');

            if (!input || !changeAmount) return;

            var given = parseFloat(input.value) || 0;
            var change = given - requiredAmount;

            if (given <= 0) {
                changeLabel.innerText = 'Tiền thối lại cho khách:';
                changeAmount.innerText = '0 đ';
                changeAmount.style.color = '#64748b';
                changeWords.innerText = '(Chưa nhập tiền khách đưa)';
                if (changeBox) {
                    changeBox.style.borderColor = '#cbd5e1';
                    changeBox.style.background = '#ffffff';
                }
                return;
            }

            if (change >= 0) {
                changeLabel.innerText = '✓ TIỀN THỐI LẠI CHO KHÁCH:';
                changeAmount.innerText = Number(change).toLocaleString('vi-VN') + ' đ';
                changeAmount.style.color = '#15803d';
                changeWords.innerText = '(' + numberToVietnameseWords(Math.round(change)) + ')';
                if (changeBox) {
                    changeBox.style.borderColor = '#86efac';
                    changeBox.style.background = '#f0fdf4';
                }
            } else {
                var shortage = Math.abs(change);
                changeLabel.innerText = '⚠️ CÒN THIẾU (KHÁCH ĐƯA CHƯA ĐỦ):';
                changeAmount.innerText = Number(shortage).toLocaleString('vi-VN') + ' đ';
                changeAmount.style.color = '#dc2626';
                changeWords.innerText = '(Thiếu ' + numberToVietnameseWords(Math.round(shortage)) + ')';
                if (changeBox) {
                    changeBox.style.borderColor = '#fca5a5';
                    changeBox.style.background = '#fef2f2';
                }
            }
        }

        function setCashGiven(val, requiredAmount) {
            var input = document.getElementById('calc-cash-given');
            if (input) {
                input.value = val;
                calculateCashChange(requiredAmount);
            }
        }

        function addCashGiven(val, requiredAmount) {
            var input = document.getElementById('calc-cash-given');
            if (input) {
                var current = parseFloat(input.value) || 0;
                input.value = current + val;
                calculateCashChange(requiredAmount);
            }
        }

        function clearCashGiven(requiredAmount) {
            var input = document.getElementById('calc-cash-given');
            if (input) {
                input.value = '';
                calculateCashChange(requiredAmount);
                input.focus();
            }
        }

        // 3. CHUYỂN ĐỔI PHƯƠNG THỨC THU TIỀN (TIỀN MẶT / VIETQR) KHI THU THÊM VIỆN PHÍ
        function selectSettleMethod(method) {
            currentSettleMethod = method;
            var btnCash = document.getElementById('btn-settle-cash');
            var btnBank = document.getElementById('btn-settle-bank');
            var calcPanel = document.getElementById('settle-cash-calc-panel');
            var qrPanel = document.getElementById('settle-vietqr-panel');

            if (btnCash && btnBank) {
                if (method === 'Cash') {
                    btnCash.style.borderColor = '#15803d';
                    btnCash.style.background = '#f0fdf4';
                    btnBank.style.borderColor = '#cbd5e1';
                    btnBank.style.background = '#ffffff';
                    if (calcPanel) calcPanel.style.display = 'block';
                    if (qrPanel) qrPanel.style.display = 'none';
                } else {
                    btnBank.style.borderColor = '#15803d';
                    btnBank.style.background = '#f0fdf4';
                    btnCash.style.borderColor = '#cbd5e1';
                    btnCash.style.background = '#ffffff';
                    if (calcPanel) calcPanel.style.display = 'none';
                    if (qrPanel) {
                        qrPanel.style.display = 'block';
                        loadSettleVietQr();
                    }
                }
            }
        }

        async function loadSettleVietQr() {
            const reqSeq = ++settleQrSeq;
            var container = document.getElementById('current-invoice-data-container');
            var appId = container ? parseInt(container.getAttribute('data-appointment-id')) : 0;
            if (!appId) return;

            var netDiffElem = document.getElementById('val-net-diff');
            var netDiff = netDiffElem ? Math.max(0, parseFloat(netDiffElem.getAttribute('data-net')) || 0) : 0;
            if (netDiff <= 0) return;

            var img = document.getElementById('settle-qr-img');
            if (img) img.removeAttribute('src');

            try {
                var url = '@Url.Action("GenerateQr", "Cashier", new { area = "Staff" })?appointmentId=' + appId + '&customAmount=' + netDiff;
                var res = await fetch(url);
                var data = await res.json();
                var activeContainer = document.getElementById('current-invoice-data-container');
                var activeAppId = activeContainer ? parseInt(activeContainer.getAttribute('data-appointment-id')) : 0;
                if (reqSeq !== settleQrSeq || activeAppId !== appId) return;

                if (res.ok && data.qrDataUri) {
                    img = document.getElementById('settle-qr-img');
                    if (img) img.src = data.qrDataUri;
                    var bTitle = document.getElementById('settle-qr-bank');
                    if (bTitle) bTitle.innerText = 'Ngân hàng: ' + data.bankName + ' (' + data.bankCode + ')';
                    var acc = document.getElementById('settle-qr-acc');
                    if (acc) acc.innerText = data.accountNumber;
                    var holder = document.getElementById('settle-qr-holder');
                    if (holder) holder.innerText = data.accountHolder;
                    var amt = document.getElementById('settle-qr-amount');
                    if (amt) amt.innerText = Number(data.amount).toLocaleString('vi-VN') + ' đ';
                    var msg = document.getElementById('settle-qr-msg');
                    if (msg) msg.innerText = data.message;
                }
            } catch (err) {
                console.error('Không thể tạo mã VietQR quyết toán:', err);
            }
        }

        function copyText(text) {
            if (!text) return;
            navigator.clipboard.writeText(text).then(function() {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'Đã sao chép: ' + text,
                    showConfirmButton: false,
                    timer: 1800,
                    timerProgressBar: true
                });
            }).catch(function() {
                prompt('Sao chép nội dung:', text);
            });
        }

        // 4. THỰC HIỆN QUYẾT TOÁN VIỆN PHÍ & HOÀN TIỀN MẶT TẠM ỨNG DƯ
        async function submitSettleDischarge(appId) {
            if (!isShiftOpen) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Chưa mở ca thu ngân',
                    text: 'Vui lòng mở ca thu ngân trước khi thực hiện thu tiền & quyết toán.',
                    confirmButtonText: 'Mở ca ngay',
                    confirmButtonColor: '#15803d'
                });
                document.getElementById('modal-open-shift').showModal();
                return;
            }

            var refInput = document.getElementById('settle-ref-code');
            var refCode = refInput ? refInput.value.trim() : null;
            var noteInput = document.getElementById('settle-reason-note');
            var note = noteInput ? noteInput.value.trim() : null;
            var approvedByInput = document.getElementById('settle-approved-by');
            var approvedBy = approvedByInput ? approvedByInput.value.trim() : null;
            var sendEmailChk = document.getElementById('settle-send-email');
            var receiptEmailInput = document.getElementById('settle-receipt-email');
            var sendReceiptEmail = !!(sendEmailChk && sendEmailChk.checked);
            var receiptEmail = receiptEmailInput ? receiptEmailInput.value.trim() : '';

            if (sendReceiptEmail) {
                if (!receiptEmail) {
                    await Swal.fire({
                        icon: 'warning',
                        title: 'Chưa nhập email nhận biên lai',
                        text: 'Vui lòng nhập địa chỉ email của người bệnh hoặc bỏ chọn gửi biên lai qua email.',
                        confirmButtonColor: '#0284c7'
                    });
                    if (receiptEmailInput) receiptEmailInput.focus();
                    return;
                }
                var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!emailRegex.test(receiptEmail)) {
                    await Swal.fire({
                        icon: 'warning',
                        title: 'Email không hợp lệ',
                        text: 'Vui lòng kiểm tra lại định dạng email nhận biên lai.',
                        confirmButtonColor: '#0284c7'
                    });
                    if (receiptEmailInput) receiptEmailInput.focus();
                    return;
                }
            }

            var netElem = document.getElementById('val-net-diff');
            var netDiffVal = netElem ? parseFloat(netElem.getAttribute('data-net') || '0') : 0;

            if (netDiffVal > 0 && currentSettleMethod === 'Cash') {
                var cashGivenInput = document.getElementById('calc-cash-given');
                var cashGivenVal = cashGivenInput ? parseFloat(cashGivenInput.value) : 0;
                if (cashGivenVal > 0 && cashGivenVal < netDiffVal) {
                    await Swal.fire({
                        icon: 'warning',
                        title: 'Tiền khách đưa chưa đủ',
                        text: 'Số tiền khách đưa (' + cashGivenVal.toLocaleString('vi-VN') + ' đ) đang ít hơn số tiền cần thu thêm (' + netDiffVal.toLocaleString('vi-VN') + ' đ). Vui lòng kiểm tra lại!',
                        confirmButtonColor: '#15803d'
                    });
                    cashGivenInput.focus();
                    return;
                }
            }

            if (netDiffVal > 0 && currentSettleMethod === 'BankTransfer' && !refCode) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Thiếu mã giao dịch ngân hàng',
                    text: 'Vui lòng nhập mã chuẩn chi / giao dịch ngân hàng trước khi xác nhận.',
                    confirmButtonColor: '#15803d'
                });
                if (refInput) refInput.focus();
                return;
            }

            if (netDiffVal < 0) {
                if (!approvedBy) {
                    await Swal.fire({
                        icon: 'warning',
                        title: 'Thiếu thông tin người duyệt',
                        text: 'Vui lòng nhập họ tên Người duyệt hoàn tiền (Bác sĩ / Trưởng ca thu ngân).',
                        confirmButtonColor: '#15803d'
                    });
                    if (approvedByInput) approvedByInput.focus();
                    return;
                }
            }

            var emailNoteHtml = sendReceiptEmail
                ? '<br/><small style="color:#0369a1;">📧 Sẽ gửi biên lai điện tử tới: <b>' + escapeHtml(receiptEmail) + '</b></small>'
                : '';

            var confirmRes = await Swal.fire({
                icon: 'question',
                title: netDiffVal < 0 ? 'Xác nhận hoàn trả tiền thừa?' : 'Xác nhận thu tiền & quyết toán?',
                html: (netDiffVal < 0
                    ? 'Xác nhận cấn trừ viện phí và <b>CHI HOÀN TIỀN MẶT ' + Math.abs(netDiffVal).toLocaleString('vi-VN') + ' đ</b> cho người bệnh?<br/><small style="color:#475569;">Người duyệt: ' + escapeHtml(approvedBy) + '</small>'
                    : (netDiffVal > 0
                        ? 'Xác nhận thu đủ <b>' + netDiffVal.toLocaleString('vi-VN') + ' đ</b> (' + (currentSettleMethod === 'BankTransfer' ? 'Chuyển khoản VietQR' : 'Tiền mặt') + ') và hoàn tất quyết toán viện phí?'
                        : 'Xác nhận cấn trừ tạm ứng đủ 100% và hoàn tất quyết toán viện phí?')) + emailNoteHtml,
                showCancelButton: true,
                confirmButtonText: '✓ Xác nhận ngay',
                cancelButtonText: 'Hủy',
                confirmButtonColor: netDiffVal < 0 ? '#15803d' : '#15803d',
                cancelButtonColor: '#64748b'
            });

            if (!confirmRes.isConfirmed) {
                return;
            }

            var btn = document.getElementById('btn-settle-discharge');
            if (btn) {
                btn.disabled = true;
                btn.innerText = '⏳ Đang xử lý quyết toán...';
            }

            // Khi hoàn tiền cho khách (netDiffVal < 0), luôn chi hoàn bằng Tiền mặt (0)
            var finalMethod = netDiffVal < 0 ? 0 : (currentSettleMethod === 'BankTransfer' ? 1 : 0);
            var idempotencyKey = getOrCreateIdempotencyKey(appId);

            try {
                var token = getAntiForgeryToken();
                var postUrl = '@Url.Action("SettleDischarge", "Cashier", new { area = "Staff" })';
                var res = await fetch(postUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        appointmentId: appId,
                        method: finalMethod,
                        referenceCode: refCode,
                        note: note,
                        approvedBy: approvedBy,
                        idempotencyKey: idempotencyKey,
                        receiptEmail: sendReceiptEmail ? receiptEmail : null,
                        sendReceiptEmail: sendReceiptEmail,
                        cashierAccountId: 0
                    })
                });

                var data = null;
                try {
                    data = await res.json();
                } catch (e) {
                    throw new Error('Máy chủ phản hồi không đúng định dạng. Vui lòng kiểm tra lại ca thu ngân.');
                }

                if (res.ok && data.success) {
                    var chipStatus = document.getElementById('app-chip-status-' + appId);
                    if (chipStatus) {
                        chipStatus.style.background = '#15803d';
                        chipStatus.style.color = '#ffffff';
                        chipStatus.innerText = '✓ Đã tất toán';
                    }

                    await selectAppointment(appId, document.getElementById('app-card-' + appId));

                    await Swal.fire({
                        icon: 'success',
                        title: netDiffVal < 0 ? 'Hoàn tiền & Quyết toán thành công!' : 'Thu viện phí thành công!',
                        text: data.message || 'Hồ sơ viện phí đã được quyết toán hoàn tất.',
                        showCancelButton: true,
                        confirmButtonText: '🖨️ In bảng kê & Hóa đơn',
                        cancelButtonText: 'Đóng',
                        confirmButtonColor: '#15803d',
                        cancelButtonColor: '#64748b'
                    }).then(function(result) {
                        if (result.isConfirmed) {
                            printDischargeSettlement();
                        }
                    });
                } else {
                    await Swal.fire({
                        icon: 'error',
                        title: 'Không thể quyết toán',
