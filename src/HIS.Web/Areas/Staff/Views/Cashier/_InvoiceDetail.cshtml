@model HIS.BLL.DTOs.InvoiceDetailDto
@inject Microsoft.Extensions.Options.IOptions<HIS.BLL.Options.BillingOptions> BillingOptionsAccessor
@{
    var shift = ViewBag.CurrentShift as HIS.BLL.DTOs.CashierShiftDto;
    string search = (ViewBag.Search as string) ?? "";
    var billingOpts = BillingOptionsAccessor.Value;
    var insurancePlans = ViewBag.InsurancePlans as IReadOnlyList<HIS.BLL.DTOs.InsurancePlanOptionDto> ?? Array.Empty<HIS.BLL.DTOs.InsurancePlanOptionDto>();
}

@if (Model == null)
{
    @if (string.IsNullOrWhiteSpace(search))
    {
        <div class="empty-state">
            <div class="empty-state-icon">@await Html.PartialAsync("_AdminIcon", "wallet")</div>
            <h3>Tra cứu viện phí</h3>
            <p>Nhập Mã bệnh nhân hoặc số CCCD ở trên để thu tiền, trừ BHYT và tất toán tạm ứng.</p>
        </div>
    }
    else
    {
        <div class="empty-state err">
            <div class="empty-state-icon">@await Html.PartialAsync("_AdminIcon", "search")</div>
            <h3>Không tìm thấy hồ sơ</h3>
            <p>Không có hồ sơ viện phí chưa thanh toán nào khớp với <strong>"@search"</strong>.</p>
        </div>
    }
}
else
{
    var patientFee = Model.PatientAmount;
    var depositBal = (Model.Status == HIS.Domain.InvoiceStatus.Paid && (Model.DepositDeducted + Model.DepositRefundedAmount) > 0)
        ? (Model.DepositDeducted + Model.DepositRefundedAmount)
        : Model.AvailableDepositBalance;
    var netDiff = patientFee - depositBal;
    var refundAmount = Math.Abs(netDiff);
    var postPaymentInvoiceRefund = Math.Max(0m, Model.RefundedAmount - Model.DepositRefundedAmount);
    var maxInvoiceRefundable = Math.Max(0m, Model.PatientAmount - postPaymentInvoiceRefund);
    bool isVisitCompleted = Model.AppointmentStatusId == (int)HIS.Domain.AppointmentStatusId.Completed;

    <div id="current-invoice-data-container"
         data-invoice-id="@Model.InvoiceId"
         data-appointment-id="@Model.AppointmentId"
         data-appointment-code="@Model.AppointmentCode"
         data-patient-name="@Model.PatientName"
         data-patient-code="@Model.PatientCode"
         data-patient-phone="@Model.PatientPhone"
         data-patient-cccd="@(Model.NationalId ?? "")"
         data-patient-address="@(Model.Address ?? "")"
         data-diagnosis="@(Model.Diagnosis ?? "Khám chuyên khoa")"
         data-card-number="@(Model.InsuranceCardNumber ?? "")"
         data-coverage-pct="@Model.CoveragePct"
         data-department="@Model.DepartmentName"
         data-doctor="@Model.DoctorName"
         data-exam-date="@Model.ExamDate.ToString("dd/MM/yyyy")"
         data-total-amount="@Model.TotalAmount"
         data-insurance-covered="@Model.InsuranceCoveredAmount"
         data-patient-amount="@Model.PatientAmount"
         data-deposit-balance="@depositBal"
         data-status="@Model.Status"
         data-invoice-number="@(Model.InvoiceNumber ?? "")"
         data-cashier-name="@(Model.CashierName ?? (shift?.CashierName ?? "Thu ngân"))"
         style="display: none;"></div>

    <!-- 1. Thông tin hành chính, lâm sàng & BHYT -->
    <div class="invoice-header-grid">
        <div>
            <div class="invoice-badges">
                <span class="status-badge ok mono">MÃ BN: @Model.PatientCode</span>
                <span class="status-badge muted mono">LƯỢT KHÁM: @Model.AppointmentCode</span>
                @if (Model.Status == HIS.Domain.InvoiceStatus.Paid)
                {
                    <span class="status-badge ok">Đã quyết toán</span>
                }
                else
                {
                    <span class="status-badge warn">Chờ quyết toán</span>
                }
            </div>

            <h2 class="invoice-patient-name">@Model.PatientName</h2>

            <div class="patient-meta-grid">
                <div>Giới tính / Tuổi: <strong>@Model.Gender · @Model.Age tuổi</strong> (@Model.DateOfBirth.ToString("dd/MM/yyyy"))</div>
                <div>Điện thoại: <strong>@Model.PatientPhone</strong></div>
                <div>Số CCCD/ĐDCN: <strong class="mono num-pos">@(string.IsNullOrWhiteSpace(Model.NationalId) ? "Chưa cập nhật" : Model.NationalId)</strong></div>
                <div>Địa chỉ: <strong>@(string.IsNullOrWhiteSpace(Model.Address) ? "TP. Hồ Chí Minh" : Model.Address)</strong></div>
            </div>

            <div class="clinical-box">
                <div>
                    <strong>Chẩn đoán lâm sàng:</strong> <strong>@(Model.Diagnosis ?? "Khám và theo dõi chuyên khoa")</strong>
                </div>
                <small>
                    Khoa điều trị: <strong>@Model.DepartmentName</strong> · Bác sĩ chỉ định: <strong>@(Model.DoctorName.StartsWith("BS") ? Model.DoctorName : "BS. " + Model.DoctorName)</strong> · Ngày khám: <strong>@Model.ExamDate.ToString("dd/MM/yyyy")</strong>
                </small>
            </div>
        </div>

        <div class="bhyt-card @(Model.HasInsurance ? "insured" : "")">
            @if (Model.HasInsurance)
            {
                <div>
                    <div class="bhyt-top">
                        <span class="status-badge ok">BHYT đúng tuyến</span>
                        <span style="font-size: 12px; color: #166534; font-weight: 700;">Mức hưởng: @Model.CoveragePct.ToString("0.##")%</span>
                    </div>
                    <div class="bhyt-number mono">Mã thẻ: @Model.InsuranceCardNumber</div>
                    <div style="font-size: 12px; color: #166534; margin-top: 4px;">
                        Nơi ĐKKCB ban đầu: <strong>@(Model.RegisteredFacility ?? "Bệnh viện Đa khoa MediCare")</strong>
                    </div>
                </div>
                <div class="bhyt-footer">
                    <span style="color: #166534; font-weight: 600;">Quỹ BHYT thanh toán:</span>
                    <strong class="num-pos" style="font-size: 15px;">@Model.InsuranceCoveredAmount.ToString("N0") đ</strong>
                </div>
            }
            else
            {
                <div>
                    <div class="bhyt-top">
                        <span class="status-badge muted">Khám dịch vụ / Tự túc</span>
                    </div>
                    <div style="font-size: 12.5px; color: #475569; margin-top: 6px; line-height: 1.5;">
                        Tự chi trả 100% theo bảng giá dịch vụ.
                    </div>
                </div>
                <div class="bhyt-footer">
                    <span style="color: #64748b; font-weight: 600;">Mức hưởng BHYT:</span>
                    <strong style="color: #64748b;">0% (0 đ)</strong>
                </div>
            }
            @if (Model.Status != HIS.Domain.InvoiceStatus.Paid)
            {
                <div style="margin-top: 10px; text-align: right;">
                    <button type="button" class="btn outline" onclick="openBhytModal()"
                            style="padding: 5px 12px; font-size: 12px; font-weight: 700; background: #ffffff; border-color: #0284c7; color: #0369a1; cursor: pointer;">
                        💳 @(Model.HasInsurance ? "Sửa / Đổi thẻ BHYT" : "Khai báo thẻ BHYT")
                    </button>
                </div>
            }
        </div>
    </div>

    <div class="section-bar">
        <h3>I. Chi tiết dịch vụ &amp; thuốc</h3>
        <span>@Model.Items.Count khoản mục</span>
    </div>

    <div class="card" style="margin-bottom: 16px; overflow: hidden;">
        <div class="table-wrap">
            <table class="cashier-table">
                <thead>
                    <tr>
                        <th class="center" style="width: 52px;">STT</th>
                        <th>Nhóm / Tên dịch vụ &amp; thuốc chỉ định</th>
                        <th class="center" style="width: 60px;">SL</th>
                        <th class="right" style="width: 110px;">Đơn giá</th>
                        <th class="right" style="width: 120px;">Thành tiền</th>
                        <th class="center" style="width: 75px;">% BHYT</th>
                        <th class="right" style="width: 110px;">BHYT trả</th>
                        <th class="right" style="width: 120px;">BN tự trả</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="center">@item.Id</td>
                            <td>
                                <span class="status-badge ok" style="margin-right: 6px;">@item.Category</span>
                                <strong>@item.Description</strong>
                            </td>
                            <td class="center">@item.Quantity</td>
                            <td class="right mono">@item.UnitPrice.ToString("N0")</td>
                            <td class="right mono"><strong>@item.Total.ToString("N0")</strong></td>
                            <td class="center">
                                @if (item.IsInsuranceCovered && item.CoveragePctApplied > 0)
                                {
                                    <span class="num-pos">@item.CoveragePctApplied.ToString("0.##")%</span>
                                }
                                else
                                {
                                    <span style="color: #94a3b8;">0%</span>
                                }
                            </td>
                            <td class="right mono num-pos">@item.CoveredAmount.ToString("N0")</td>
                            <td class="right mono num-neg">@item.PatientAmount.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background: #f8fafc; font-weight: 700;">
                        <td colspan="4" class="right">TỔNG CỘNG CHI PHÍ DỊCH VỤ &amp; THUỐC:</td>
                        <td class="right mono">@Model.TotalAmount.ToString("N0") đ</td>
                        <td></td>
                        <td class="right mono num-pos">@Model.InsuranceCoveredAmount.ToString("N0") đ</td>
                        <td class="right mono num-neg" id="txt-patient-amount" data-total="@Model.PatientAmount">@Model.PatientAmount.ToString("N0") đ</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    @if (Model.PatientDeposits != null && Model.PatientDeposits.Count > 0)
    {
        <div style="margin-bottom: 16px;">
            <div class="section-bar">
                <h3>II. Tạm ứng đã nộp (@Model.PatientDeposits.Count phiếu)</h3>
                <span class="num-pos">Tổng: @depositBal.ToString("N0") đ</span>
            </div>
            <div class="card" style="overflow: hidden;">
                <div class="table-wrap">
                    <table class="cashier-table">
                        <thead>
                            <tr>
                                <th>Mã phiếu</th>
                                <th>Thời gian thu</th>
                                <th>Mục đích tạm ứng</th>
                                <th>Người duyệt / Chỉ định</th>
                                <th class="center">Hình thức</th>
                                <th class="right">Số tiền nộp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dep in Model.PatientDeposits)
                            {
                                <tr>
                                    <td class="mono num-pos"><strong>@dep.DepositCode</strong></td>
                                    <td>@dep.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><strong>@(dep.Purpose ?? "Tạm ứng viện phí")</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(dep.ApprovedBy) ? (Model.DoctorName.StartsWith("BS") ? Model.DoctorName : $"BS. {Model.DoctorName}") : dep.ApprovedBy)</td>
                                    <td class="center">@(dep.PaymentMethod == HIS.Domain.PaymentMethod.Cash ? "Tiền mặt" : "Chuyển khoản")</td>
                                    <td class="right mono num-pos"><strong>@dep.Amount.ToString("N0") đ</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- 4. Khối quyết toán -->
    @if (Model.Status == HIS.Domain.InvoiceStatus.Paid)
    {
        <div class="settlement-box paid">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 12px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span class="status-badge ok">Đã hoàn tất quyết toán</span>
                    <strong style="color: #166534; font-size: 15px;">Số hóa đơn: @Model.InvoiceNumber</strong>
                </div>
                <div style="font-size: 12.5px; color: #334155;">
                    Mã chứng từ: <strong class="mono">@Model.TransactionCode</strong>
                </div>
            </div>

            <div style="background: #ffffff; padding: 12px 16px; border-radius: 8px; border: 1px solid #bbf7d0; margin-bottom: 14px;">
                <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; font-size: 12.5px;">
                    <div>Thời gian quyết toán: <strong>@(Model.PaidAt?.ToString("HH:mm, dd/MM/yyyy") ?? DateTime.Now.ToString("HH:mm, dd/MM/yyyy"))</strong></div>
                    <div>Phương thức: <strong>@(Model.PaymentMethod ?? "Tiền mặt")</strong> · Thu ngân: <strong>@(Model.CashierName ?? (shift?.CashierName ?? "Thu ngân"))</strong></div>
                </div>
                <div style="margin-top: 10px; padding-top: 10px; border-top: 1px dashed #cbd5e1; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px;">
                    <div>
                        <small>Viện phí BN tự trả</small><br />
                        <strong>@Model.PatientAmount.ToString("N0") đ</strong>
                    </div>
                    <div>
                        <small>Tạm ứng đã nộp</small><br />
                        <strong class="num-pos">@depositBal.ToString("N0") đ</strong>
                    </div>
                    <div>
                        <small>Đã cấn trừ tạm ứng</small><br />
                        <strong>@Model.DepositDeducted.ToString("N0") đ</strong>
                    </div>
                    <div>
                        @if (Model.DepositRefundedAmount > 0)
                        {
                            <small>Đã hoàn tiền mặt cho BN</small><br />
                            <strong class="num-neg">@Model.RefundedAmount.ToString("N0") đ</strong>
                        }
                        else if (Model.AdditionalPaid > 0)
                        {
                            <small>Đã thu thêm</small><br />
                            <strong class="num-pos">@Model.AdditionalPaid.ToString("N0") đ</strong>
                        }
                        else if (Model.DepositDeducted > 0)
                        {
                            <small>Đã thu thêm tại quầy</small><br />
                            <strong class="num-pos">0 đ</strong>
                        }
                        else
                        {
                            <small>Đã thu tại quầy</small><br />
                            <strong class="num-pos">@Model.PatientAmount.ToString("N0") đ</strong>
                        }
                        @if (postPaymentInvoiceRefund > 0)
                        {
                            <div style="font-size: 11.5px; color: #b91c1c; font-weight: 700; margin-top: 4px;">
                                Đã hoàn viện phí sau thu: @postPaymentInvoiceRefund.ToString("N0") đ
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap;">
                @if (shift != null && maxInvoiceRefundable > 0)
                {
                    <button type="button" class="btn outline" onclick="openRefundInvoiceModal()"
                            style="border-color: #fca5a5; color: #b91c1c;">
                        Hoàn viện phí / Điều chỉnh
                    </button>
                }
                <a asp-area="Staff" asp-controller="Cashier" asp-action="Receipt" asp-route-appointmentId="@Model.AppointmentId"
                   target="_blank" rel="noopener" class="btn outline">
                    Xem biên lai thu viện phí
                </a>
                <button type="button" class="btn primary" onclick="printDischargeSettlement()">
                    In bảng kê &amp; biên lai quyết toán (Mẫu C40-HD)
                </button>
            </div>
        </div>
    }
    else if (!isVisitCompleted)
    {
        <!-- TRƯỜNG HỢP: CA KHÁM CHƯA HOÀN TẤT TẠI PHÒNG BÁC SĨ -> CHẶN QUYẾT TOÁN SỚM, CHỈ CHO THU TẠM ỨNG -->
        <div style="background: #fffbeb; border: 1.5px solid #f59e0b; border-radius: 10px; padding: 18px 20px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap;">
                <div style="flex: 1; min-width: 280px;">
                    <span style="background: #d97706; color: #ffffff; font-size: 11.5px; font-weight: 800; padding: 3px 10px; border-radius: 4px; text-transform: uppercase;">
                        ⏳ CHƯA ĐỦ ĐIỀU KIỆN QUYẾT TOÁN RA VIỆN
                    </span>
                    <h4 style="margin: 10px 0 6px; font-size: 16px; font-weight: 800; color: #78350f;">
                        Lượt khám đang ở trạng thái: "@Model.AppointmentStatusName"
                    </h4>
                    <p style="margin: 0; font-size: 13.5px; color: #92400e; line-height: 1.55;">
                        Bác sĩ chưa kết thúc khám và lưu hồ sơ bệnh án nên <strong>chỉ định cận lâm sàng &amp; đơn thuốc có thể chưa đầy đủ</strong>.
                        Nếu chốt hóa đơn ngay lúc này sẽ làm khóa sổ và bỏ sót tiền xét nghiệm/thuốc phát sinh sau đó.
                    </p>
                </div>
                <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                    <a asp-area="Staff" asp-controller="Cashier" asp-action="Deposits" asp-route-search="@Model.PatientCode"
                       class="btn primary" style="padding: 10px 16px; font-size: 13px; font-weight: 700; text-decoration: none; background: #0284c7; border-color: #0284c7;">
                        💰 Thu tạm ứng trước cho BN
                    </a>
                    <button type="button" class="btn outline" onclick="selectAppointment(@Model.AppointmentId)"
                            style="padding: 10px 16px; font-size: 13px; font-weight: 700; background: #ffffff; cursor: pointer;">
                        🔄 Kiểm tra lại trạng thái
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="settlement-box">
            <div class="section-bar" style="margin-bottom: 12px;">
                <h3>@(Model.PatientDeposits != null && Model.PatientDeposits.Count > 0 ? "III. Quyết toán" : "II. Quyết toán")</h3>
            </div>

            <div class="settlement-summary-grid">
                <div class="summary-tile">
                    <div class="tile-label">Tổng chi phí BN phải trả</div>
                    <div class="tile-val">@patientFee.ToString("N0") đ</div>
                    <div class="tile-sub">Sau khi trừ BHYT (@Model.InsuranceCoveredAmount.ToString("N0") đ)</div>
                </div>
                <div class="summary-tile">
                    <div class="tile-label">Tiền tạm ứng đã nộp</div>
                    <div class="tile-val num-pos">@depositBal.ToString("N0") đ</div>
                    <div class="tile-sub">@(depositBal > 0 ? $"Khấu trừ viện phí: {Math.Min(depositBal, patientFee):N0} đ" : "Chưa có tạm ứng")</div>
                </div>
                <div class="summary-tile @(netDiff > 0 ? "highlight-due" : "highlight-ok")">
                    <div class="tile-label" style="color: @(netDiff > 0 ? "#dc2626" : "#107c41");">
                        @(netDiff > 0 ? "Số tiền cần thu thêm" : (netDiff < 0 ? "Số tiền hoàn trả cho BN" : "Cân đối vừa đủ"))
                    </div>
                    <div class="tile-val" style="color: @(netDiff > 0 ? "#dc2626" : "#107c41");" id="val-net-diff" data-net="@netDiff">
                        @(Math.Abs(netDiff).ToString("N0")) đ
                    </div>
                    <div class="tile-sub">
                        @(netDiff > 0 ? "Thu tiền mặt hoặc quét VietQR" : (netDiff < 0 ? "Chi hoàn tiền mặt trực tiếp tại quầy" : "Không phát sinh thu/chi thêm"))
                    </div>
                </div>
            </div>

            <!-- TÙY CHỌN GỬI BIÊN LAI ĐIỆN TỬ QUA EMAIL (CHẠY NỀN, KHÔNG CHẶN THANH TOÁN) -->
            <div style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px 16px; margin-bottom: 14px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px;">
                <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #1e293b; cursor: pointer; margin: 0;">
                    <input type="checkbox" id="settle-send-email" @(!string.IsNullOrWhiteSpace(Model.PatientEmail) ? "checked" : null) onchange="toggleReceiptEmailInput()" style="width: 16px; height: 16px; accent-color: #0284c7;" />
                    📧 Gửi biên lai điện tử qua email (tùy chọn)
                </label>
                <input type="email" id="settle-receipt-email" value="@(Model.PatientEmail ?? "")" maxlength="100"
                       placeholder="Nhập email người bệnh nhận biên lai (để trống nếu không gửi)..."
                       style="flex: 1; min-width: 240px; padding: 7px 12px; font-size: 13px; border: 1.5px solid #cbd5e1; border-radius: 6px;" />
                <span style="font-size: 11.5px; color: #64748b;">Chỉ gửi thông tin tài chính, không gồm chẩn đoán bệnh.</span>
            </div>

            @if (netDiff > 0)
            {
                <div class="card card-body">
                    <div class="pay-method-grid">
                        <button type="button" class="pay-method-btn active" id="btn-settle-cash" onclick="selectSettleMethod('Cash')">
                            Thu Tiền mặt (@netDiff.ToString("N0") đ)
                        </button>
                        <button type="button" class="pay-method-btn" id="btn-settle-bank" onclick="selectSettleMethod('BankTransfer')">
                            Thu Chuyển khoản VietQR (@netDiff.ToString("N0") đ)
                        </button>
                    </div>

                    <div id="settle-cash-calc-panel" class="cash-calc-panel">
                        <div class="cash-calc-grid">
                            <div>
                                <label for="calc-cash-given" style="display: block; margin-bottom: 6px;">
                                    Tiền khách đưa (VNĐ)
                                </label>
                                <div style="display: flex; gap: 6px;">
                                    <input type="number" id="calc-cash-given" min="0" step="1000"
                                           placeholder="Nhập số tiền khách đưa..."
                                           style="flex: 1; height: 38px; padding: 0 12px; font-weight: 700; color: #107c41;"
                                           oninput="calculateCashChange(@netDiff)" />
                                    <button type="button" class="btn outline" onclick="clearCashGiven(@netDiff)">Xóa</button>
                                </div>

                                <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px;">
                                    <button type="button" class="btn outline sm" onclick="setCashGiven(@netDiff, @netDiff)">
                                        Vừa đủ (@netDiff.ToString("N0") đ)
                                    </button>
                                    @if (netDiff <= 100000)
                                    {
                                        <button type="button" class="btn outline sm" onclick="setCashGiven(100000, @netDiff)">100.000</button>
                                    }
                                    @if (netDiff <= 200000)
                                    {
                                        <button type="button" class="btn outline sm" onclick="setCashGiven(200000, @netDiff)">200.000</button>
                                    }
                                    @if (netDiff <= 500000)
                                    {
                                        <button type="button" class="btn outline sm" onclick="setCashGiven(500000, @netDiff)">500.000</button>
                                    }
                                    <button type="button" class="btn outline sm" onclick="setCashGiven(1000000, @netDiff)">1.000.000</button>
                                    <button type="button" class="btn outline sm" onclick="addCashGiven(50000, @netDiff)">+50k</button>
                                    <button type="button" class="btn outline sm" onclick="addCashGiven(100000, @netDiff)">+100k</button>
                                </div>
                            </div>

                            <div id="calc-change-box" class="change-box">
                                <div style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase;" id="calc-change-label">Tiền thừa thối lại cho khách:</div>
                                <div style="font-size: 20px; font-weight: 800; color: #15803d; margin: 4px 0;" id="calc-change-amount">0 đ</div>
                                <div style="font-size: 11.5px; color: #475569; font-style: italic;" id="calc-change-words">(Không đồng)</div>
                            </div>
                        </div>
                    </div>

                    <div id="settle-vietqr-panel" class="vietqr-panel" style="display: none;">
                        <div style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap;">
                            <div style="text-align: center; flex-shrink: 0;">
                                <img id="settle-qr-img" src="" alt="Mã VietQR Quyết toán" style="width: 150px; height: 150px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff;" />
                                <div style="font-size: 11px; color: #64748b; margin-top: 3px;">Quét mã để chuyển khoản</div>
                            </div>
                            <div style="flex: 1; font-size: 13px; color: #334155; line-height: 1.65;">
                                <div style="font-weight: 700; color: #0f172a; font-size: 14px;" id="settle-qr-bank">Ngân hàng: VietinBank (970415)</div>
                                <div>Số tài khoản: <strong id="settle-qr-acc" class="mono">119002953584</strong></div>
                                <div>Chủ tài khoản: <strong id="settle-qr-holder">BENH VIEN MEDICARE</strong></div>
                                <div>Số tiền thanh toán: <strong id="settle-qr-amount" class="num-neg">@netDiff.ToString("N0") đ</strong></div>
                                <div>Nội dung CK: <strong id="settle-qr-msg" class="mono num-pos">HIS @Model.AppointmentCode</strong></div>
                            </div>
                        </div>

                        <div style="margin-top: 10px;">
                            <label for="settle-ref-code" style="display: block; margin-bottom: 4px;">
                                Mã chuẩn chi / Giao dịch ngân hàng sau khi khách quét QR *
                            </label>
                            <input type="text" id="settle-ref-code" placeholder="Nhập mã giao dịch ngân hàng (VD: FT26318...)..." style="width: 100%; height: 36px; padding: 0 12px;" />
                        </div>
                    </div>

                    @if (shift != null)
                    {
                        <button type="button" class="btn primary" id="btn-settle-discharge" onclick="submitSettleDischarge(@Model.AppointmentId)" style="width: 100%; min-height: 42px; font-size: 14px;">
                            Xác nhận thu @netDiff.ToString("N0") đ &amp; in hóa đơn
                        </button>
                    }
                    else
                    {
                        <div class="flash-banner warn">
                            <span>Vui lòng mở ca thu ngân trước khi thu tiền.</span>
                        </div>
                    }
                </div>
            }
            else if (netDiff < 0)
            {
                <div class="card card-body" style="border-color: #107c41;">
                    <div class="refund-summary-row">
                        <div>
                            <strong style="color: #15803d; font-size: 13.5px;">Hoàn trả tiền mặt tại quầy</strong>
                            <div style="font-size: 12.5px; color: #475569; margin-top: 4px;">
                                Đã trừ <strong>@patientFee.ToString("N0") đ</strong> viện phí từ tạm ứng.
                            </div>
                        </div>
                        <div class="refund-amount-col">
                            <small>SỐ TIỀN HOÀN LẠI</small>
                            <div class="num-pos" style="font-size: 20px; font-weight: 800;">@refundAmount.ToString("N0") đ</div>
                        </div>
                    </div>

                    <div class="refund-form-grid">
                        <div>
                            <label for="settle-approved-by" style="display: block; margin-bottom: 4px;">Người duyệt *</label>
                            <input type="text" id="settle-approved-by" value="Kế toán trưởng" placeholder="Nhập người duyệt..." style="width: 100%; height: 36px; padding: 0 12px;" />
                        </div>
                        <div>
                            <label for="settle-reason-note" style="display: block; margin-bottom: 4px;">Lý do hoàn trả</label>
                            <input type="text" id="settle-reason-note" value="Hoàn trả số dư tạm ứng thừa" style="width: 100%; height: 36px; padding: 0 12px;" />
                        </div>
                    </div>

                    @if (shift != null)
                    {
                        <button type="button" class="btn primary" id="btn-settle-discharge" onclick="submitSettleDischarge(@Model.AppointmentId)" style="width: 100%; min-height: 42px; font-size: 14px;">
                            Xác nhận hoàn @refundAmount.ToString("N0") đ &amp; in bảng kê
                        </button>
                    }
                    else
                    {
                        <div class="flash-banner warn">
                            <span>Vui lòng mở ca thu ngân trước khi chi hoàn tiền mặt.</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card card-body" style="border-color: #107c41; text-align: center;">
                    <div style="font-size: 13.5px; font-weight: 600;" class="num-pos">
                        Tiền tạm ứng vừa đủ chi trả 100% viện phí (@patientFee.ToString("N0") đ) — Không phát sinh thu thêm hay hoàn tiền.
                    </div>
                    @if (shift != null)
                    {
                        <button type="button" class="btn primary" id="btn-settle-discharge" onclick="submitSettleDischarge(@Model.AppointmentId)" style="width: 100%; min-height: 42px; margin-top: 12px; font-size: 14px;">
                            Xác nhận cấn trừ đủ &amp; in hóa đơn quyết toán
                        </button>
                    }
                </div>
            }
        </div>
    }

    <!-- MODAL KHAI BÁO / CẬP NHẬT THẺ BHYT TẠI QUẦY THU NGÂN -->
    @if (Model.Status != HIS.Domain.InvoiceStatus.Paid)
    {
        var defaultValidFrom = (Model.InsuranceValidFrom ?? new DateOnly(Model.ExamDate.Year, 1, 1)).ToString("yyyy-MM-dd");
        var defaultValidTo = (Model.InsuranceValidTo ?? new DateOnly(Model.ExamDate.Year, 12, 31)).ToString("yyyy-MM-dd");
        <dialog id="modal-upsert-bhyt" style="border: none; border-radius: 12px; padding: 24px; max-width: 520px; width: 95%; box-shadow: 0 15px 35px rgba(0,0,0,0.25);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px;">
                <h3 style="margin: 0; font-size: 18px; color: #14532d;">💳 Đối chiếu &amp; cập nhật thẻ BHYT</h3>
                <button type="button" onclick="document.getElementById('modal-upsert-bhyt').close()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #64748b;">✕</button>
            </div>
            <p style="font-size: 12.5px; color: #475569; margin: 0 0 14px;">
                Người bệnh: <strong>@Model.PatientName</strong> (Mã BN: <strong>@Model.PatientCode</strong>) · Ngày khám: <strong>@Model.ExamDate.ToString("dd/MM/yyyy")</strong>
            </p>

            <div style="margin-bottom: 12px;">
                <label style="font-size: 12px; font-weight: 700; display: block; margin-bottom: 4px; color: #1e293b;">Mã số thẻ BHYT (10–20 ký tự) <span style="color: #dc2626;">*</span>:</label>
                <input type="text" id="bhyt-card-number" value="@(Model.InsuranceCardNumber ?? "")" maxlength="20" class="form-control"
                       placeholder="VD: DN4797938328001" style="width: 100%; padding: 8px 12px; font-size: 14px; font-weight: 700; font-family: monospace; text-transform: uppercase;" />
            </div>

            <div style="margin-bottom: 12px;">
                <label style="font-size: 12px; font-weight: 700; display: block; margin-bottom: 4px; color: #1e293b;">Nhóm đối tượng / Mức hưởng BHYT <span style="color: #dc2626;">*</span>:</label>
                <select id="bhyt-plan-id" class="form-control" style="width: 100%; padding: 8px 12px; font-size: 13.5px;">
                    @foreach (var p in insurancePlans)
                    {
                        <option value="@p.Id" selected="@(Model.InsurancePlanId == p.Id)">@p.Name (Mức hưởng: @p.CoveragePct.ToString("0.##")%)</option>
                    }
                </select>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                <div>
                    <label style="font-size: 12px; font-weight: 700; display: block; margin-bottom: 4px; color: #1e293b;">Giá trị từ ngày:</label>
                    <input type="date" id="bhyt-valid-from" value="@defaultValidFrom" class="form-control" style="width: 100%; padding: 8px 10px; font-size: 13px;" />
                </div>
                <div>
                    <label style="font-size: 12px; font-weight: 700; display: block; margin-bottom: 4px; color: #1e293b;">Đến hết ngày:</label>
                    <input type="date" id="bhyt-valid-to" value="@defaultValidTo" class="form-control" style="width: 100%; padding: 8px 10px; font-size: 13px;" />
                </div>
            </div>

            <div style="margin-bottom: 12px;">
                <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #166534; cursor: pointer;">
                    <input type="checkbox" id="bhyt-registered-here" @(Model.InsuranceIsRegisteredHere ? "checked" : null) style="width: 16px; height: 16px; accent-color: #15803d;" />
                    Đúng tuyến KCB (Đăng ký KCB ban đầu tại BV MediCare hoặc có giấy chuyển tuyến)
                </label>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="font-size: 12px; font-weight: 700; display: block; margin-bottom: 4px; color: #1e293b;">Nơi ĐKKCB ban đầu ghi trên thẻ:</label>
                <input type="text" id="bhyt-facility" value="@(Model.RegisteredFacility ?? "Bệnh viện Đa khoa MediCare")" maxlength="150" class="form-control"
                       style="width: 100%; padding: 8px 12px; font-size: 13px;" />
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px; border-top: 1px solid #e2e8f0; padding-top: 14px; flex-wrap: wrap;">
                <div>
                    @if (Model.HasInsurance)
                    {
                        <button type="button" class="btn outline" onclick="submitUpsertBhyt(@Model.AppointmentId, @Model.PatientId, false)"
                                style="padding: 8px 12px; font-size: 12.5px; color: #b91c1c; border-color: #fca5a5;">
                            Gỡ thẻ (Khám tự túc)
                        </button>
                    }
                </div>
                <div style="display: flex; gap: 8px;">
                    <button type="button" class="btn outline" onclick="document.getElementById('modal-upsert-bhyt').close()">Hủy</button>
                    <button type="button" class="btn primary" id="btn-save-bhyt" onclick="submitUpsertBhyt(@Model.AppointmentId, @Model.PatientId, true)"
                            style="background: #15803d; border-color: #15803d; font-weight: 700;">
                        ✓ Lưu thẻ &amp; tính lại BHYT
                    </button>
                </div>
            </div>
        </dialog>
    }

    <!-- MODAL HOÀN VIỆN PHÍ / ĐIỀU CHỈNH HÓA ĐƠN SAU THANH TOÁN -->
    @if (Model.Status == HIS.Domain.InvoiceStatus.Paid && maxInvoiceRefundable > 0)
    {
        <dialog id="modal-refund-invoice" style="border: none; border-radius: 12px; padding: 24px; max-width: 500px; width: 95%; box-shadow: 0 15px 35px rgba(0,0,0,0.25);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px;">
                <h3 style="margin: 0; font-size: 18px; color: #b91c1c;">↩️ Hoàn trả viện phí / Điều chỉnh hóa đơn</h3>
                <button type="button" onclick="document.getElementById('modal-refund-invoice').close()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #64748b;">✕</button>
            </div>
            <p style="font-size: 12.5px; color: #475569; margin: 0 0 12px;">
                Hóa đơn: <strong>@Model.InvoiceNumber</strong> · Người bệnh: <strong>@Model.PatientName</strong><br />
                Số tiền tối đa có thể hoàn: <strong style="color: #b91c1c;">@maxInvoiceRefundable.ToString("N0") đ</strong>
            </p>

            <div style="margin-bottom: 12px;">
                <label style="font-size: 12px; font-weight: 700; display: block; margin-bottom: 4px; color: #1e293b;">Số tiền hoàn trả (VNĐ) <span style="color: #dc2626;">*</span>:</label>
                <input type="number" id="refund-inv-amount" min="1000" max="@maxInvoiceRefundable" step="1000" value="@maxInvoiceRefundable" class="form-control"
                       style="width: 100%; padding: 8px 12px; font-size: 15px; font-weight: 800; color: #b91c1c;" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                <div>
                    <label style="font-size: 12px; font-weight: 700; display: block; margin-bottom: 4px; color: #1e293b;">Hình thức chi hoàn:</label>
                    <select id="refund-inv-method" class="form-control" onchange="toggleRefundInvRef()" style="width: 100%; padding: 8px 10px; font-size: 13px;">
                        <option value="0">💵 Tiền mặt tại quầy</option>
                        <option value="1">📱 Chuyển khoản ngân hàng</option>
                    </select>
                </div>
                <div>
                    <label style="font-size: 12px; font-weight: 700; display: block; margin-bottom: 4px; color: #1e293b;">Người duyệt hoàn:</label>
                    <input type="text" id="refund-inv-approver" value="Kế toán trưởng / Trưởng ca" class="form-control" style="width: 100%; padding: 8px 10px; font-size: 13px;" />
                </div>
            </div>

            <div id="refund-inv-ref-box" style="display: none; margin-bottom: 12px;">
                <label style="font-size: 12px; font-weight: 700; display: block; margin-bottom: 4px; color: #1e293b;">Mã giao dịch chuyển khoản hoàn <span style="color: #dc2626;">*</span>:</label>
                <input type="text" id="refund-inv-ref" class="form-control" placeholder="Nhập mã tham chiếu ngân hàng..." style="width: 100%; padding: 8px 12px; font-size: 13px;" />
            </div>

            <div style="margin-bottom: 16px;">
                <label style="font-size: 12px; font-weight: 700; display: block; margin-bottom: 4px; color: #1e293b;">Lý do hoàn viện phí <span style="color: #dc2626;">*</span>:</label>
                <input type="text" id="refund-inv-reason" class="form-control" placeholder="VD: Hủy dịch vụ cận lâm sàng theo chỉ định Bác sĩ..." style="width: 100%; padding: 8px 12px; font-size: 13px;" />
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 8px; border-top: 1px solid #e2e8f0; padding-top: 14px;">
                <button type="button" class="btn outline" onclick="document.getElementById('modal-refund-invoice').close()">Hủy</button>
                <button type="button" class="btn primary" id="btn-submit-refund-inv" onclick="submitRefundInvoice(@Model.AppointmentId, @Model.InvoiceId, @maxInvoiceRefundable)"
                        style="background: #dc2626; border-color: #dc2626; font-weight: 700;">
                    ✓ Xác nhận chi hoàn
                </button>
            </div>
        </dialog>
    }
}
