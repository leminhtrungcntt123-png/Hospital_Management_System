@model IReadOnlyList<HIS.BLL.DTOs.LedgerItemDto>
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Sổ nhật ký thu ngân";
    var filter = ViewBag.Filter as HIS.BLL.DTOs.LedgerFilterDto ?? new HIS.BLL.DTOs.LedgerFilterDto();
    var summary = ViewBag.Summary as HIS.BLL.DTOs.LedgerSummaryDto;
    var shifts = ViewBag.Shifts as IReadOnlyList<HIS.BLL.DTOs.CashierShiftDto> ?? Array.Empty<HIS.BLL.DTOs.CashierShiftDto>();

    decimal totalCash = Model.Where(p => p.PaymentMethod == HIS.Domain.PaymentMethod.Cash && (p.PaymentType == HIS.Domain.PaymentType.Payment || p.PaymentType == HIS.Domain.PaymentType.Deposit)).Sum(p => p.Amount);
    decimal totalTransfer = Model.Where(p => p.PaymentMethod == HIS.Domain.PaymentMethod.BankTransfer && (p.PaymentType == HIS.Domain.PaymentType.Payment || p.PaymentType == HIS.Domain.PaymentType.Deposit)).Sum(p => p.Amount);
    decimal totalRefund = Model.Where(p => p.PaymentType == HIS.Domain.PaymentType.Refund).Sum(p => p.Amount);
    decimal netTotal = totalCash + totalTransfer - totalRefund;
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff-cashier.css" asp-append-version="true" />
}

<div class="cashier-page">
    <div class="page-heading">
        <div>
            <span class="eyebrow">TÀI CHÍNH KẾ TOÁN</span>
            <h1>Sổ thu ngân</h1>
        </div>
        <div class="heading-actions">
            <a class="btn primary" asp-action="LedgerExport"
               asp-route-fromDate="@filter.FromDate" asp-route-toDate="@filter.ToDate" asp-route-method="@filter.Method" asp-route-type="@filter.Type">
                @await Html.PartialAsync("_AdminIcon", "download") Xuất CSV
            </a>
            <a class="btn outline" asp-action="Ledger">
                @await Html.PartialAsync("_AdminIcon", "refresh") Làm mới
            </a>
        </div>
    </div>

    <div class="kpi-grid">
        <article class="card stat-card">
            <span class="stat-icon">@await Html.PartialAsync("_AdminIcon", "wallet")</span>
            <div class="stat-body">
                <span class="stat-label">Thực thu ròng</span>
                <strong>@netTotal.ToString("N0") đ</strong>
            </div>
        </article>
        <article class="card stat-card">
            <span class="stat-icon">@await Html.PartialAsync("_AdminIcon", "wallet")</span>
            <div class="stat-body">
                <span class="stat-label">Tiền mặt</span>
                <strong>@totalCash.ToString("N0") đ</strong>
            </div>
        </article>
        <article class="card stat-card">
            <span class="stat-icon">@await Html.PartialAsync("_AdminIcon", "wallet")</span>
            <div class="stat-body">
                <span class="stat-label">Chuyển khoản / QR</span>
                <strong>@totalTransfer.ToString("N0") đ</strong>
            </div>
        </article>
        <article class="card stat-card">
            <span class="stat-icon">@await Html.PartialAsync("_AdminIcon", "refresh")</span>
            <div class="stat-body">
                <span class="stat-label">Hoàn trả</span>
                <strong class="num-neg">@totalRefund.ToString("N0") đ</strong>
            </div>
        </article>
    </div>

    <section class="card">
        <div class="card-body">
            <form asp-action="Ledger" method="get" class="filter-bar">
                <div class="filter-field">
                    <label for="ledger-from">Từ ngày</label>
                    <input id="ledger-from" type="date" name="FromDate" value="@(filter.FromDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="filter-field">
                    <label for="ledger-to">Đến ngày</label>
                    <input id="ledger-to" type="date" name="ToDate" value="@(filter.ToDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="filter-field">
                    <label for="ledger-method">Hình thức</label>
                    <select id="ledger-method" name="Method">
                        <option value="">Tất cả</option>
                        <option value="Cash" selected="@(filter.Method == HIS.Domain.PaymentMethod.Cash)">Tiền mặt</option>
                        <option value="BankTransfer" selected="@(filter.Method == HIS.Domain.PaymentMethod.BankTransfer)">Chuyển khoản</option>
                    </select>
                </div>
                <div class="filter-field">
                    <label for="ledger-type">Loại giao dịch</label>
                    <select id="ledger-type" name="Type">
                        <option value="">Tất cả</option>
                        <option value="Payment" selected="@(filter.Type == HIS.Domain.PaymentType.Payment)">Thu phí</option>
                        <option value="Deposit" selected="@(filter.Type == HIS.Domain.PaymentType.Deposit)">Tạm ứng</option>
                        <option value="Refund" selected="@(filter.Type == HIS.Domain.PaymentType.Refund)">Hoàn tiền</option>
                    </select>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn primary">Lọc</button>
                    <a asp-action="Ledger" class="btn outline">Đặt lại</a>
                </div>
            </form>
        </div>
    </section>

    <section class="card">
        <div class="card-header">
            <h2>Danh sách giao dịch (@Model.Count)</h2>
        </div>
        <div class="table-wrap">
            <table class="cashier-table">
                <thead>
                    <tr>
                        <th>Mã giao dịch</th>
                        <th>Số hóa đơn / Phiếu</th>
                        <th>Thời gian</th>
                        <th>Mã hẹn / Người bệnh</th>
                        <th class="right">Số tiền</th>
                        <th class="center">Loại GD</th>
                        <th class="center">Hình thức</th>
                        <th>Mã chuẩn chi</th>
                        <th>Thu ngân</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="center" style="padding: 40px 16px; color: #64748b;">
                                Không có giao dịch nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="mono"><strong>@item.TransactionCode</strong></td>
                                <td class="mono num-pos">@item.InvoiceNumber</td>
                                <td>@item.PaidAt.ToString("HH:mm:ss, dd/MM/yyyy")</td>
                                <td>
                                    <strong>@item.PatientName</strong><br />
                                    <small>Mã: @item.AppointmentCode</small>
                                </td>
                                <td class="right mono @(item.PaymentType == HIS.Domain.PaymentType.Refund ? "num-neg" : "")">
                                    <strong>@(item.PaymentType == HIS.Domain.PaymentType.Refund ? "-" : "")@item.Amount.ToString("N0") đ</strong>
                                </td>
                                <td class="center">
                                    @if (item.PaymentType == HIS.Domain.PaymentType.Payment)
                                    {
                                        <span class="status-badge ok">Thu phí</span>
                                    }
                                    else if (item.PaymentType == HIS.Domain.PaymentType.Deposit)
                                    {
                                        <span class="status-badge ok">Tạm ứng</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge danger">Hoàn tiền</span>
                                    }
                                </td>
                                <td class="center">
                                    @if (item.PaymentMethod == HIS.Domain.PaymentMethod.Cash)
                                    {
                                        <span class="status-badge muted">Tiền mặt</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge ok">Chuyển khoản (VietQR)</span>
                                    }
                                </td>
                                <td class="mono">@(item.ReferenceCode ?? "—")</td>
                                <td>@item.CashierName</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
