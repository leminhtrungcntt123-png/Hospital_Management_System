                <!-- Số 4 bên phải (Miếng băng urgo) -->
                <g id="digit-right-4">
                    <path d="M 380 28 L 338 92 L 400 92 M 380 28 L 380 130" stroke="#bae6fd" stroke-width="20" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M 380 25 L 338 89 L 400 89 M 380 25 L 380 127" stroke="url(#hisTealGrad)" stroke-width="18" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M 380 30 L 343 86 L 394 86 M 380 30 L 380 122" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.45" />

                    <!-- Băng urgo -->
                    <g transform="translate(366, 76) rotate(-22)">
                        <rect x="0" y="0" width="30" height="12" rx="4" fill="#fde68a" stroke="#d97706" stroke-width="1" />
                        <rect x="10" y="1" width="10" height="10" rx="1.5" fill="#fffbeb" />
                        <circle cx="4" cy="6" r="0.8" fill="#b45309" />
                        <circle cx="26" cy="6" r="0.8" fill="#b45309" />
                    </g>
                </g>
            </svg>
        </div>

        <!-- Tiêu đề & Thông điệp tối giản, đúng chuẩn 404 -->
        <h1 class="his-title">KHÔNG TÌM THẤY TRANG</h1>
        <p class="his-desc">Đường dẫn không tồn tại</p>

        <!-- 2. HÌNH HOẠT HỌA "XUẤT HỒN" PHÍA DƯỚI -->
