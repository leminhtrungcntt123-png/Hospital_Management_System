@{
    Layout = "_MediCareAuthLayout";
    ViewData["Title"] = "404 - Không tìm thấy trang";
}

@section Styles {
    <style>
        /* Khóa cứng kích thước và chống tràn tạo thanh cuộn */
        body.mvc-auth {
            overflow-y: auto;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .mvc-auth-main.his-auth-main {
            padding: 8px 14px !important;
            flex: 1 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            box-sizing: border-box;
        }

        .his-404-wrapper {
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            box-sizing: border-box;
        }

        /* Thẻ hiển thị cao cấp, bo góc mềm mại, bóng đổ đa tầng */
        .his-404-card {
            width: min(510px, 94vw);
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(248, 250, 252, 0.96) 100%);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border-radius: 24px;
            padding: 18px 24px 16px;
            box-shadow: 
                0 25px 50px -12px rgba(2, 132, 199, 0.22),
                0 10px 20px -6px rgba(15, 23, 42, 0.06),
                inset 0 1px 0 rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(226, 232, 240, 0.9);
            text-align: center;
            position: relative;
            overflow: hidden;
            box-sizing: border-box;
            transition: box-shadow 0.3s ease;
        }

        .his-404-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3.5px;
            background: linear-gradient(90deg, #0ea5e9, #0284c7, #10b981, #0ea5e9);
            background-size: 200% 100%;
            animation: gradientSlide 4s linear infinite;
        }

        @@keyframes gradientSlide {
            0% { background-position: 0% 50%; }
            100% { background-position: 200% 50%; }
        }

        /* 1. Huy hiệu nhỏ nhắn */
        .his-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 3.5px 11px;
            background: #f0fdf4;
            color: #166534;
            border: 1px solid #bbf7d0;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.4px;
            margin-bottom: 6px;
        }

        .his-badge-pulse {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #ef4444;
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
            animation: pulseDot 1.8s infinite;
        }

        @@keyframes pulseDot {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }

        /* 2. Hình 404 nhịp tim phía trên */
        .his-art-top {
            width: 100%;
            max-width: 320px;
            height: 98px;
            margin: 0 auto 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .his-art-top svg {
            width: 100%;
            height: 100%;
            display: block;
        }

        /* Keyframes ECG & Heart */
        @@keyframes ecgAnim {
            0% { stroke-dashoffset: 500; }
            100% { stroke-dashoffset: 0; }
        }

        .anim-ecg {
            stroke-dasharray: 500;
            animation: ecgAnim 2.5s linear infinite;
        }

        @@keyframes heartLubDub {
            0%, 100% { transform: scale(1); }
            15% { transform: scale(1.22); }
            30% { transform: scale(1); }
            45% { transform: scale(1.15); }
            60% { transform: scale(1); }
        }

        .anim-heart {
            transform-origin: 250px 75px;
            animation: heartLubDub 1.6s ease-in-out infinite;
        }

        @@keyframes floatPill {
            0%, 100% { transform: translateY(0) rotate(15deg); }
            50% { transform: translateY(-5px) rotate(25deg); }
        }

        .anim-pill {
            transform-origin: 45px 30px;
            animation: floatPill 3s ease-in-out infinite;
        }

        @@keyframes floatCross {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }

        .anim-cross {
            transform-origin: 455px 30px;
            animation: floatCross 3.2s ease-in-out infinite;
        }

        @@keyframes eyeBlink {
            0%, 92%, 100% { transform: scaleY(1); }
            96% { transform: scaleY(0.1); }
        }

        .anim-eye {
            transform-origin: center;
            animation: eyeBlink 3.6s infinite;
        }

        @@keyframes magnifyingScan {
            0%, 100% { transform: rotate(-6deg) translate(0, 0); }
            50% { transform: rotate(8deg) translate(3px, -2px); }
        }

        .anim-glass {
            transform-origin: 210px 48px;
            animation: magnifyingScan 2.6s ease-in-out infinite;
        }

        /* Định dạng tiêu đề & thông điệp - Tinh chỉnh hài hòa */
        .his-title {
            font-size: 18px;
            font-weight: 800;
            color: #0f172a;
            margin: 4px 0 3px;
            letter-spacing: 0.6px;
            line-height: 1.3;
        }

        .his-desc {
            font-size: 13px;
            color: #64748b;
            font-weight: 500;
            line-height: 1.4;
            margin: 0 auto 8px;
            max-width: 420px;
        }

        /* 3. Hoạt họa xuất hồn phía dưới - Có vệt chiếu sàn êm dịu */
        .his-art-bottom {
            width: 100%;
            max-width: 380px;
            height: 112px;
            margin: 0 auto 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(ellipse at center bottom, rgba(224, 242, 254, 0.45) 0%, rgba(248, 250, 252, 0) 70%);
            border-radius: 16px;
        }

        .his-art-bottom svg {
            width: 100%;
            height: 100%;
            display: block;
        }

        /* Keyframes */
        @@keyframes soulAscend {
            0%, 100% {
                transform: translateY(0) rotate(0deg);
            }
            50% {
                transform: translateY(-9px) rotate(2.5deg);
            }
        }

        .anim-soul {
            transform-origin: 190px 45px;
            animation: soulAscend 2.8s ease-in-out infinite;
        }

        @@keyframes haloFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-3px); }
        }

        .anim-halo {
            transform-origin: 190px 22px;
            animation: haloFloat 2.6s ease-in-out infinite;
        }

        @@keyframes bubbleFloat {
            0%, 100% { transform: translate(220px, 12px) scale(1); }
            50% { transform: translate(220px, 8px) scale(1.03); }
        }

        .anim-bubble {
            animation: bubbleFloat 2.6s ease-in-out infinite;
        }

        @@keyframes dripFall {
            0% { transform: translateY(0); opacity: 1; }
            70% { transform: translateY(14px); opacity: 1; }
            100% { transform: translateY(17px); opacity: 0; }
        }

        .anim-drip {
            animation: dripFall 1.7s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        @@keyframes flatlineBlink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.35; }
        }

        .anim-flatline {
            animation: flatlineBlink 1.4s ease-in-out infinite;
        }

        @@keyframes floatQ {
            0%, 100% { transform: translateY(0); opacity: 0.7; }
            50% { transform: translateY(-5px); opacity: 1; }
        }

        .anim-float-q {
            animation: floatQ 2.4s ease-in-out infinite;
        }

        /* 4. Nút quay lại sang trọng */
        .his-actions {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 8px;
        }

        .his-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 9px 26px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.3px;
            border-radius: 12px;
            text-decoration: none;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            border: none;
            box-sizing: border-box;
        }

        .his-btn-primary {
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            color: #ffffff !important;
            box-shadow: 0 4px 14px -2px rgba(2, 132, 199, 0.42);
        }

        .his-btn-primary:hover {
            box-shadow: 0 6px 20px -2px rgba(2, 132, 199, 0.55);
            background: linear-gradient(135deg, #0369a1 0%, #075985 100%);
            transform: translateY(-2px);
        }

        .his-btn-primary:active {
            transform: translateY(0);
            box-shadow: 0 2px 8px -1px rgba(2, 132, 199, 0.4);
        }

        /* 5. Chân trang hotline */
        .his-emergency-bar {
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px solid rgba(226, 232, 240, 0.8);
            font-size: 11.5px;
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .his-emergency-bar strong {
            color: #0284c7;
            font-weight: 700;
        }

        @@media (max-width: 576px) {
            .his-404-card {
                padding: 14px 14px 12px;
                border-radius: 18px;
            }

            .his-title {
                font-size: 16px;
            }

            .his-desc {
                font-size: 12px;
                margin-bottom: 6px;
            }

            .his-art-top {
                max-width: 280px;
                height: 85px;
            }

            .his-art-bottom {
                max-width: 320px;
                height: 98px;
            }

            .his-btn {
                width: 100%;
                padding: 9px 16px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .anim-ecg, .anim-heart, .anim-pill, .anim-cross, .anim-eye, .anim-glass,
            .anim-soul, .anim-halo, .anim-bubble, .anim-drip, .anim-flatline,
            .anim-float-q, .his-404-card::before {
                animation: none !important;
            }
        }
    </style>
}

<div class="his-404-wrapper">
    <div class="his-404-card">
        <!-- Huy hiệu nhỏ -->
        <div class="his-badge">
            <span class="his-badge-pulse" aria-hidden="true"></span>
            <span>LỖI 404</span>
        </div>

        <!-- 1. HÌNH 404 NHỊP TIM ĐIỆN TÂM ĐỒ (ECG) PHÍA TRÊN -->
        <div class="his-art-top" aria-label="Hình 404 nhịp tim ECG">
            <svg viewBox="0 0 500 150" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="hisTealGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#38bdf8" />
                        <stop offset="100%" stop-color="#0284c7" />
                    </linearGradient>

                    <linearGradient id="hisScreenGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#0f172a" />
                        <stop offset="100%" stop-color="#090d16" />
                    </linearGradient>

                    <linearGradient id="hisHeartGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#fb7185" />
                        <stop offset="100%" stop-color="#e11d48" />
                    </linearGradient>

                    <filter id="ecgGlow" x="-20%" y="-20%" width="140%" height="140%">
                        <feDropShadow dx="0" dy="0" stdDeviation="2.5" flood-color="#10b981" flood-opacity="0.8" />
                    </filter>
                </defs>

                <!-- Quả thuốc nổi bên trái -->
                <g class="anim-pill">
                    <rect x="36" y="24" width="24" height="12" rx="6" fill="#38bdf8" />
                    <rect x="48" y="24" width="12" height="12" rx="6" fill="#f8fafc" />
                    <line x1="48" y1="24" x2="48" y2="36" stroke="#cbd5e1" stroke-width="0.8" />
                </g>

                <!-- Chữ thập cứu thương bên phải -->
                <g class="anim-cross">
                    <circle cx="460" cy="30" r="12" fill="#fee2e2" />
                    <path d="M 460 23 V 37 M 453 30 H 467" stroke="#ef4444" stroke-width="3" stroke-linecap="round" />
                </g>

                <!-- Số 4 bên trái (Ống nghe y tế) -->
                <g id="digit-left-4">
                    <path d="M 120 28 L 78 92 L 140 92 M 120 28 L 120 130" stroke="#bae6fd" stroke-width="20" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M 120 25 L 78 89 L 140 89 M 120 25 L 120 127" stroke="url(#hisTealGrad)" stroke-width="18" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M 120 30 L 83 86 L 134 86 M 120 30 L 120 122" stroke="#ffffff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.45" />

                    <!-- Dây ống nghe -->
                    <path d="M 66 124 Q 78 100 100 106 T 125 80" fill="none" stroke="#64748b" stroke-width="3" stroke-linecap="round" />
                    <circle cx="65" cy="126" r="5.5" fill="#94a3b8" stroke="#475569" stroke-width="1.5" />
                    <circle cx="65" cy="126" r="2.5" fill="#e2e8f0" />
                </g>

                <!-- Số 0 ở giữa: Màn hình Monitor nhịp tim ECG -->
                <g id="monitor-center-0">
                    <rect x="175" y="18" width="150" height="118" rx="20" fill="#1e293b" stroke="#38bdf8" stroke-width="2.5" />
                    <rect x="183" y="26" width="134" height="102" rx="14" fill="url(#hisScreenGrad)" />

                    <!-- Header monitor -->
                    <circle cx="195" cy="38" r="3" fill="#10b981" />
                    <text x="203" y="41" fill="#38bdf8" font-size="8" font-weight="700" font-family="'Segoe UI', Roboto, sans-serif">MEDICARE·ECG</text>
                    <text x="286" y="41" fill="#f43f5e" font-size="8" font-weight="800" font-family="'Segoe UI', Roboto, sans-serif">404 ERR</text>

                    <!-- Sóng nhịp tim điện tâm đồ chạy liên tục -->
                    <path class="anim-ecg" d="M 185 80 L 210 80 L 215 70 L 220 90 L 227 50 L 234 105 L 240 72 L 245 84 L 252 80 L 278 80 L 284 68 L 290 92 L 295 80 L 315 80"
                          fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" filter="url(#ecgGlow)" />

                    <!-- Quả tim đập theo nhịp sinh học -->
                    <g class="anim-heart">
                        <path d="M 250 72 C 250 68 245 65 241 65 C 236 65 233 68 233 73 C 233 80 240 85 250 92 C 260 85 267 80 267 73 C 267 68 264 65 259 65 C 255 65 250 68 250 72 Z"
                              fill="url(#hisHeartGrad)" />
                    </g>
                </g>

                <!-- Bác sĩ chibi đội mũ phẫu thuật chớp mắt -->
