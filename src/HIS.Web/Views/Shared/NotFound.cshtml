                    <circle cx="130" cy="91" r="10" fill="#fde047" opacity="0.9" />
                    <path d="M 120 88 Q 130 79 140 88" stroke="#0f172a" stroke-width="1.8" stroke-linecap="round" fill="none" />
                    <!-- Mắt x_x -->
                    <path d="M 124 89 L 128 93 M 128 89 L 124 93" stroke="#475569" stroke-width="1.3" stroke-linecap="round" />
                    <path d="M 132 89 L 136 93 M 136 89 L 132 93" stroke="#475569" stroke-width="1.3" stroke-linecap="round" />
                    <ellipse cx="130" cy="96" rx="1.6" ry="1.2" fill="#94a3b8" />
