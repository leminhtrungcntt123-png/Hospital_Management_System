                    </linearGradient>

                    <filter id="soulGlow3" x="-20%" y="-20%" width="140%" height="140%">
                        <feDropShadow dx="0" dy="0" stdDeviation="4" flood-color="#38bdf8" flood-opacity="0.55" />
                    </filter>

                    <filter id="haloGlow3" x="-30%" y="-30%" width="160%" height="160%">
