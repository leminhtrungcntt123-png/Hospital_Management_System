                    <path d="M 235 10 Q 250 2 265 10 C 268 13 268 19 265 21 L 235 21 C 232 19 232 13 235 10 Z" fill="#0284c7" />
                    <rect x="245" y="10" width="10" height="3" rx="1.5" fill="#38bdf8" />
                    <path d="M 237 20 Q 250 22 263 20 Q 265 30 250 31 Q 235 30 237 20 Z" fill="#fde047" opacity="0.9" />
                    <g class="anim-eye">
                        <circle cx="245" cy="24" r="1.8" fill="#0f172a" />
                        <circle cx="255" cy="24" r="1.8" fill="#0f172a" />
                    </g>
                    <ellipse cx="250" cy="28" rx="1.6" ry="1" fill="#b45309" />
