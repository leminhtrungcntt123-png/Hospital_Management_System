<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#079bc9" />
    <link rel="icon" type="image/jpeg" href="~/images/medicare-logo.jpg" />
    <title>@ViewData["Title"] — MediCare HIS</title>
    <partial name="MediCare/_Styles" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/auth/portal.css" asp-append-version="true" />
</head>
<body class="mvc-auth his-auth-bg">
    <partial name="MediCare/_AuthHeader" />
    <main class="mvc-auth-main his-auth-main">
        @RenderBody()
    </main>

    <partial name="MediCare/_AuthFooter" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
