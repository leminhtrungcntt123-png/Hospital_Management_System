     4. MODAL DIALOGS (CHUẨN FORM BACKEND)
     ==================================================================== -->

<!-- MODAL THÊM PHÒNG BAN -->
<dialog id="department-dialog" class="misa-modal" aria-labelledby="department-title">
    <form id="department-form">
        <div class="misa-modal-header">
            <div>
                <p class="misa-modal-eyebrow">CƠ CẤU BỆNH VIỆN</p>
                <h2 id="department-title" class="misa-modal-title">Thêm Khoa / Phòng Ban Mới</h2>
            </div>
            <button type="button" data-close class="misa-modal-close-btn" aria-label="Đóng">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <div class="misa-modal-body">
            <label class="misa-form-label">
                <span>Tên khoa / phòng ban *</span>
                <input name="name" maxlength="100" minlength="2" placeholder="Ví dụ: Khoa Cấp Cứu, Khoa Tim Mạch..." required />
            </label>
            <label class="misa-form-label">
                <span>Mô tả chức năng</span>
                <textarea name="description" maxlength="255" rows="3" placeholder="Mô tả phạm vi hoạt động của khoa phòng..."></textarea>
            </label>
            <p class="form-error" role="alert"></p>
        </div>
        <div class="misa-modal-footer">
            <button type="button" class="btn misa-btn-secondary" data-close>Hủy Bỏ</button>
            <button class="btn misa-btn-primary" type="submit">Lưu Phòng Ban</button>
        </div>
    </form>
</dialog>

<!-- MODAL TẠO TÀI KHOẢN -->
<dialog id="account-dialog" class="misa-modal" aria-labelledby="account-title">
    <form id="account-form">
        <div class="misa-modal-header">
            <div>
                <p class="misa-modal-eyebrow">QUẢN LÝ TRUY CẬP</p>
                <h2 id="account-title" class="misa-modal-title">Tạo Tài Khoản Mới</h2>
            </div>
            <button type="button" data-close class="misa-modal-close-btn" aria-label="Đóng">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <div class="misa-modal-body">
            <div class="misa-form-grid">
                <label class="misa-form-label">
                    <span>Tên đăng nhập *</span>
                    <input
                        name="username"
                        minlength="3"
                        maxlength="50"
                        pattern="[a-zA-Z0-9_.]+"
                        autocomplete="off"
                        placeholder="Tên tài khoản (viết liền không dấu)"
                        required
                    />
                </label>
                <label class="misa-form-label">
                    <span>Mật khẩu ban đầu *</span>
                    <input
                        name="password"
                        type="password"
                        minlength="8"
                        maxlength="72"
                        autocomplete="new-password"
                        placeholder="Ít nhất 8 ký tự"
                        required
                    />
                </label>
                <label class="misa-form-label">
                    <span>Vai trò truy cập *</span>
                    <select name="roleId" required></select>
                </label>
                <label class="misa-form-label">
                    <span>Địa chỉ Email</span>
                    <input name="email" type="email" maxlength="100" placeholder="email@medicare.vn" />
                </label>
                <label class="misa-form-label" data-name-field>
                    <span>Họ và tên nhân sự *</span>
                    <input name="fullName" minlength="2" maxlength="100" placeholder="Họ và tên đầy đủ" />
                </label>
                <label class="misa-form-label" data-department-field>
                    <span>Khoa / Phòng ban công tác *</span>
                    <select name="departmentId"></select>
                </label>
                <label class="misa-form-label" data-patient-field>
                    <span>Ngày sinh người khám *</span>
                    <input name="dateOfBirth" type="date" />
                </label>
                <label class="misa-form-label" data-patient-field>
                    <span>Điện thoại người khám *</span>
                    <input name="phoneNumber" type="tel" maxlength="15" placeholder="Số điện thoại" />
                </label>
            </div>
            <p class="misa-form-hint" id="account-hint">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle; margin-right:4px;" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <span>Tài khoản mới sẽ được tự động kích hoạt ngay sau khi tạo thành công.</span>
            </p>
            <p class="form-error" role="alert"></p>
        </div>
        <div class="misa-modal-footer">
            <button type="button" class="btn misa-btn-secondary" data-close>Hủy Bỏ</button>
            <button class="btn misa-btn-primary" type="submit">Xác Nhận Tạo</button>
        </div>
    </form>
</dialog>

<script src="~/js/admin-management.js" asp-append-version="true" defer></script>
