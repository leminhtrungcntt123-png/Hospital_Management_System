    <form id="upsert-schedule-form">
        <input type="hidden" name="id" value="" />
        <div class="dialog-heading">
            <div>
                <p class="eyebrow">PHÂN CÔNG LỊCH KHÁM</p>
                <h2 id="upsert-schedule-title">Chỉnh sửa ca khám</h2>
            </div>
            <button type="button" data-close aria-label="Đóng">×</button>
        </div>
        <div class="form-grid">
            <label>
                Bác sĩ *
                <select name="doctorId" required></select>
            </label>
            <label>
                Phòng khám *
                <select name="roomId" required></select>
            </label>
            <label>
                Ngày làm việc *
                <input name="workDate" type="date" required />
            </label>
            <label>
                Ca làm việc *
                <select name="shift" required>
                    <option value="0">Ca Sáng (07:30 - 11:30)</option>
                    <option value="1">Ca Chiều (13:00 - 16:30)</option>
                </select>
            </label>
            <label>
                Số BN tối đa
                <input name="maxPatients" type="number" min="1" max="100" value="40" />
            </label>
            <label>
                Số slot online
                <input name="onlineSlots" type="number" min="0" max="100" value="28" />
            </label>
            <label style="grid-column:1 / -1;">
                Ghi chú
                <input name="doctorNote" maxlength="200" placeholder="Ghi chú phân công (nếu có)" />
            </label>
        </div>
        <p class="form-error" role="alert"></p>
        <div class="dialog-actions">
            <button type="button" class="btn button secondary" data-close>Hủy</button>
            <button class="btn button primary" type="submit">Lưu lịch khám</button>
        </div>
    </form>
</dialog>

<dialog id="admin-confirm-dialog" aria-labelledby="admin-confirm-title" style="max-width: 440px;">
    <div class="dialog-heading">
        <div>
            <p class="eyebrow">XÁC NHẬN THAO TÁC</p>
            <h2 id="admin-confirm-title">Xác nhận</h2>
        </div>
        <button type="button" data-close aria-label="Đóng">×</button>
    </div>
    <div class="confirm-body" style="padding: 16px 0; color: #475569;">
        <p id="admin-confirm-msg" style="margin: 0; font-size: 14px; line-height: 1.5;"></p>
    </div>
    <div class="dialog-actions">
        <button type="button" class="btn button secondary" data-confirm-cancel>Hủy</button>
        <button type="button" class="btn button primary" id="admin-confirm-ok">Đồng ý</button>
    </div>
</dialog>

<script src="~/js/admin-management.js" asp-append-version="true" defer></script>
