@{
    ViewData["Title"] = "Quản trị bệnh viện";
    var home = Url.Action("Index", "Home", new { area = "" });
}

<div class="admin-workspace staff-app"
     data-api="@Url.Action("Index", "Management", new { area = "Admin" })"
     data-section="@(ViewData["AdminSection"] ?? "dashboard")">
    <aside class="admin-sidebar sidebar" id="admin-sidebar" aria-label="Điều hướng quản trị">
        <div>
            <a class="admin-brand brand-link" href="@home" aria-label="MediCare, về trang chủ">
                <span class="brand">
                    <span class="brand-mark">@await Html.PartialAsync("_AdminIcon", "plus")</span>
                    <span>MediCare<sup>+</sup></span>
                </span>
            </a>
            <div class="workspace">
                @await Html.PartialAsync("_AdminIcon", "building")
                <span>
                    <strong>Bệnh viện MediCare</strong>
                    <small>Quản trị viên</small>
                </span>
            </div>
        </div>
        <nav class="staff-nav" aria-label="Chức năng quản trị">
            <div class="nav-group">
                <span>ĐIỀU HÀNH</span>
                <a href="#dashboard" data-section="dashboard">
                    @await Html.PartialAsync("_AdminIcon", "grid")
                    <span>Tổng quan &amp; doanh thu</span>
                </a>
                <a href="#requests" data-section="requests">
                    @await Html.PartialAsync("_AdminIcon", "calendar")
                    <span>Nghỉ / đổi ca</span>
                </a>
                <a href="#scheduling" data-section="scheduling">
                    @await Html.PartialAsync("_AdminIcon", "calendar")
                    <span>Phân &amp; duyệt ca</span>
                </a>
                <a href="#audit" data-section="audit">
                    @await Html.PartialAsync("_AdminIcon", "clipboard")
                    <span>Nhật ký truy vết</span>
                </a>
            </div>
            <div class="nav-group">
                <span>QUẢN TRỊ</span>
                <a href="#departments" data-section="departments">
                    @await Html.PartialAsync("_AdminIcon", "building")
                    <span>Phòng ban</span>
                </a>
                <a href="#rooms" data-section="rooms">
                    @await Html.PartialAsync("_AdminIcon", "building")
                    <span>Phòng khám</span>
                </a>
                <a href="#services" data-section="services">
                    @await Html.PartialAsync("_AdminIcon", "pulse")
                    <span>Dịch vụ &amp; bảng giá</span>
                </a>
                <a href="#medications" data-section="medications">
                    @await Html.PartialAsync("_AdminIcon", "wallet")
                    <span>Danh mục thuốc</span>
                </a>
                <a href="#staff" data-section="staff">
                    @await Html.PartialAsync("_AdminIcon", "users")
                    <span>Nhân sự</span>
                </a>
                <a href="#doctors" data-section="doctors">
                    @await Html.PartialAsync("_AdminIcon", "stethoscope")
                    <span>Danh sách bác sĩ</span>
                </a>
                <a href="#accounts" data-section="accounts">
                    @await Html.PartialAsync("_AdminIcon", "shield")
                    <span>Tài khoản</span>
                </a>
            </div>
        </nav>
        <div class="sidebar-bottom">
            <a class="btn portal-link" href="@home">
                @await Html.PartialAsync("_AdminIcon", "external")
                <span>Cổng bệnh nhân</span>
            </a>
            <div>
                <span><i></i>MediCare HIS</span>
            </div>
        </div>
    </aside>
    <button class="admin-sidebar-scrim sidebar-scrim" type="button" aria-label="Đóng điều hướng" hidden></button>

    <div class="admin-content">
        <header class="admin-topbar staff-topbar">
            <button class="icon-btn mobile-only" id="admin-menu-toggle" type="button"
                    aria-label="Mở điều hướng" aria-controls="admin-sidebar" aria-expanded="false">
                @await Html.PartialAsync("_AdminIcon", "menu")
            </button>
            <div class="staff-breadcrumb">
                <span>Quản trị viên</span>
                <i>/</i>
                <strong id="admin-breadcrumb">Tổng quan &amp; doanh thu</strong>
            </div>
            <div class="admin-session">
                <span class="admin-identity">@(User.FindFirst("FullName")?.Value ?? User.Identity?.Name)</span>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button class="btn button secondary sm small-button" type="submit">Đăng xuất</button>
                </form>
            </div>
        </header>

        <main class="staff-main">
            <div class="admin-heading">
                <div>
                    <p class="eyebrow">ĐIỀU HÀNH BỆNH VIỆN</p>
                    <h1 id="page-title">Tổng quan &amp; doanh thu</h1>
                    <p id="page-description">
                        Theo dõi số lượt tiếp nhận và dòng tiền theo thời gian.
                    </p>
                </div>
                <button class="btn button secondary" id="refresh-data" type="button">@await Html.PartialAsync("_AdminIcon", "refresh")<span>Làm mới</span></button>
            </div>

            <div id="admin-message" role="status" aria-live="polite" hidden></div>
            <div id="admin-token" hidden>@Html.AntiForgeryToken()</div>

            <section data-panel="dashboard" aria-label="Báo cáo doanh thu">
                <form id="report-filter" class="filter-bar">
                    <label>
                        Từ ngày
                        <input name="from" type="date" required />
                    </label>
                    <label>
                        Đến ngày
                        <input name="to" type="date" required />
                    </label>
                    <button class="btn button primary" type="submit">Xem báo cáo</button>
                    <button class="btn button secondary" id="export-revenue" type="button">
                        @await Html.PartialAsync("_AdminIcon", "download")<span>Xuất CSV / Excel</span>
                    </button>
                </form>
                <p class="definition">
                    Doanh thu thực thu = tạm ứng + thanh toán − hoàn tiền. Lượng khách tính theo
                    lượt đã tiếp nhận; một người khám nhiều lần được tính nhiều lượt.
                </p>
                <div class="admin-stats" id="report-stats" aria-live="polite"></div>
                <div class="card chart-card">
                    <div class="card-heading">
                        <h2>Doanh thu theo ngày</h2>
                        <span>Tiền thực thu · VNĐ</span>
                    </div>
                    <div id="revenue-chart" class="revenue-chart"></div>
                </div>
                <div class="card">
                    <div class="card-heading">
                        <h2>Chi tiết theo thời gian</h2>
                        <span id="report-period"></span>
                    </div>
                    <div class="table-scroll" id="report-table"></div>
                    <div id="report-pagination" style="display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 16px; border-top:1px solid var(--border, #e2e8f0);" hidden></div>
                </div>
                <div class="card">
                    <div class="card-heading">
                        <h2>Lượt tiếp nhận &amp; doanh thu theo chuyên khoa</h2>
                        <span>Số liệu thống kê trong kỳ</span>
                    </div>
                    <div class="table-scroll" id="department-stats-table"></div>
                </div>
            </section>

            <section data-panel="requests" aria-label="Yêu cầu nghỉ và đổi ca" hidden>
                <p class="definition">
                    Duyệt trước khi ca bắt đầu. Hệ thống chuyển lịch sang khung giờ còn chỗ trong khoa;
                    lịch không còn chỗ được đánh dấu cần đặt lại và gửi thông báo. Khung giờ cũ được khóa
                    để giữ lịch sử.
                </p>
                <div class="card">
                    <div class="card-heading" style="flex-wrap:wrap; gap:10px;">
                        <div style="display:flex; gap:8px; flex-wrap:wrap;" id="requests-status-tabs">
                            <button type="button" class="btn button primary sm" data-req-filter="all">Tất cả</button>
                            <button type="button" class="btn button secondary sm" data-req-filter="Pending">Chờ duyệt</button>
                            <button type="button" class="btn button secondary sm" data-req-filter="Approved">Đã duyệt</button>
                            <button type="button" class="btn button secondary sm" data-req-filter="Rejected">Từ chối</button>
                        </div>
                        <span>Hiển thị tối đa 200 đề nghị gần nhất</span>
                    </div>
                    <div class="table-scroll" id="requests-table"></div>
                </div>
            </section>

            <section data-panel="scheduling" aria-label="Phân và duyệt ca khám" hidden>
                <div class="section-actions">
                    <div class="section-filter-group">
                        <label class="filter-dropdown-label" for="scheduling-dept">
                            Khoa chuyên môn:
                            <select id="scheduling-dept"></select>
                        </label>
                    </div>
                    <div style="display:flex; gap:8px; flex-wrap:wrap;">
                        <button class="btn button secondary" id="open-create-period" type="button">+ Tạo kỳ đăng ký</button>
                        <button class="btn button primary" id="publish-period-btn" type="button" hidden>Xuất bản kỳ &amp; Sinh Slot</button>
                        <button class="btn button primary" id="open-upsert-schedule" type="button">+ Xếp lịch trực tiếp</button>
                    </div>
                </div>
                <div class="card" id="active-period-card" style="padding:14px 18px; margin-bottom:14px;">
                    <div id="active-period-info">Đang tải thông tin kỳ đăng ký...</div>
                </div>
                <div class="card" style="padding:16px; margin-bottom:14px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:12px;">
                        <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; font-size:13px;">
                            <strong>Lưới ca trực đợt đăng ký:</strong>
                            <span>⚪ Đang trống (0 phòng)</span>
                            <span>🟢 Còn chỗ</span>
                            <span>🔴 Cạnh tranh cao</span>
                            <span class="badge reject">🔥 Ca Hot</span>
                        </div>
                        <small style="color:#64748b;">Nhấp vào bất kỳ ca nào trên lưới để tải Bảng Ma trận quyết định bên dưới</small>
                    </div>
                    <div id="demand-grid-board" style="display:grid; grid-auto-flow:column; grid-auto-columns:minmax(200px, 1fr); gap:10px; overflow-x:auto; padding-bottom:6px;"></div>
                </div>
                <div class="card" id="inline-decision-matrix" style="padding:16px; margin-bottom:14px;">
                    <div class="card-heading" style="padding:0 0 12px 0; border-bottom:1px solid #e2e8f0; margin-bottom:12px;">
                        <div>
                            <h2 style="margin:0;">Bảng xếp hạng ưu tiên xét duyệt ca (Decision Matrix)</h2>
                            <small id="dm-selected-label" style="color:#0284c7; font-weight:600;">Chọn một ô ca trên lưới để xem chi tiết</small>
                        </div>
                        <span id="dm-rooms-count" style="font-size:13px; font-weight:600; color:#334155;"></span>
                    </div>
                    <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:12px;">
                        <label style="display:flex; align-items:center; gap:6px; font-size:13px;">
                            Ngày:
                            <input type="date" id="dm-date" />
                        </label>
                        <label style="display:flex; align-items:center; gap:6px; font-size:13px;">
                            Ca:
                            <select id="dm-shift">
                                <option value="0">Sáng (07:30 - 11:30)</option>
                                <option value="1">Chiều (13:00 - 16:30)</option>
                            </select>
                        </label>
                    </div>
                    <div class="table-scroll" id="dm-table"></div>
                </div>
                <div class="card">
                    <div class="card-heading" style="flex-wrap:wrap; gap:10px;">
                        <div>
                            <h2 style="margin:0;">Lịch khám trong tuần</h2>
                            <small style="color:#64748b;">Nhấp vào ca khám để xem hoặc chỉnh sửa Quota tiếp nhận (Tổng chỉ tiêu / Đặt online / Khám tại quầy)</small>
                        </div>
                        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                            <button type="button" class="btn button secondary sm" id="sched-prev-week">← Tuần trước</button>
                            <button type="button" class="btn button secondary sm" id="sched-this-week">Tuần hiện tại</button>
                            <button type="button" class="btn button secondary sm" id="sched-next-week">Tuần sau →</button>
                            <button type="button" class="btn button secondary sm" id="sched-generate-slots">⚡ Sinh slot tuần này</button>
                            <span style="font-size:12px; color:#64748b; background:#f8fafc; padding:4px 10px; border-radius:6px; border:1px solid #e2e8f0;">
                                Sáng: 07:30-11:30 · Chiều: 13:00-16:30 · Tối: 18:00-07:00
                            </span>
                        </div>
                    </div>
                    <div class="table-scroll" id="dept-schedules-grid"></div>
                </div>
            </section>

            <section data-panel="departments" aria-label="Danh sách phòng ban" hidden>
                <div class="section-actions">
                    <div class="section-filter-group">
                        <span>Khoa / đơn vị chuyên môn của bệnh viện</span>
                        <label class="filter-dropdown-label" for="filter-department">
                            Lọc phòng ban:
                            <select id="filter-department">
                                <option value="">Tất cả phòng ban</option>
                            </select>
                        </label>
                    </div>
                    <button class="btn button primary" data-open="department-dialog" type="button">
                        + Thêm phòng ban
                    </button>
                </div>
                <div class="card"><div class="table-scroll" id="departments-table"></div></div>
            </section>

            <section data-panel="staff" aria-label="Danh sách nhân sự" hidden>
                <div class="section-actions">
                    <span>Bác sĩ, y tá và trưởng khoa</span>
                    <button class="btn button primary" id="new-staff" type="button">
                        + Thêm nhân sự
                    </button>
                </div>
                <p class="definition">
                    Hồ sơ nhân sự được tạo cùng tài khoản để bảo đảm liên kết đúng vai trò và phòng
                    ban.
                </p>
                <div class="card"><div class="table-scroll" id="staff-table"></div></div>
            </section>

            <section data-panel="doctors" aria-label="Danh sách bác sĩ" hidden>
                <div class="card">
                    <div class="card-heading">
                        <h2>Đội ngũ bác sĩ</h2>
                        <span>Thông tin nhân sự, không bao gồm bệnh án</span>
                    </div>
                    <div class="table-scroll" id="doctors-table"></div>
                </div>
            </section>

            <section data-panel="accounts" aria-label="Danh sách tài khoản" hidden>
                <div class="section-actions">
                    <span>Quản lý quyền truy cập và trạng thái hoạt động</span>
                    <button class="btn button primary" id="new-account" type="button">
                        + Tạo tài khoản
                    </button>
                </div>
                <div class="card"><div class="table-scroll" id="accounts-table"></div></div>
            </section>

            <section data-panel="rooms" aria-label="Danh sách phòng khám" hidden>
                <div class="section-actions">
                    <div class="section-filter-group">
                        <span>Phòng khám / buồng bệnh theo khoa chuyên môn</span>
                        <label class="filter-dropdown-label" for="filter-room-department">
                            Khoa chuyên môn:
                            <select id="filter-room-department">
                                <option value="">Tất cả khoa chuyên môn</option>
                            </select>
                        </label>
                    </div>
                    <button class="btn button primary" data-open="room-dialog" type="button">
                        + Thêm phòng khám
                    </button>
                </div>
                <div class="card"><div class="table-scroll" id="rooms-table"></div></div>
            </section>

            <section data-panel="services" aria-label="Dịch vụ y tế và bảng giá" hidden>
                <div class="section-actions">
                    <span>Danh mục dịch vụ khám, xét nghiệm và chẩn đoán</span>
                    <button class="btn button primary" data-open="service-dialog" id="new-service" type="button">
                        + Thêm dịch vụ y tế
                    </button>
                </div>
                <div class="card"><div class="table-scroll" id="services-table"></div></div>
            </section>

            <section data-panel="medications" aria-label="Danh mục thuốc" hidden>
                <div class="section-actions">
                    <span>Danh mục thuốc, hoạt chất và đơn giá</span>
                    <button class="btn button primary" data-open="medication-dialog" id="new-medication" type="button">
                        + Thêm thuốc
                    </button>
                </div>
                <div class="card"><div class="table-scroll" id="medications-table"></div></div>
            </section>

            <section data-panel="audit" aria-label="Nhật ký truy vết bảo mật" hidden>
                <form id="audit-filter" class="filter-bar" style="margin-bottom: 20px;">
                    <label>
                        Từ ngày
                        <input name="from" type="date" />
                    </label>
                    <label>
                        Đến ngày
                        <input name="to" type="date" />
                    </label>
                    <label>
                        Loại hành động
                        <select name="action">
                            <option value="">Tất cả hành động</option>
                            <option value="VIEW_RECORD">Xem bệnh án (VIEW_RECORD)</option>
                            <option value="CREATE_RECORD">Lưu bệnh án (CREATE_RECORD)</option>
                            <option value="CHECK_IN_WEB">Tiếp nhận hẹn trước (CHECK_IN_WEB)</option>
                            <option value="REGISTER_WALK_IN">Tiếp nhận tại quầy (REGISTER_WALK_IN)</option>
                            <option value="ADMIN_CREATE_ACCOUNT">Tạo tài khoản (ADMIN_CREATE_ACCOUNT)</option>
                            <option value="ADMIN_ACTIVATE_ACCOUNT">Kích hoạt tài khoản</option>
                            <option value="ADMIN_DEACTIVATE_ACCOUNT">Khóa tài khoản</option>
                            <option value="ADMIN_APPROVE_SCHEDULE">Duyệt ca trực</option>
                            <option value="ADMIN_REJECT_SCHEDULE">Từ chối ca trực</option>
                            <option value="AdminLogin">Đăng nhập</option>
                        </select>
                    </label>
                    <label>
                        Tìm kiếm nhanh
                        <input name="search" type="search" placeholder="Tên nhân sự, IP, bệnh nhân..." />
                    </label>
                    <button class="btn button primary" type="submit">Lọc nhật ký</button>
                    <button class="btn button secondary" id="reset-audit" type="button">Đặt lại</button>
                </form>

                <div class="card">
                    <div class="card-heading">
                        <div>
                            <h2>Nhật ký truy vết hệ thống (Audit Trail)</h2>
                            <span>Ghi nhận thời gian, địa chỉ IP và hành vi truy cập bệnh án / phân quyền</span>
                        </div>
                        <span id="audit-count" class="status">Đang tải...</span>
                    </div>
                    <div class="table-scroll" id="audit-table"></div>
                </div>
            </section>
        </main>
    </div>
</div>

<dialog id="department-dialog" aria-labelledby="department-title">
    <form id="department-form">
        <div class="dialog-heading">
            <div>
                <p class="eyebrow">CƠ CẤU BỆNH VIỆN</p>
                <h2 id="department-title">Thêm phòng ban</h2>
            </div>
            <button type="button" data-close aria-label="Đóng">×</button>
        </div>
        <label>
            Tên phòng ban *
            <input name="name" maxlength="100" minlength="2" required />
        </label>
        <label>
            Mô tả
            <textarea name="description" maxlength="255" rows="3"></textarea>
        </label>
        <p class="form-error" role="alert"></p>
        <div class="dialog-actions">
            <button type="button" class="btn button secondary" data-close>Hủy</button>
            <button class="btn button primary" type="submit">Lưu phòng ban</button>
        </div>
    </form>
</dialog>

<dialog id="account-dialog" aria-labelledby="account-title">
    <form id="account-form">
        <div class="dialog-heading">
            <div>
                <p class="eyebrow">QUẢN LÝ TRUY CẬP</p>
                <h2 id="account-title">Tạo tài khoản</h2>
            </div>
            <button type="button" data-close aria-label="Đóng">×</button>
        </div>
        <div class="form-grid">
            <label>
                Tên đăng nhập *
                <input
                    name="username"
                    minlength="3"
                    maxlength="50"
                    pattern="[a-zA-Z0-9_.]+"
                    autocomplete="off"
                    required
                />
            </label>
            <label>
                Mật khẩu ban đầu *
                <input
                    name="password"
                    type="password"
                    minlength="8"
                    maxlength="72"
                    autocomplete="new-password"
                    required
                />
            </label>
            <label>
                Vai trò *
                <select name="roleId" required></select>
            </label>
            <label>
                Email
                <input name="email" type="email" maxlength="100" />
            </label>
            <label data-name-field>
                Họ tên *
                <input name="fullName" minlength="2" maxlength="100" />
            </label>
            <label data-department-field>
                Phòng ban *
                <select name="departmentId"></select>
            </label>
            <label data-patient-field>
                Ngày sinh người khám *
                <input name="dateOfBirth" type="date" />
            </label>
            <label data-patient-field>
                Điện thoại người khám *
                <input name="phoneNumber" type="tel" maxlength="15" />
            </label>
        </div>
        <p class="definition" id="account-hint">
            Tài khoản mới được kích hoạt sau khi tạo. Mật khẩu không được hiển thị trong danh sách.
        </p>
        <p class="form-error" role="alert"></p>
        <div class="dialog-actions">
            <button type="button" class="btn button secondary" data-close>Hủy</button>
            <button class="btn button primary" type="submit">Tạo tài khoản</button>
        </div>
    </form>
</dialog>

<dialog id="room-dialog" aria-labelledby="room-title">
    <form id="room-form">
        <div class="dialog-heading">
            <div>
                <p class="eyebrow">CƠ CẤU BỆNH VIỆN</p>
                <h2 id="room-title">Thêm phòng khám</h2>
            </div>
            <button type="button" data-close aria-label="Đóng">×</button>
        </div>
        <div class="form-grid">
            <label>
                Khoa / Phòng ban *
                <select name="departmentId" required></select>
            </label>
            <label>
                Số phòng (Mã phòng) *
                <input name="roomNumber" placeholder="VD: P.101" maxlength="20" required />
