@{
    ViewData["Title"] = "Quản trị bệnh viện";
    var home = Url.Action("Index", "Home", new { area = "" });
    var userFullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Admin";
    var initials = userFullName.Length >= 2 ? userFullName.Substring(0, 2).ToUpper() : "AD";
}

<div class="admin-workspace"
     data-api="@Url.Action("Index", "Management", new { area = "Admin" })"
     data-section="@(ViewData["AdminSection"] ?? "dashboard")">

    <!-- ====================================================================
         SIDEBAR: HIS WHITE & GREEN THEME (BALANCED SPACING & COMPACT DESIGN)
         ==================================================================== -->
    <aside class="admin-sidebar" id="admin-sidebar" aria-label="Điều hướng quản trị">
        <div class="sidebar-top">
            <!-- Brand Group -->
            <a class="admin-brand" href="@home" title="HIS MediCare - Về trang chủ">
                <div class="brand-logo-box">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </div>
                <div class="brand-text">
                    <span class="brand-title">HIS <em>MediCare</em></span>
                </div>
            </a>
        </div>

        <!-- Navigation Menu with balanced, harmonious spacing -->
        <nav class="staff-nav" aria-label="Chức năng quản trị">
            <div class="nav-group">
                <span class="nav-group-title">ĐIỀU HÀNH</span>
                <a href="#dashboard" data-section="dashboard" class="nav-item">
                    @await Html.PartialAsync("_AdminIcon", "grid")
                    <span>Tổng quan</span>
                </a>
                <a href="#requests" data-section="requests" class="nav-item">
                    @await Html.PartialAsync("_AdminIcon", "swap")
                    <span>Nghỉ / đổi ca</span>
                </a>
                <a href="#scheduling" data-section="scheduling" class="nav-item">
                    @await Html.PartialAsync("_AdminIcon", "calendar-check")
                    <span>Phân &amp; duyệt ca</span>
                </a>
                <a href="#audit" data-section="audit" class="nav-item">
                    @await Html.PartialAsync("_AdminIcon", "history")
                    <span>Nhật ký truy vết</span>
                </a>
            </div>

            <div class="nav-group">
                <span class="nav-group-title">QUẢN TRỊ</span>
                <a href="#departments" data-section="departments" class="nav-item">
                    @await Html.PartialAsync("_AdminIcon", "building")
                    <span>Phòng ban</span>
                </a>
                <a href="#rooms" data-section="rooms" class="nav-item">
                    @await Html.PartialAsync("_AdminIcon", "door")
                    <span>Phòng khám</span>
                </a>
                <a href="#services" data-section="services" class="nav-item">
                    @await Html.PartialAsync("_AdminIcon", "tag")
                    <span>Dịch vụ &amp; bảng giá</span>
                </a>
                <a href="#medications" data-section="medications" class="nav-item">
                    @await Html.PartialAsync("_AdminIcon", "pill")
                    <span>Danh mục thuốc</span>
                </a>
                <a href="#staff" data-section="staff" class="nav-item">
                    @await Html.PartialAsync("_AdminIcon", "users")
                    <span>Nhân sự</span>
                </a>
                <a href="#doctors" data-section="doctors" class="nav-item">
                    @await Html.PartialAsync("_AdminIcon", "stethoscope")
                    <span>Danh sách bác sĩ</span>
                </a>
                <a href="#accounts" data-section="accounts" class="nav-item">
                    @await Html.PartialAsync("_AdminIcon", "shield")
                    <span>Tài khoản &amp; phân quyền</span>
                </a>
            </div>
        </nav>

        <!-- Sidebar Bottom User Profile -->
        <div class="sidebar-bottom">
            <div class="sidebar-user-card">
                <div class="user-avatar" title="@userFullName">@initials</div>
                <div class="user-details">
                    <strong class="user-name">@userFullName</strong>
                    <span class="user-role">Quản trị viên</span>
                </div>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout-form">
                    <button class="logout-icon-btn" type="submit" title="Đăng xuất hệ thống" aria-label="Đăng xuất">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Mobile scrim backdrop -->
    <button class="admin-sidebar-scrim" type="button" aria-label="Đóng điều hướng" hidden></button>

    <!-- ====================================================================
         MAIN CONTENT AREA
         ==================================================================== -->
    <div class="admin-content">
        <!-- TOPBAR HEADER -->
        <header class="admin-topbar">
            <div class="topbar-left">
                <button class="icon-btn mobile-only" id="admin-menu-toggle" type="button"
                        aria-label="Mở điều hướng" aria-controls="admin-sidebar" aria-expanded="false">
                    @await Html.PartialAsync("_AdminIcon", "menu")
                </button>
                <div class="staff-breadcrumb">
                    <span class="bc-root">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                        Quản trị
                    </span>
                    <span class="bc-sep">›</span>
                    <strong class="bc-current" id="admin-breadcrumb">Tổng quan</strong>
                </div>
            </div>

            <div class="topbar-right">
                <!-- Quick Search Input -->
                <div class="topbar-search">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" placeholder="Tìm kiếm nhanh..." id="admin-quick-search" />
                    <kbd>Ctrl K</kbd>
                </div>

                <!-- Date Range Display Pill -->
                <div class="topbar-date-pill">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <span>@DateTime.Now.ToString("dd/MM/yyyy")</span>
                </div>

                <!-- Admin Session -->
                <div class="admin-session">
                    <div class="session-avatar">@initials</div>
                    <span class="admin-identity">@userFullName</span>
                </div>
            </div>
        </header>

        <!-- MAIN VIEWPORT -->
        <main class="staff-main">
            <!-- PAGE HEADING -->
            <div class="admin-heading">
                <div class="heading-content">
                    <h1 id="page-title">Tổng quan</h1>
                    <p id="page-description" hidden></p>
                </div>
                <div class="heading-actions">
                    <form id="report-filter" class="dashboard-filter">
                        <div class="date-input-group">
                            <label>
                                <span class="input-label-text">Từ ngày</span>
                                <input name="from" type="date" required />
                            </label>
                            <span class="date-arrow">→</span>
                            <label>
                                <span class="input-label-text">Đến ngày</span>
                                <input name="to" type="date" required />
                            </label>
                        </div>
                        <button class="btn button primary" type="submit">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            <span>Xem báo cáo</span>
                        </button>
                    </form>
                    <button class="btn button secondary" id="refresh-data" type="button">
                        @await Html.PartialAsync("_AdminIcon", "refresh")
                        <span>Làm mới</span>
                    </button>
                </div>
            </div>

            <!-- NOTIFICATION MESSAGE BANNER (TOAST) -->
            <div id="admin-message" class="admin-toast" role="status" aria-live="polite" hidden>
                <div class="toast-icon"></div>
                <div class="toast-body">
                    <strong class="toast-title">Thông báo</strong>
                    <span class="toast-text"></span>
                </div>
                <button type="button" class="toast-close" aria-label="Đóng thông báo">×</button>
            </div>
            <div id="admin-token" hidden>@Html.AntiForgeryToken()</div>

            <!-- ================================================================
                 1. PANEL: TỔNG QUAN & DOANH THU (DASHBOARD)
                 ================================================================ -->
            <section data-panel="dashboard" aria-label="Báo cáo doanh thu">
                <!-- KPI STATS CARDS -->
                <div class="admin-stats" id="report-stats" aria-live="polite"></div>

                <!-- CHARTS ROW: BIỂU ĐỒ CỘT 7 NGÀY & BIỂU ĐỒ TRÒN CƠ CẤU -->
                <div class="dashboard-charts-grid">
                    <!-- CỘT TRÁI: BIỂU ĐỒ DOANH THU 7 NGÀY -->
                    <div class="card chart-card">
                        <div class="card-heading">
                            <div class="heading-title-group">
                                <div class="card-title-icon green">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" y1="20" x2="18" y2="10"></line>
                                        <line x1="12" y1="20" x2="12" y2="4"></line>
                                        <line x1="6" y1="20" x2="6" y2="14"></line>
                                    </svg>
                                </div>
                                <div>
                                    <h2>Doanh thu theo ngày</h2>
                                </div>
                            </div>
                        </div>
                        <div class="revenue-chart-wrapper">
                            <div id="revenue-chart-y" class="chart-y-axis" aria-hidden="true"></div>
                            <div id="revenue-chart" class="revenue-chart"></div>
                        </div>
                    </div>

                    <!-- CỘT PHẢI: BIỂU ĐỒ TRÒN CƠ CẤU THEO KHOA -->
                    <div class="card donut-card">
                        <div class="card-heading">
                            <div class="heading-title-group">
                                <div class="card-title-icon green">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <path d="M12 2a10 10 0 0 1 10 10h-10z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h2>Phân bổ lượt khám</h2>
                                    <p class="card-subtitle">Cơ cấu tiếp nhận theo chuyên khoa</p>
                                </div>
                            </div>
                            <span class="badge badge-neutral" id="donut-total-badge">0 lượt</span>
                        </div>
                        <div class="donut-chart-container">
                            <div class="donut-chart-visual">
                                <svg class="donut-svg" viewBox="0 0 160 160" width="150" height="150">
                                    <circle class="donut-bg" cx="80" cy="80" r="56" fill="none" stroke="#e2e8f0" stroke-width="22" />
                                    <g id="donut-segments"></g>
                                </svg>
                                <div class="donut-center-label">
                                    <span class="donut-center-num" id="donut-center-total">0</span>
                                    <span class="donut-center-text">Lượt khám</span>
                                </div>
                            </div>
                            <div class="donut-legend" id="donut-legend"></div>
                        </div>
                    </div>
                </div>

                <!-- TWO COLUMN / GRID LAYOUT FOR TABLES -->
                <div class="dashboard-tables-grid">
                    <!-- TABLE 1: BẢNG KÊ CHI TIẾT THEO THỜI GIAN -->
                    <div class="card">
                        <div class="card-heading">
                            <div class="heading-title-group">
                                <div class="card-title-icon green">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                </div>
                                <div>
                                    <h2>Chi tiết theo thời gian</h2>
                                </div>
                            </div>
                            <div class="card-heading-actions">
                                <span id="report-period" class="badge badge-neutral"></span>
                                <button class="btn button secondary sm small-button" id="export-revenue" type="button">
                                    @await Html.PartialAsync("_AdminIcon", "download")
                                    <span>Xuất CSV</span>
                                </button>
                            </div>
                        </div>
                        <div class="table-scroll" id="report-table"></div>
                        <div id="report-pagination" class="report-pager" hidden></div>
                    </div>

                    <!-- TABLE 2: DOANH THU THEO KHOA -->
                    <div class="card">
                        <div class="card-heading">
                            <div class="heading-title-group">
                                <div class="card-title-icon green">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M4 22V4h16v18 M2 22h20 M8 8h1 M15 8h1 M8 12h1 M15 12h1 M10 22v-6h4v6"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h2>Doanh thu theo chuyên khoa</h2>
                                </div>
                            </div>
                        </div>
                        <div class="table-scroll" id="department-stats-table"></div>
                    </div>
                </div>
            </section>

            <!-- ================================================================
                 2. PANEL: NGHỈ / ĐỔI CA (REQUESTS)
                 ================================================================ -->
            <section data-panel="requests" aria-label="Yêu cầu nghỉ và đổi ca" hidden>
                <div class="card">
                    <div class="card-heading" style="flex-wrap:wrap; gap:12px;">
                        <div class="heading-title-group">
                            <div class="card-title-icon blue">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            </div>
                            <div>
                                <h2>Yêu cầu nghỉ &amp; đổi ca trực</h2>
                                <p class="card-subtitle">Hiển thị tối đa 200 đề nghị ca trực gần nhất</p>
                            </div>
                        </div>
                        <div style="display:flex; gap:8px; flex-wrap:wrap;" id="requests-status-tabs">
                            <button type="button" class="btn button primary sm" data-req-filter="all">Tất cả</button>
                            <button type="button" class="btn button secondary sm" data-req-filter="Pending">Chờ duyệt</button>
                            <button type="button" class="btn button secondary sm" data-req-filter="Approved">Đã duyệt</button>
                            <button type="button" class="btn button secondary sm" data-req-filter="Rejected">Từ chối</button>
                        </div>
                    </div>
                    <div class="table-scroll" id="requests-table"></div>
                </div>
            </section>

            <!-- ================================================================
                 3. PANEL: PHÂN & DUYỆT CA (SCHEDULING)
                 ================================================================ -->
            <section data-panel="scheduling" aria-label="Phân và duyệt ca khám" hidden>
                <div class="sched-hero">
                    <div class="sched-hero-left">
                        <label class="sched-dept" for="scheduling-dept">
                            <span>Khoa</span>
                            <select id="scheduling-dept"></select>
                        </label>
                        <div class="sched-weeknav" id="sched-weeknav" role="group" aria-label="Chuyển tuần">
                            <button type="button" class="sched-nav" id="sched-prev-week" aria-label="Tuần trước">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                            </button>
                            <button type="button" class="sched-range" id="sched-this-week" title="Về tuần hiện tại">Tuần này</button>
                            <button type="button" class="sched-nav" id="sched-next-week" aria-label="Tuần sau">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </button>
                        </div>
                        <span class="sched-period-pill is-none" id="sched-period-pill">Chưa có kỳ đăng ký</span>
                    </div>
                    <div class="sched-hero-actions">
                        <button type="button" class="btn button secondary sm" id="sched-generate-slots" title="Sinh slot khám trực tuyến cho tuần và khoa đang chọn" hidden>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><path d="M12 13v6M9 16h6"></path></svg>
                            <span>Sinh slot</span>
                        </button>
                        <button class="btn button secondary sm" id="publish-period-btn" type="button" hidden>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                            <span>Công bố &amp; Sinh slot</span>
                        </button>
                        <button class="btn button primary sm" id="open-create-period" type="button">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><line x1="12" y1="14" x2="12" y2="18"></line><line x1="10" y1="16" x2="14" y2="16"></line></svg>
                            <span>Mở đợt đăng ký</span>
                        </button>
                    </div>
                </div>

                <div class="sched-kpis" id="sched-kpis"></div>

                <div class="sched-board" id="sched-board">
                    <div class="sched-board-head">
                        <div class="sched-board-tabs" role="tablist" aria-label="Khu vực phân lịch">
                            <button type="button" role="tab" data-sched-view="progress" class="is-active" aria-selected="true">Tiến độ theo khoa</button>
                            <button type="button" role="tab" data-sched-view="roster" aria-selected="false">Lưới lịch chi tiết</button>
                        </div>
                        <div class="sched-board-tools" id="sched-board-tools" hidden>
                            <span class="sched-board-meta" id="roster-meta"></span>
                            <label class="wk-search">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                <input type="search" id="roster-search" placeholder="Tìm bác sĩ…" aria-label="Tìm bác sĩ trong lịch" />
                            </label>
                            <button class="btn button primary sm" id="open-upsert-schedule" type="button" title="Thêm ca khám cho bác sĩ trong khoa đang chọn">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                <span>Thêm ca</span>
                            </button>
                        </div>
                    </div>
                    <div class="sched-pane" id="sched-view-progress">
                        <div id="dept-progress"></div>
                    </div>

                    <div class="sched-pane" id="sched-view-roster" hidden>
                        <div id="dept-schedules-grid"></div>
                        <div class="sched-legend-row">
                            <div class="sched-legend">
                                <span class="sched-legend-title">Ca làm việc</span>
                                <span><i class="lg-swatch lg-morning"></i>Ca sáng</span>
                                <span><i class="lg-swatch lg-afternoon"></i>Ca chiều</span>
                                <span><i class="lg-swatch lg-night"></i>Trực đêm</span>
                                <span><i class="lg-swatch lg-pending"></i>Chờ duyệt</span>
                            </div>
                            <span class="sched-footnote">Bấm ca để sửa · Nút × trên ca để hủy · Bấm ô trống (dấu +) để xếp ca · Giờ Việt Nam (GMT+7)</span>
                        </div>
                    </div>
                </div>

                <div class="sched-pane assign-layout" id="sched-view-assign" hidden>
                    <div class="sched-card assign-form">
                        <header class="assign-head">
                            <div>
                                <h3>Thông tin ca làm việc</h3>
                                <p>Các trường có dấu * là bắt buộc.</p>
                            </div>
                            <button type="button" class="btn button secondary sm" id="assign-back">← Về lịch làm việc</button>
                        </header>
                        <div class="assign-grid">
                            <label>
                                Ngày làm việc *
                                <input type="date" id="assign-date" required />
                            </label>
                            <label>
                                Ca làm việc *
                                <select id="assign-shift">
                                    <option value="0">Ca sáng · 07:30 – 11:30</option>
                                    <option value="1">Ca chiều · 13:00 – 16:30</option>
                                </select>
                            </label>
                            <label>
                                Địa điểm *
                                <select id="assign-room"></select>
                            </label>
                            <label>
                                Lặp lại
                                <select id="assign-repeat">
                                    <option value="1">Không lặp lại</option>
                                    <option value="2">2 tuần</option>
                                    <option value="3">3 tuần</option>
                                    <option value="4">4 tuần</option>
                                </select>
                            </label>
                        </div>
                        <div class="assign-doctors">
                            <div class="assign-doctors-head">
