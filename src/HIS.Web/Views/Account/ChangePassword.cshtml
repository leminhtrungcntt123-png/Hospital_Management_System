@model HIS.Web.Models.ChangePasswordViewModel

@{
    Layout = "_MediCareAuthLayout";
    ViewData["Title"] = "Đổi mật khẩu";
}

<section class="mvc-auth-card card">
    <span class="eyebrow">TÀI KHOẢN CỦA BẠN</span>
    <h1>Đổi mật khẩu</h1>
    <p class="mvc-auth-intro">Cập nhật mật khẩu để bảo vệ tài khoản của bạn.</p>

    @if (ViewBag.SuccessMessage != null)
    {
        <p class="notice">@ViewBag.SuccessMessage</p>
    }

    <form asp-area="" asp-controller="Account" asp-action="ChangePassword" method="post">
        <div asp-validation-summary="ModelOnly" class="mvc-validation" role="alert"></div>

        <div class="field">
            <label for="oldPassword">Mật khẩu hiện tại</label>
            <input id="oldPassword"
                   type="password"
                   asp-for="OldPassword"
                   autocomplete="current-password"
                   required />
            <span asp-validation-for="OldPassword" class="mvc-validation" role="alert"></span>
        </div>

        <div class="field">
            <label for="newPassword">Mật khẩu mới</label>
            <input id="newPassword"
                   type="password"
                   asp-for="NewPassword"
                   autocomplete="new-password"
                   required />
            <span asp-validation-for="NewPassword" class="mvc-validation" role="alert"></span>
        </div>

        <button class="btn primary full large" type="submit">Cập nhật mật khẩu</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
