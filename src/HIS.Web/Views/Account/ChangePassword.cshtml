@model HIS.Web.ViewModels.Account.ChangePasswordViewModel

@{
    Layout = "_MediCareAuthLayout";
    ViewData["Title"] = "Đổi mật khẩu";
}

@section Styles {
    <style>
        .his-change-card {
            position: relative;
            width: min(460px, 94vw);
            background: #ffffff;
            border-radius: 24px;
            padding: 38px 34px;
            box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(226, 232, 240, 0.9);
            box-sizing: border-box;
        }

        .his-change-header {
            text-align: center;
            margin-bottom: 24px;
        }

        .his-change-icon {
            width: 54px;
            height: 54px;
            border-radius: 16px;
            background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);
            color: #0284c7;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 12px;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.15);
        }

        .his-change-title {
            font-size: 24px;
            font-weight: 800;
            color: #0f172a;
            margin: 0 0 6px;
            letter-spacing: -0.3px;
        }

        .his-change-subtitle {
            font-size: 13px;
            color: #64748b;
            margin: 0;
            line-height: 1.5;
        }

        .his-input-group {
            position: relative;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
        }

        .his-input-icon {
            position: absolute;
            left: 14px;
            color: #64748b;
            display: flex;
            align-items: center;
            pointer-events: none;
            transition: color 0.2s;
        }

        .his-input-field {
            width: 100%;
            height: 46px;
            padding: 0 42px 0 42px;
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            font-size: 13.5px;
            color: #0f172a;
            outline: none;
            transition: all 0.2s ease;
            box-sizing: border-box;
        }

        .his-input-field::placeholder {
            color: #94a3b8;
        }

        .his-input-field:focus {
            background: #ffffff;
            border-color: #0284c7;
            box-shadow: 0 0 0 3.5px rgba(2, 132, 199, 0.12);
        }

        .his-input-group:focus-within .his-input-icon {
            color: #0284c7;
        }

        .his-pass-toggle {
            position: absolute;
            right: 12px;
            background: transparent;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            padding: 6px;
            display: flex;
            align-items: center;
            border-radius: 6px;
            transition: color 0.2s;
        }

        .his-pass-toggle:hover {
            color: #0f172a;
        }

        .his-field-error {
            display: block;
            color: #dc2626;
            font-size: 12px;
            margin: -10px 0 12px 4px;
        }

        .his-field-error:empty {
            display: none;
        }

        .his-btn-solid {
            width: 100%;
            height: 46px;
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0.3px;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(2, 132, 199, 0.35);
            transition: all 0.2s ease;
            margin-top: 6px;
        }

        .his-btn-solid:hover {
            background: linear-gradient(135deg, #0369a1 0%, #075985 100%);
            box-shadow: 0 6px 18px rgba(2, 132, 199, 0.45);
            transform: translateY(-1px);
        }

        .his-btn-solid:active {
            transform: translateY(0);
        }

        .his-alert-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            padding: 9px 12px;
            border-radius: 10px;
            font-size: 12.5px;
            margin-bottom: 16px;
            line-height: 1.4;
        }

        .his-back-home {
            position: fixed;
            top: 22px;
            left: 24px;
            z-index: 100;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            color: #1e293b;
            font-weight: 700;
            font-size: 13.5px;
            text-decoration: none;
            border-radius: 999px;
            border: 1px solid rgba(226, 232, 240, 0.9);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            transition: all 0.2s ease;
        }

        .his-back-home:hover {
            background: #ffffff;
            color: #0284c7;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(2, 132, 199, 0.16);
        }

        .his-cancel-link {
            display: block;
            text-align: center;
            margin-top: 16px;
            color: #64748b;
            font-size: 13px;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s;
        }

        .his-cancel-link:hover {
            color: #0284c7;
        }
    </style>
}

<a asp-controller="Booking" asp-action="Index" class="his-back-home" title="Quay lại trang chủ">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7" />
    </svg>
    <span>Về trang chủ</span>
</a>

<div class="his-change-card">
    <div class="his-change-header">
        <div class="his-change-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
        </div>
        <h2 class="his-change-title">Đổi Mật Khẩu</h2>
        <p class="his-change-subtitle">Cập nhật mật khẩu để bảo vệ tài khoản MediCare của bạn.</p>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="his-alert-error" role="alert">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>⚠️ @error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-controller="Account" asp-action="ChangePassword" method="post">
        <!-- Mật khẩu hiện tại -->
        <div class="his-input-group">
            <span class="his-input-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </span>
            <input asp-for="OldPassword"
                   id="oldPassword"
                   type="password"
                   class="his-input-field"
                   placeholder="Mật khẩu hiện tại"
                   autocomplete="current-password"
                   autofocus />
            <button type="button" class="his-pass-toggle" onclick="togglePass('oldPassword', 'eye-old')" title="Hiện/ẩn mật khẩu">
                <svg id="eye-old" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
            </button>
        </div>
        <span asp-validation-for="OldPassword" class="his-field-error"></span>

        <!-- Mật khẩu mới -->
        <div class="his-input-group">
            <span class="his-input-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
            </span>
            <input asp-for="NewPassword"
                   id="newPassword"
                   type="password"
                   class="his-input-field"
                   placeholder="Mật khẩu mới (tối thiểu 6 ký tự)"
                   autocomplete="new-password" />
            <button type="button" class="his-pass-toggle" onclick="togglePass('newPassword', 'eye-new')" title="Hiện/ẩn mật khẩu">
                <svg id="eye-new" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
            </button>
        </div>
        <span asp-validation-for="NewPassword" class="his-field-error"></span>

        <!-- Xác nhận mật khẩu mới -->
        <div class="his-input-group">
            <span class="his-input-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
            </span>
            <input asp-for="ConfirmPassword"
                   id="confirmPassword"
                   type="password"
                   class="his-input-field"
                   placeholder="Nhập lại mật khẩu mới"
                   autocomplete="new-password" />
            <button type="button" class="his-pass-toggle" onclick="togglePass('confirmPassword', 'eye-confirm')" title="Hiện/ẩn mật khẩu">
                <svg id="eye-confirm" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="his-field-error"></span>

        <button type="submit" class="his-btn-solid">Cập Nhật Mật Khẩu</button>
        <a asp-controller="Booking" asp-action="Index" class="his-cancel-link">← Quay lại trang chủ</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePass(inputId, iconId) {
            var el = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (!el || !icon) return;

            if (el.type === 'password') {
                el.type = 'text';
                icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            } else {
                el.type = 'password';
                icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
            }
        }
    </script>
}

