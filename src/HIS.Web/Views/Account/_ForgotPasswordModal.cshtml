<!-- 4. MODAL KHÔI PHỤC MẬT KHẨU (FORGOT PASSWORD MODAL) -->
<div class="his-modal-overlay" id="hisForgotModal" role="dialog" aria-modal="true" aria-labelledby="forgotModalTitle">
    <div class="his-modal-card">
        <button type="button" class="his-modal-close" data-auth-action="closeForgotModal" aria-label="Đóng">&times;</button>

        <div class="his-modal-header">
            <img src="~/images/medicare-logo.jpg" alt="MediCare Logo" class="his-modal-logo" />
            <h3 class="his-modal-title" id="forgotModalTitle">Khôi Phục Mật Khẩu</h3>
            <p class="his-modal-subtitle">Hệ thống thông tin y tế MediCare</p>
        </div>

        <!-- BƯỚC 1: NHẬP EMAIL / TÀI KHOẢN -->
        <div id="forgotStep1" class="his-modal-step">
            <p class="his-step-desc">
                Nhập email hoặc tên tài khoản đã đăng ký. Hệ thống sẽ tạo và gửi mã xác thực (OTP) để bạn đặt lại mật khẩu mới.
            </p>

            <div id="step1Alert" class="auth-hidden his-alert-error"></div>

            <form id="step1Form">
                <div class="his-input-group">
                    <span class="his-input-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                        </svg>
                    </span>
                    <input id="forgot-account" class="his-input-field" aria-label="Email hoặc Tên đăng nhập" placeholder="Email hoặc Tên đăng nhập" required />
                </div>
                <span class="his-field-error" id="forgot-account-error"></span>

                <button type="submit" id="btnSendOtp" class="his-btn-solid">
                    <span id="btnSendOtpText">Gửi Mã Xác Thực OTP</span>
                </button>
            </form>

            <div>
                <a href="#" data-auth-action="closeForgotModal" class="auth-link-medium his-forgot-link">
                    ← Quay lại đăng nhập
                </a>
            </div>
        </div>

        <!-- BƯỚC 2: NHẬP OTP & ĐẶT MẬT KHẨU MỚI -->
        <div id="forgotStep2" class="auth-hidden his-modal-step">
            <div class="his-alert-info">
                Nếu thông tin tài khoản phù hợp, mã OTP gồm 6 chữ số sẽ được gửi đến email đã đăng ký và có hiệu lực trong 5 phút. Vui lòng kiểm tra hộp thư.
            </div>

            <div id="step2Alert" class="auth-hidden his-alert-error"></div>

            <form id="step2Form">
                <input id="step2AccountHidden" type="hidden" />

                <div class="his-input-group">
                    <span class="his-input-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                    </span>
                    <input id="step2Otp" class="auth-otp-input his-input-field" aria-label="Nhập mã OTP (6 chữ số)" placeholder="Nhập mã OTP (6 chữ số)" maxlength="6" pattern="[0-9]{6}" required />
                </div>
                <span class="his-field-error" id="step2Otp-error"></span>

                <div class="his-input-group">
                    <span class="his-input-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </span>
                    <input id="step2NewPass" type="password" class="his-input-field" aria-label="Mật khẩu mới (tối thiểu 6 ký tự)" placeholder="Mật khẩu mới (tối thiểu 6 ký tự)" minlength="6" required />
                    <button type="button" class="his-pass-toggle" data-auth-action="password-toggle" data-input="step2NewPass" data-icon="eye-icon-newpass" title="Hiện/ẩn mật khẩu">
                        <svg id="eye-icon-newpass" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <span class="his-field-error" id="step2NewPass-error"></span>

                <div class="his-input-group">
                    <span class="his-input-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </span>
                    <input id="step2ConfirmPass" type="password" class="his-input-field" aria-label="Nhập lại mật khẩu mới" placeholder="Nhập lại mật khẩu mới" minlength="6" required />
                    <button type="button" class="his-pass-toggle" data-auth-action="password-toggle" data-input="step2ConfirmPass" data-icon="eye-icon-confirmpass" title="Hiện/ẩn mật khẩu">
                        <svg id="eye-icon-confirmpass" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <span class="his-field-error" id="step2ConfirmPass-error"></span>

                <button type="submit" id="btnConfirmReset" class="his-btn-solid">
                    <span id="btnConfirmResetText">Xác Nhận Đổi Mật Khẩu</span>
                </button>
            </form>

            <div>
                <a href="#" data-auth-action="backToStep1" class="his-forgot-link">← Nhập lại email</a>
                <a href="#" data-auth-action="resendOtp" class="auth-link-strong his-forgot-link">Gửi lại OTP</a>
            </div>
        </div>

        <!-- BƯỚC 3: THÀNH CÔNG -->
        <div id="forgotStep3" class="auth-reset-success his-modal-step">
            <div>
                ✓
            </div>
            <h4>Đổi Mật Khẩu Thành Công!</h4>
            <p>
                Mật khẩu mới của bạn đã được cập nhật thành công. Bạn có thể đăng nhập ngay bây giờ.
            </p>
            <button type="button" class="his-btn-solid" data-auth-action="finishAndLogin">Đăng Nhập Ngay</button>
        </div>
    </div>
</div>
