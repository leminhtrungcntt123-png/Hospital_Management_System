@{
    Layout = "_MediCareAuthLayout";
    ViewData["Title"] = "Không có quyền truy cập";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var roleName = (userRole?.Trim().ToUpperInvariant()) switch
    {
        "ADMIN" => "Quản trị viên",
        "DEPARTMENT_HEAD" or "DEPT_HEAD" => "Trưởng khoa",
        "DOCTOR" => "Bác sĩ",
        "NURSE" => "Điều dưỡng / Tiếp đón",
        "CASHIER" => "Thu ngân",
        "PATIENT" => "Bệnh nhân",
        _ => "Chưa xác định"
    };
    var displayName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Người dùng";
}

<div style="width: min(480px, 94vw); background: #ffffff; border-radius: 24px; padding: 36px 30px; box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.25); text-align: center; border: 1px solid rgba(226, 232, 240, 0.9);">
    <div style="width: 60px; height: 60px; border-radius: 50%; background: #fee2e2; color: #ef4444; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 18px;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
    </div>

    <h2 style="font-size: 22px; font-weight: 800; color: #0f172a; margin: 0 0 8px; letter-spacing: -0.3px;">Khu Vực Bị Giới Hạn</h2>
    <p style="font-size: 13.5px; color: #64748b; margin: 0 0 20px; line-height: 1.5;">
        Xin chào <strong>@displayName</strong>,<br />
        Tài khoản của bạn hiện có vai trò: <span style="display: inline-block; padding: 2px 10px; background: #e0f2fe; color: #0369a1; font-weight: 700; border-radius: 999px; font-size: 12.5px;">@roleName</span>.<br />
        Bạn không có quyền truy cập vào chức năng hoặc phân hệ vừa yêu cầu.
    </p>

    <div style="display: flex; flex-direction: column; gap: 10px;">
        <a asp-controller="Account" asp-action="Dashboard" style="display: block; width: 100%; box-sizing: border-box; padding: 12px; background: #0284c7; color: #ffffff; text-decoration: none; border-radius: 12px; font-weight: 700; font-size: 14px; box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);">
            Về trang làm việc của bạn →
        </a>

        <a asp-controller="Account" asp-action="Logout" style="display: block; width: 100%; box-sizing: border-box; padding: 10px; background: #f8fafc; color: #475569; text-decoration: none; border-radius: 12px; font-weight: 600; font-size: 13px; border: 1px solid #e2e8f0;">
            Đăng xuất / Đổi tài khoản
        </a>
    </div>
</div>
