@{
    Layout = "_MediCareAuthLayout";
    ViewData["Title"] = "Không có quyền truy cập";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var roleName = (userRole?.Trim().ToUpperInvariant()) switch
    {
        "ADMIN" => "Quản trị viên",
        "DEPARTMENT_HEAD" or "DEPT_HEAD" => "Trưởng khoa",
        "DOCTOR" => "Bác sĩ",
        "NURSE" => "Điều dưỡng / Tiếp đón",
        "CASHIER" => "Thu ngân",
        "PATIENT" => "Bệnh nhân",
        _ => "Chưa xác định"
    };
    var displayName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Người dùng";
}

<div class="access-denied-card">
    <div class="access-denied-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
    </div>

    <h2 class="access-denied-title">Khu Vực Bị Giới Hạn</h2>
    <p class="access-denied-message">
        Xin chào <strong>@displayName</strong>,<br />
        Tài khoản của bạn hiện có vai trò: <span class="access-denied-role">@roleName</span>.<br />
        Bạn không có quyền truy cập vào chức năng hoặc phân hệ vừa yêu cầu.
    </p>

    <div class="access-denied-actions">
        <a asp-controller="Account" asp-action="Dashboard" class="access-denied-home">
            Về trang làm việc của bạn →
        </a>

        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="access-denied-logout">
                Đăng xuất / Đổi tài khoản
            </button>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/auth/access-denied.css" asp-append-version="true" />
}
