@model HIS.Web.Models.RegisterViewModel

@{
    Layout = "_MediCareAuthLayout";
    ViewData["Title"] = "Đăng ký người khám";
}

<section class="mvc-auth-card card">
    <span class="eyebrow">ĐỒNG HÀNH CÙNG MEDICARE</span>
    <h1>Đăng ký người khám</h1>
    <p class="mvc-auth-intro">Tạo tài khoản để đặt khám và theo dõi hồ sơ của bạn.</p>

    <form asp-controller="Account" asp-action="Register" asp-area="" method="post">
        <div asp-validation-summary="ModelOnly" class="mvc-validation" role="alert"></div>

        <div class="field">
            <label asp-for="FullName">Họ và tên *</label>
            <input asp-for="FullName" autocomplete="name" required />
            <span asp-validation-for="FullName" class="mvc-validation"></span>
        </div>

        <div class="field">
            <label asp-for="DateOfBirth">Ngày sinh *</label>
            <input asp-for="DateOfBirth" type="date" required />
            <span asp-validation-for="DateOfBirth" class="mvc-validation"></span>
        </div>

        <div class="field">
            <label asp-for="PhoneNumber">Số điện thoại *</label>
            <input asp-for="PhoneNumber" type="tel" autocomplete="tel" required />
            <span asp-validation-for="PhoneNumber" class="mvc-validation"></span>
        </div>

        <div class="field">
            <label asp-for="Email">Email liên hệ</label>
            <input asp-for="Email" type="email" autocomplete="email" />
            <span asp-validation-for="Email" class="mvc-validation"></span>
        </div>

        <div class="field">
            <label asp-for="Username">Tên đăng nhập *</label>
            <input asp-for="Username" autocomplete="username" required />
            <span asp-validation-for="Username" class="mvc-validation"></span>
        </div>

        <div class="field">
            <label asp-for="Password">Mật khẩu *</label>
            <input asp-for="Password" autocomplete="new-password" required />
            <span asp-validation-for="Password" class="mvc-validation"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword">Nhập lại mật khẩu *</label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" required />
            <span asp-validation-for="ConfirmPassword" class="mvc-validation"></span>
        </div>

        <button type="submit" class="btn primary full large">Tạo tài khoản</button>
    </form>
    <p class="mvc-auth-switch">
        Đã có tài khoản?
        <a asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a>
    </p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
